#!/usr/bin/env python3
"""rig — bring cloud machines up and down, and hand their names to everything else.

One namespace, one verb-first CLI, one job: make a box exist and be reachable.
Driving the box is bridge's job; running experiments on it is svx's job.

Backends are adapters registered with @backend(name): 'gcp' and 'azure'.
`ls` and `reap` walk every configured cloud (config `clouds:`), because the
machine you forgot is on the cloud you stopped thinking about; the other verbs
locate a rig by name across clouds and fall back to the default backend.

Ownership and expiry (Dan, 2026-09-03, after an H100 billed five idle hours):
every rig is named `<prefix><agent>-<local>` with `prefix:` REQUIRED in the
config — the prefix is how rig knows which machines are its own. `up` puts a
lease on the box (Azure's own auto-shutdown schedule, cloud-side, so it fires
with the laptop asleep and the session dead); `renew` extends it; `gc` offers
to destroy rigs that have sat stopped for days; `keep` exempts one. The verb
an automatic actor gets is always the reversible one: deallocate, never rm.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone

try:
    import yaml
except ImportError:
    yaml = None


CONFIG_PATH = os.path.expanduser("~/.config/rig/config.yaml")
SSH_CONFIG = os.path.expanduser("~/.ssh/config")
BLOCK_BEGIN = "# >>> rig managed block — regenerated by `rig up`; do not edit >>>"
BLOCK_END = "# <<< rig managed block <<<"

# Approximate on-demand USD/hour, us-east1. Informational only — for noticing a
# rig you forgot, not for billing. Unknown types report as '?'.

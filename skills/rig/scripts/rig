    },
}


def die(msg, code=1):
    print(f"rig: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    print(msg, file=sys.stderr)


def deep_merge(base, over):
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = deep_merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


def load_config():
    if not os.path.exists(CONFIG_PATH):
        return dict(DEFAULTS)
    if yaml is None:
        die("PyYAML not available but ~/.config/rig/config.yaml exists")
    with open(CONFIG_PATH) as f:
        return deep_merge(DEFAULTS, yaml.safe_load(f) or {})


# ---------------------------------------------------------------- names

# One name, everywhere: rig name == ssh alias == tmux session == cloud instance.
#
# The separator is a HYPHEN, not a dot, and that is load-bearing rather than
# cosmetic. A dot cannot survive the whole chain: tmux silently rewrites `.`
# to `_` in session names (measured, not documented), and GCE forbids dots in
# instance names outright. Either one alone breaks "one name" — together they
# guarantee that a dotted name means three different strings in three tools,
# which is exactly the confusion this convention exists to remove.
#
# A hyphen is legal and unmangled in all four namespaces, so the name a user
# types is the name every tool shows back.
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,61}[a-z0-9]$")


def owner_prefix(cfg):
    """The configured owner prefix, normalised to end in a hyphen. Required:
    it is how rig tells its own machines from everyone else's, so there is no
    default and nothing is derived from $USER — a guessed prefix would make
    `gc` offer to destroy machines the guess happened to match."""
    p = (cfg.get("prefix") or "").strip().lower()
    if not p:
        die("no `prefix:` in ~/.config/rig/config.yaml — set the owner prefix every rig you "
            "make will carry (Dan's is `do-`); rig refuses to run without one")
    if not p.endswith("-"):
        p += "-"
    if not re.match(r"^[a-z][a-z0-9]*-$", p):
        die(f"bad prefix {p!r} — lowercase letters/digits, e.g. `do-`")
    return p


def name_candidates(name, cfg, agent_opt):
    """(prefixed, legacy) forms of a rig name.

    The namespace is global and flat. Every rig is `<prefix><agent>-<local>`:
    the owner prefix from config says whose it is, the agent slug keeps two
    agents from colliding on 'dev'. `legacy` is the pre-prefix `<agent>-<local>`
    form, kept so rigs made before 2026-09-03 (`svp-h100`, `a2x-dev`) are still
    found by the name they carry; new rigs are never made under it.
    """
    prefix = owner_prefix(cfg)
    agent = (agent_opt or os.environ.get("RIG_AGENT") or os.environ.get("BRIDGE_AGENT")
             or cfg.get("agent") or "").lower()
    if "." in name:
        die(f"bad rig name {name!r} — dots do not survive tmux (rewritten to '_') or GCE "
            f"instance names; use hyphens: {name.replace('.', '-')!r}")
    local = name[len(prefix):] if name.startswith(prefix) else name
    if agent and not local.startswith(f"{agent}-"):
        local = f"{agent}-{local}"
    full = prefix + local
    for n in (full, local):
        if not NAME_RE.match(n):
            die(f"bad rig name {n!r} — lowercase letters, digits and hyphens; "
                f"must start with a letter and end alphanumeric, e.g. do-a2x-dev")
    if not agent:
        note(f"rig: warning: no agent slug known, so {full!r} has no <agent>- part — "
             f"prefer <prefix><agent>-<name> (set --agent or $RIG_AGENT)")
    return full, local


def resolve_name(name, cfg, agent_opt):
    """The canonical `<prefix><agent>-<local>` name — what a NEW rig is called."""
    return name_candidates(name, cfg, agent_opt)[0]


def owned(cfg, row):
    """Is this ls row one of ours to destroy? Rig-tagged AND carrying the owner
    prefix. A rig-tagged box under a pre-prefix name (`a2x-dev`) is still
    listed by name and still `reap`-able (stop is reversible), but `gc` never
    offers it: the prefix is the only evidence of *whose* it is."""
    rig = row.get("rig") or "-"
    return rig != "-" and rig.startswith(owner_prefix(cfg))


# ---------------------------------------------------------------- backends

BACKENDS = {}


def backend(name):
    def wrap(cls):
        cls.name = name
        BACKENDS[name] = cls
        return cls
    return wrap


class BackendDown(Exception):
    """A cloud answered with a failure that is not about any one rig — an
    expired token, a network that is not there, a CLI that crashed. Raised
    instead of dying so a cross-cloud walk (`ls`, `reap`, the frozen nag)
    can report THAT cloud as unreachable and keep going: an expired gcloud
    token was hiding every Azure rig and stopping the hourly reaper (T670,
    2026-09-04 — a $6.98/h box invisible to `rig ls`). Single-backend verbs
    still die on it, in main()."""


class Unavailable(Exception):
    """A backend that cannot run here (CLI missing, not logged in). Fatal for a
    verb aimed at that cloud; a skip-with-note for the cross-cloud walks."""


class Backend:
    """Adapter contract. Every method takes/returns rig-level names, never
    backend-native ones — mapping is the adapter's problem.

    A rig has two independent states, and they cost differently:
      exists?   created / absent      (up creates, rm destroys)
      running?  up / down             (up starts, down stops)
    """

    def __init__(self, cfg):
        self.cfg = cfg

    def up(self, name, opts): raise NotImplementedError
    def down(self, name): raise NotImplementedError
    def rm(self, name): raise NotImplementedError
    def ls(self): raise NotImplementedError          # -> [dict(rig,native,zone,size,gpu,state,ip)]
    def ip(self, name): raise NotImplementedError    # -> str or None
    def ssh_target(self, name): raise NotImplementedError  # -> (user, host, keyfile)

    # Expiry. A lease is a cloud-side deadline after which the box deallocates
    # on its own, with no laptop, session or on-box agent involved. A backend
    # without one says so (returns None) and rig says so out loud on `up`.
    def lease(self, name, hours): return None        # -> datetime (UTC) the box will stop, or None = unsupported
    def lease_info(self, name): return None          # -> datetime (UTC) of the next stop, or None
    def stopped_since(self, row): return None        # -> datetime (UTC) a down row stopped, or None = unknown
    def keep_until(self, row): return None           # -> date the row is exempt from gc through, or None
    def keep(self, name, until): raise NotImplementedError   # tag the rig exempt from gc through `until` (date)
    def watch(self, name, idle_min): return None     # install the on-box idle watcher; None = unsupported here


@backend("gcp")
class GCP(Backend):
    """Google Compute Engine, via the gcloud CLI.

    Naming: rig names are already RFC1035-legal, so the instance carries the
    rig name verbatim — there is no mapping layer to get wrong. The name is
    also written to instance metadata as 'rig-name' so that machines created
    outside rig can be adopted under a chosen name.
    """

    def __init__(self, cfg):
        super().__init__(cfg)
        self.c = cfg["gcp"]
        if not shutil.which("gcloud"):
            raise Unavailable("gcloud not on PATH")

    # -- plumbing

    def _gcloud(self, *args, check=True, json_out=False):
        cmd = ["gcloud", "compute", *args]
        if self.c.get("project"):
            cmd += [f"--project={self.c['project']}"]
        if json_out:
            cmd += ["--format=json"]
        p = subprocess.run(cmd, capture_output=True, text=True)
        if check and p.returncode != 0:
            raise BackendDown(p.stderr.strip() or f"gcloud failed: {' '.join(args)}")
        if json_out:
            try:
                return json.loads(p.stdout or "[]")
            except json.JSONDecodeError:
                return []
        return p

    @staticmethod
    def _native(name):
        # Identity by construction — rig names are RFC1035-legal. The replace
        # is a safety net for any legacy dotted name still recorded in metadata.
        return name.replace(".", "-")

    def _find(self, name):
        """Locate an instance by rig name. Returns the raw gcloud dict or None."""
        want = self._native(name)
        for inst in self._gcloud("instances", "list", json_out=True):
            meta = {i["key"]: i.get("value") for i in inst.get("metadata", {}).get("items", [])}
            if meta.get("rig-name") == name or inst["name"] == want:
                return inst
        return None

    @staticmethod
    def _ip_of(inst):
        for nic in inst.get("networkInterfaces", []):
            for ac in nic.get("accessConfigs", []):
                if ac.get("natIP"):
                    return ac["natIP"]
        return None

    @staticmethod
    def _row(inst):
        gpus = inst.get("guestAccelerators") or []
        gpu = ",".join(f"{g['acceleratorCount']}x{g['acceleratorType'].rsplit('/', 1)[-1]}" for g in gpus) or "-"
        meta = {i["key"]: i.get("value") for i in inst.get("metadata", {}).get("items", [])}
        return {
            "rig": meta.get("rig-name") or "-",
            "native": inst["name"],
            "zone": inst["zone"].rsplit("/", 1)[-1],
            "size": inst["machineType"].rsplit("/", 1)[-1],
            "gpu": gpu,
            "state": "up" if inst["status"] == "RUNNING" else "down",
            "ip": GCP._ip_of(inst) or "-",
        }

    # -- verbs

    def up(self, name, opts):
        inst = self._find(name)
        if inst:
            zone = inst["zone"].rsplit("/", 1)[-1]
            if inst["status"] == "RUNNING":
                note(f"rig: {name} already up")
            else:
                note(f"rig: starting {name} ({inst['name']}, {zone})")
                self._gcloud("instances", "start", inst["name"], f"--zone={zone}")
            return self._find(name)

        native = self._native(name)
        size = opts.size or self.c["size"]
        zones = [opts.zone] if opts.zone else list(self.c["zones"])
        keyfile = os.path.expanduser(self.c["key"])
        pub = keyfile + ".pub"
        if not os.path.exists(pub):
            die(f"public key {pub} missing — generate it with: ssh-keygen -t ed25519 -f {keyfile} -N ''")

        keydir = os.path.expanduser("~/.config/rig")
        os.makedirs(keydir, exist_ok=True)
        keyspec = os.path.join(keydir, "sshkeys.tmp")
        with open(keyspec, "w") as f:
            f.write(f"{self.c['user']}:{open(pub).read().strip()}\n")

        # Zone fallback: G2 stockouts are routine and gcloud names the zones
        # that do have capacity, but only after the request fails.
        last = None
        for zone in zones:
            note(f"rig: creating {name} as {native} ({size}, {zone})")
            p = self._gcloud(
                "instances", "create", native,
                f"--zone={zone}",
                f"--machine-type={size}",
                f"--image-family={opts.image or self.c['image_family']}",
                f"--image-project={self.c['image_project']}",
                f"--boot-disk-size={opts.disk or self.c['disk']}GB",
                f"--boot-disk-type={self.c['disk_type']}",
                "--maintenance-policy=TERMINATE",
                f"--metadata-from-file=ssh-keys={keyspec}",
                f"--metadata=rig-name={name},block-project-ssh-keys=TRUE,install-nvidia-driver=True",
                "--labels=managed-by=rig",
                check=False,
            )
            if p.returncode == 0:
                break
            last = p.stderr.strip()
            if "STOCKOUT" in last or "does not have enough resources" in last:
                note(f"rig: {zone} is out of capacity, trying next zone")
                continue
            die(last)
        else:
            die(f"no zone had capacity for {size}\n{last}")

        return self._find(name)

    def down(self, name):
        inst = self._find(name)
        if not inst:
            return False
        if inst["status"] != "RUNNING":
            note(f"rig: {name} already down")
            return True
        self._gcloud("instances", "stop", inst["name"], f"--zone={inst['zone'].rsplit('/', 1)[-1]}")
        return True

    def rm(self, name):
        inst = self._find(name)
        if not inst:
            return False
        self._gcloud("instances", "delete", inst["name"],
                     f"--zone={inst['zone'].rsplit('/', 1)[-1]}", "--quiet")
        return True

    def ls(self):
        return [self._row(i) for i in self._gcloud("instances", "list", json_out=True)]

    def ip(self, name):
        inst = self._find(name)
        return self._ip_of(inst) if inst else None

    def ssh_target(self, name):
        return self.c["user"], self.ip(name), os.path.expanduser(self.c["key"])

    # No lease on GCE: an instance schedule needs a resource policy and IAM the
    # project's Contributor role does not grant, and SportsVisio compute left
    # GCP on 2026-09-02. `up --cloud gcp` says so; the reaper is the only net.

    def stopped_since(self, row):
        inst = self._find(row["rig"]) if row["rig"] != "-" else None
        ts = (inst or {}).get("lastStopTimestamp")
        return _parse_iso(ts) if ts else None

    def keep_until(self, row):
        inst = self._find(row["rig"]) if row["rig"] != "-" else None
        v = ((inst or {}).get("labels") or {}).get("rig-keep-until")
        return _parse_ymd(v) if v else None

    def keep(self, name, until):
        inst = self._find(name)
        if not inst:
            return False
        self._gcloud("instances", "add-labels", inst["name"],
                     f"--zone={inst['zone'].rsplit('/', 1)[-1]}",
                     f"--labels=rig-keep-until={until.strftime('%Y%m%d')}")
        return True


def _parse_iso(s):
    """Cloud timestamps: RFC3339 with Z or offset, sometimes 7-digit fractions."""
    s = re.sub(r"(\.\d{6})\d+", r"\1", s.strip()).replace("Z", "+00:00")
    try:
        return datetime.fromisoformat(s).astimezone(timezone.utc)
    except ValueError:
        return None


def _parse_ymd(s):
    s = s.strip().replace("-", "")
    try:
        return datetime.strptime(s, "%Y%m%d").date()
    except ValueError:
        return None


@backend("azure")
class Azure(Backend):
    """Microsoft Azure, via the az CLI.

    Naming: rig names are legal VM names verbatim, so the VM carries the rig
    name and the tag `rig-name` (adoption of a VM made outside rig works the
    same way as on GCE).

    Every rig lives in its OWN resource group, named exactly as the rig is
    (the owner prefix already says whose it is; `rig-<name>` was the form
    before 2026-09-03 and is still recognised by `rm`). `az vm delete`
    removes the VM and leaves NIC, public IP, NSG and the OS disk behind -- the
    disk still billing -- and there is no flag that reliably takes all of them.
    `az group delete` on a per-rig group takes everything in one call, so `rm`
    has nothing to forget. A VM found in somebody else's group is never
    group-deleted; `rm` falls back to deleting the VM alone and says what it
    left.

    `down` is `deallocate`, never `stop`: a stopped-but-allocated Azure VM
    keeps billing for compute. That is the Azure spelling of the down/rm trap.
    """

    def __init__(self, cfg):
        super().__init__(cfg)
        self.c = cfg["azure"]
        if not shutil.which("az"):
            raise Unavailable("az not on PATH")

    # -- plumbing

    def _az(self, *args, check=True, json_out=True):
        cmd = ["az", *args, "-o", "json" if json_out else "none"]
        if self.c.get("subscription"):
            cmd += ["--subscription", self.c["subscription"]]
        p = subprocess.run(cmd, capture_output=True, text=True)
        if p.returncode != 0:
            err = p.stderr.strip()
            if "az login" in err or "AADSTS" in err:
                raise Unavailable("az is not logged in — run: az login --use-device-code")
            if check:
                raise BackendDown(err or f"az failed: {' '.join(args)}")
            return p
        if json_out:
            try:
                return json.loads(p.stdout or "null")
            except json.JSONDecodeError:
                return None
        return p

    def _vms(self):
        # -d adds powerState and publicIps; the plain list has neither.
        return self._az("vm", "list", "-d") or []

    def _find(self, name):
        for vm in self._vms():
            if (vm.get("tags") or {}).get("rig-name") == name or vm["name"] == name:
                return vm
        return None

    @staticmethod
    def _row(vm):
        size = (vm.get("hardwareProfile") or {}).get("vmSize", "?")
        short = size.replace("Standard_", "")
        gpu = AZURE_GPU.get(short) or ("gpu?" if short[:1] == "N" else "-")
        return {
            "rig": (vm.get("tags") or {}).get("rig-name") or "-",
            "native": vm["name"],
            "zone": vm.get("location", "?"),
            "size": size,
            "gpu": gpu,
            "state": "up" if vm.get("powerState") == "VM running" else "down",
            "ip": vm.get("publicIps") or "-",
            "rg": vm.get("resourceGroup"),
        }

    # -- verbs

    def up(self, name, opts):
        vm = self._find(name)
        if vm:
            if vm.get("powerState") == "VM running":
                note(f"rig: {name} already up")
            else:
                note(f"rig: starting {name} ({vm['name']}, {vm['resourceGroup']})")
                self._az("vm", "start", "-g", vm["resourceGroup"], "-n", vm["name"], json_out=False)
            return self._find(name)

        size = opts.size or self.c["size"]
        loc = opts.zone or self.c["location"]
        keyfile = os.path.expanduser(self.c["key"])
        pub = keyfile + ".pub"
        if not os.path.exists(pub):
            die(f"public key {pub} missing — generate it with: ssh-keygen -t ed25519 -f {keyfile} -N ''")
        rg = name   # the group IS the rig: same prefixed name, nothing to translate (Dan, 2026-09-03)
        note(f"rig: creating {name} in {rg} ({size}, {loc})")
        self._az("group", "create", "-n", rg, "-l", loc,
                 "--tags", "managed-by=rig", f"rig-name={name}", json_out=False)
        p = self._az(
            "vm", "create", "-g", rg, "-n", name, "-l", loc,
            "--image", opts.image or self.c["image"],
            "--size", size,
            "--admin-username", self.c["user"],
            "--ssh-key-values", pub,
            "--os-disk-size-gb", str(opts.disk or self.c["disk"]),
            "--storage-sku", self.c["disk_sku"],
            "--public-ip-sku", "Standard",
            "--nsg-rule", "SSH",
            "--tags", "managed-by=rig", f"rig-name={name}",
            check=False, json_out=False,
        )
        if p.returncode != 0:
            err = p.stderr.strip()
            # Nothing to keep: an empty group is not free of confusion even if
            # it is free of charge, and a half-made VM has a disk that bills.
            self._az("group", "delete", "-n", rg, "--yes", "--no-wait", check=False, json_out=False)
            if any(k in err for k in ("SkuNotAvailable", "AllocationFailed", "Overconstrained", "QuotaExceeded")):
                die(f"{loc} cannot allocate {size} right now (capacity or quota). "
                    f"`az vm list-usage -l {loc}` shows quota; try --size or --zone <other-location>.\n{err[:600]}")
            die(err)
        return self._find(name)

    def down(self, name):
        vm = self._find(name)
        if not vm:
            return False
        if vm.get("powerState") != "VM running":
            note(f"rig: {name} already down")
            return True
        self._az("vm", "deallocate", "-g", vm["resourceGroup"], "-n", vm["name"], json_out=False)
        return True

    def rm(self, name):
        vm = self._find(name)
        if not vm:
            return False
        rg = vm["resourceGroup"]
        # Own group = named for the rig. `rig-<name>` is the pre-2026-09-03 form,
        # accepted so a rig made under it still cleans up whole.
        if rg.lower() in (name.lower(), f"rig-{name}".lower()):
            self._az("group", "delete", "-n", rg, "--yes", json_out=False)
            return True
        self._az("vm", "delete", "-g", rg, "-n", vm["name"], "--yes", json_out=False)
        note(f"rig: {name} lived in {rg}, not its own group — its NIC, public IP, NSG and OS disk "
             f"are still there; clean them by hand or delete the group if it is yours")
        return True

    def ls(self):
        return [self._row(vm) for vm in self._vms()]

    def ip(self, name):
        vm = self._find(name)
        return (vm.get("publicIps") or None) if vm else None

    def ssh_target(self, name):
        return self.c["user"], self.ip(name), os.path.expanduser(self.c["key"])

    # The lease is Azure's own auto-shutdown schedule: a DevTestLab schedule
    # resource in the VM's group that DEALLOCATES the VM at a UTC time of day.
    # It runs on Azure's side, so it fires with the laptop shut and the agent
    # gone, and a Contributor can set it -- unlike a self-stopping managed
    # identity, which needs a role assignment Contributor cannot make (checked
    # 2026-09-03: Dan is Contributor on sv-startups-01). One day is the
    # ceiling: the schedule is daily, so a lease is always < 24 h out; `renew`
    # moves the time, and a stopped VM is a no-op for it.

    def _schedule(self, vm):
        return self._az("resource", "show", "-g", vm["resourceGroup"],
                        "-n", f"shutdown-computevm-{vm['name']}",
                        "--resource-type", "Microsoft.DevTestLab/schedules", check=False)

    def lease(self, name, hours):
        vm = self._find(name)
        if not vm:
            return None
        if not 0 < hours < 24:
            die(f"lease must be under 24 h (the schedule is daily); got {hours}")
        at = datetime.now(timezone.utc) + timedelta(hours=hours)
        self._az("vm", "auto-shutdown", "-g", vm["resourceGroup"], "-n", vm["name"],
                 "--time", at.strftime("%H%M"), json_out=False)
        return at.replace(second=0, microsecond=0)

    def lease_off(self, name):
        vm = self._find(name)
        if vm:
            self._az("vm", "auto-shutdown", "-g", vm["resourceGroup"], "-n", vm["name"],
                     "--off", check=False, json_out=False)

    def lease_info(self, name):
        vm = self._find(name)
        if not vm:
            return None
        s = self._schedule(vm)
        if not isinstance(s, dict):
            return None
        props = s.get("properties") or {}
        if props.get("status") != "Enabled":
            return None
        hhmm = (props.get("dailyRecurrence") or {}).get("time", "")
        if not re.match(r"^\d{4}$", hhmm):
            return None
        now = datetime.now(timezone.utc)
        at = now.replace(hour=int(hhmm[:2]), minute=int(hhmm[2:]), second=0, microsecond=0)
        return at if at > now else at + timedelta(days=1)

    def stopped_since(self, row):
        # `vm list -d` carries no stop time; the instance view's provisioning
        # status is stamped with the last operation, which for a deallocated
        # VM is the deallocation.
        if not row.get("rg"):
            return None
        view = self._az("vm", "get-instance-view", "-g", row["rg"], "-n", row["native"],
                        "--query", "instanceView.statuses", check=False)
        for st in view or []:
            if str(st.get("code", "")).startswith("ProvisioningState/") and st.get("time"):
                return _parse_iso(st["time"])
        return None

    def keep_until(self, row):
        vm = self._find(row["rig"]) if row["rig"] != "-" else None
        v = ((vm or {}).get("tags") or {}).get("rig-keep-until")
        return _parse_ymd(v) if v else None

    def keep(self, name, until):
        vm = self._find(name)
        if not vm:
            return False
        self._az("vm", "update", "-g", vm["resourceGroup"], "-n", vm["name"],
                 "--set", f"tags.rig-keep-until={until.isoformat()}", json_out=False)
        return True

    # The on-box watcher. The VM gets a system-assigned identity holding ONE
    # custom role, scoped to its own resource group: read + deallocate. A
    # systemd timer runs the same idle probe `reap` uses and, when nothing has
    # happened for idle_minutes, deallocates the VM through the instance
    # metadata token -- no CLI, no secrets, no laptop. Needs the caller to be
    # able to write role definitions/assignments (Owner); Juan granted Dan a
    # conditioned Owner on 2026-09-03 for exactly this.

    SELF_STOP_ROLE = "Rig Self-Stop"

    def _sub(self):
        return self.c.get("subscription") or self._az("account", "show", "--query", "id")

    def _ensure_role(self):
        have = self._az("role", "definition", "list", "--name", self.SELF_STOP_ROLE, "--custom-role-only", "true")
        if have:
            return
        sub = self._sub()
        spec = {
            "Name": self.SELF_STOP_ROLE, "IsCustom": True,
            "Description": "Let a rig VM read and deallocate itself (rig on-box idle watcher, 2026-09-03).",
            "Actions": ["Microsoft.Compute/virtualMachines/read",
                        "Microsoft.Compute/virtualMachines/deallocate/action"],
            "NotActions": [], "AssignableScopes": [f"/subscriptions/{sub}"],
        }
        path = os.path.expanduser("~/.config/rig/self-stop-role.json")
        with open(path, "w") as f:
            json.dump(spec, f)
        self._az("role", "definition", "create", "--role-definition", path, json_out=False)
        note(f"rig: created custom role {self.SELF_STOP_ROLE!r} (read + deallocate) on the subscription")

    def watch(self, name, idle_min):
        vm = self._find(name)
        if not vm:
            return None
        rg = vm["resourceGroup"]
        self._ensure_role()
        ident = self._az("vm", "identity", "assign", "-g", rg, "-n", vm["name"])
        pid = (ident or {}).get("systemAssignedIdentity") or ((ident or {}).get("identity") or {}).get("principalId")
        if not pid:
            die(f"{name}: could not read the VM's identity principal from `az vm identity assign`: {ident}")
        scope = f"/subscriptions/{self._sub()}/resourceGroups/{rg}"
        p = self._az("role", "assignment", "create", "--assignee-object-id", pid,
                     "--assignee-principal-type", "ServicePrincipal",
                     "--role", self.SELF_STOP_ROLE, "--scope", scope, check=False, json_out=False)
        if p is not None and getattr(p, "returncode", 0) != 0 and "RoleAssignmentExists" not in (p.stderr or ""):
            die(f"{name}: role assignment failed: {p.stderr.strip()[:400]}")
        script = WATCH_INSTALL.replace("__IDLE__", str(int(idle_min)))
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=30", name, "sudo bash -s"],
                           input=script, capture_output=True, text=True)
        if r.returncode != 0:
            die(f"{name}: watcher install failed over ssh: {r.stderr.strip()[:400]}")
        return idle_min


# Installed on the box by `Azure.watch` via `ssh NAME sudo bash -s`. Bash + curl
# + python3 only (all on the HPC image); nvidia-smi is optional (no GPU → 0).
# Busy = any of: GPU compute process, 1-min load >= LOAD_MAX, tmux input inside
# IDLE_MIN on ANY user's server, a logged-in tty; plus a boot grace of IDLE_MIN.
WATCH_INSTALL = r"""
set -e
mkdir -p /etc/rig
cat > /etc/rig/watch.conf <<EOF
IDLE_MIN=__IDLE__
LOAD_MAX=0.2
EOF
cat > /usr/local/bin/rig-watch <<'EOF'
#!/bin/bash
# rig on-box idle watcher: deallocate THIS vm when nothing is happening.
. /etc/rig/watch.conf
log(){ echo "$(date -u +%FT%TZ) $*" >> /var/log/rig-watch.log; }
up_s=$(cut -d. -f1 /proc/uptime)
[ "$up_s" -lt $((IDLE_MIN*60)) ] && { log "grace: booted ${up_s}s ago"; exit 0; }
gpu=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | sed '/^$/d' | wc -l | tr -d ' ')
load=$(cut -d' ' -f1 /proc/loadavg)
now=$(date +%s); act=0
for s in /tmp/tmux-*/default; do
  [ -S "$s" ] || continue
  for a in $(tmux -S "$s" list-sessions -F '#{session_activity}' 2>/dev/null); do
    [ "$a" -gt "$act" ] && act=$a
  done
done
logins=$(who | wc -l | tr -d ' ')
idle_s=999999; [ "$act" != 0 ] && idle_s=$((now-act))
busy=""
[ "${gpu:-0}" -gt 0 ] && busy="$busy gpu_procs=$gpu"
awk -v l="$load" -v m="$LOAD_MAX" 'BEGIN{exit !(l>=m)}' && busy="$busy load=$load"
[ "$idle_s" -lt $((IDLE_MIN*60)) ] && busy="$busy tmux_input=$((idle_s/60))m_ago"
[ "$logins" -gt 0 ] && busy="$busy logins=$logins"
if [ -n "$busy" ]; then log "busy:$busy"; exit 0; fi
log "IDLE gpu=$gpu load=$load tmux_idle=$((idle_s/60))m logins=0 -> deallocating self"
md(){ curl -sf -H Metadata:true "http://169.254.169.254/metadata/$1"; }
inst=$(md "instance/compute?api-version=2021-02-01")
jget(){ python3 -c 'import sys,json;print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }
sub=$(echo "$inst" | jget subscriptionId); rg=$(echo "$inst" | jget resourceGroupName); vm=$(echo "$inst" | jget name)
tok=$(md "identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fmanagement.azure.com%2F" | jget access_token)
url="https://management.azure.com/subscriptions/$sub/resourceGroups/$rg/providers/Microsoft.Compute/virtualMachines/$vm/deallocate?api-version=2024-07-01"
code=$(curl -s -o /tmp/rig-watch.resp -w '%{http_code}' -X POST -H "Authorization: Bearer $tok" -H "Content-Length: 0" "$url")
log "deallocate -> HTTP $code $(head -c 200 /tmp/rig-watch.resp | tr '\n' ' ')"
EOF
chmod +x /usr/local/bin/rig-watch
cat > /etc/systemd/system/rig-watch.service <<EOF
[Unit]
Description=rig on-box idle watcher (deallocate self when idle)
[Service]
Type=oneshot
ExecStart=/usr/local/bin/rig-watch
EOF
cat > /etc/systemd/system/rig-watch.timer <<EOF
[Unit]
Description=rig on-box idle watcher, every 5 min
[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now rig-watch.timer >/dev/null 2>&1
echo "rig-watch installed (idle __IDLE__ min)"
"""


# ---------------------------------------------------------------- ssh config

def _edit_ssh_block(name, stanza):
    """Replace (or with stanza=None, drop) this rig's entry in the managed block.

    The block exists because cloud addresses are not stable: a rig that stops and
    starts may come back on a different IP, and every consumer (bridge, svx,
    plain ssh) reaches it by alias. Rewriting on every `up` repairs the
    indirection exactly when it breaks.

    Removal matters as much as writing. A destroyed rig whose alias survives
    points at an address the cloud will recycle to somebody else's machine —
    which is worse than a broken alias, because it still connects.
    """
    text = open(SSH_CONFIG).read() if os.path.exists(SSH_CONFIG) else ""
    if BLOCK_BEGIN in text and BLOCK_END in text:
        head, rest = text.split(BLOCK_BEGIN, 1)
        block, tail = rest.split(BLOCK_END, 1)
    else:
        head, block, tail = text.rstrip("\n") + "\n\n", "\n", "\n"

    kept = [s for s in re.split(r"\n(?=Host )", block.strip("\n"))
            if s.strip() and not re.match(rf"Host {re.escape(name)}\s*$", s.splitlines()[0].strip())]
    if stanza:
        kept.append(stanza.rstrip("\n"))

    body = "\n".join(kept)
    with open(SSH_CONFIG, "w") as f:
        f.write(head + BLOCK_BEGIN + "\n" + (body + "\n" if body else "") + BLOCK_END + tail)
    os.chmod(SSH_CONFIG, 0o600)


def write_ssh_alias(name, user, host, keyfile):
    _edit_ssh_block(name, (f"Host {name}\n"
                           f"    HostName {host}\n"
                           f"    User {user}\n"
                           f"    IdentityFile {keyfile}\n"
                           f"    IdentitiesOnly yes\n"
                           f"    StrictHostKeyChecking accept-new\n"
                           f"    ServerAliveInterval 60\n"))


def remove_ssh_alias(name):
    _edit_ssh_block(name, None)


# ---------------------------------------------------------------- cli

def get_backend(cfg, which):
    which = which or cfg["backend"]
    cls = BACKENDS.get(which)
    if not cls:
        die(f"unknown backend {which!r} — have: {', '.join(sorted(BACKENDS))}")
    try:
        return cls(cfg)
    except Unavailable as e:
        die(f"{which}: {e}")


def all_backends(cfg, which):
    """The backends a cross-cloud verb walks: --cloud if given, else every
    cloud in config `clouds:`, else the default backend. One that cannot run
    here is reported and skipped — the walk exists to notice money, and a
    cloud you cannot even query is worth a line, not a crash."""
    names = [which] if which else (cfg.get("clouds") or [cfg["backend"]])
    out = []
    for n in names:
        cls = BACKENDS.get(n)
        if not cls:
            die(f"unknown backend {n!r} — have: {', '.join(sorted(BACKENDS))}")
        try:
            out.append(cls(cfg))
        except Unavailable as e:
            note(f"rig: {n}: {e} — skipped")
    return out


_UNREACHABLE_SAID = set()


def walk_ls(cfg, which):
    """(backend, rows) for every backend a cross-cloud verb can reach. A
    backend whose listing fails is reported on stderr as unreachable — one
    line, first line of the cloud's own error — and skipped, so one dead
    cloud never hides another's money (T670)."""
    for be in all_backends(cfg, which):
        try:
            rows = be.ls()
        except BackendDown as e:
            # `ls` walks once for the table and once for the frozen nag; the
            # cloud is dead either way, and saying so twice teaches skipping.
            if be.name not in _UNREACHABLE_SAID:
                _UNREACHABLE_SAID.add(be.name)
                first = (str(e).splitlines() or ["?"])[0].strip()
                note(f"rig: {be.name}: unreachable — {first} — skipped")
            continue
        yield be, rows


def locate(cfg, which, raw, agent_opt):
    """(backend, name) for a rig the user named.

    Tries the canonical `<prefix><agent>-<local>` form first, then the legacy
    `<agent>-<local>` form, across the configured clouds when --cloud is not
    given. Nothing found → the default backend and the canonical name, which is
    what `up` creates. An existing rig therefore always restarts on its own
    cloud under the name it already carries, and a new one is born prefixed.
    """
    full, legacy = name_candidates(raw, cfg, agent_opt)
    bes = [get_backend(cfg, which)] if which else all_backends(cfg, None)
    rows = [(be, r) for be in bes for r in be.ls()]
    for cand in (full, legacy):
        for be, r in rows:
            if r["rig"] == cand or r["native"] == cand:
                return be, cand
    return (bes[0] if which else get_backend(cfg, None)), full


def _fmt_until(at):
    left = at - datetime.now(timezone.utc)
    h = left.total_seconds() / 3600
    return f"{at.strftime('%H:%MZ')} ({h:.1f}h)" if h < 48 else f"{at.strftime('%m-%d %H:%MZ')}"


def apply_lease(be, name, cfg, hours, forever=False):
    """Put the lease on a running rig and say what it is — or say plainly that
    this cloud has none. Silence here is how a box bills for a month."""
    if forever:
        if hasattr(be, "lease_off"):
            be.lease_off(name)
        note(f"rig: {name}: NO LEASE (--forever) — it runs until someone takes it down")
        return None
    at = be.lease(name, hours)
    if at is None:
        note(f"rig: {name}: NO LEASE — {be.name} has no cloud-side expiry; only the hourly "
             f"reaper will stop it. Take it down yourself.")
        return None
    note(f"rig: {name}: lease until {_fmt_until(at)} — deallocates then unless `rig renew {name}`")
    return at


def cmd_up(args, cfg):
    be, name = locate(cfg, args.cloud, args.name, args.agent)   # an existing rig restarts on its own cloud
    inst = be.up(name, args)
    user, host, key = be.ssh_target(name)
    if not host:
        die(f"{name} is up but has no external IP")
    write_ssh_alias(name, user, host, key)
    apply_lease(be, name, cfg, args.lease or cfg["lease_hours"], args.forever)
    if args.no_watch or not cfg["watch"]:
        note(f"rig: {name}: NO WATCHER — it will not stop itself when idle")
    else:
        idle = args.idle or cfg["idle_minutes"]
        got = be.watch(name, idle)
        if got is None:
            note(f"rig: {name}: NO WATCHER — {be.name} has no on-box idle watcher; the hourly reaper is the only idle net")
        else:
            note(f"rig: {name}: watcher installed — deallocates itself after {got} min idle (no GPU work, no load, no tmux input, no login)")
    note(f"rig: {name} up at {host} — ssh {name}")
    print(host)
    nag_frozen(cfg, args.cloud)


def cmd_down(args, cfg):
    be, name = locate(cfg, args.cloud, args.name, args.agent)
    found = be.down(name)
    remove_ssh_alias(name)   # unconditional: a stale alias outliving its rig is the trap
    note(f"rig: {name} down (disk kept — `rig rm {name}` to destroy)" if found
         else f"rig: no such rig: {name} (cleared any stale ssh alias)")
    nag_frozen(cfg, args.cloud)


def cmd_rm(args, cfg):
    be, name = locate(cfg, args.cloud, args.name, args.agent)
    if not args.yes:
        die(f"refusing to destroy {name} without --yes (this deletes the disk)")
    found = be.rm(name)
    remove_ssh_alias(name)
    note(f"rig: {name} destroyed" if found
         else f"rig: no such rig: {name} (cleared any stale ssh alias)")
    nag_frozen(cfg, args.cloud)


def cmd_renew(args, cfg):
    be, name = locate(cfg, args.cloud, args.name, args.agent)
    if not any(r["rig"] == name and r["state"] == "up" for r in be.ls()):
        die(f"{name} is not up — a lease is for a running rig")
    apply_lease(be, name, cfg, args.hours or cfg["lease_hours"])


def cmd_name(args, cfg):
    """Machine-readable: the canonical name on stdout, nothing else, so a
    script can say NAME=$(rig --agent svp name h100) and ssh it."""
    print(resolve_name(args.name, cfg, args.agent))


def frozen_rigs(cfg, which, days):
    """Owned rigs that have sat stopped longer than `days`, with the exempt
    ones removed. One list, used by the nag and by `gc`, so they never
    disagree about what is frozen."""
    now = datetime.now(timezone.utc)
    out = []
    for be, rows in walk_ls(cfg, which):
        for r in rows:
            if r["state"] == "up" or not owned(cfg, r):
                continue
            keep = be.keep_until(r)
            if keep and keep >= now.date():
                continue
            since = be.stopped_since(r)
            age = (now - since).days if since else None
            if age is None or age >= days:
                out.append((be, r, age))
    return out


def nag_frozen(cfg, which):
    """One line, on every verb that already talked to the cloud: a stopped rig
    still bills its disk, and the one nobody mentions is the one that stays."""
    frozen = frozen_rigs(cfg, which, cfg["frozen_days"])
    if frozen:
        names = ", ".join(f"{r['rig']} ({age}d)" if age is not None else f"{r['rig']} (age ?)"
                          for _, r, age in frozen)
        note(f"rig: {len(frozen)} frozen rig(s) stopped > {cfg['frozen_days']}d, disks billing: "
             f"{names} — `rig gc` to destroy, `rig keep NAME` to exempt")


def cmd_gc(args, cfg):
    """Destroy owned rigs that have been stopped for days. Never automatic:
    an agent runs rig without a terminal, so it must pass --yes, and a human
    at a terminal is asked. `rm`, confirmed, is the only destroy path there is."""
    days = args.days if args.days is not None else cfg["frozen_days"]
    frozen = frozen_rigs(cfg, args.cloud, days)
    if not frozen:
        note(f"rig: no owned rig has been stopped > {days}d")
        return
    for be, r, age in frozen:
        note(f"rig: {r['rig']}  {be.name} {r['size']}  stopped {age if age is not None else '?'}d")
    if args.dry_run:
        return
    if not args.yes:
        if not sys.stdin.isatty():
            die(f"{len(frozen)} frozen rig(s) — re-run `rig gc --yes` to destroy them (no terminal to ask)")
        ans = input(f"destroy these {len(frozen)} rig(s), disks and all? [y/N] ").strip().lower()
        if ans not in ("y", "yes"):
            note("rig: nothing destroyed")
            return
    for be, r, _ in frozen:
        be.rm(r["rig"])
        remove_ssh_alias(r["rig"])
        note(f"rig: {r['rig']} destroyed")


def cmd_keep(args, cfg):
    be, name = locate(cfg, args.cloud, args.name, args.agent)
    until = (datetime.now(timezone.utc) + timedelta(days=args.days)).date()
    if not be.keep(name, until):
        die(f"no such rig: {name}")
    note(f"rig: {name} kept through {until.isoformat()} — `gc` will not offer it before then")


def cmd_ls(args, cfg):
    rows, bes = [], {}
    for be, listed in walk_ls(cfg, args.cloud):
        bes[be.name] = be
        for r in listed:
            r["cloud"] = be.name
            rows.append(r)
    if not rows:
        note("rig: nothing here")
        return
    hdr = ("CLOUD", "RIG", "STATE", "SIZE", "GPU", "ZONE", "IP", "$/HR", "LEASE")
    out, burn = [], 0.0
    for r in sorted(rows, key=lambda r: (r["state"] != "up", r["cloud"], r["rig"])):
        price = PRICE_HINT.get(r["size"])
        if r["state"] == "up" and price:
            burn += price
        # LEASE: when an owned running rig will stop on its own. "NONE" on a
        # running owned rig is the line to act on — it bills until someone does.
        lease = "-"
        if r["state"] == "up" and r["rig"] != "-":
            try:
                at = bes[r["cloud"]].lease_info(r["rig"])
                lease = _fmt_until(at) if at else "NONE"
            except BackendDown:
                lease = "?"
        out.append((r["cloud"], r["rig"] if r["rig"] != "-" else f"({r['native']})",
                    r["state"], r["size"], r["gpu"], r["zone"], r["ip"],
                    f"{price:.2f}" if price and r["state"] == "up" else "-", lease))
    w = [max(len(str(x[i])) for x in [hdr, *out]) for i in range(len(hdr))]
    print("  ".join(h.ljust(w[i]) for i, h in enumerate(hdr)))
    for row in out:
        print("  ".join(str(c).ljust(w[i]) for i, c in enumerate(row)))
    if burn:
        print(f"\nrunning burn ≈ ${burn:.2f}/hr  (≈ ${burn * 24 * 30:,.0f}/mo if left up)")
    nag_frozen(cfg, args.cloud)


IDLE_PROBE = r"""
# wc, not `grep -c`: grep exits 1 on zero matches, so a `|| echo 0` fallback
# fires ON TOP of grep's own "0" and the probe returns two lines.
gpu=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | sed '/^$/d' | wc -l | tr -d ' ')
load=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || echo 0)
now=$(date +%s)
act=0
for a in $(tmux list-sessions -F '#{session_activity}' 2>/dev/null); do
  [ "$a" -gt "$act" ] && act=$a
done
if [ "$act" = 0 ]; then idle_s=999999; else idle_s=$(( now - act )); fi
echo "gpu=$gpu load=$load idle_s=$idle_s"
"""


def cmd_reap(args, cfg):
    """Take down rigs that are up but doing nothing.

    A stopgap for the fact that nothing expires: a forgotten GPU box bills
    continuously and the agent that made it has no session tomorrow in which
    to remember. This does not replace a real lease — it just makes the
    common case (someone walked away) cost an hour instead of a month.

    Three safety properties, in order of importance:

    1. **Only rigs rig manages.** A machine without a `rig-name` is somebody
       else's; it is never touched, however idle it looks.
    2. **Unreachable is never idle.** A box we cannot probe is left running
       and reported. Silence is not evidence of inactivity, and guessing
       wrong here destroys someone's session.
    3. **`down`, never `rm`.** Stopping is reversible and keeps the disk;
       destroying is not. An automatic actor gets the reversible verb only.
    """
    idle_min = args.idle
    acted, skipped = [], []

    for be, rows in walk_ls(cfg, args.cloud):
        for r in rows:
            if r["state"] != "up":
                continue
            if r["rig"] == "-":
                # Safety property 1 — but say so: the hourly log is the only
                # place a forgotten unmanaged box gets noticed at all.
                price = PRICE_HINT.get(r["size"])
                skipped.append((f"({r['native']})", f"{be.name} {r['size']} up, not rig-managed — left alone"
                                + (f", ≈ ${price:.2f}/hr" if price else "")))
                continue
            name = r["rig"]
            p = subprocess.run(
                ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", name, "bash -s"],
                input=IDLE_PROBE, capture_output=True, text=True,
            )
            if p.returncode != 0:
                skipped.append((name, "unreachable — left running on purpose"))
                continue
            try:
                f = dict(kv.split("=", 1) for kv in p.stdout.split())
                gpu, load, idle_s = int(f["gpu"]), float(f["load"]), int(f["idle_s"])
            except (ValueError, KeyError):
                skipped.append((name, f"unparseable probe: {p.stdout.strip()[:40]}"))
                continue

            busy = []
            if gpu:
                busy.append(f"{gpu} GPU process(es)")
            if load >= args.load:
                busy.append(f"load {load:.2f}")
            if idle_s < idle_min * 60:
                busy.append(f"tmux active {idle_s // 60}m ago")
            if busy:
                skipped.append((name, "busy — " + ", ".join(busy)))
                continue

            if args.dry_run:
                acted.append((name, f"WOULD stop (idle {idle_s // 60}m, load {load:.2f}, no GPU work)"))
                continue
            be.down(name)
            remove_ssh_alias(name)
            acted.append((name, f"stopped (idle {idle_s // 60}m, load {load:.2f}, no GPU work)"))

    for n, why in acted:
        note(f"rig: {n}: {why}")
    for n, why in skipped:
        note(f"rig: {n}: {why}")
    if not acted and not skipped:
        note("rig: nothing running")


def cmd_ip(args, cfg):
    """Machine-readable by design — bare IP on stdout, nothing else, so
    `ssh root@$(rig ip a2x-dev)` works."""
    be, name = locate(cfg, args.cloud, args.name, args.agent)
    ip = be.ip(name)
    if not ip:
        sys.exit(1)
    print(ip)


def cmd_ssh(args, cfg):
    be, name = locate(cfg, args.cloud, args.name, args.agent)
    user, host, key = be.ssh_target(name)
    if not host:
        die(f"{name} has no external IP — is it up?")
    write_ssh_alias(name, user, host, key)
    os.execvp("ssh", ["ssh", name, *args.rest])


def main():
    cfg = load_config()
    p = argparse.ArgumentParser(prog="rig", description="bring cloud machines up and down")
    p.add_argument("--cloud", help=f"backend (default {cfg['backend']}; ls/reap walk {cfg.get('clouds') or [cfg['backend']]}); have: {', '.join(sorted(BACKENDS))}")
    p.add_argument("--agent", help="agent slug for the <agent>-<name> namespace convention")
    sub = p.add_subparsers(dest="verb", required=True)

    up = sub.add_parser("up", help="ensure it exists and is running (creates on first call)")
    up.add_argument("name")
    up.add_argument("--size", help="machine type")
    up.add_argument("--zone", help="pin a zone (gcp: default tries each configured zone; azure: the location)")
    up.add_argument("--disk", type=int, help="boot disk GB")
    up.add_argument("--image", help="image family")
    up.add_argument("--lease", type=float, help=f"hours until the box deallocates itself (default {cfg['lease_hours']}; <24)")
    up.add_argument("--forever", action="store_true", help="no lease — runs until someone takes it down (says so loudly)")
    up.add_argument("--idle", type=int, help=f"on-box watcher: minutes idle before it deallocates itself (default {cfg['idle_minutes']})")
    up.add_argument("--no-watch", action="store_true", help="skip the on-box idle watcher (says so loudly)")
    up.set_defaults(fn=cmd_up)

    rn = sub.add_parser("renew", help="push the lease out again on a running rig")
    rn.add_argument("name")
    rn.add_argument("--hours", type=float, help=f"hours from now (default {cfg['lease_hours']})")
    rn.set_defaults(fn=cmd_renew)

    gc = sub.add_parser("gc", help="destroy owned rigs that have sat stopped for days (asks first)")
    gc.add_argument("--days", type=int, help=f"stopped at least this long (default {cfg['frozen_days']})")
    gc.add_argument("--yes", action="store_true", help="destroy without asking (required when there is no terminal)")
    gc.add_argument("--dry-run", action="store_true", help="list them, destroy nothing")
    gc.set_defaults(fn=cmd_gc)

    kp = sub.add_parser("keep", help="exempt a stopped rig from gc for a while")
    kp.add_argument("name")
    kp.add_argument("--days", type=int, default=14, help="how long (default 14)")
    kp.set_defaults(fn=cmd_keep)

    nm = sub.add_parser("name", help="print the canonical <prefix><agent>-<local> name for NAME")
    nm.add_argument("name")
    nm.set_defaults(fn=cmd_name)

    dn = sub.add_parser("down", help="stop it — disk survives, compute billing stops")
    dn.add_argument("name")
    dn.set_defaults(fn=cmd_down)

    rm = sub.add_parser("rm", help="destroy it — disk and all")
    rm.add_argument("name")
    rm.add_argument("--yes", action="store_true", help="required; this is not reversible")
    rm.set_defaults(fn=cmd_rm)

    ls = sub.add_parser("ls", help="what exists, what's running, what it's burning")
    ls.set_defaults(fn=cmd_ls)

    rp = sub.add_parser("reap", help="stop rig-managed machines that are up but idle")
    rp.add_argument("--idle", type=int, default=60, help="minutes of inactivity before stopping (default 60)")
    rp.add_argument("--load", type=float, default=0.2, help="1-min load average at or above which a box counts as busy")
    rp.add_argument("--dry-run", action="store_true", help="report what would be stopped, change nothing")
    rp.set_defaults(fn=cmd_reap)

    ip = sub.add_parser("ip", help="print the IP on stdout (for `$(rig ip NAME)`)")
    ip.add_argument("name")
    ip.set_defaults(fn=cmd_ip)

    sh = sub.add_parser("ssh", help="refresh the alias and hop on")
    sh.add_argument("name")
    sh.add_argument("rest", nargs=argparse.REMAINDER)
    sh.set_defaults(fn=cmd_ssh)

    args = p.parse_args()
    try:
        args.fn(args, cfg)
    except BackendDown as e:
        die(str(e))


if __name__ == "__main__":
    main()

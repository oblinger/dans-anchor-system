    "g2-standard-16": 1.15, "g2-standard-32": 2.71,   # 32: F054 measured ≈$2.7/hr
    "e2-standard-4": 0.13, "c3-standard-8": 0.39,
    # Azure pay-as-you-go, centralus, 2026-09
    "Standard_NC40ads_H100_v5": 6.98, "Standard_NC80adis_H100_v5": 13.96,
    "Standard_NC24ads_A100_v4": 3.67, "Standard_NC48ads_A100_v4": 7.35,

#!/usr/bin/env python3
"""rig — bring cloud machines up and down, and hand their names to everything else.

One namespace, one verb-first CLI, one job: make a box exist and be reachable.
Driving the box is bridge's job; running experiments on it is svx's job.

Backends are adapters registered with @backend(name). Only 'gcp' is real today;
the seam is here so azure can be added without touching the CLI layer.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys

try:
    import yaml
except ImportError:
    yaml = None


CONFIG_PATH = os.path.expanduser("~/.config/rig/config.yaml")
SSH_CONFIG = os.path.expanduser("~/.ssh/config")
BLOCK_BEGIN = "# >>> rig managed block — regenerated by `rig up`; do not edit >>>"
BLOCK_END = "# <<< rig managed block <<<"

# Approximate on-demand USD/hour, us-east1. Informational only — for noticing a
# rig you forgot, not for billing. Unknown types report as '?'.
PRICE_HINT = {
    "g2-standard-4": 0.71, "g2-standard-8": 0.85, "g2-standard-12": 1.00,
    "g2-standard-16": 1.15, "g2-standard-32": 1.90,
    "e2-standard-4": 0.13, "c3-standard-8": 0.39,
}

DEFAULTS = {
    "backend": "gcp",
    "agent": None,
    "gcp": {
        "project": None,               # None → whatever gcloud is set to
        "zones": ["us-east1-b", "us-east1-c", "us-east1-d"],
        "size": "g2-standard-12",
        "disk": 500,
        "disk_type": "pd-balanced",
        "image_family": "common-cu129-ubuntu-2204-nvidia-580",
        "image_project": "deeplearning-platform-release",
        "user": "dano",
        "key": "~/.ssh/gcp_sv_dev",
    },
}


def die(msg, code=1):
    print(f"rig: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    print(msg, file=sys.stderr)


def deep_merge(base, over):
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = deep_merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


def load_config():
    if not os.path.exists(CONFIG_PATH):
        return dict(DEFAULTS)
    if yaml is None:
        die("PyYAML not available but ~/.config/rig/config.yaml exists")
    with open(CONFIG_PATH) as f:
        return deep_merge(DEFAULTS, yaml.safe_load(f) or {})


# ---------------------------------------------------------------- names

NAME_RE = re.compile(r"^[a-z][a-z0-9]*(\.[a-z0-9][a-z0-9-]*)*$")


def resolve_name(name, cfg, agent_opt):
    """Apply the <agent>.<local> namespace convention.

    The namespace is global and flat. An agent owning rigs prefixes them with
    its own slug so two agents never collide on 'dev'.
    """
    agent = agent_opt or os.environ.get("RIG_AGENT") or os.environ.get("BRIDGE_AGENT") or cfg.get("agent")
    if "." not in name and agent:
        name = f"{agent.lower()}.{name}"
    if not NAME_RE.match(name):
        die(f"bad rig name {name!r} — use lowercase [a-z0-9-] segments separated by dots, e.g. a2x.dev")
    if "." not in name:
        note(f"rig: warning: {name!r} has no agent prefix — the namespace is global; "
             f"prefer <agent>.<name> (set --agent or $RIG_AGENT)")
    return name


# ---------------------------------------------------------------- backends

BACKENDS = {}


def backend(name):
    def wrap(cls):
        cls.name = name
        BACKENDS[name] = cls
        return cls
    return wrap


class Backend:
    """Adapter contract. Every method takes/returns rig-level names, never
    backend-native ones — mapping is the adapter's problem.

    A rig has two independent states, and they cost differently:
      exists?   created / absent      (up creates, rm destroys)
      running?  up / down             (up starts, down stops)
    """

    def __init__(self, cfg):
        self.cfg = cfg

    def up(self, name, opts): raise NotImplementedError
    def down(self, name): raise NotImplementedError
    def rm(self, name): raise NotImplementedError
    def ls(self): raise NotImplementedError          # -> [dict(rig,native,zone,size,gpu,state,ip)]
    def ip(self, name): raise NotImplementedError    # -> str or None
    def ssh_target(self, name): raise NotImplementedError  # -> (user, host, keyfile)


@backend("gcp")
class GCP(Backend):
    """Google Compute Engine, via the gcloud CLI.

    Naming: GCE instance names are RFC1035 and cannot contain dots, so the rig
    name 'a2x.dev' becomes instance 'a2x-dev'. The authoritative rig name is
    stored in instance metadata under 'rig-name', so the mapping stays exact
    even when a local segment legitimately contains a hyphen.
    """

    def __init__(self, cfg):
        super().__init__(cfg)
        self.c = cfg["gcp"]
        if not shutil.which("gcloud"):
            die("gcloud not on PATH")

    # -- plumbing

    def _gcloud(self, *args, check=True, json_out=False):
        cmd = ["gcloud", "compute", *args]
        if self.c.get("project"):
            cmd += [f"--project={self.c['project']}"]
        if json_out:
            cmd += ["--format=json"]
        p = subprocess.run(cmd, capture_output=True, text=True)
        if check and p.returncode != 0:
            die(p.stderr.strip() or f"gcloud failed: {' '.join(args)}")
        if json_out:
            try:
                return json.loads(p.stdout or "[]")
            except json.JSONDecodeError:
                return []
        return p

    @staticmethod
    def _native(name):
        return name.replace(".", "-")

    def _find(self, name):
        """Locate an instance by rig name. Returns the raw gcloud dict or None."""
        want = self._native(name)
        for inst in self._gcloud("instances", "list", json_out=True):
            meta = {i["key"]: i.get("value") for i in inst.get("metadata", {}).get("items", [])}
            if meta.get("rig-name") == name or inst["name"] == want:
                return inst
        return None

    @staticmethod
    def _ip_of(inst):
        for nic in inst.get("networkInterfaces", []):
            for ac in nic.get("accessConfigs", []):
                if ac.get("natIP"):
                    return ac["natIP"]
        return None

    @staticmethod
    def _row(inst):
        gpus = inst.get("guestAccelerators") or []
        gpu = ",".join(f"{g['acceleratorCount']}x{g['acceleratorType'].rsplit('/', 1)[-1]}" for g in gpus) or "-"
        meta = {i["key"]: i.get("value") for i in inst.get("metadata", {}).get("items", [])}
        return {
            "rig": meta.get("rig-name") or "-",
            "native": inst["name"],
            "zone": inst["zone"].rsplit("/", 1)[-1],
            "size": inst["machineType"].rsplit("/", 1)[-1],
            "gpu": gpu,
            "state": "up" if inst["status"] == "RUNNING" else "down",
            "ip": GCP._ip_of(inst) or "-",
        }

    # -- verbs

    def up(self, name, opts):
        inst = self._find(name)
        if inst:
            zone = inst["zone"].rsplit("/", 1)[-1]
            if inst["status"] == "RUNNING":
                note(f"rig: {name} already up")
            else:
                note(f"rig: starting {name} ({inst['name']}, {zone})")
                self._gcloud("instances", "start", inst["name"], f"--zone={zone}")
            return self._find(name)

        native = self._native(name)
        size = opts.size or self.c["size"]
        zones = [opts.zone] if opts.zone else list(self.c["zones"])
        keyfile = os.path.expanduser(self.c["key"])
        pub = keyfile + ".pub"
        if not os.path.exists(pub):
            die(f"public key {pub} missing — generate it with: ssh-keygen -t ed25519 -f {keyfile} -N ''")

        keydir = os.path.expanduser("~/.config/rig")
        os.makedirs(keydir, exist_ok=True)
        keyspec = os.path.join(keydir, "sshkeys.tmp")
        with open(keyspec, "w") as f:
            f.write(f"{self.c['user']}:{open(pub).read().strip()}\n")

        # Zone fallback: G2 stockouts are routine and gcloud names the zones
        # that do have capacity, but only after the request fails.
        last = None
        for zone in zones:
            note(f"rig: creating {name} as {native} ({size}, {zone})")
            p = self._gcloud(
                "instances", "create", native,
                f"--zone={zone}",
                f"--machine-type={size}",
                f"--image-family={opts.image or self.c['image_family']}",
                f"--image-project={self.c['image_project']}",
                f"--boot-disk-size={opts.disk or self.c['disk']}GB",
                f"--boot-disk-type={self.c['disk_type']}",
                "--maintenance-policy=TERMINATE",
                f"--metadata-from-file=ssh-keys={keyspec}",
                f"--metadata=rig-name={name},block-project-ssh-keys=TRUE,install-nvidia-driver=True",
                "--labels=managed-by=rig",
                check=False,
            )
            if p.returncode == 0:
                break
            last = p.stderr.strip()
            if "STOCKOUT" in last or "does not have enough resources" in last:
                note(f"rig: {zone} is out of capacity, trying next zone")
                continue
            die(last)
        else:
            die(f"no zone had capacity for {size}\n{last}")

        return self._find(name)

    def down(self, name):
        inst = self._find(name)
        if not inst:
            return False
        if inst["status"] != "RUNNING":
            note(f"rig: {name} already down")
            return True
        self._gcloud("instances", "stop", inst["name"], f"--zone={inst['zone'].rsplit('/', 1)[-1]}")
        return True

    def rm(self, name):
        inst = self._find(name)
        if not inst:
            return False
        self._gcloud("instances", "delete", inst["name"],
                     f"--zone={inst['zone'].rsplit('/', 1)[-1]}", "--quiet")
        return True

    def ls(self):
        return [self._row(i) for i in self._gcloud("instances", "list", json_out=True)]

    def ip(self, name):
        inst = self._find(name)
        return self._ip_of(inst) if inst else None

    def ssh_target(self, name):
        return self.c["user"], self.ip(name), os.path.expanduser(self.c["key"])


# ---------------------------------------------------------------- ssh config

def _edit_ssh_block(name, stanza):
    """Replace (or with stanza=None, drop) this rig's entry in the managed block.

    The block exists because cloud addresses are not stable: a rig that stops and
    starts may come back on a different IP, and every consumer (bridge, svx,
    plain ssh) reaches it by alias. Rewriting on every `up` repairs the
    indirection exactly when it breaks.

    Removal matters as much as writing. A destroyed rig whose alias survives
    points at an address the cloud will recycle to somebody else's machine —
    which is worse than a broken alias, because it still connects.
    """
    text = open(SSH_CONFIG).read() if os.path.exists(SSH_CONFIG) else ""
    if BLOCK_BEGIN in text and BLOCK_END in text:
        head, rest = text.split(BLOCK_BEGIN, 1)
        block, tail = rest.split(BLOCK_END, 1)
    else:
        head, block, tail = text.rstrip("\n") + "\n\n", "\n", "\n"

    kept = [s for s in re.split(r"\n(?=Host )", block.strip("\n"))
            if s.strip() and not re.match(rf"Host {re.escape(name)}\s*$", s.splitlines()[0].strip())]
    if stanza:
        kept.append(stanza.rstrip("\n"))

    body = "\n".join(kept)
    with open(SSH_CONFIG, "w") as f:
        f.write(head + BLOCK_BEGIN + "\n" + (body + "\n" if body else "") + BLOCK_END + tail)
    os.chmod(SSH_CONFIG, 0o600)


def write_ssh_alias(name, user, host, keyfile):
    _edit_ssh_block(name, (f"Host {name}\n"
                           f"    HostName {host}\n"
                           f"    User {user}\n"
                           f"    IdentityFile {keyfile}\n"
                           f"    IdentitiesOnly yes\n"
                           f"    StrictHostKeyChecking accept-new\n"
                           f"    ServerAliveInterval 60\n"))


def remove_ssh_alias(name):
    _edit_ssh_block(name, None)


# ---------------------------------------------------------------- cli

def get_backend(cfg, which):
    which = which or cfg["backend"]
    cls = BACKENDS.get(which)
    if not cls:
        die(f"unknown backend {which!r} — have: {', '.join(sorted(BACKENDS))}")
    return cls(cfg)


def cmd_up(args, cfg):
    be = get_backend(cfg, args.cloud)
    name = resolve_name(args.name, cfg, args.agent)
    inst = be.up(name, args)
    user, host, key = be.ssh_target(name)
    if not host:
        die(f"{name} is up but has no external IP")
    write_ssh_alias(name, user, host, key)
    note(f"rig: {name} up at {host} — ssh {name}")
    print(host)


def cmd_down(args, cfg):
    be = get_backend(cfg, args.cloud)
    name = resolve_name(args.name, cfg, args.agent)
    found = be.down(name)
    remove_ssh_alias(name)   # unconditional: a stale alias outliving its rig is the trap
    note(f"rig: {name} down (disk kept — `rig rm {name}` to destroy)" if found
         else f"rig: no such rig: {name} (cleared any stale ssh alias)")


def cmd_rm(args, cfg):
    be = get_backend(cfg, args.cloud)
    name = resolve_name(args.name, cfg, args.agent)
    if not args.yes:
        die(f"refusing to destroy {name} without --yes (this deletes the disk)")
    found = be.rm(name)
    remove_ssh_alias(name)
    note(f"rig: {name} destroyed" if found
         else f"rig: no such rig: {name} (cleared any stale ssh alias)")


def cmd_ls(args, cfg):
    be = get_backend(cfg, args.cloud)
    rows = be.ls()
    if not rows:
        note("rig: nothing here")
        return
    hdr = ("RIG", "STATE", "SIZE", "GPU", "ZONE", "IP", "$/HR")
    out, burn = [], 0.0
    for r in sorted(rows, key=lambda r: (r["state"] != "up", r["rig"])):
        price = PRICE_HINT.get(r["size"])
        if r["state"] == "up" and price:
            burn += price
        out.append((r["rig"] if r["rig"] != "-" else f"({r['native']})",
                    r["state"], r["size"], r["gpu"], r["zone"], r["ip"],
                    f"{price:.2f}" if price and r["state"] == "up" else "-"))
    w = [max(len(str(x[i])) for x in [hdr, *out]) for i in range(len(hdr))]
    print("  ".join(h.ljust(w[i]) for i, h in enumerate(hdr)))
    for row in out:
        print("  ".join(str(c).ljust(w[i]) for i, c in enumerate(row)))
    if burn:
        print(f"\nrunning burn ≈ ${burn:.2f}/hr  (≈ ${burn * 24 * 30:,.0f}/mo if left up)")


def cmd_ip(args, cfg):
    """Machine-readable by design — bare IP on stdout, nothing else, so
    `ssh root@$(rig ip a2x.dev)` works."""
    be = get_backend(cfg, args.cloud)
    ip = be.ip(resolve_name(args.name, cfg, args.agent))
    if not ip:
        sys.exit(1)
    print(ip)


def cmd_ssh(args, cfg):
    be = get_backend(cfg, args.cloud)
    name = resolve_name(args.name, cfg, args.agent)
    user, host, key = be.ssh_target(name)
    if not host:
        die(f"{name} has no external IP — is it up?")
    write_ssh_alias(name, user, host, key)
    os.execvp("ssh", ["ssh", name, *args.rest])


def main():
    cfg = load_config()
    p = argparse.ArgumentParser(prog="rig", description="bring cloud machines up and down")
    p.add_argument("--cloud", help=f"backend (default {cfg['backend']}); have: {', '.join(sorted(BACKENDS))}")
    p.add_argument("--agent", help="agent slug for the <agent>.<name> namespace convention")
    sub = p.add_subparsers(dest="verb", required=True)

    up = sub.add_parser("up", help="ensure it exists and is running (creates on first call)")
    up.add_argument("name")
    up.add_argument("--size", help="machine type")
    up.add_argument("--zone", help="pin a zone (default: try each configured zone)")
    up.add_argument("--disk", type=int, help="boot disk GB")
    up.add_argument("--image", help="image family")
    up.set_defaults(fn=cmd_up)

    dn = sub.add_parser("down", help="stop it — disk survives, compute billing stops")
    dn.add_argument("name")
    dn.set_defaults(fn=cmd_down)

    rm = sub.add_parser("rm", help="destroy it — disk and all")
    rm.add_argument("name")
    rm.add_argument("--yes", action="store_true", help="required; this is not reversible")
    rm.set_defaults(fn=cmd_rm)

    ls = sub.add_parser("ls", help="what exists, what's running, what it's burning")
    ls.set_defaults(fn=cmd_ls)

    ip = sub.add_parser("ip", help="print the IP on stdout (for `$(rig ip NAME)`)")
    ip.add_argument("name")
    ip.set_defaults(fn=cmd_ip)

    sh = sub.add_parser("ssh", help="refresh the alias and hop on")
    sh.add_argument("name")
    sh.add_argument("rest", nargs=argparse.REMAINDER)
    sh.set_defaults(fn=cmd_ssh)

    args = p.parse_args()
    args.fn(args, cfg)


if __name__ == "__main__":
    main()

#!/bin/bash
# hook-run — the Warden-less fallback executor for the DAS hook registry
# (TINK F328). Usage: hook-run <moment>. Reads the registry, runs every
# executable registered at that moment, in file order, and always exits 0 —
# a hook that fails is logged and must not suppress its neighbours or the
# session it fires in.
#
# The shebang is #!/bin/bash ON PURPOSE and load-bearing: the no-eval
# dispatch below relies on bash's word-splitting rules. Under zsh, unquoted
# $cmd does not word-split, so a zsh-tested "simplification" of the quoting
# would behave identically there and break under bash — that exact confusion
# already cost one round of measurement (F328 § No eval). Do not port this
# to zsh or sh untested.
#
# One registry line = one moment + one executable path, NO inline arguments —
# anything needing arguments gets a wrapper script. The whole remainder after
# the moment is the path, expanded quoted ("$cmd") as a single word: that is
# what lets a path contain interior spaces with no quoting in the registry,
# and what keeps `;`-chains and $( ) substitutions in a hostile registry
# line inert (measured: eval executed both injections AND broke spaced
# paths; the quoted form blocks both and works).
#
# Registry grammar (F328 § The registry file): one line per hook — moment,
# whitespace (any run of spaces/tabs), executable path. Blank lines and
# `#` comments (leading whitespace tolerated) are skipped. File order is
# execution order.

REGISTRY="${DAS_HOOK_REGISTRY:-$HOME/.config/anchor-system/hooks/registry}"
LOG="${DAS_HOOK_LOG:-$HOME/.config/anchor-system/hooks/hook-run.log}"

moment="$1"
[ -z "$moment" ] && exit 0
[ -f "$REGISTRY" ] || exit 0

# Hooks receive their real input as JSON on stdin; capture it once so every
# registered hook gets the same payload. (stdin may legitimately be empty.)
input=$(cat)

# `|| [ -n "$m" ]` keeps a final line without a trailing newline firing.
# OUTPUTS ARE MERGED, NOT CONCATENATED (defect found 2026-08-17, TINK T233).
# The harness parses this process's stdout as ONE JSON hook envelope. With
# several hooks at a moment, letting each write stdout directly concatenates
# an envelope with plain text (measured live: inject.sh's brief followed by
# read-age's warning) — invalid JSON, so the harness silently discarded BOTH.
# Each hook's stdout is therefore captured, and at the end everything is
# folded into a single envelope: an envelope's additionalContext is extracted,
# plain text rides as-is. The merge runs python3 only when some hook actually
# produced output — the every-read silent path stays pure bash.
outputs=""
while read -r m cmd || [ -n "$m" ]; do
    case "$m" in ""|\#*) continue ;; esac
    [ "$m" = "$moment" ] || continue
    [ -n "$cmd" ] || continue
    out=$(printf '%s' "$input" | "$cmd")
    rc=$?
    if [ -n "$out" ]; then
        outputs="${outputs}${out}
"
    fi
    mkdir -p "$(dirname "$LOG")"
    if [ $rc -eq 0 ]; then
        printf '%s  %s  ok  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$moment" "$cmd" >> "$LOG"
    else
        printf '%s  %s  exit=%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$moment" "$rc" "$cmd" >> "$LOG"
    fi
done < "$REGISTRY"

if [ -n "$outputs" ]; then
    printf '%s' "$outputs" | python3 -c '
import json, sys
moment = sys.argv[1]
raw = sys.stdin.read()
# One hook spoke and produced a single well-formed JSON object: pass it
# through verbatim, preserving whatever envelope it built for itself.
try:
    obj = json.loads(raw)
    sys.stdout.write(raw.strip())
    sys.exit(0)
except ValueError:
    pass
parts = []
dec = json.JSONDecoder()
event = "PreToolUse" if moment.startswith("tool:pre:") else "PostToolUse"
i, n = 0, len(raw)
while i < n:
    while i < n and raw[i] in " \t\r\n":
        i += 1
    if i >= n:
        break
    if raw[i] == "{":
        try:
            obj, end = dec.raw_decode(raw, i)
            ctx = (obj.get("hookSpecificOutput") or {}).get("additionalContext")
            parts.append(ctx if ctx is not None else json.dumps(obj))
            i = end
            continue
        except ValueError:
            pass
    j = raw.find("\n", i)
    if j < 0:
        j = n
    parts.append(raw[i:j])
    i = j + 1
text = "\n\n".join(p for p in parts if p.strip())
if text:
    json.dump({"hookSpecificOutput": {"hookEventName": event,
                                      "additionalContext": text}}, sys.stdout)
' "$moment"
fi
exit 0

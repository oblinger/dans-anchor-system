#!/usr/bin/env python3
"""stone — mint and propagate pebbles and rocks (TINK F313).

See `~/ob/kmr/SYS/Bespoke/Skill Agent/dans-anchor-system/facets/DAS Stone.md`
(and its `DAS Stone Design.md` / `DAS Stone Keys.md` siblings) for the design.
This is the mechanical half only.

    stone <kind> new <anchor> --line "TEXT" [--body TEXT] [--root PATH]
        Mint the next stone file for <anchor> (`{slug} {PREFIX}{NNNN}`, never
        recycled), and insert its rendered line at the top of that anchor's
        OWN control file. Does not propagate — run `update` for that.

    stone <kind> push <owner> <sid> --to <target> [--root PATH]
        PLACE one stone on another anchor's list as a deliberate act (T626).
        Writes the line into the target's control file, records the target
        in the stone's `enrolled::`, and prints a receipt. If the target's
        `.anchor` carries `accepts: k1, k2`, the stone must carry each of
        those keys or the push is refused, naming what is missing (SPARKS
        declares `accepts: due, done, importance` — ASTR Comms § The
        handoff contract, made mechanical). `update`
        keeps an enrolled line where it would sweep a merely-propagated one.

    stone <kind> recall <owner> <sid> --from <target> [--root PATH]
        The exit: un-enroll, remove the line, print what came off.

    stone <kind> update [--root PATH]
        Walk the `feeds:` DAG under PATH (default: vault root) and reconcile
        every control file of this kind against its stones:
          - a line differing from its stone is an EDIT of the stone — the
            edit travels up to the stone, then every projection is rewritten
            to match (convergence: every projection == its stone at the end).
            If two projections of one stone were edited to DIFFERENT values in
            the same pass, that is a collision: the values are CONCATENATED,
            newest file first, joined by ` ⚡ `, and that one long line is
            written everywhere (T642, Dan 2026-09-02 — superseding F312 Q6 =
            C's abort, which stopped every anchor's update on one stale line).
            Nothing is discarded, everything converges, and the cleanup is a
            hand edit of any one copy. The pass names each conflict on stderr
            and counts them in its summary line.
          - a stone missing from every OTHER control file it should reach is
            silently re-added (a feed edge, or a line's position relative to
            the self-section, changed); a stone whose line only vanished from
            its OWN control file is archived — appended to the month file
            `archive/YYYY-MM <list> archive.md` inside its stone folder (T655)
            and its own file deleted. Both are silent: nothing is printed per line.
          - a cycle in `feeds:` is reported as a path and the whole pass
            aborts with NO writes.

    stone <verb> <list> ...   (F628 named lists; T653 verbs: move --dest, share, archive)
        The ADDRESSED form. `Lumen` names her dotless (default) list;
        `Lumen.rocks` a named one. Lists are declared in the owning anchor's
        `.anchor` under `stones:` (one entry per list; `_` designates the
        dotless one), with per-type field defaults from the `stones:` section
        of ~/.config/anchor-system/global.yaml. The kind table below stays the
        fallback layer until the migration completes, and both CLI forms work.
        `stone update` (no kind) runs ONE list-level reconciliation pass
        over every declared list (step 3): per-list `feeds:` edges from
        the registry (a bare anchor target means its DEFAULT list, Q4),
        plus the anchor-level `feeds:` transition grammar (each
        same-named list projects the edge, exactly as before).

Kind config (folder, control-file name, stone-number prefix, digits, the two
display-alias templates) is a MARKDOWN TABLE in a DAS facet doc — DAS is
markdown-first — located by `stone_kinds_doc` in ~/.config/anchor-system/
global.yaml. The table is content; its address is configuration. Nothing about
a kind is hard-coded here. Parsed by stone-kinds.py beside this file.

Root resolution mirrors backlog-edit.py's `ANCHOR_VAULT_ROOT` / VAULT_ROOT
convention (F269) so fixture tests never touch the real vault: `--root`, else
`$ANCHOR_VAULT_ROOT`, else `~/ob/kmr`.
"""
from __future__ import annotations

import argparse
import json
import os
import datetime as _dt
import re
import shutil
import sys
from pathlib import Path
from types import SimpleNamespace

# --------------------------------------------------------------------------
# Errors — mirrors `backlog_edit.BacklogEditError` / `state`'s convention:
# a SystemExit subclass so a caller must catch it by name, never by accident.


class StoneError(SystemExit):
    def __init__(self, msg):
        super().__init__(f"stone: {msg}")


# --------------------------------------------------------------------------
# Config

DEFAULT_ROOT = (
    Path(os.environ["ANCHOR_VAULT_ROOT"]).expanduser()
    if os.environ.get("ANCHOR_VAULT_ROOT")
    else Path.home() / "ob" / "kmr"
)

# Kind declarations come from the markdown table in the doc named by
# `stone_kinds_doc` (~/.config/anchor-system/global.yaml). The parse lives in
# stone-kinds.py beside this file and is BORROWED by audit-plan.py, never
# copied (T120) — the JSON this replaced had already drifted from the
# human-readable table of the same facts, and two parsers would drift the same
# way.


def _stone_kinds_mod():
    import importlib.util
    mp = Path(__file__).resolve().parent / "stone-kinds.py"
    spec = importlib.util.spec_from_file_location("stone_kinds_for_stone", mp)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def load_kind_config(path: Path | None = None) -> dict:
    """`{kind: cfg}` from the DAS kind table. Raises rather than degrading —
    a mint that cannot read its kinds must not guess a folder name."""
    mod = _stone_kinds_mod()
    try:
        return mod.load_kinds(path)
    except mod.StoneKindsError as e:
        raise StoneError(str(e))


def _control_suffix(cfg: dict) -> str:
    """The fixed word after `{slug} ` in cfg['control'] — e.g. 'Rock'.

    Header/self-section identity (R-stone-04: "a header is identified by its
    link target") is derived from this, never from a separate pattern, so a
    kind whose 'control' template isn't literally '{slug} WORD' is refused up
    front rather than silently never matching a header anywhere.
    """
    tmpl = cfg["control"]
    lead = "{slug} "
    if not tmpl.startswith(lead) or tmpl == lead:
        raise StoneError(
            f"kind config 'control' template {tmpl!r} must be exactly "
            "'{slug} WORD' — header detection derives the fixed WORD from it"
        )
    return tmpl[len(lead):]


# --------------------------------------------------------------------------
# Named stone lists (F628, migration step 1).
#
# A LIST is a declared entity: one folder of stone files, one control file,
# one entry in the owning anchor's `.anchor` under `stones:`. Everything the
# kind table holds becomes per-list configuration; the kind table is honored
# as a FALLBACK during the transition — an anchor with no registry (or whose
# registry does not name the list) still resolves any kind-table type exactly
# as before, so nothing breaks mid-migration. The fallback retires at
# migration step 4.
#
#     stones:
#       _: pebble              # the dotless type — bare `Lumen` resolves here
#       pebble:                # a defaulted type: declaring it is one line
#       rocks:
#         folder: Lumen Track/Lumen Rocks    # anchor-relative placement
#         prefix: R
#
# Type DEFAULTS live per type name in the `stones:` section of
# ~/.config/anchor-system/global.yaml (F628 Q1), overlaying defaults derived
# from the kind table. A default never creates a list — existence comes only
# from a registry entry (except for the transition fallback above). `_` in
# that config section names the system-wide dotless type (default: pebble),
# per-anchor overridable by the registry's own `_` (Q2).

# Digit-leading names are legal — Dan's HUD screens are lists named `1`,
# `2`, `3`, addressed `HUD.1` (ruled 2026-08-30, the HUD restructure).
_LIST_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")

# Entry fields that override a type default wholesale. `folder` and `control`
# are handled separately because they carry placement.
_LIST_FIELDS = ("prefix", "digits", "member", "stone_alias", "header_alias",
                "header_line", "feeds", "accepts")

_GLOBAL_STONES_CACHE = None


def _global_stones_section() -> dict:
    """The `stones:` section of the F080 global config, memoized — the update
    walk resolves an effective cfg per anchor and must not re-read YAML a
    couple hundred times per pass."""
    global _GLOBAL_STONES_CACHE
    if _GLOBAL_STONES_CACHE is not None:
        return _GLOBAL_STONES_CACHE
    mod = _stone_kinds_mod()
    try:
        _GLOBAL_STONES_CACHE = mod.stones_section()
    except mod.StoneKindsError as e:
        raise StoneError(str(e))
    return _GLOBAL_STONES_CACHE


def _anchor_stones(anchor_dir: Path):
    """The `stones:` registry from `.anchor` — {list_name: fields} plus an
    optional `_` -> name — or None when the anchor declares none.

    Parsed as a YAML block extracted by indentation rather than by loading
    the whole file: `.anchor` files predate any YAML discipline, and only
    this section is owed structure."""
    f = anchor_dir / ".anchor"
    if not f.is_file():
        return None
    lines = f.read_text(encoding="utf-8").splitlines()
    start = None
    for i, ln in enumerate(lines):
        if re.match(r"^stones:\s*(#.*)?$", ln):
            start = i
            break
    if start is None:
        return None
    block = ["stones:"]
    for ln in lines[start + 1:]:
        if ln.strip() == "" or ln[:1] in (" ", "\t"):
            block.append(ln)
        else:
            break
    try:
        import yaml
        data = yaml.safe_load("\n".join(block)) or {}
    except Exception as e:
        raise StoneError(f"{f}: `stones:` section is not valid YAML: {e}")
    raw = data.get("stones")
    if raw is None:
        return {}
    if not isinstance(raw, dict):
        raise StoneError(f"{f}: `stones:` must map list names to fields")
    out = {}
    for name, entry in raw.items():
        name = str(name)
        if name == "_":
            if not isinstance(entry, str) or not entry.strip():
                raise StoneError(
                    f"{f}: `stones: _:` designates the dotless list by NAME — "
                    f"a string, got {entry!r}")
            out["_"] = entry.strip()
            continue
        if not _LIST_NAME_RE.match(name):
            raise StoneError(
                f"{f}: list name {name!r} — lowercase letters, digits, -/_, "
                f"starting with a letter")
        if entry is None:
            entry = {}
        if not isinstance(entry, dict):
            raise StoneError(
                f"{f}: stones entry {name!r} must be empty (all defaults) or "
                f"a mapping of fields, got {entry!r}")
        out[name] = entry
    return out


def _novel_type_cfg(name: str) -> dict:
    """Defaults for a list name with no config/kind-table entry: numbered
    members, prefix = the name's first letter, folder `{slug} <Name>/`, and
    the control file INSIDE it as the folder note — the new-world default
    shape (F628 Q3)."""
    return _stone_kinds_mod().type_defaults(name)


def load_type_defaults(cfg_all: dict) -> dict:
    """type-name -> default fields. Base layer: the kind table (every kind is
    a defaulted type during the transition). Overlay: the config `stones:`
    section — the future sole home (F628 Q1)."""
    out = {k: dict(v) for k, v in cfg_all.items()}
    for name, fields in _global_stones_section().items():
        if name == "_":
            continue
        base = out.setdefault(name, _novel_type_cfg(name))
        for k, v in (fields or {}).items():
            base[k] = v
    return out


def load_types() -> dict:
    """The live type set (F628 step 4): the config `stones:` section is the
    source of truth once it exists — its names ARE the types, each built on
    the novel-name conventions plus its declared fields. Without a section,
    the kind table serves as the shipped default set (fresh installs,
    fixtures). This is the retirement switch for the kind table: writing the
    section flips every verb to config types in one move."""
    sec = _global_stones_section()
    if any(k != "_" for k in sec):
        mod = _stone_kinds_mod()
        try:
            return mod.load_types(section=sec)
        except mod.StoneKindsError as e:
            raise StoneError(str(e))
    # Table mode falls back through stone's OWN wrapper — error-wrapped, and
    # the seam fixtures monkeypatch (f313's required_keys case), which
    # mod.load_kinds() would silently bypass.
    return load_kind_config()


def parse_address(addr: str):
    """`Lumen` -> ('Lumen', None); `Lumen.rocks` -> ('Lumen', 'rocks').

    Split on the LAST dot, and only when the tail is a well-formed list
    name — an anchor slug may contain a space but a list name may not, so
    `HUD 1.rocks` reads as ('HUD 1', 'rocks') and a dotted slug that names
    no list stays whole."""
    if "." in addr:
        head, _sep, tail = addr.rpartition(".")
        if head and _LIST_NAME_RE.match(tail):
            return head, tail
    return addr, None


# --------------------------------------------------------------------------
# The line budget (Dan, 2026-08-30): a stone's rendered line must fit on ONE
# line of the Obsidian reading view — "in no cases do we want them to word
# wrap, because it just makes it unreadable." The budget is the config key
# `stone_line_max` in ~/.config/anchor-system/global.yaml (0 / absent = no
# limit). It is measured on the DISPLAYED text — `ALIAS: ` plus the line with
# every `[[target|shown]]` collapsed to what Obsidian shows — because that is
# what wraps. A mint over budget is REFUSED (the agent can always put the
# detail in the pebble body); the update walk WARNS per over-budget stone,
# naming it, so hand edits and older stones surface without blocking
# reconciliation.

_LINE_MAX_CACHE = None
_LINK_DISPLAY_RE = re.compile(r"\[\[([^\]|]+)(?:\|([^\]]*))?\]\]")


def _line_max() -> int:
    global _LINE_MAX_CACHE
    if _LINE_MAX_CACHE is not None:
        return _LINE_MAX_CACHE
    cfgp = Path.home() / ".config" / "anchor-system" / "global.yaml"
    val = 0
    if cfgp.is_file():
        try:
            import yaml
            data = yaml.safe_load(cfgp.read_text(encoding="utf-8")) or {}
            val = int(data.get("stone_line_max") or 0)
        except Exception as e:
            raise StoneError(f"{cfgp}: stone_line_max unreadable: {e}")
    _LINE_MAX_CACHE = val
    return val


def display_text(text: str) -> str:
    """What Obsidian shows for a line: each wiki-link collapsed to its alias,
    or its target when it has none."""
    return _LINK_DISPLAY_RE.sub(
        lambda m: m.group(2) if m.group(2) is not None else m.group(1), text)


def rendered_length(owner: str, text: str, cfg: dict) -> int:
    alias = cfg["stone_alias"].format(slug=owner)
    return len(f"{alias} {display_text(text)}")


def _over_budget(owner: str, text: str, cfg: dict):
    """(shown_len, budget) when the rendered line exceeds the budget, else None."""
    budget = _line_max()
    if not budget:
        return None
    n = rendered_length(owner, text, cfg)
    return (n, budget) if n > budget else None


def _normalize_control(stem: str, slug: str) -> str:
    """A registry `control:` name, normalized to the `{slug} WORD` template
    header identity derives from (_control_suffix). Free-named controls
    (`Traffic.md` as its own anchor page) arrive with the list-level walk —
    F628 step 3 — and are refused loudly until then."""
    if stem.startswith("{slug} "):
        return stem
    if stem.startswith(slug + " "):
        return "{slug} " + stem[len(slug) + 1:]
    raise StoneError(
        f"stones: control {stem!r} on {slug} — a control name must (for now) "
        f"be `{slug} WORD`; free-named control files land with the "
        f"list-level walk (F628 step 3)")


def _effective_cfg(anchor_path: Path, slug: str, list_name, cfg_all: dict,
                   paths_only_base: dict = None):
    """(cfg, resolved_list_name) for one anchor's list — the F628 resolution.

    Bare (list_name None) resolves through the registry's `_`, else the
    config-wide dotless type. A registry entry overlays its type's defaults;
    an anchor with no registry, or none for this name, falls back to the
    kind-table type of that name (transition fallback, retired at step 4).

    With `paths_only_base` (the update walk), grammar comes from that base
    cfg unchanged and only the entry's folder/control PLACEMENT is honored —
    one pass classifies every file with one grammar until the walk itself
    goes list-level (step 3). Placement must be honored even there: a walk
    reading a relocated list's old path would see every stone missing from
    its own control file and archive the lot.
    """
    registry = _anchor_stones(anchor_path)
    if list_name is None:
        if registry and "_" in registry:
            list_name = registry["_"]
        else:
            list_name = str(_global_stones_section().get("_") or "pebble")
    entry = registry.get(list_name) if registry else None
    if entry is None:
        if list_name not in load_type_defaults(cfg_all):
            hint = ("its .anchor stones: registry does not declare it"
                    if registry is not None
                    else "it declares no stones: registry")
            raise StoneError(
                f"no list {list_name!r} on {slug} — {hint}, and no type "
                f"default by that name exists (config `stones:` section or "
                f"the kind table). Declare it under `stones:` in "
                f"{anchor_path / '.anchor'}.")
        entry = {}  # transition fallback: the type acts as an implicit list
    if paths_only_base is not None:
        cfg = dict(paths_only_base)
        # The base may be ANOTHER anchor's resolved cfg (push/recall hand the
        # owner's over) — its placement is not ours. Only THIS anchor's entry
        # may relocate this list.
        cfg.pop("_folder_rel", None)
        cfg.pop("_control_rel", None)
    else:
        cfg = dict(load_type_defaults(cfg_all).get(list_name)
                   or _novel_type_cfg(list_name))
        for k in _LIST_FIELDS:
            if k in entry:
                cfg[k] = entry[k]
        if entry.get("control") and "/" not in str(entry["control"]):
            cfg["control"] = _normalize_control(str(entry["control"]), slug)
        for k in ("feeds", "accepts"):
            if isinstance(cfg.get(k), str):
                cfg[k] = [s.strip() for s in cfg[k].split(",") if s.strip()]
        if cfg.get("digits") is not None:
            cfg["digits"] = int(cfg["digits"])
    if entry.get("folder"):
        cfg["_folder_rel"] = str(entry["folder"]).rstrip("/")
    if entry.get("control") and "/" in str(entry["control"]):
        rel = str(entry["control"])
        if not rel.endswith(".md"):
            rel += ".md"
        cfg["_control_rel"] = rel
    return cfg, list_name


# --------------------------------------------------------------------------
# Anchor discovery — `.anchor` carries `slug:` and `feeds:` (DAS feed, F312)

# `.+?` and not `\S+`: a slug may contain a space (`HUD 1`, `Career Track`).
# Under `\S+` such a line matched nothing, so the declaration was silently
# ignored and the slug fell back to the folder name — which happened to agree
# in every case in the corpus, so the bug was invisible. Verified 2026-08-10:
# no `.anchor` anywhere carries a spaced `slug:` that differs from its folder
# name, so widening this changes no anchor's identity. A slug that cannot own
# a stone is refused at the mint (`_reject_unroundtrippable_owner`), not here.
_SLUG_RE = re.compile(r"^slug:\s*(.+?)\s*$")
_FEEDS_RE = re.compile(r"^feeds:\s*(.*)$")
# `accepts: due, done, importance` — the keys a stone PUSHED into this anchor
# must carry (T626). Declared by the receiving anchor, because it is the
# receiver's contract (SPARKS refuses a watch that does not say what outcome
# ends it, when it decays, and how much it matters), and read at the push so
# the refusal reaches the agent that can still fix it.
_ACCEPTS_RE = re.compile(r"^accepts:\s*(.*)$")


def _anchor_slug(anchor_dir: Path) -> str:
    f = anchor_dir / ".anchor"
    if f.is_file():
        for line in f.read_text(encoding="utf-8").splitlines():
            m = _SLUG_RE.match(line)
            if m:
                return m.group(1)
    return anchor_dir.name


def _anchor_feeds(anchor_dir: Path) -> list:
    f = anchor_dir / ".anchor"
    if not f.is_file():
        return []
    for line in f.read_text(encoding="utf-8").splitlines():
        m = _FEEDS_RE.match(line)
        if m:
            return [s.strip() for s in m.group(1).split(",") if s.strip()]
    return []


def _anchor_accepts(anchor_dir: Path) -> list:
    f = anchor_dir / ".anchor"
    if not f.is_file():
        return []
    for line in f.read_text(encoding="utf-8").splitlines():
        m = _ACCEPTS_RE.match(line)
        if m:
            return [s.strip() for s in m.group(1).split(",") if s.strip()]
    return []


def discover_anchors(root: Path):
    """(anchors, ambiguous) — slug -> SimpleNamespace(slug, path, feeds) for every
    unambiguously-named `.anchor` under root, plus slug -> [paths] for those that
    collide.

    A collision is deliberately NOT fatal here. This walk covers the whole vault,
    so any unrelated pair of same-named folders would otherwise make every stone
    operation impossible — including a mint that touches exactly one anchor. And
    some collisions are correct: Warden's corpus reuses `FX1` across independent
    test cases on purpose, because each fixture is a self-contained mini-vault.
    Ambiguity is an error only when a slug is actually *referenced* — as a mint
    target, a feed endpoint, or the owner of real stone data — which is where
    `_ambiguous_error` and `_reject_ambiguous_use` raise.
    """
    anchors = {}
    ambiguous: dict = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if ".anchor" in filenames:
            p = Path(dirpath)
            slug = _anchor_slug(p)
            if slug in ambiguous:
                ambiguous[slug].append(p)
            elif slug in anchors:
                ambiguous[slug] = [anchors.pop(slug).path, p]
            else:
                anchors[slug] = SimpleNamespace(slug=slug, path=p, feeds=_anchor_feeds(p),
                                                accepts=_anchor_accepts(p))
    return anchors, ambiguous


def _ambiguous_error(slug: str, paths: list, why: str) -> StoneError:
    listing = "\n  ".join(str(p) for p in paths)
    return StoneError(
        f"anchor slug {slug!r} is ambiguous — {why}, but {len(paths)} "
        f"directories resolve to it:\n  {listing}\n"
        "Give all but one a distinct `slug:` in its .anchor."
    )


def _reject_ambiguous_use(anchors: dict, ambiguous: dict, cfg: dict) -> None:
    """Raise if any ambiguous slug is actually reachable by the update walk.

    Two ways it can be: something `feeds:` from it, or one of the colliding
    directories carries real stone data that the walk would otherwise skip in
    silence — the exact shape the no-silent-empty invariant exists to catch.
    """
    if not ambiguous:
        return
    for a in anchors.values():
        for src in a.feeds:
            if src in ambiguous:
                raise _ambiguous_error(src, ambiguous[src], f"{a.slug}'s feeds: names it")
    for slug, paths in sorted(ambiguous.items()):
        carrying = [
            p for p in paths
            if _stone_folder(p, slug, cfg).is_dir() or _control_path(p, slug, cfg).is_file()
        ]
        if carrying:
            raise _ambiguous_error(
                slug, paths, "it carries stone data that would otherwise be skipped"
            )


def _reject_unroundtrippable_owner(slug: str, cfg: dict) -> None:
    """Refuse to mint a stone whose own control line could never be read back.

    `_is_stone_target` requires an owner slug of `[A-Za-z][A-Za-z0-9]*` — no
    spaces, no punctuation — because a control line has to be split back into
    (owner, number) from the link target alone. A slug like `HUD 1` mints
    fine and writes a control line that LOOKS right, and then classifies as
    'other' forever: it never propagates, never reads back, and no pass ever
    says so. Consuming-only nodes may carry such a slug safely — `HUD 1` draws
    from `HUD` and owns nothing — so this is checked at the mint, where the
    slug first has to round-trip, and not at discovery, where it would ban a
    perfectly good screen.
    """
    if _dated(cfg):
        # A dated line names its owner in the alias, so what has to round-trip
        # is the alias, not the target. `HUD 1` survives here where it could
        # never own a numbered stone — the space is harmless inside an alias.
        probe = cfg["stone_alias"].format(slug=slug)
        if _alias_owner(probe, cfg) == slug:
            return
        raise StoneError(
            f"anchor slug {slug!r} cannot own a {cfg.get('member')} stone — its "
            f"rendered alias {probe!r} does not read back as the slug, so the "
            f"line could never be attributed to it."
        )
    if _is_stone_target(f"{slug} {cfg['prefix']}{'0' * cfg.get('digits', 4)}", cfg) is None:
        raise StoneError(
            f"anchor slug {slug!r} cannot own a stone — a control line is parsed "
            f"back into (owner, number) from its link target, which requires a "
            f"slug of letters and digits with no spaces. Such an anchor can still "
            f"CONSUME stones via feeds:; only minting into it is refused. Give it "
            f"a one-word `slug:` in its .anchor to mint here."
        )


def _track_dir(anchor_path: Path, slug: str) -> Path:
    return anchor_path / f"{slug} Track"


def _stone_folder(anchor_path: Path, slug: str, cfg: dict) -> Path:
    # F628: a registry entry may place the folder explicitly, anchor-relative.
    if cfg.get("_folder_rel"):
        return anchor_path / cfg["_folder_rel"]
    return _track_dir(anchor_path, slug) / cfg["folder"].format(slug=slug)


def _control_path(anchor_path: Path, slug: str, cfg: dict) -> Path:
    """The control file. Normally BESIDE the group folder in Track.

    **A container-named kind keeps it INSIDE, as the folder note.** Per
    [[DAS Facets]] (Dan, 2026-08-18) a facet word is singular when it names the
    container and plural when it names the elements: `Pebbles`/`Rocks` name the
    elements, so folder and control differ (`SONAR Pebbles/` + `SONAR Pebble.md`)
    and the control has somewhere of its own to sit. `Book` names the container,
    so both resolve to the same name and the only coherent place for the control
    file is the folder note. The audit's member check already exempts a
    `{folder}.md` inside the folder as "the group's own anchor page", so nothing
    downstream has to change."""
    name = cfg["control"].format(slug=slug) + ".md"
    folder = _stone_folder(anchor_path, slug, cfg)
    if cfg.get("_control_rel"):
        # F628: explicit placement wins outright.
        return anchor_path / cfg["_control_rel"]
    if cfg["control"] == cfg["folder"]:
        return folder / name
    if cfg.get("_folder_rel"):
        # F628: a relocated folder keeps its control BESIDE it (or inside as
        # the folder note, per the names-coincide rule above) — the
        # Track-relative rule, carried to wherever the folder went.
        return folder.parent / name
    return _track_dir(anchor_path, slug) / name


# --------------------------------------------------------------------------
# The merged per-node list (T574)
#
# `stone` writes one control file per kind, because a kind decides which file a
# line lands in. Dan reads one long scrollable list instead — column 2 of the
# MuxUX `lists` view — and MuxUX cannot join the two at display time: a pane
# carries exactly one `path`, deliberately, because the show session addresses
# panes by index against a single declared target. So the join has to produce a
# file, and `update` is where it happens: the merged list was a second command
# for two days and went stale exactly as often as someone forgot it, which is
# worse than the two panes it replaced because a dropped stone looks like no
# stone rather than like a missing one.

# `{slug} Stones.md` and NOT `{slug} All.md`: `HUD All` is already an anchor of
# its own, and a second file by that name makes every `[[HUD All]]` in the vault
# ambiguous. The interim script's first run created exactly that collision.
MERGED_SUFFIX = "Stones"

# Pebbles first, rocks last — Dan, 2026-08-21: "all the pebbles go first ...
# stones at the end of the list." `sleeper` is deliberately absent: a sleeper is
# a worked-out goal with no commitment to ever wake it, so it does not belong on
# a daily surface. Adding it is one word here if that changes.
# Both the kind-table names and the config-mode plural names are listed, so
# the order holds in either mode; only the names a pass actually knows match.
MERGE_ORDER = ["pebble", "pebbles", "rock", "rocks"]


def _merged_path(anchor_path: Path, slug: str) -> Path:
    return _track_dir(anchor_path, slug) / f"{slug} {MERGED_SUFFIX}.md"


def _merged_body(anchor_path: Path, slug: str, cfg_all: dict,
                 live_map: dict) -> str | None:
    """This node's control lines across every merged kind, in MERGE_ORDER.

    `live_map` maps list-name -> in-memory lines for every list THIS pass is
    reconciling; anything merged but not in the map (a restricted per-kind
    pass) is read from disk — which is what lets `stone pebble update` alone
    write a file that still carries the rocks, and what makes `--dry-run`
    render what WOULD be written rather than what is still there.

    Only lines that open `[[` survive: frontmatter, the `-[[X Pebble|X]]-`
    header and any prose are dropped. The merged file gets no frontmatter and
    no generated-by banner of its own, because it is rendered raw in a MuxUX
    pane and anything that is not a stone line is visible garbage there (Dan,
    2026-08-21: "don't give this thing any front matter. It just looks like
    garbage inside the HUD view").
    """
    out = []
    for name in MERGE_ORDER:
        if name in live_map:
            lines = live_map[name]
        else:
            kcfg = cfg_all.get(name)
            if kcfg is None:
                continue
            kcfg, _ = _effective_cfg(anchor_path, slug, name, cfg_all,
                                     paths_only_base=kcfg)
            cpath = _control_path(anchor_path, slug, kcfg)
            if not cpath.is_file():
                continue
            lines = cpath.read_text(encoding="utf-8").splitlines()
        out.extend(ln for ln in lines if ln.startswith("[["))
    return ("\n".join(out) + "\n") if out else None


def _stone_number_re(slug: str, cfg: dict):
    """Matches EXACTLY `{slug} {PREFIX}{NNNN}` — the full stone name, digits and all.

    Not a `{slug} {PREFIX}*` glob, and the difference is not cosmetic: for the
    `rock` kind the prefix is `R`, so that glob matches the stone group's own
    anchor page — `HBR Rocks.md` inside `HBR Rocks/` — for **every rock group
    that exists**. Loading it as a stone gives it a `line::` block and a sid of
    `Rocks`, then writes a control line pointing at it. Observed live 2026-08-10
    against MED, AIS and HBR at once.
    """
    return re.compile(rf"^{re.escape(slug)} {re.escape(cfg['prefix'])}(\d{{{cfg.get('digits', 4)}}})$")


def _stone_files(folder: Path, slug: str, cfg: dict) -> list:
    """Every file in `folder` that is genuinely a stone of this kind.

    A dated kind is matched by SHAPE rather than by slug — its members carry no
    slug at all. The group's own folder note (`{slug} Book.md`) is excluded for
    free by the same test, which is the dated echo of the `HBR Rocks.md` bug
    below: the note never starts with a date.
    """
    if _dated(cfg):
        return [f for f in folder.glob("*.md") if f.is_file() and _DATED_RE.match(f.stem)]
    num_re = _stone_number_re(slug, cfg)
    return [f for f in folder.glob("*.md") if f.is_file() and num_re.match(f.stem)]


# --------------------------------------------------------------------------
# Topological order over the feed DAG, cycle reported as a path (F312 Inv. 1)

def _topo_nodes(nodes: dict, edges: dict, label) -> list:
    """Topological order over LIST nodes (F628 step 3). A cycle is fatal and
    reported as a path; dangling edges never reach here — the edge builder in
    cmd_update collects them (T599 semantics) before this runs."""
    indeg = {k: 0 for k in nodes}
    consumers = {k: [] for k in nodes}
    for k, srcs in edges.items():
        for s in srcs:
            consumers[s].append(k)
            indeg[k] += 1
    order = []
    ready = sorted(k for k, d in indeg.items() if d == 0)
    while ready:
        n = ready.pop(0)
        order.append(n)
        newly_ready = []
        for m in consumers[n]:
            indeg[m] -= 1
            if indeg[m] == 0:
                newly_ready.append(m)
        ready = sorted(ready + newly_ready)
    if len(order) != len(nodes):
        done = set(order)
        remaining = [k for k in nodes if k not in done]
        path = _cycle_path(remaining, edges)
        raise StoneError("cycle in feeds: DAG — " + " → ".join(label(k) for k in path))
    return order


def _cycle_path(remaining: list, edges: dict) -> list:
    rem = set(remaining)
    visiting: list = []
    visited: set = set()

    def dfs(node):
        visiting.append(node)
        for src in edges.get(node, []):
            if src not in rem:
                continue
            if src in visiting:
                i = visiting.index(src)
                return visiting[i:] + [src]
            if src not in visited:
                found = dfs(src)
                if found:
                    return found
        visiting.pop()
        visited.add(node)
        return None

    for n in sorted(rem):
        found = dfs(n)
        if found:
            return list(reversed(found))
    return sorted(rem)  # unreachable when a cycle genuinely exists


# --------------------------------------------------------------------------
# Stone files — `key:: value` lines at the top, above the prose (DAS Stone Keys)

_KEY_RE = re.compile(r"^([A-Za-z][\w-]*)::\s?(.*)$")


def _parse_stone(text: str):
    lines = text.splitlines()
    keys = []
    i = 0
    while i < len(lines):
        m = _KEY_RE.match(lines[i])
        if not m:
            break
        keys.append((m.group(1), m.group(2)))
        i += 1
    if i < len(lines) and lines[i].strip() == "":
        i += 1
    body = "\n".join(lines[i:])
    return keys, body


def _render_stone(keys: list, body: str) -> str:
    out = [f"{k}:: {v}" for k, v in keys]
    out.append("")
    if body:
        out.extend(body.splitlines())
    text = "\n".join(out)
    if not text.endswith("\n"):
        text += "\n"
    return text


def _kv_get(keys: list, name: str, default=None):
    for k, v in keys:
        if k == name:
            return v
    return default


def _kv_del(keys: list, name: str):
    keys[:] = [(k, v) for k, v in keys if k != name]


def _kv_set(keys: list, name: str, value: str):
    for i, (k, _v) in enumerate(keys):
        if k == name:
            keys[i] = (name, value)
            return
    keys.append((name, value))


def _load_stone(path: Path, slug: str, live: bool, cfg: dict = None):
    text = path.read_text(encoding="utf-8")
    keys, body = _parse_stone(text)
    # T553 — trailing whitespace in a `line::` is not content, and leaving it in
    # made two CFO pebbles report a phantom edit on every single pass: the
    # rendered projection is trimmed on write, so `stone` compared a stored
    # `… — [[FIN]] ` against a projected `… — [[FIN]]` and called the difference
    # an edit forever. Trimming here removes the churn at its source rather than
    # teaching each comparison to ignore it.
    line = (_kv_get(keys, "line", "") or "").strip()
    appears_raw = _kv_get(keys, "appears", "") or ""
    appears = {a.strip() for a in appears_raw.split(",") if a.strip()}
    enrolled_raw = _kv_get(keys, "enrolled", "") or ""
    enrolled = {a.strip() for a in enrolled_raw.split(",") if a.strip()}
    sid = path.stem if (cfg and _dated(cfg)) else path.stem[len(slug) + 1:]
    return SimpleNamespace(
        slug=slug, sid=sid, path=path, keys=keys, body=body,
        line=line, orig_line=line,
        appears=appears, orig_appears=frozenset(appears),
        enrolled=enrolled, orig_enrolled=frozenset(enrolled),
        live=live, orig_live=live,
    )


def _write_stone(st):
    _kv_set(st.keys, "line", st.line)
    _kv_set(st.keys, "appears", ", ".join(sorted(st.appears)))
    # `enrolled::` is the receipt of a deliberate act (T626), so it is present
    # exactly when there is one to record — an empty key would read as a
    # placement that never happened.
    if st.enrolled:
        _kv_set(st.keys, "enrolled", ", ".join(sorted(st.enrolled)))
    else:
        _kv_del(st.keys, "enrolled")
    st.path.write_text(_render_stone(st.keys, st.body), encoding="utf-8")


# --------------------------------------------------------------------------
# Archive (T655) — one markdown file per list per MONTH, not one per stone.
#
# Dan 2026-09-03, on Obsidian's ~40K-file ceiling: archived stones stop being
# one `.md` each. `archive/YYYY-MM <Slug[.list]> archive.md` holds every stone
# retired that month as a `# <Slug> <id>` section (H1 — Dan 2026-09-03: an H2
# lets a body's own headings blur the boundary); the file's `aliases:` gains
# each stone's name so `[[Tink P0020]]` keeps resolving in Obsidian. Nothing is
# ever read back from a month file except by `_is_archived` (a heading grep for
# an error message) and the one-time `_next_sid` seed. Not a zip: grep, git and
# Obsidian all need to open it.

_ARCHIVE_NAME_RE = re.compile(r"^\d{4}-\d{2} (.+) archive$")


def _default_list_name(anchor_path: Path) -> str:
    registry = _anchor_stones(anchor_path)
    if registry and "_" in registry:
        return str(registry["_"])
    return str(_global_stones_section().get("_") or "pebble")


def _list_label(anchor_path: Path, slug: str, list_name) -> str:
    """The list exactly as ADDRESSED — `Tink` for the default list, `Tink.rocks`
    for a named one — which is what the month file is named after."""
    if list_name is None or list_name == _default_list_name(anchor_path):
        return slug
    return f"{slug}.{list_name}"


def _archive_month_path(folder: Path, label: str, month: str = None) -> Path:
    month = month or _dt.date.today().strftime("%Y-%m")
    return folder / "archive" / f"{month} {label} archive.md"


def _archive_month_files(folder: Path) -> list:
    d = folder / "archive"
    if not d.is_dir():
        return []
    return sorted(f for f in d.glob("*.md") if _ARCHIVE_NAME_RE.match(f.stem))


def _fm_bounds(lines: list):
    """(start, end) indices of the frontmatter's inner lines, or None."""
    if lines and lines[0].strip() == "---":
        i = 1
        while i < len(lines) and lines[i].strip() != "---":
            i += 1
        if i < len(lines):
            return 1, i
    return None


def _fm_get(lines: list, key: str):
    b = _fm_bounds(lines)
    if not b:
        return None
    rx = re.compile(rf"^{re.escape(key)}:\s*(.*?)\s*$")
    for ln in lines[b[0]:b[1]]:
        m = rx.match(ln)
        if m:
            return m.group(1)
    return None


def _fm_set(lines: list, key: str, value: str) -> None:
    """Set a scalar frontmatter key in place, creating the block when the file
    has none (legacy control files predate any frontmatter)."""
    b = _fm_bounds(lines)
    if not b:
        lines[0:0] = ["---", f"{key}: {value}", "---"]
        return
    rx = re.compile(rf"^{re.escape(key)}:")
    for i in range(b[0], b[1]):
        if rx.match(lines[i]):
            lines[i] = f"{key}: {value}"
            return
    lines.insert(b[1], f"{key}: {value}")


def _fm_add_alias(lines: list, name: str) -> None:
    b = _fm_bounds(lines)
    if not b:
        lines[0:0] = ["---", "aliases:", f"  - {name}", "---"]
        return
    for i in range(b[0], b[1]):
        if re.match(r"^aliases:\s*$", lines[i]):
            j = i + 1
            while j < b[1] and lines[j].startswith("  - "):
                if lines[j][4:].strip() == name:
                    return
                j += 1
            lines.insert(j, f"  - {name}")
            return
    lines[b[1]:b[1]] = ["aliases:", f"  - {name}"]


def _archive_append(folder: Path, label: str, name: str, keys: list, body: str,
                    month: str = None) -> Path:
    """Append one stone as a `# name` section to the list's month file,
    registering `name` as an alias. Creates the file on first use. Sections
    are appended in retirement order — chronological, oldest first (Dan)."""
    mpath = _archive_month_path(folder, label, month)
    mpath.parent.mkdir(parents=True, exist_ok=True)
    if mpath.is_file():
        lines = mpath.read_text(encoding="utf-8").splitlines()
    else:
        lines = ["---", "aliases:", "---"]
    _fm_add_alias(lines, name)
    while lines and lines[-1].strip() == "":
        lines.pop()
    lines.append("")
    lines.append(f"# {name}")
    lines.extend(f"{k}:: {v}" for k, v in keys)
    if body.strip():
        lines.append("")
        lines.extend(body.rstrip("\n").splitlines())
    mpath.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return mpath


def _archive_keys(keys: list, line: str, extra: list) -> list:
    """The keys an archived section carries: everything but the projection
    state (`appears::`, `enrolled::` describe live lists), `line::` current,
    plus the retirement stamp."""
    out = [(k, v) for k, v in keys if k not in ("appears", "enrolled", "line")]
    return [("line", line)] + out + extra


def _is_archived(folder: Path, slug: str, sid: str) -> bool:
    """Does `archive/` hold this stone — as a T655 month-file section, or as a
    legacy one-file archive not yet converted?"""
    name = f"{slug} {sid}"
    if (folder / "archive" / f"{name}.md").is_file():
        return True
    rx = re.compile(rf"^# {re.escape(name)}\s*$", re.M)
    return any(rx.search(f.read_text(encoding="utf-8")) for f in _archive_month_files(folder))


def _archived_numbers(folder: Path, slug: str, cfg: dict) -> list:
    """Every stone number `archive/` still records — legacy files and month-file
    headings — for the ONE seed of the `next:` counter."""
    num_re = _stone_number_re(slug, cfg)
    nums = []
    d = folder / "archive"
    if d.is_dir():
        nums += [int(num_re.match(f.stem).group(1)) for f in _stone_files(d, slug, cfg)]
    for f in _archive_month_files(folder):
        for m in re.finditer(r"^# (.+?)\s*$", f.read_text(encoding="utf-8"), re.M):
            mm = num_re.match(m.group(1))
            if mm:
                nums.append(int(mm.group(1)))
    return nums


def _archive_stone(st):
    """Retire a live stone: its section goes to this month's file, its own
    file is deleted. `st.archive_label` (set by the caller) names the list as
    addressed; a caller that never set it gets the bare slug."""
    folder = st.path.parent
    label = getattr(st, "archive_label", None) or st.slug
    today = _dt.date.today().isoformat()
    keys = _archive_keys(st.keys, st.line, [("retired", today)])
    mpath = _archive_append(folder, label, st.path.stem, keys, st.body)
    st.path.unlink()
    st.archived_to = mpath
    st.live = False
    st.appears = set()


# --------------------------------------------------------------------------
# Line-level parsing of a control file. A HEADER is any line whose first
# link's TARGET is some anchor's control file for this kind (R-stone-04); a
# STONE line is any line whose first link's TARGET is `{slug} {PREFIX}{NNNN}`.

# The optional leading `-` admits the header_line wrap (`-[[X Pebble|X]]-`,
# dashes OUTSIDE the link — Dan, 2026-08-17) and, incidentally, a stone line
# someone bulleted; identity still comes only from the link target (R-stone-04).
_FIRST_LINK_RE = re.compile(r"^\s*(?:-\s*)?\[\[([^\]|]+)(?:\|([^\]]*))?\]\](.*)$")


def _is_header_target(target: str, cfg: dict):
    suf = _control_suffix(cfg)
    tail = " " + suf
    if target.endswith(tail):
        slug = target[: -len(tail)]
        if slug:
            return slug
    return None


_DATED_RE = re.compile(r"^(\d{4}-\d{2}-\d{2}) .+$")


def _dated(cfg: dict) -> bool:
    return cfg.get("member") == "dated"


def _alias_owner(alias: str, cfg: dict, host: str | None = None):
    """The owning slug read back out of a rendered alias, or None.

    THIS IS WHERE A DATED STONE'S IDENTITY COMES FROM, and it is the whole
    design decision of T276. A numbered stone carries its owner in the link
    TARGET (`[[SONAR P0003]]`); a dated one cannot, because its name is a date
    and a title and nothing else — that readability is the point of the kind.

    The obvious alternative is "the owner is whichever anchor's control file
    the line sits in," and it is wrong: a published stone propagates along
    `feeds:` into OTHER anchors' files, where that rule would rename it to the
    consumer on the first pass and the ownership would be lost with no error.
    The alias is the one part of the rendered line that already names the
    owner (`stone_alias` is `{slug}:`), `render_stone_line` already writes it
    from the owner, and it travels with the line downstream — so the
    round-trip closes with no new field in the file format.
    """
    if alias is None:
        return None
    if alias.strip() == OWN_ALIAS:
        # The dash means "this list's own anchor" — legible only when the
        # caller says whose list it is reading. Without a host it reads as no
        # owner at all, which is the honest answer.
        return host
    pat = re.escape(cfg["stone_alias"]).replace(re.escape("{slug}"), r"(.+?)")
    m = re.fullmatch(pat, alias.strip())
    if not m:
        return None
    owner = m.group(1).strip()
    return owner or None


def _stone_link_target(owner: str, sid: str, cfg: dict) -> str:
    """The link target for a stone — the half that differs between kinds."""
    return sid if _dated(cfg) else f"{owner} {sid}"


def _stone_filename(owner: str, sid: str, cfg: dict) -> str:
    return f"{sid}.md" if _dated(cfg) else f"{owner} {sid}.md"


def _is_stone_target(target: str, cfg: dict, alias: str = None,
                     host: str | None = None):
    if _dated(cfg):
        # A dated member's sid IS its whole name — date and title together —
        # because that name is the file and there is no number to carry.
        if not _DATED_RE.match(target):
            return None
        owner = _alias_owner(alias, cfg, host)
        return (owner, target) if owner else None
    prefix = cfg["prefix"]
    digits = cfg.get("digits", 4)
    m = re.match(rf"^([A-Za-z][A-Za-z0-9]*) ({re.escape(prefix)}\d{{{digits}}})$", target)
    if m:
        return m.group(1), m.group(2)
    return None


def classify_line(line: str, cfg: dict, host: str | None = None):
    """('other',) | ('header', anchor_slug, rest_after_link) |
    ('stone', owner_slug, sid, line_text). `host` is the anchor slug of the
    list being read — what a dash alias resolves to."""
    m = _FIRST_LINK_RE.match(line)
    if not m:
        return ("other",)
    target = m.group(1).strip()
    rest = m.group(3)
    hdr_slug = _is_header_target(target, cfg)
    if hdr_slug:
        return ("header", hdr_slug, rest)
    st = _is_stone_target(target, cfg, m.group(2), host)
    if st:
        owner, sid = st
        return ("stone", owner, sid, rest.lstrip())
    return ("other",)


def classify_stone_chunk(chunk: str, cfg: dict, host: str | None = None):
    """Like classify_line but for one comma-separated INLINE entry (no
    trailing content beyond the entry itself is expected)."""
    m = _FIRST_LINK_RE.match(chunk.strip())
    if not m:
        return None
    target = m.group(1).strip()
    rest = m.group(3)
    st = _is_stone_target(target, cfg, m.group(2), host)
    if not st:
        return None
    owner, sid = st
    return owner, sid, rest.lstrip()


def _split_inline(payload: str) -> list:
    """Split an inline header's comma list at `, [[`, never inside a link."""
    return [p.strip() for p in re.split(r",\s*(?=\[\[)", payload) if p.strip()]


OWN_ALIAS = "-"


def _stone_alias(owner: str, cfg: dict, host: str | None = None) -> str:
    """What the stone's link SHOWS. In a list belonging to the stone's own
    anchor the alias is a bare dash (Dan, 2026-08-30: "If I'm in the Atticus
    list, I shouldn't see Atticus colon. I should just see a dash") — the
    owner is the page, so naming it on every line is noise. Anywhere else the
    line is a guest and `stone_alias` (`{slug}:`) names who it belongs to.
    `host` is the anchor slug of the list the line sits in; None means "not
    known", which renders the full alias — never the dash, because a dash
    whose host is unknown cannot be read back to an owner."""
    if host is not None and host == owner:
        return OWN_ALIAS
    return cfg["stone_alias"].format(slug=owner)


def render_stone_line(owner: str, sid: str, text: str, cfg: dict,
                      host: str | None = None) -> str:
    return f"[[{_stone_link_target(owner, sid, cfg)}|{_stone_alias(owner, cfg, host)}]] {text}"


def _render_header(owner: str, cfg: dict) -> str:
    control = cfg["control"].format(slug=owner)
    alias = cfg["header_alias"].format(slug=owner)
    link = f"[[{control}|{alias}]]"
    return cfg.get("header_line", "{link}").format(link=link)


def _header_payload(line: str, rest: str):
    """(head, payload) for an INLINE header line — head is everything up to
    the first `:` in `rest`, payload what follows it. (None, None) for the
    block form. Tolerates the header_line wrap: an optional `-` may sit
    between the link and the colon (`-[[X Pebble|X]]-: …`)."""
    tail = rest.lstrip()
    if tail.startswith("-"):
        tail = tail[1:].lstrip()
    if not tail.startswith(":"):
        return None, None
    colon = len(line) - len(rest) + rest.index(":")
    return line[:colon], line[colon + 1:].strip()


def _find_header_index(lines: list, target_slug: str, cfg: dict):
    for i, line in enumerate(lines):
        cls = classify_line(line, cfg)
        if cls[0] == "header" and cls[1] == target_slug:
            return i
    return None


_NEW_HEADER_RE = re.compile(r"^\s*#{1,6}\s+New\s*$", re.IGNORECASE)


def _content_start(lines: list) -> int:
    """Where a NEW line lands in a control file (T618, Dan 2026-08-29).

    A control file is an arbitrary document; the engine's only requirement of
    it is that it links every stone. So a missing line is INSERTED and nothing
    else is touched — no packing, no blank-stripping, no H1 removal: the file
    keeps its shape and the user moves the line wherever it belongs. Where the
    insert goes: directly under a `## New` header if the file has one (any
    level, case-insensitive — the user's way of steering new lines away from
    the top), else the top of the content, just past frontmatter and a leading
    H1. Whether the member is numbered or dated has no bearing on placement.
    """
    for i, line in enumerate(lines):
        if _NEW_HEADER_RE.match(line):
            j = i + 1
            while j < len(lines) and lines[j].strip() == "":
                j += 1
            return min(j, len(lines))
    i = 0
    if i < len(lines) and lines[i].strip() == "---":
        i += 1
        while i < len(lines) and lines[i].strip() != "---":
            i += 1
        i += 1
        while i < len(lines) and lines[i].strip() == "":
            i += 1
    if i < len(lines) and lines[i].lstrip().startswith("# "):
        i += 1
        while i < len(lines) and lines[i].strip() == "":
            i += 1
    return min(i, len(lines))


def _find_all_stone_occurrences(lines: list, cfg: dict, host: str | None = None) -> set:
    out = set()
    for line in lines:
        cls = classify_line(line, cfg, host)
        if cls[0] == "stone":
            out.add((cls[1], cls[2]))
        elif cls[0] == "header":
            _head, payload = _header_payload(line, cls[2])
            if payload is not None:
                for chunk in _split_inline(payload):
                    sub = classify_stone_chunk(chunk, cfg, host)
                    if sub:
                        out.add((sub[0], sub[1]))
    return out


def _add_to_own_top(cf, slug: str, sid: str, st, cfg: dict):
    idx = _content_start(cf.lines)
    cf.lines.insert(idx, render_stone_line(slug, sid, st.line, cfg, host=slug))


def _add_downstream(cf, source_slug: str, additions: list, stones: dict, cfg: dict):
    """additions: [(owner, sid), ...] in desired order — insert under the
    header for `source_slug` (block, one line each; inline, comma-appended),
    or at the top of the file if no such header exists (§ Propagation)."""
    hdr_idx = _find_header_index(cf.lines, source_slug, cfg)
    if hdr_idx is None:
        insert_idx = _content_start(cf.lines)
        for owner, sid in additions:
            cf.lines.insert(insert_idx, render_stone_line(owner, sid, stones[(owner, sid)].line, cfg, host=cf.slug))
            insert_idx += 1
        return

    line = cf.lines[hdr_idx]
    cls = classify_line(line, cfg, cf.slug)
    head, payload = _header_payload(line, cls[2])
    if head is not None:
        chunks = _split_inline(payload) if payload else []
        for owner, sid in additions:
            chunks.append(render_stone_line(owner, sid, stones[(owner, sid)].line, cfg, host=cf.slug))
        cf.lines[hdr_idx] = f"{head}: " + ", ".join(chunks)
        return

    # Block form: append after the contiguous run of stone-lines under header.
    end = hdr_idx + 1
    while end < len(cf.lines) and classify_line(cf.lines[end], cfg, cf.slug)[0] == "stone":
        end += 1
    insert_idx = end
    for owner, sid in additions:
        cf.lines.insert(insert_idx, render_stone_line(owner, sid, stones[(owner, sid)].line, cfg, host=cf.slug))
        insert_idx += 1


def remove_stones(cf, targets: set, cfg: dict):
    """Drop every block line and inline chunk naming a stone in `targets`."""
    new_lines = []
    for line in cf.lines:
        cls = classify_line(line, cfg, cf.slug)
        if cls[0] == "stone":
            if (cls[1], cls[2]) in targets:
                continue
            new_lines.append(line)
        elif cls[0] == "header":
            head, payload = _header_payload(line, cls[2])
            if payload:
                kept = []
                for chunk in _split_inline(payload):
                    sub = classify_stone_chunk(chunk, cfg, cf.slug)
                    if sub and (sub[0], sub[1]) in targets:
                        continue
                    kept.append(chunk)
                new_lines.append(f"{head}: " + ", ".join(kept) if kept else f"{head}:")
            else:
                new_lines.append(line)
        else:
            new_lines.append(line)
    cf.lines[:] = new_lines


# --------------------------------------------------------------------------
# The list-level walk (F628 step 3): nodes, union grammar

def _default_list_name(anchor_path: Path) -> str:
    """The dotless list name for one anchor — its registry `_`, else the
    config-wide default (Q2/Q4: a bare feed target names this)."""
    registry = _anchor_stones(anchor_path)
    if registry and "_" in registry:
        return registry["_"]
    return str(_global_stones_section().get("_") or "pebble")


def _build_nodes(anchors: dict, cfg_all: dict, kinds=None) -> dict:
    """One node per LIST: (slug, list_name) -> namespace(cfg, folder, cpath,
    stem). Unified walk (kinds None): every kind-table type on every anchor
    (the transition fallback) plus every registry-declared list. Restricted
    walk (legacy `stone <kind> update`): that one type on every anchor."""
    nodes = {}
    for slug, a in sorted(anchors.items()):
        if kinds is None:
            registry = _anchor_stones(a.path) or {}
            wanted = list(cfg_all) + [n for n in registry
                                      if n != "_" and n not in cfg_all]
        else:
            wanted = list(kinds)
        for name in wanted:
            cfg, name = _effective_cfg(a.path, slug, name, cfg_all)
            nodes[(slug, name)] = SimpleNamespace(
                slug=slug, name=name, anchor=a, cfg=cfg,
                folder=_stone_folder(a.path, slug, cfg),
                cpath=_control_path(a.path, slug, cfg),
                stem=cfg["control"].format(slug=slug))
    return nodes


class Gram:
    """Union line-grammar + node map for one UPDATE pass (F628 step 3).

    The single-list verbs (new / move / push / recall) keep the cfg-based
    helpers above; the update engine classifies with this union instead,
    because a list-level walk must recognize every known list's lines in one
    file — a traffic control file legitimately carries rock lines once a
    cross-type edge exists. Headers are matched by control-stem suffix (the
    generalization of `_is_header_target`), numbered stones by the union of
    known (prefix, digits) pairs, dated stones by shape + alias owner. The
    two grammars agree wherever both apply; the cfg helpers fold into this
    when the kind table retires (step 4).
    """

    def __init__(self, nodes: dict, restricted: bool = False):
        self.nodes = nodes
        self.restricted = restricted
        self.suffixes = sorted({_control_suffix(nd.cfg) for nd in nodes.values()},
                               key=len, reverse=True)
        self.pairs = sorted({(nd.cfg["prefix"], int(nd.cfg.get("digits", 4)))
                             for nd in nodes.values()
                             if not _dated(nd.cfg) and nd.cfg.get("prefix")})
        self.dated_cfgs, seen = [], set()
        for key in sorted(nodes):
            cfg = nodes[key].cfg
            if _dated(cfg) and cfg["stone_alias"] not in seen:
                seen.add(cfg["stone_alias"])
                self.dated_cfgs.append(cfg)

    def label(self, key) -> str:
        """Restricted labels stay bare slugs — the walk has one list per
        anchor and every existing message names anchors, not lists."""
        return key[0] if self.restricted else f"{key[0]}.{key[1]}"

    def header_target(self, target: str):
        for suf in self.suffixes:
            tail = " " + suf
            if target.endswith(tail) and target[: -len(tail)]:
                return target
        return None

    def stone_target(self, target: str, alias, host: str | None = None):
        for cfg in self.dated_cfgs:
            hit = _is_stone_target(target, cfg, alias, host)
            if hit:
                return hit
        for prefix, digits in self.pairs:
            m = re.match(
                rf"^([A-Za-z][A-Za-z0-9]*) ({re.escape(prefix)}\d{{{digits}}})$",
                target)
            if m:
                return m.group(1), m.group(2)
        return None

    def classify(self, line: str, host: str | None = None):
        """('other',) | ('header', stem, rest) | ('stone', owner, sid, text).
        `host` is the anchor slug of the file being read (a dash alias means
        that anchor)."""
        m = _FIRST_LINK_RE.match(line)
        if not m:
            return ("other",)
        target = m.group(1).strip()
        rest = m.group(3)
        stem = self.header_target(target)
        if stem:
            return ("header", stem, rest)
        hit = self.stone_target(target, m.group(2), host)
        if hit:
            return ("stone", hit[0], hit[1], rest.lstrip())
        return ("other",)

    def stone_chunk(self, chunk: str, host: str | None = None):
        m = _FIRST_LINK_RE.match(chunk.strip())
        if not m:
            return None
        hit = self.stone_target(m.group(1).strip(), m.group(2), host)
        if not hit:
            return None
        return hit[0], hit[1], m.group(3).lstrip()

    def occurrences(self, lines: list, host: str | None = None) -> set:
        out = set()
        for line in lines:
            cls = self.classify(line, host)
            if cls[0] == "stone":
                out.add((cls[1], cls[2]))
            elif cls[0] == "header":
                _head, payload = _header_payload(line, cls[2])
                if payload is not None:
                    for chunk in _split_inline(payload):
                        sub = self.stone_chunk(chunk, host)
                        if sub:
                            out.add((sub[0], sub[1]))
        return out

    def render(self, st, host: str | None = None) -> str:
        """A stone renders with its HOME list's grammar, wherever the line
        lands — ownership belongs to the owner, not the host file. The alias
        is the one host-dependent part: a dash on the owner's own pages, the
        owner's name everywhere else (`_stone_alias`)."""
        return render_stone_line(st.slug, st.sid, st.line, st.home_cfg, host)

    def find_header(self, lines: list, stem: str):
        for i, line in enumerate(lines):
            cls = self.classify(line)
            if cls[0] == "header" and cls[1] == stem:
                return i
        return None

    def remove(self, cf, targets: set):
        new_lines = []
        for line in cf.lines:
            cls = self.classify(line, cf.slug)
            if cls[0] == "stone":
                if (cls[1], cls[2]) in targets:
                    continue
                new_lines.append(line)
            elif cls[0] == "header":
                head, payload = _header_payload(line, cls[2])
                if payload:
                    kept = []
                    for chunk in _split_inline(payload):
                        sub = self.stone_chunk(chunk, cf.slug)
                        if sub and (sub[0], sub[1]) in targets:
                            continue
                        kept.append(chunk)
                    new_lines.append(f"{head}: " + ", ".join(kept) if kept else f"{head}:")
                else:
                    new_lines.append(line)
            else:
                new_lines.append(line)
        cf.lines[:] = new_lines

    def add_downstream(self, cf, source_key, additions: list, stones: dict):
        """Insert under the header for the SOURCE list (block: one line each;
        inline: comma-appended), else at the top of the content."""
        stem = self.nodes[source_key].stem
        hdr_idx = self.find_header(cf.lines, stem)
        if hdr_idx is None:
            insert_idx = _content_start(cf.lines)
            for k in additions:
                cf.lines.insert(insert_idx, self.render(stones[k], cf.slug))
                insert_idx += 1
            return
        line = cf.lines[hdr_idx]
        cls = self.classify(line, cf.slug)
        head, payload = _header_payload(line, cls[2])
        if head is not None:
            chunks = _split_inline(payload) if payload else []
            chunks.extend(self.render(stones[k], cf.slug) for k in additions)
            cf.lines[hdr_idx] = f"{head}: " + ", ".join(chunks)
            return
        end = hdr_idx + 1
        while end < len(cf.lines) and self.classify(cf.lines[end], cf.slug)[0] == "stone":
            end += 1
        insert_idx = end
        for k in additions:
            cf.lines.insert(insert_idx, self.render(stones[k], cf.slug))
            insert_idx += 1


# --------------------------------------------------------------------------
# The propagation pass (§ Propagation)

def _mtime(p):
    try:
        return p.stat().st_mtime
    except (OSError, AttributeError):
        return None


def _newer_side(st, cf, tolerance: float = 2.0):
    """`"stone"` / `"control"` / `None` — which of the two files was written
    last, or None when that cannot be told (T553).

    None covers equal-within-`tolerance` and either mtime being unreadable. The
    two-second band is not superstition: a git checkout, an rsync, or two
    writes inside one agent turn routinely land both files in the same instant,
    and a sub-second gap there says nothing about which text a human authored.
    Callers treat None as a conflict rather than a tie-break, because guessing
    is the whole defect this discriminator exists to close.
    """
    a = _mtime(getattr(st, "path", None))
    b = _mtime(getattr(cf, "path", None)) if cf is not None else None
    if a is None or b is None:
        return None
    if abs(a - b) <= tolerance:
        return None
    return "stone" if a > b else "control"


def readback(stones: dict, control: dict, gram: Gram,
             stats: dict | None = None, notes: list | None = None) -> list:
    """Any line differing from its stone is an edit of the stone (wherever
    found), compared against each stone's ORIGINAL line:: (as of the start of
    the pass), not a running value — so a single edit surrounded by untouched
    stale copies is never mistaken for a later 'edit' reverting it. Then every
    occurrence is resynced: convergence, the property the design is tested
    against.

    Returns the COLLISIONS — stones whose projections were edited to two or
    more different values in one pass (F312 Q6 = C: the caller aborts before
    any write, so no edit disappears quietly). The predicate is *distinct*
    differing values — two projections carrying the SAME new text is a
    propagated edit, not a conflict.

    **T553 — a differing projection is not always an edit; it may be STALE.**
    The discriminator is file mtime: whichever of the stone file and the
    control file carrying the projection was written last is the authored
    side. Stone newer -> the projection is stale; keep the stone's value and
    let resync push it back out (this is the case that was losing data —
    [[Hermes]] 2026-08-17). Control newer -> a genuine edit; propagate.
    Neither (equal mtimes, a fresh clone / checkout / rsync) -> propagate,
    but report it by name with both strings, counted as `unadjudicated` —
    aborting there would make the tool unusable at exactly the moment
    nothing is in conflict.

    F628 step 3: `control` is keyed by NODE (slug, list) and classification
    goes through the union grammar, so an edit made to a projection hosted on
    a different-type list still travels home to its stone.
    """
    if stats is None:
        stats = {}
    if notes is None:
        notes = []
    occ: dict = {}
    for key in sorted(control):
        cf = control[key]
        for line in cf.lines:
            cls = gram.classify(line, cf.slug)
            if cls[0] == "stone":
                _t, owner, sid, text = cls
                occ.setdefault((owner, sid), []).append((key, text))
            elif cls[0] == "header":
                _head, payload = _header_payload(line, cls[2])
                if payload is not None:
                    for chunk in _split_inline(payload):
                        sub = gram.stone_chunk(chunk, cf.slug)
                        if sub:
                            owner, sid, text = sub
                            occ.setdefault((owner, sid), []).append((key, text))

    collisions = []
    for skey, seen in occ.items():
        st = stones.get(skey)
        if st is None:
            continue  # dangling reference — left untouched, not this tool's job
        original = st.orig_line
        edits = [(k, text) for k, text in seen if text != original]
        distinct = {text for _k, text in edits}
        if len(distinct) > 1:
            # T642 (Dan 2026-09-02) — supersedes F312 Q6 = (C). Two different
            # edits, neither the stone's: CONCATENATE them, newest file first,
            # joined by a visible ` ⚡ `, and let resync push that one long
            # line everywhere. Nothing vanishes (every value is on the line),
            # everything converges (the next pass sees one value), and the
            # conflict sits where someone reads it — the line itself — rather
            # than in an error that stopped forty unrelated anchors' updates
            # (Eli, blocked on a stale Lumen line, 2026-09-02). The cleanup is
            # a hand edit of any one copy, which then propagates as usual.
            def _when(k):
                m = _mtime(getattr(control.get(k), "path", None))
                return -(m or 0)
            ordered = []
            for k, text in sorted(edits, key=lambda kt: _when(kt[0])):
                if text not in ordered:
                    ordered.append(text)
            joined = " ⚡ ".join(ordered)
            collisions.append((skey[0], skey[1],
                               sorted((gram.label(k), text) for k, text in edits)))
            stats["concatenated"] = stats.get("concatenated", 0) + 1
            notes.append(
                f"CONFLICT on {skey[0]} {skey[1]} — {len(ordered)} different edits, "
                f"concatenated newest-first (clean it up by editing any one copy):\n"
                + "\n".join(f"      {gram.label(k)} says: {text}" for k, text in edits))
            st.line = joined
            continue
        if not edits or edits[-1][1] == st.line:
            continue
        k, text = edits[-1]
        # T553 — only take the projection when it is demonstrably the newer
        # side. An EMPTY `original` is not a replacement: there is nothing to
        # lose, so an unset line:: is filled without ceremony.
        if original.strip():
            side = _newer_side(st, control.get(k))
            if side == "stone":
                stats["kept_stone"] = stats.get("kept_stone", 0) + 1
                notes.append(
                    f"kept {skey[0]} {skey[1]}'s own line — {gram.label(k)}'s copy is older\n"
                    f"      stone: {original}\n"
                    f"      {gram.label(k)}: {text}")
                continue
            stats["replaced"] = stats.get("replaced", 0) + 1
            if side is None:
                stats["unadjudicated"] = stats.get("unadjudicated", 0) + 1
                notes.append(
                    f"replaced {skey[0]} {skey[1]}'s line from {gram.label(k)} — mtimes "
                    f"could not say which is newer, so this one is UNADJUDICATED:\n"
                    f"      was:  {original}\n"
                    f"      now:  {text}")
            else:
                notes.append(f"replaced {skey[0]} {skey[1]}'s line from "
                             f"{gram.label(k)}'s newer copy")
        st.line = text
    return collisions


def resync(stones: dict, control: dict, gram: Gram):
    """Rewrite every projection to match its stone — the second half of the
    convergence contract (readback pulls edits UP, this pushes the settled
    value back OUT). Regression case P in test-f313-stone.py.

    The whole rendered line is compared, not just its text, so a line whose
    ALIAS has gone stale — an old slug (`ATT:` for Atticus), or the full name
    where the host's own pages now show a dash — is brought current on the
    next pass. Anything the user typed before the link (a list dash, indent)
    is kept."""
    for key in sorted(control):
        cf = control[key]
        for i, line in enumerate(cf.lines):
            cls = gram.classify(line, cf.slug)
            if cls[0] == "stone":
                _t, owner, sid, text = cls
                st = stones.get((owner, sid))
                if st is None:
                    continue
                pre = line[:line.index("[[")]
                want = pre + gram.render(st, cf.slug)
                if line != want:
                    cf.lines[i] = want
        for i, line in enumerate(cf.lines):
            cls = gram.classify(line, cf.slug)
            if cls[0] != "header":
                continue
            head, payload = _header_payload(line, cls[2])
            if not payload:
                continue
            new_chunks = []
            any_diff = False
            for chunk in _split_inline(payload):
                sub = gram.stone_chunk(chunk, cf.slug)
                if sub:
                    owner, sid, text = sub
                    st = stones.get((owner, sid))
                    if st is not None:
                        nc = gram.render(st, cf.slug)
                        if nc != chunk:
                            any_diff = True
                        new_chunks.append(nc)
                        continue
                new_chunks.append(chunk)
            if any_diff:
                cf.lines[i] = f"{head}: " + ", ".join(new_chunks)
        # write-out compares final text against what was on disk, so a file
        # with no real difference simply writes a no-op-identical text.


def compute_published(key, cf, stones: dict, gram: Gram) -> list:
    """Stones (owned or merely re-shared) below this LIST's OWN self-section
    marker — the header, anywhere in its own control file, pointing at its
    own control file. No marker: nothing is published."""
    hdr_idx = gram.find_header(cf.lines, gram.nodes[key].stem)
    if hdr_idx is None:
        return []
    out = []
    for i, line in enumerate(cf.lines):
        if i <= hdr_idx:
            continue
        cls = gram.classify(line, cf.slug)
        if cls[0] == "stone":
            st = stones.get((cls[1], cls[2]))
            if st is not None and st.live:
                out.append((cls[1], cls[2]))
        elif cls[0] == "header":
            _head, payload = _header_payload(line, cls[2])
            if payload is not None:
                for chunk in _split_inline(payload):
                    sub = gram.stone_chunk(chunk, cf.slug)
                    if sub:
                        st = stones.get((sub[0], sub[1]))
                        if st is not None and st.live:
                            out.append((sub[0], sub[1]))
    return out


def reconcile_own(key, stones: dict, control: dict, gram: Gram, stats: dict,
                  dry: bool = False):
    """A stone is always present in its own control file — except once: gone
    from THERE (not merely absent) is the archive signal (§ A stone always
    appears in its own control file — except once). Own = the HOME list's
    control file; a stone's line hosted on a sibling list of the same anchor
    neither publishes nor saves it."""
    cf = control[key]
    slug, _name = key
    owned = sorted(sid for (s, sid), s_t in stones.items()
                   if s == slug and s_t.home == key)
    for sid in owned:
        st = stones[(slug, sid)]
        if not st.live:
            continue
        present = (slug, sid) in gram.occurrences(cf.lines, slug)
        if present:
            continue
        if slug in st.appears:
            if dry:
                # _archive_stone MOVES the file — a dry run that archived would be
                # the loudest possible violation of the word "dry".
                print(f"  would archive {st.path}")
                st.live = False
                st.appears = set()
            else:
                _archive_stone(st)
            stats["archived"] += 1
        else:
            cf.lines.insert(_content_start(cf.lines), gram.render(st, slug))
            st.appears.add(slug)


def propagate_in(key, edges: dict, stones: dict, control: dict,
                 published: dict, gram: Gram):
    """Add/remove are silent (§ Adding and removing are silent, and are not
    events) — driven purely by (a) a list-level edge existing and (b) the
    upstream stone's current published-ness, never by anything printed.
    Enrollment (T626) is the exception by design: an enrolled stone is
    desired on the target anchor's list OF THE OWNER'S TYPE regardless of
    edges, until recalled or archived."""
    cf = control[key]
    slug, name = key
    sources = edges.get(key, [])
    desired = set()
    for src in sources:
        desired.update(published.get(src, []))
    enrolled_here = sorted(
        k for k, st in stones.items()
        if st.live and k[0] != slug
        and ((slug in st.enrolled and st.home[1] == name)      # T626: list of the owner's type
             or f"{slug}.{name}" in st.enrolled)               # T653: a named list
    )
    desired.update(enrolled_here)

    existing = gram.occurrences(cf.lines, slug)
    to_remove = {(o, s) for (o, s) in existing if o != slug and (o, s) not in desired}
    if to_remove:
        gram.remove(cf, to_remove)
        for k in to_remove:
            # A DANGLING occurrence — a line whose stone file no longer exists
            # or whose owner cannot be resolved — has no stone to bookkeep.
            # The line still comes off. Crashed live on ('HERMES', dated sid)
            # after the 2026-08-30 Staff rename left old-slug aliases behind.
            st_ = stones.get(k)
            if st_ is not None:
                st_.appears.discard(slug)

    existing_after = gram.occurrences(cf.lines, slug)
    for src in sources:
        adds = [k for k in published.get(src, []) if k not in existing_after]
        if not adds:
            continue
        gram.add_downstream(cf, src, adds, stones)
        for k in adds:
            stones[k].appears.add(slug)
        existing_after = gram.occurrences(cf.lines, slug)
    for k in enrolled_here:
        if k in existing_after:
            continue
        # Filed under the owner's header if the target keeps one, else the top.
        gram.add_downstream(cf, stones[k].home, [k], stones)
        stones[k].appears.add(slug)
        existing_after = gram.occurrences(cf.lines, slug)


# --------------------------------------------------------------------------
# Verbs

def _default_control_lines(slug: str, cfg: dict) -> list:
    # A FRESH control file is a bare list (Dan, 2026-08-17 — "just an empty
    # list file, no header to it"). Only the default is shaped: an existing
    # file is never repacked (T618) — see _content_start.
    control_name = cfg["control"].format(slug=slug)
    return ["---", f"description: {control_name} — control file", "---", ""]


def _body_start(lines: list) -> int:
    """Index of the first line after the frontmatter block, or 0."""
    if lines and lines[0].strip() == "---":
        i = 1
        while i < len(lines) and lines[i].strip() != "---":
            i += 1
        return min(i + 1, len(lines))
    return 0


def _ensure_leading_blank(lines: list) -> None:
    """The first line of a control file's body is always blank (Dan,
    2026-08-30): it is the user's place to type. Whatever they put there
    becomes the first line, and the next pass puts a fresh blank above it —
    so the slot is never used up. Only the engine's write paths call this;
    an empty (nonexistent) file is left empty, since writing a lone blank
    would create control files for every list that has never held a stone."""
    if not lines:
        return
    i = _body_start(lines)
    if i >= len(lines) or lines[i].strip() != "":
        lines.insert(i, "")


def _mint_warnings(cf, slug: str, sid: str, keys: list, cfg: dict) -> list:
    """What a fresh mint does NOT do, said out loud (T554).

    [[Hermes]], 2026-08-17, on a `stone pebble new` that reported success:
    *"Both are invisible at mint time. Nothing in the output distinguishes a
    working pebble from one that will never raise, and the failure only shows
    up as absence."* Neither condition below is a bug in what the mint WRITES —
    unpublished-at-mint is the design (case E: publishing is the human act of
    moving the line below the self-header), and this script is kind-generic so
    it has never known which keys a kind requires. The defect is that the
    output claimed unqualified success for a stone that cannot work yet, and
    absence is the hardest failure to notice.

    Reporting only. Refusing, or growing a `--tempo` flag to satisfy the
    requirement, is new CLI surface and is not this function's call to make.
    """
    out = []
    hdr = _find_header_index(cf.lines, slug, cfg)
    if hdr is not None:
        try:
            own = next(i for i, l in enumerate(cf.lines)
                       if classify_line(l, cfg, slug)[:3] == ("stone", slug, sid))
        except StopIteration:
            own = None
        if own is not None and own < hdr:
            out.append(
                f"UNPUBLISHED — the line sits ABOVE {slug}'s self-header, which "
                f"is where a new stone starts by design. It raises nothing and "
                f"propagates nowhere until it is moved BELOW the header.")
    missing = [k for k in cfg.get("required_keys", [])
               if not dict(keys).get(k, "").strip()]
    if missing:
        out.append(
            f"MISSING {', '.join(k + '::' for k in missing)} — required per "
            f"[[DAS Stone Keys]]. Without it the stone has no raising "
            f"condition and will never surface. Add it to {_stone_filename(slug, sid, cfg)} by "
            f"hand.")
    return out


def _next_sid(cpath: Path, folder: Path, slug: str, cfg: dict) -> str:
    """The next unused number on a numbered list, from the `next:` counter in
    the control file's frontmatter (T655). Absent, it is seeded ONCE from the
    live folder plus everything `archive/` records, and never scanned again —
    archived stones no longer exist as files, so a scan could not see them.
    Allocating advances the counter; a mint that fails afterwards leaves a gap,
    which is what monotonic means."""
    prefix = cfg["prefix"]
    digits = cfg.get("digits", 4)
    lines = (cpath.read_text(encoding="utf-8").splitlines() if cpath.is_file()
             else _default_control_lines(slug, cfg))
    cur = _fm_get(lines, "next")
    if cur is not None and re.fullmatch(r"\d+", cur.strip()):
        n = int(cur)
    else:
        num_re = _stone_number_re(slug, cfg)
        nums = [int(num_re.match(f.stem).group(1)) for f in _stone_files(folder, slug, cfg)]
        nums += _archived_numbers(folder, slug, cfg)
        n = (max(nums) + 1) if nums else 1
    _fm_set(lines, "next", str(n + 1))
    cpath.parent.mkdir(parents=True, exist_ok=True)
    cpath.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return f"{prefix}{str(n).zfill(digits)}"


def cmd_new(kind, root: Path, args) -> int:
    anchors, ambiguous = discover_anchors(root)
    slug = args.anchor
    if slug in ambiguous:
        raise _ambiguous_error(slug, ambiguous[slug], "it is the mint target")
    if slug not in anchors:
        raise StoneError(f"no anchor {slug!r} (.anchor) found under {root}")
    a = anchors[slug]
    cfg, kind = _effective_cfg(a.path, slug, kind, load_types())
    _reject_unroundtrippable_owner(slug, cfg)
    over = _over_budget(slug, args.line, cfg)
    if over:
        n, budget = over
        raise StoneError(
            f"refused: the line renders as {n} characters and the budget is "
            f"{budget} (`stone_line_max`) — it would wrap in Obsidian. Shorten "
            f"the --line; the detail belongs in --body. Nothing was written.")

    folder = _stone_folder(a.path, slug, cfg)
    folder.mkdir(parents=True, exist_ok=True)
    cpath = _control_path(a.path, slug, cfg)

    if _dated(cfg):
        # A dated stone is NAMED, not counted, so there is no scan to do and no
        # next number to allocate. The date is the CREATION date and never the
        # ordering key -- ordering lives in the control file, which may be
        # generated from any key at all (see stone-kinds.py).
        title = (getattr(args, "title", None) or "").strip()
        if not title:
            raise StoneError(
                f"{cfg.get('control', '').format(slug=slug)} is a dated kind — its "
                f"members are named `YYYY-MM-DD {{Title}}`, so a mint needs --title."
            )
        if any(ch in title for ch in "/:\\"):
            raise StoneError(f"--title {title!r} cannot contain / : or \\ — it is a filename")
        date = (getattr(args, "date", None) or "").strip() or _dt.date.today().isoformat()
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
            raise StoneError(f"--date {date!r} is not YYYY-MM-DD")
        sid = f"{date} {title}"
    else:
        sid = _next_sid(cpath, folder, slug, cfg)
    stone_path = folder / _stone_filename(slug, sid, cfg)
    if stone_path.exists():
        raise StoneError(f"{stone_path} already exists — refusing to overwrite")

    keys = [("line", args.line)]
    body = args.body or ""
    stone_path.write_text(_render_stone(keys, body), encoding="utf-8")
    st = _load_stone(stone_path, slug, live=True, cfg=cfg)

    cpath.parent.mkdir(parents=True, exist_ok=True)
    lines = cpath.read_text(encoding="utf-8").splitlines() if cpath.is_file() else _default_control_lines(slug, cfg)
    cf = SimpleNamespace(slug=slug, path=cpath, lines=lines)
    after = getattr(args, "after", None)
    where = "top"
    if after:
        # T654: mint straight into its group — below a label line, or below
        # another stone — instead of at the top and a move.
        try:
            ref = (_locate_stone(cf.lines, after, None, cfg, slug) if _looks_like_sid(after)
                   else _locate_label(cf.lines, after, cfg, slug))
        except StoneError:
            stone_path.unlink(missing_ok=True)   # nothing half-minted
            raise
        cf.lines.insert(ref + 1, render_stone_line(slug, sid, st.line, cfg, host=slug))
        where = f"below {after.strip()!r}"
    else:
        _add_to_own_top(cf, slug, sid, st, cfg)
    _ensure_leading_blank(cf.lines)
    cpath.write_text("\n".join(cf.lines) + "\n", encoding="utf-8")

    st.appears.add(slug)
    _write_stone(st)

    print(f"stone: minted {slug} {sid} in {folder.name}/, inserted into {cpath.name} ({where})")
    for w in _mint_warnings(cf, slug, sid, keys, cfg):
        print(f"  {w}")
    return 0


def _stone_run(lines: list, idx: int, cfg: dict, host: str | None = None) -> tuple:
    """(start, end) of the contiguous run of stone-lines containing `idx`.

    The run — not the file — is the unit a move may travel within. A control
    file groups imported stones under a header per source ([[R-stone]]-04), and
    "top of the file" would carry a stone across a header into someone else's
    group, which reads as a propagation bug rather than as a reorder. Bounding
    the move by the blank line or header that already separates the groups
    means the file's structure decides what `--to-top` means, and the caller
    cannot ask for something the format does not mean."""
    start = idx
    while start > 0 and classify_line(lines[start - 1], cfg, host)[0] == "stone":
        start -= 1
    end = idx
    while end + 1 < len(lines) and classify_line(lines[end + 1], cfg, host)[0] == "stone":
        end += 1
    return start, end


def _locate_stone(lines: list, sid: str, owner: str | None, cfg: dict,
                  host: str | None = None) -> int:
    """Index of the block line carrying `sid`, or raise naming what it found."""
    hits = [(i, cls[1]) for i, line in enumerate(lines)
            for cls in (classify_line(line, cfg, host),)
            if cls[0] == "stone" and cls[2] == sid
            and (owner is None or cls[1] == owner)]
    if len(hits) == 1:
        return hits[0][0]
    if not hits:
        # An inline header holds its stones inside one line, so a stone that is
        # present but not on a line of its own must say so rather than read as
        # absent — the two need different fixes and only one is a typo.
        for i, line in enumerate(lines):
            cls = classify_line(line, cfg, host)
            if cls[0] != "header":
                continue
            _head, payload = _header_payload(line, cls[2])
            for chunk in _split_inline(payload or ""):
                sub = classify_stone_chunk(chunk, cfg, host)
                if sub and sub[1] == sid and (owner is None or sub[0] == owner):
                    raise StoneError(
                        f"stone: {sid} sits inside the inline header on line "
                        f"{i + 1}, not on a line of its own — reorder that "
                        f"header's comma list by hand, or split it to the "
                        f"block form first")
        raise StoneError(f"stone: no line in this control file names {sid}")
    owners = ", ".join(sorted({o for _i, o in hits}))
    raise StoneError(
        f"stone: {sid} appears {len(hits)} times in this control file "
        f"(owners: {owners}) — name the owner with `--owner <SLUG>`")


def cmd_move(kind, root: Path, args) -> int:
    """Reorder one stone's line within its own run in a control file (T602).

    `pebble new` always mints at the top and `pebble update` reconciles feeds
    rather than moving rows, so a stone that belongs *behind* existing work had
    no route but hand-editing a machine-maintained file — which is the one
    thing this tool exists to prevent. Hit live on `AUP Pebble.md` 2026-08-28.
    """
    anchors, ambiguous = discover_anchors(root)
    slug = args.anchor
    if slug in ambiguous:
        raise _ambiguous_error(slug, ambiguous[slug], "it is the move target")
    if slug not in anchors:
        raise StoneError(f"no anchor {slug!r} (.anchor) found under {root}")

    cfg, kind = _effective_cfg(anchors[slug].path, slug, kind, load_types())
    cpath = _control_path(anchors[slug].path, slug, cfg)
    if not cpath.is_file():
        raise StoneError(f"stone: {cpath} does not exist — nothing to reorder")
    lines = cpath.read_text(encoding="utf-8").splitlines()

    if getattr(args, "dest", None):
        return _relocate(anchors, ambiguous, root, slug, kind, cfg, cpath, lines, args)
    if not _has_placement(args):
        raise StoneError("stone move: name a place — --after ID | --before ID | "
                         "--to-top | --to-bottom (or --dest <list> to relocate)")

    moved = _reorder(lines, args.stone, args.owner, cfg, slug, args, cpath)
    if moved is None:
        print(f"stone: {args.stone} is already there — {cpath.name} unchanged")
        return 0
    src, dest = moved
    _ensure_leading_blank(lines)
    cpath.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"stone: moved {args.stone} from line {src + 1} to line {dest + 1} "
          f"in {cpath.name}")
    return 0


def _has_placement(args) -> bool:
    return bool(getattr(args, "after", None) or getattr(args, "before", None)
                or getattr(args, "to_top", False) or getattr(args, "to_bottom", False))


def _looks_like_sid(ref: str) -> bool:
    """An id (`P0013`, `R0002`, or a dated `YYYY-MM-DD Title`) versus a label's text."""
    ref = ref.strip()
    return bool(re.fullmatch(r"[A-Z]+\d+", ref) or _DATED_RE.match(ref))


def _locate_label(lines: list, text: str, cfg: dict, host: str | None) -> int:
    """Index of the ONE non-stone, non-header line whose trimmed text equals
    `text` (T654 — Dan's group labels, `CYCLE 27:`). Zero or several matches
    refuse, listing what the file does offer."""
    want = text.strip()
    hits = [i for i, l in enumerate(lines)
            if l.strip() == want and classify_line(l, cfg, host)[0] == "other"]
    if len(hits) == 1:
        return hits[0]
    labels = [l.strip() for l in lines
              if l.strip() and classify_line(l, cfg, host)[0] == "other"
              and not l.lstrip().startswith(("---", "description:"))]
    if not hits:
        raise StoneError(
            f"stone: no line reads exactly {want!r} — labels in this file: "
            + (", ".join(repr(x) for x in labels[:8]) or "none"))
    raise StoneError(f"stone: {want!r} appears {len(hits)} times (lines "
                     f"{', '.join(str(i + 1) for i in hits)}) — make the label unique first")


def _reorder(lines: list, sid: str, owner, cfg: dict, host: str, args, cpath: Path):
    """Move `sid`'s line within its run per the placement flags, in place.
    Returns (src, dest) or None when it is already there."""
    src = _locate_stone(lines, sid, owner, cfg, host)
    start, end = _stone_run(lines, src, cfg, host)

    ref_id = args.after or args.before
    if args.to_top:
        dest = start
    elif args.to_bottom:
        dest = end
    elif ref_id and not _looks_like_sid(ref_id):
        # T654: a LABEL line. Crossing the run boundary is the point — a
        # named label is a deliberate act, unlike the accidental slide under
        # an import header the same-run rule guards against.
        ref = _locate_label(lines, ref_id, cfg, host)
        ref_after_pop = ref - 1 if ref > src else ref
        dest = ref_after_pop + 1 if args.after else ref_after_pop
    else:
        ref = _locate_stone(lines, ref_id, None, cfg, host)
        if not (start <= ref <= end):
            raise StoneError(
                f"stone: {sid} and {ref_id} are not in the same run of "
                f"lines (lines {src + 1} and {ref + 1}) — a move never crosses "
                f"a header or a blank line, because that would change which "
                f"source a stone is filed under, not merely its rank")
        if ref == src:
            raise StoneError(f"stone: {sid} cannot be placed relative to itself")
        # `dest` indexes the list AFTER the line is popped, so a reference
        # below the mover shifts up by one first.
        ref_after_pop = ref - 1 if ref > src else ref
        dest = ref_after_pop + 1 if args.after else ref_after_pop

    if dest == src:
        return None
    before = _find_all_stone_occurrences(lines, cfg, host)
    line = lines.pop(src)
    lines.insert(dest, line)
    after = _find_all_stone_occurrences(lines, cfg, host)
    # A reorder that loses or duplicates a stone is a corruption of a
    # machine-maintained file, and the next `update` would propagate it. Cheap
    # to assert, and the only assertion that catches an off-by-one here.
    if before != after:
        raise StoneError(
            f"stone: refusing to write — the reorder changed which stones the "
            f"file names ({len(before)} -> {len(after)}). This is a bug in "
            f"`stone move`; {cpath} is untouched")
    return src, dest


def _withdraw_all(anchors, ambiguous, root, owner, sid, st, kind, force: bool, verb: str):
    """A stone placed on other lists cannot leave home quietly: refuse, or with
    --force recall every appearance first (the receiver agreed to a stone
    with THIS home)."""
    if not st.enrolled:
        return []
    if not force:
        raise StoneError(
            f"stone {verb}: {owner} {sid} is shared with "
            f"{', '.join(sorted(st.enrolled))} — `stone share {owner} {sid} "
            f"--recall <list>` first, or --force to withdraw every appearance")
    done = []
    for tgt in sorted(st.enrolled):
        cmd_recall(kind, root, SimpleNamespace(anchor=owner, stone=sid, from_=tgt, root=str(root)))
        done.append(tgt)
    return done


def _relocate(anchors, ambiguous, root: Path, owner: str, kind, cfg: dict,
              cpath: Path, lines: list, args) -> int:
    """`stone move <list> <id> --dest <list>` (T653): a NEW number on the
    target list, the file moved by `anchor update` so every link follows, the
    old name recorded in the source list's month file (T655 — the `next:`
    counter keeps the number retired), and the placement flags applied on
    arrival (default: top)."""
    sid = args.stone
    if args.owner and args.owner != owner:
        raise StoneError(
            f"stone move --dest relocates a stone from its HOME list; {sid} is "
            f"{args.owner}'s, so address {args.owner}'s list, not {owner}'s")
    dslug, dlist = parse_address(args.dest)
    if dslug in ambiguous:
        raise _ambiguous_error(dslug, ambiguous[dslug], "it is the --dest")
    if dslug not in anchors:
        raise StoneError(f"no anchor {dslug!r} (.anchor) found under {root}")
    dcfg, dlist = _effective_cfg(anchors[dslug].path, dslug, dlist, load_types())
    if _dated(cfg) or _dated(dcfg):
        raise StoneError("stone move --dest: a dated list's members are named, not "
                         "numbered — relocating to or from one is not supported")
    folder = _stone_folder(anchors[owner].path, owner, cfg)
    src = folder / _stone_filename(owner, sid, cfg)
    if not src.is_file():
        archived = _is_archived(folder, owner, sid)
        raise StoneError(f"no live stone {owner} {sid}" + (" — it is archived" if archived else ""))
    dfolder = _stone_folder(anchors[dslug].path, dslug, dcfg)
    if dfolder.resolve() == folder.resolve():
        raise StoneError(f"stone move: {sid} already lives on {args.dest} — use the "
                         f"placement flags alone to reorder it")
    anchor_bin = shutil.which("anchor")
    if not anchor_bin:
        raise StoneError("stone move --dest needs the `anchor` command on PATH to move "
                         "the file and rewrite its links — none found; nothing was written")
    st = _load_stone(src, owner, live=True, cfg=cfg)
    withdrawn = _withdraw_all(anchors, ambiguous, root, owner, sid, st, kind,
                              getattr(args, "force", False), "move")

    # 1. the source list forgets it
    cf = SimpleNamespace(slug=owner, path=cpath, lines=lines)
    remove_stones(cf, {(owner, sid)}, cfg)
    _ensure_leading_blank(cf.lines)
    cpath.write_text("\n".join(cf.lines) + "\n", encoding="utf-8")

    # 2. new number on the target, file moved with its links
    dfolder.mkdir(parents=True, exist_ok=True)
    dcpath = _control_path(anchors[dslug].path, dslug, dcfg)
    new_sid = _next_sid(dcpath, dfolder, dslug, dcfg)
    dst = dfolder / _stone_filename(dslug, new_sid, dcfg)
    import subprocess
    r = subprocess.run([anchor_bin, "update", str(src), str(dst), "--root", str(root)],
                       capture_output=True, text=True)
    if r.returncode != 0 or not dst.is_file():
        raise StoneError(f"anchor update failed moving {src.name} -> {dst.name}: "
                         f"{(r.stderr or r.stdout).strip()[-300:]}")
    links = next((l for l in r.stdout.splitlines() if l.startswith("rewrote")), "").strip()

    # 3. the old name goes on record in the source list's month file
    today = _dt.date.today().isoformat()
    src_label = _list_label(anchors[owner].path, owner, kind)
    mpath = _archive_append(folder, src_label, src.stem,
                            _archive_keys(st.keys, st.line, [("moved", f"{today} → [[{dst.stem}]]")]),
                            st.body)

    # 4. the target list takes it, placed as asked (default: top)
    st2 = _load_stone(dst, dslug, live=True, cfg=dcfg)
    st2.appears = {dslug}
    st2.enrolled = set()
    _write_stone(st2)
    dlines = _control_lines(dcpath, dslug, dcfg)
    dcf = SimpleNamespace(slug=dslug, path=dcpath, lines=dlines)
    _add_to_own_top(dcf, dslug, new_sid, st2, dcfg)
    placed = "top"
    if _has_placement(args):
        moved = _reorder(dcf.lines, new_sid, dslug, dcfg, dslug, args, dcpath)
        placed = f"line {moved[1] + 1}" if moved else "top"
    _ensure_leading_blank(dcf.lines)
    dcpath.parent.mkdir(parents=True, exist_ok=True)
    dcpath.write_text("\n".join(dcf.lines) + "\n", encoding="utf-8")

    print(f"stone: moved {owner} {sid} -> {dslug} {new_sid} ({dcpath.name}, {placed}); "
          f"{links or 'links rewritten'}; recorded in archive/{mpath.name}"
          + (f"; withdrawn from {', '.join(withdrawn)}" if withdrawn else ""))
    print("  run `stone update` to sweep projections of the old name")
    return 0


def cmd_archive(kind, root: Path, args) -> int:
    """`stone archive <list> <id>` (T653): the drain that existed only as
    *delete the line from its own control file, then update* — one command,
    refusing on a shared stone unless --force."""
    anchors, ambiguous = discover_anchors(root)
    slug = args.anchor
    if slug in ambiguous:
        raise _ambiguous_error(slug, ambiguous[slug], "it owns the stone")
    if slug not in anchors:
        raise StoneError(f"no anchor {slug!r} (.anchor) found under {root}")
    cfg, kind = _effective_cfg(anchors[slug].path, slug, kind, load_types())
    folder = _stone_folder(anchors[slug].path, slug, cfg)
    label = _list_label(anchors[slug].path, slug, kind)
    if getattr(args, "convert", False):
        return _archive_convert(folder, slug, label, cfg)
    if not args.stone:
        raise StoneError("stone archive <list> <id> — an <id> is required (or --convert)")
    spath = folder / _stone_filename(slug, args.stone, cfg)
    if not spath.is_file():
        archived = _is_archived(folder, slug, args.stone)
        raise StoneError(f"no live stone {slug} {args.stone}"
                         + (" — it is already archived" if archived else ""))
    st = _load_stone(spath, slug, live=True, cfg=cfg)
    st.archive_label = label
    withdrawn = _withdraw_all(anchors, ambiguous, root, slug, args.stone, st, kind,
                              getattr(args, "force", False), "archive")
    cpath = _control_path(anchors[slug].path, slug, cfg)
    if cpath.is_file():
        cf = SimpleNamespace(slug=slug, path=cpath, lines=cpath.read_text(encoding="utf-8").splitlines())
        remove_stones(cf, {(slug, args.stone)}, cfg)
        _ensure_leading_blank(cf.lines)
        cpath.write_text("\n".join(cf.lines) + "\n", encoding="utf-8")
    _archive_stone(st)
    print(f"stone: archived {slug} {args.stone} -> {folder.name}/archive/{st.archived_to.name}"
          + (f"; withdrawn from {', '.join(withdrawn)}" if withdrawn else ""))
    print("  run `stone update` to sweep its projections")
    return 0


def _archive_convert(folder: Path, slug: str, label: str, cfg: dict) -> int:
    """`stone archive <list> --convert` (T655, one-shot): fold the pre-T655
    one-file-per-stone archive into month files, each by its file's mtime,
    then delete the files. Idempotent — nothing left to fold is a clean zero."""
    archive_dir = folder / "archive"
    files = sorted(_stone_files(archive_dir, slug, cfg)) if archive_dir.is_dir() else []
    months = {}
    for f in files:
        when = _dt.date.fromtimestamp(f.stat().st_mtime)
        keys, body = _parse_stone(f.read_text(encoding="utf-8"))
        line = (_kv_get(keys, "line", "") or "").strip()
        extra = [] if _kv_get(keys, "moved") is not None else [("retired", when.isoformat())]
        mpath = _archive_append(folder, label, f.stem, _archive_keys(keys, line, extra),
                                body, month=when.strftime("%Y-%m"))
        f.unlink()
        months[mpath.name] = months.get(mpath.name, 0) + 1
    if not files:
        print(f"stone: {label}: nothing to convert in {folder.name}/archive/")
        return 0
    for name, n in sorted(months.items()):
        print(f"stone: {label}: {n} archived stone(s) -> archive/{name}")
    return 0


def cmd_update(kind, root: Path, args) -> int:
    """The reconciliation walk. `kind` None (bare `stone update`) is the
    UNIFIED list-level pass over every declared list (F628 step 3); a kind
    name is the legacy restricted walk — one kind-table type, byte-compatible
    with the pre-F628 behavior, retiring with the kind table at step 4."""
    cfg_all = load_types()
    unified = kind is None
    if not unified and kind not in cfg_all:
        raise StoneError(
            f"unknown kind {kind!r} — the legacy walk takes a kind-table "
            f"kind; bare `stone update` walks every declared list")
    anchors, ambiguous = discover_anchors(root)
    if not anchors:
        raise StoneError(f"no anchors (.anchor) found under {root}")
    for pk in (list(cfg_all) if unified else [kind]):
        _reject_ambiguous_use(anchors, ambiguous, cfg_all[pk])

    nodes = _build_nodes(anchors, cfg_all, None if unified else [kind])
    gram = Gram(nodes, restricted=not unified)

    stones: dict = {}
    control: dict = {}
    seen_paths: dict = {}
    for key in sorted(nodes):
        nd = nodes[key]
        slug = key[0]
        if nd.folder.is_dir():
            for f in sorted(_stone_files(nd.folder, slug, nd.cfg)):
                st = _load_stone(f, slug, live=True, cfg=nd.cfg)
                prev = stones.get((slug, st.sid))
                if prev is not None and prev.live and prev.home != key:
                    raise StoneError(
                        f"two lists both hold a stone named {slug} {st.sid}: "
                        f"{prev.path} and {f} — give one list a different prefix")
                st.home, st.home_cfg = key, nd.cfg
                st.archive_label = _list_label(anchors[slug].path, slug, key[1])
                stones[(slug, st.sid)] = st
            # T655 — archive/ is written, never read: a month file is not a
            # stone, and a stone whose file is gone is simply not live.
        prev_key = seen_paths.get(nd.cpath)
        if prev_key is not None:
            raise StoneError(
                f"lists {gram.label(prev_key)} and {gram.label(key)} resolve "
                f"to the same control file {nd.cpath} — fix the registry")
        seen_paths[nd.cpath] = key
        exists = nd.cpath.is_file()
        lines = nd.cpath.read_text(encoding="utf-8").splitlines() if exists else []
        control[key] = SimpleNamespace(key=key, slug=slug, path=nd.cpath,
                                       lines=lines, exists=exists)

    # Edges. Anchor-level `feeds:` is the TRANSITION grammar — each
    # same-named list projects the edge, exactly today's "every kind projects
    # the same DAG". Per-list `feeds:` from the registry (F628 Q4): a dotted
    # target names the list, a bare anchor names its DEFAULT list. A missing
    # anchor is a dangling edge — named, skipped, non-zero exit, nothing else
    # taken down (T599). In the restricted walk a per-list target outside
    # this kind is simply not this pass's business.
    dangling: list = []
    for slug, a in sorted(anchors.items()):
        for src in a.feeds:
            if src not in anchors:
                dangling.append((slug, src))
    edges = {key: [] for key in nodes}
    for key in sorted(nodes):
        slug, name = key
        for src in anchors[slug].feeds:
            if (src, name) in nodes:
                edges[key].append((src, name))
        for tgt in (nodes[key].cfg.get("feeds") or []):
            tgt = str(tgt)
            a_slug, l_name = parse_address(tgt)
            if a_slug not in anchors:
                dangling.append((gram.label(key), tgt))
                continue
            if l_name is None:
                l_name = _default_list_name(anchors[a_slug].path)
            if (a_slug, l_name) not in nodes:
                if unified:
                    dangling.append((gram.label(key), tgt))
                continue
            edges[key].append((a_slug, l_name))
    for key in edges:
        edges[key] = sorted(set(edges[key]))

    # The DAG is checked FIRST: a cycle makes "which value is downstream"
    # meaningless, so a structural error outranks a content conflict.
    order = _topo_nodes(nodes, edges, gram.label)

    stats = {"archived": 0}
    readback_notes: list = []
    collisions = readback(stones, control, gram, stats, readback_notes)
    # Collisions no longer abort (T642, Dan 2026-09-02, superseding F312 Q6 =
    # C): readback has already concatenated each one into a single visible
    # line, and the pass writes it out like any other edit. The report below
    # still names every stone and value, on stderr, so the log carries it.
    for owner, sid, edits in sorted(collisions):
        print(f"stone: conflict on {owner}:{sid} — {len(set(t for _s, t in edits))} "
              f"different values concatenated into one line; edit any copy to clean it",
              file=sys.stderr)

    resync(stones, control, gram)

    published: dict = {}
    dry = getattr(args, "dry_run", False)
    for key in order:
        reconcile_own(key, stones, control, gram, stats, dry=dry)
        propagate_in(key, edges, stones, control, published, gram)
        published[key] = compute_published(key, control[key], stones, gram)

    n_files = 0
    for cf in control.values():
        _ensure_leading_blank(cf.lines)
        original = cf.path.read_text(encoding="utf-8") if cf.exists else None
        new_text = "\n".join(cf.lines) + ("\n" if cf.lines else "")
        if new_text != (original or ""):
            if not dry:
                cf.path.parent.mkdir(parents=True, exist_ok=True)
                cf.path.write_text(new_text, encoding="utf-8")
            else:
                print(f"  would write {cf.path}")
            n_files += 1

    # T574 — the merged per-node list, written by the same pass that wrote the
    # control files above, so it cannot be the command someone forgets.
    # A node opts in by HAVING the file: an existing `{slug} Stones.md` is
    # kept current, one that does not exist is never created.
    n_merged = 0
    by_anchor: dict = {}
    for key, cf in control.items():
        by_anchor.setdefault(key[0], {})[key[1]] = cf.lines
    for slug, live_map in sorted(by_anchor.items()):
        mpath = _merged_path(anchors[slug].path, slug)
        if not mpath.is_file():
            continue
        body = _merged_body(anchors[slug].path, slug, cfg_all, live_map)
        if body is None or body == mpath.read_text(encoding="utf-8"):
            continue
        if not dry:
            mpath.write_text(body, encoding="utf-8")
        else:
            print(f"  would write {mpath}")
        n_merged += 1

    n_stones = 0
    for st in stones.values():
        if st.orig_live and not st.live:
            continue   # archived this pass — its file is gone, its section written
        if st.live != st.orig_live or st.line != st.orig_line or set(st.appears) != st.orig_appears:
            if not dry:
                _write_stone(st)
            else:
                print(f"  would write {st.path}")
            n_stones += 1

    # F312 Inv. "no silent empty" — a pass always says what it did, even zero.
    skipped = f", {len(ambiguous)} ambiguous slug(s) skipped: {', '.join(sorted(ambiguous))}" if ambiguous else ""
    verb = "would be written" if dry else "written"
    arch = "would be archived" if dry else "archived"
    replaced = stats.get("replaced", 0)
    kept = stats.get("kept_stone", 0)
    loss = ""
    if replaced or kept:
        loss = (f", {replaced} line(s) replaced from a newer projection"
                f", {kept} kept against an older one")
    if stats.get("concatenated"):
        loss += f", {stats['concatenated']} conflict(s) concatenated"
    what = "update" if unified else f"{kind} update"
    lists = f", {len(nodes)} list(s)" if unified else ""
    print(
        f"stone: {what}{' — DRY RUN, nothing changed' if dry else ''} — "
        f"{n_files} control file(s) {verb}, "
        f"{n_merged} merged list(s) {verb}, "
        f"{n_stones} stone file(s) {verb} ({stats['archived']} {arch}){loss}, "
        f"across {len(anchors)} anchor(s){lists}{skipped}"
    )
    for n in readback_notes:
        print(f"  {n}")
    for w in _enrollment_warnings(anchors, stones):
        print(f"stone: warning: {w}", file=sys.stderr)
    for (owner, sid), st_ in sorted(stones.items()):
        if not st_.live:
            continue
        over = _over_budget(owner, st_.line, st_.home_cfg)
        if over:
            print(f"stone: warning: {owner} {sid} renders as {over[0]} characters, "
                  f"budget {over[1]} — it wraps; shorten its line:: (detail goes "
                  f"in the body)", file=sys.stderr)
    for who, src in sorted(set(dangling)):
        print(f"stone: warning: {who}: feeds: names {src!r}, no such anchor "
              f"under the scanned root — edge skipped, nothing propagated "
              f"from it", file=sys.stderr)
    if dangling:
        print(f"stone: {len(set(dangling))} dangling feeds edge(s) skipped — "
              f"drop or correct the slug in the .anchor named above",
              file=sys.stderr)
        return 1
    return 0


# --------------------------------------------------------------------------
# Placement — push / recall (T626)
#
# `feeds:` is AGGREGATION: this list is the sum of those lists, total and
# implicit. Placement is ENROLLMENT: this one stone is also on that list, by
# one deliberate act, with a receipt. Dan rejected the alternative — a
# predicate on feeds: (`feeds: SONAR where due`) — because it fails silently:
# "now Sonar can think that she alerted Sparks, but she didn't, because she
# didn't get it right. It didn't parse right. It didn't go through." An
# omission is visible to the agent committing it; a parse failure is visible
# to nobody until the deadline passes. So the act is explicit, the refusal is
# at the act, and `update` flags the stone that carries a clock and was pushed
# to nobody.

# The key whose presence means "this stone has a clock" — the shape that
# needs a watcher (T626: "ordinary pebbles have priority but no timing; the
# due:: is the whole difference").
TIMED_KEY = "due"


def _resolve_pair(anchors: dict, ambiguous: dict, cfg: dict, owner: str, sid: str,
                  target: str, role: str):
    """(owner anchor, stone, target anchor) for a push/recall, or raise."""
    for slug, why in ((owner, "it owns the stone"), (target, f"it is the {role}")):
        if slug in ambiguous:
            raise _ambiguous_error(slug, ambiguous[slug], why)
        if slug not in anchors:
            raise StoneError(f"no anchor {slug!r} (.anchor) found under the scanned root")
    if owner == target:
        raise StoneError(
            f"{owner} {sid} already lives on {owner}'s own list — share places "
            f"a stone on SOMEONE ELSE's list")
    a = anchors[owner]
    folder = _stone_folder(a.path, owner, cfg)
    spath = folder / _stone_filename(owner, sid, cfg)
    if not spath.is_file():
        archived = _is_archived(folder, owner, sid)
        raise StoneError(
            f"no live stone {owner} {sid}" + (" — it is archived" if archived else "")
            + f" (looked in {folder})")
    st = _load_stone(spath, owner, live=True, cfg=cfg)
    return a, st, anchors[target]


def _control_lines(cpath: Path, slug: str, cfg: dict) -> list:
    return (cpath.read_text(encoding="utf-8").splitlines() if cpath.is_file()
            else _default_control_lines(slug, cfg))


def _push_pair_cfgs(anchors: dict, ambiguous: dict, kind, owner: str, target: str,
                    target_list=None):
    """(owner cfg, resolved list name, target placement cfg) for share.

    The owner side resolves fully (registry grammar + placement). The target
    receives on the list NAMED by the address (`Lumen.rocks`, T653) or, bare,
    on its list of the owner's type — with the owner's grammar (the stone's
    lines are the owner's kind) and only the target registry's PLACEMENT for
    that list honored."""
    cfg_all = load_types()
    for s, why in ((owner, "it owns the stone"), (target, "it is the other end")):
        if s in ambiguous:
            raise _ambiguous_error(s, ambiguous[s], why)
        if s not in anchors:
            raise StoneError(f"no anchor {s!r} (.anchor) found under the scanned root")
    cfg, kind = _effective_cfg(anchors[owner].path, owner, kind, cfg_all)
    if target_list and target_list != kind:
        # A NAMED target list (T653) is placed by its own config — its folder,
        # its control file — while the stone's lines keep the owner's grammar.
        tgt_cfg, _ = _effective_cfg(anchors[target].path, target, target_list, cfg_all)
    else:
        tgt_cfg, _ = _effective_cfg(anchors[target].path, target, kind, cfg_all,
                                    paths_only_base=cfg)
    return cfg, kind, tgt_cfg


def _enrolled_key(target: str, target_list, kind: str) -> str:
    """What `enrolled::` records: the bare slug when the stone lands on the
    target's list of its own type (the T626 form), else `Slug.list`."""
    return target if (target_list is None or target_list == kind) else f"{target}.{target_list}"


def cmd_push(kind, root: Path, args) -> int:
    anchors, ambiguous = discover_anchors(root)
    owner, sid = args.anchor, args.stone
    target, tlist = parse_address(args.to)
    cfg, kind, tgt_cfg = _push_pair_cfgs(anchors, ambiguous, kind, owner, target, tlist)
    ekey = _enrolled_key(target, tlist, kind)
    _a, st, tgt = _resolve_pair(anchors, ambiguous, cfg, owner, sid, target, "share target")

    # Validation at the moment of the act — the receiver's contract, checked
    # where the agent that wrote the stone can still fix it.
    missing = [k for k in tgt.accepts if not (_kv_get(st.keys, k, "") or "").strip()]
    if missing:
        raise StoneError(
            f"refused: {owner} {sid} has no " + ", ".join(f"`{k}::`" for k in missing)
            + f" -- {target} accepts only a stone that says "
            + " and ".join(f"`{k}::`" for k in tgt.accepts)
            + f" (its .anchor: `accepts: {', '.join(tgt.accepts)}`). Add it to "
            f"{st.path.name} and push again. Nothing was written.")

    cpath = _control_path(tgt.path, target, tgt_cfg)
    lines = _control_lines(cpath, target, cfg)
    cf = SimpleNamespace(slug=target, path=cpath, lines=lines)
    present = (owner, sid) in _find_all_stone_occurrences(lines, cfg, target)
    already = ekey in st.enrolled
    if already and present:
        print(f"stone: {owner} {sid} is already enrolled with {ekey} — "
              f"{cpath.name} unchanged")
        return 0
    if not present:
        _add_downstream(cf, owner, [(owner, sid)], {(owner, sid): st}, cfg)
        _ensure_leading_blank(cf.lines)
        cpath.parent.mkdir(parents=True, exist_ok=True)
        cpath.write_text("\n".join(cf.lines) + "\n", encoding="utf-8")
    st.enrolled.add(ekey)
    st.appears.add(target)
    _write_stone(st)

    # The receipt says what happened, not that it happened.
    shown = [k for k in tgt.accepts] or [k for k in (TIMED_KEY, "tempo")
                                          if (_kv_get(st.keys, k, "") or "").strip()]
    detail = ", ".join(f"{k}:: {_kv_get(st.keys, k, '')}" for k in shown)
    print(f"{owner} {sid} -> {cpath.stem}   ({detail or 'no keys required by ' + target})"
          + ("" if not present else "   [line was already there via feeds:; enrollment recorded]"))
    return 0


def cmd_recall(kind, root: Path, args) -> int:
    anchors, ambiguous = discover_anchors(root)
    owner, sid = args.anchor, args.stone
    target, tlist = parse_address(getattr(args, "from_"))
    cfg, kind, tgt_cfg = _push_pair_cfgs(anchors, ambiguous, kind, owner, target, tlist)
    ekey = _enrolled_key(target, tlist, kind)
    _a, st, tgt = _resolve_pair(anchors, ambiguous, cfg, owner, sid, target, "recall source")
    if ekey not in st.enrolled:
        raise StoneError(
            f"{owner} {sid} is not enrolled with {ekey} (enrolled:: "
            f"{', '.join(sorted(st.enrolled)) or 'nobody'}) — nothing to recall")
    cpath = _control_path(tgt.path, target, tgt_cfg)
    outcome = "no line to remove"
    if cpath.is_file():
        lines = cpath.read_text(encoding="utf-8").splitlines()
        cf = SimpleNamespace(slug=target, path=cpath, lines=lines)
        if (owner, sid) in _find_all_stone_occurrences(lines, cfg, target):
            # Only when the line is there by enrollment alone: a copy that
            # feeds: would put straight back stays, and the receipt says so.
            if target in _fed_targets(anchors, owner):
                outcome = "enrollment withdrawn; the line stays because feeds: also carries it"
            else:
                remove_stones(cf, {(owner, sid)}, cfg)
                cpath.write_text("\n".join(cf.lines) + "\n", encoding="utf-8")
                st.appears.discard(target)
                outcome = "line removed"
    st.enrolled.discard(ekey)
    _write_stone(st)
    print(f"{owner} {sid} <- {cpath.stem}   {outcome}")
    return 0


def _fed_targets(anchors: dict, owner: str) -> set:
    """Every anchor that draws from `owner` by feeds:, transitively."""
    out, frontier = set(), [owner]
    while frontier:
        n = frontier.pop()
        for a in anchors.values():
            if n in a.feeds and a.slug not in out:
                out.add(a.slug)
                frontier.append(a.slug)
    return out


def _enrollment_warnings(anchors: dict, stones: dict) -> list:
    """The forgotten push, caught by sweep (T626 part 3): a live stone that
    carries a clock and was placed with nobody; and a placement whose target
    no longer exists. Warnings, not failures — an owner may watch its own
    clock — but a pass that stays quiet here is the silent-success shape the
    whole feature exists to close."""
    out = []
    for (owner, sid), st in sorted(stones.items()):
        if not st.live:
            continue
        if (_kv_get(st.keys, TIMED_KEY, "") or "").strip() and not st.enrolled:
            out.append(
                f"{owner} {sid} carries `{TIMED_KEY}:: {_kv_get(st.keys, TIMED_KEY)}` "
                f"and is enrolled with nobody — a clock nobody is watching. "
                f"`stone share {owner} {sid} --with <list>` if it needs one.")
        for tgt in sorted(st.enrolled):
            if parse_address(tgt)[0] not in anchors:
                out.append(f"{owner} {sid} is enrolled with {tgt!r}, which is not an "
                           f"anchor under the scanned root — recall it or fix the slug")
    return out


# --------------------------------------------------------------------------
# CLI

def build_parser(cfg_all: dict) -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="stone",
        description=(
            "stone <kind> <verb> — mint and propagate pebbles/rocks (TINK "
            "F313). Kinds are config-declared, not hard-coded; `stone "
            "<kind> --help` lists its verbs."
        ),
    )
    kind_subs = p.add_subparsers(dest="kind", required=True)
    for kind_name in cfg_all:
        ks = kind_subs.add_parser(kind_name, help=f"{kind_name} stones")
        verb_subs = ks.add_subparsers(dest="verb", required=True)

        nw = verb_subs.add_parser("new", help="mint a new stone, top of its own control file")
        nw.add_argument("anchor", help="owning anchor's slug")
        nw.add_argument("--line", required=True, help="the stone's line:: — the canonical one-line rendering")
        nw.add_argument("--body", default=None, help="prose body (optional)")
        nw.add_argument("--title", default=None,
                        help="dated kinds only: the member's title, appended to the date")
        nw.add_argument("--date", default=None,
                        help="dated kinds only: creation date YYYY-MM-DD (default: today)")
        nw.add_argument("--root", default=None, help=argparse.SUPPRESS)

        mv = verb_subs.add_parser("move", help="reorder one stone within its run in a control file")
        mv.add_argument("anchor", help="the anchor whose control file is being reordered")
        mv.add_argument("stone", help="the stone id to move, e.g. P0003")
        mv.add_argument("--owner", default=None,
                        help="disambiguate when two anchors' stones share an id")
        mv.add_argument("--root", default=None, help=argparse.SUPPRESS)
        where = mv.add_mutually_exclusive_group(required=True)
        where.add_argument("--after", metavar="ID", help="place it directly below this stone")
        where.add_argument("--before", metavar="ID", help="place it directly above this stone")
        where.add_argument("--to-top", action="store_true", help="first in its run")
        where.add_argument("--to-bottom", action="store_true", help="last in its run")

        ps = verb_subs.add_parser("push", help="place one stone on another anchor's list, with a receipt (T626)")
        ps.add_argument("anchor", help="the stone's OWNER slug")
        ps.add_argument("stone", help="the stone id, e.g. P0007")
        ps.add_argument("--to", required=True, metavar="SLUG", help="the anchor whose list receives it")
        ps.add_argument("--root", default=None, help=argparse.SUPPRESS)

        rc = verb_subs.add_parser("recall", help="take a pushed stone back off another anchor's list")
        rc.add_argument("anchor", help="the stone's OWNER slug")
        rc.add_argument("stone", help="the stone id, e.g. P0007")
        rc.add_argument("--from", dest="from_", required=True, metavar="SLUG", help="the anchor whose list it leaves")
        rc.add_argument("--root", default=None, help=argparse.SUPPRESS)

        up = verb_subs.add_parser("update", help="reconcile + propagate along feeds:")
        up.add_argument("--root", default=None, help=argparse.SUPPRESS)
        up.add_argument("--dry-run", action="store_true",
                        help="report every write and archive without performing any of them")
    return p


VERBS = ("new", "move", "share", "archive", "update")


def _resolve_root(args) -> Path:
    return (Path(args.root).expanduser().resolve()
            if getattr(args, "root", None) else DEFAULT_ROOT)


def build_addressed_parser(cfg_all: dict) -> argparse.ArgumentParser:
    """The verb-first form (F628): `stone <verb> <Anchor[.list]> ...`. The
    list is named by ADDRESS — bare `Anchor` is its dotless (default) list —
    so no kind positional exists here. The legacy `stone <kind> <verb>` form
    keeps working until the kind table retires (step 4)."""
    p = argparse.ArgumentParser(
        prog="stone",
        description=("stone <verb> <Anchor[.list]> — named stone lists "
                     "(F628). Bare `Anchor` addresses its default list; "
                     "`Anchor.rocks` a named one. The legacy `stone <kind> "
                     "<verb>` form also still works."))
    subs = p.add_subparsers(dest="verb", required=True)

    def root_arg(sp):
        # Kept for fixture tests only (T653: off the figure); the documented
        # way to point the script elsewhere is $ANCHOR_VAULT_ROOT.
        sp.add_argument("--root", default=None, help=argparse.SUPPRESS)

    nw = subs.add_parser("new", help="mint a new stone on the addressed list")
    nw.add_argument("address", help="Anchor or Anchor.list")
    nw.add_argument("--line", required=True,
                    help="the stone's line:: — the canonical one-line rendering")
    nw.add_argument("--body", default=None, help="prose body (optional)")
    nw.add_argument("--title", default=None,
                    help="dated lists only: the member's title, appended to the date")
    nw.add_argument("--date", default=None,
                    help="dated lists only: creation date YYYY-MM-DD (default: today)")
    nw.add_argument("--after", default=None, metavar="ID|LABEL",
                    help="insert below this stone id or this label line's exact text (default: top)")
    root_arg(nw)

    mv = subs.add_parser("move", help="reorder within its run, or --dest <list> to relocate")
    mv.add_argument("address", help="<list> — Slug or Slug.list — the stone's HOME list")
    mv.add_argument("stone", help="the stone id, e.g. P0003")
    mv.add_argument("--owner", default=None,
                    help="disambiguate when two anchors' stones share an id")
    mv.add_argument("--dest", default=None, metavar="LIST",
                    help="relocate to this list: new number there, links follow (anchor update), "
                         "old number retired by a tombstone in archive/; placement flags apply on arrival")
    mv.add_argument("--force", action="store_true",
                    help="with --dest: withdraw a shared stone's appearances first instead of refusing")
    root_arg(mv)
    where = mv.add_mutually_exclusive_group(required=False)
    where.add_argument("--after", metavar="ID|LABEL",
                       help="directly below this stone id, or below a label line given as its exact text")
    where.add_argument("--before", metavar="ID|LABEL",
                       help="directly above this stone id, or above a label line given as its exact text")
    where.add_argument("--to-top", action="store_true", help="first in its run")
    where.add_argument("--to-bottom", action="store_true", help="last in its run")

    sh = subs.add_parser("share", help="one stone, a second appearance on another list (was push/recall, T626)")
    sh.add_argument("address", help="<list> — the stone's HOME list")
    sh.add_argument("stone", help="the stone id, e.g. P0007")
    side = sh.add_mutually_exclusive_group(required=True)
    side.add_argument("--with", dest="with_", metavar="LIST",
                      help="the list that also shows it (Slug, or Slug.list); receipt printed")
    side.add_argument("--recall", metavar="LIST", help="stop appearing on this list")
    root_arg(sh)

    ar = subs.add_parser("archive", help="retire a stone into this month's archive file and drop its line")
    ar.add_argument("address", help="<list> — the stone's HOME list")
    ar.add_argument("stone", nargs="?", help="the stone id, e.g. P0007")
    ar.add_argument("--force", action="store_true",
                    help="withdraw a shared stone's appearances first instead of refusing")
    ar.add_argument("--convert", action="store_true",
                    help="one-shot: fold pre-T655 one-file-per-stone archive/*.md into month files")
    root_arg(ar)

    up = subs.add_parser("update",
                         help="reconcile every list + propagate along feeds:")
    root_arg(up)
    up.add_argument("--dry-run", action="store_true",
                    help="report every write and archive without performing any of them")
    return p


def _main_addressed(argv, cfg_all) -> int:
    args = build_addressed_parser(cfg_all).parse_args(argv[1:])
    root = _resolve_root(args)
    if args.verb == "update":
        return cmd_update(None, root, args)
    slug, list_name = parse_address(args.address)
    args.anchor = slug
    if args.verb == "share":
        if args.with_:
            args.to = args.with_
            return cmd_push(list_name, root, args)
        args.from_ = args.recall
        return cmd_recall(list_name, root, args)
    fn = {"new": cmd_new, "move": cmd_move, "archive": cmd_archive}[args.verb]
    return fn(list_name, root, args)


def main(argv) -> int:
    try:
        cfg_all = load_types()
        head = argv[1] if len(argv) > 1 else ""
        if head in VERBS:
            return _main_addressed(argv, cfg_all)
        parser = build_parser(cfg_all)
        args = parser.parse_args(argv[1:])
        root = _resolve_root(args)
        if args.verb == "new":
            return cmd_new(args.kind, root, args)
        if args.verb == "move":
            return cmd_move(args.kind, root, args)
        if args.verb == "push":
            return cmd_push(args.kind, root, args)
        if args.verb == "recall":
            return cmd_recall(args.kind, root, args)
        if args.verb == "update":
            return cmd_update(args.kind, root, args)
    except StoneError as e:
        print(str(e), file=sys.stderr)
        return 1

    print(f"stone: unknown verb {args.verb!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))

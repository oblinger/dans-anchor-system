#!/usr/bin/env python3
"""state — canonical state editor (F129, F236).

See `~/.claude/skills/workflow/DAS State.md` for the man-page-style reference
(synopsis, anchor resolution, subcommands, examples). Reuses all helpers from
backlog-edit.py via importlib.

One address scheme covers backlog rows and any doc's Open Questions /
Verifications:
    state [-a ANCHOR] <doc> <label> <verb> [--horizon H] [--status S] [--title T]
          [--next N] [--verify V] [--why-user W] [--choice X] [--reason R]
          [--body B | --from-file P] [< body]
        doc   = Backlog (case-insensitive) | wiki-name | path to a .md file
        label = LETTERS+DIGITS, or LETTERS+'+' to auto-mint —
                Q7 / V3 (any doc) / F157 / T8 (Backlog only) /
                F+ / T+ / Q+ / V+ (mint the next unused number) /
                T41.Q1 (a question hosted INSIDE Backlog row T41 —
                resolve and show only; T086)
        verb  = define (create-or-replace) | set (Backlog-only partial
                update — --status/--horizon/--title/--body/--next/--verify/
                --why-user) |
                resolve (move to Done/Resolved) | remove (soft-delete, audit
                trail preserved)

Plus the agent-inbox sender + drain writer (T131, design [[ATT045 - Agent
inbox pattern]]):
    state drop <anchor> "<message>" [--source S] [--tag T] [--topic H]
        Appends ONE pending entry to the target anchor's [[DAS Inbox]] file
        (`{prefix} Track/{prefix} Inbox.md`), creating it from the standard
        template on first drop. The entry carries NO status tag — that absence
        is what marks it pending; the drain writes `DONE` / `MOVED →`. Nothing
        is executed by dropping.
    state inbox-list <anchor> [--all]
        The drain's read half (leg 3, the `/inbox` skill): prints every
        PENDING entry's markdown verbatim. "Pending" is decided by the exact
        regexes `count_pending_inbox` counts against, imported not restated.
    state inbox-tag <anchor> --date D [--topic T] --tag TAG
        The drain's sanctioned writer (leg 3, the `/inbox` skill): marks one
        entry processed by appending `DONE` or `MOVED → {destination}` to its
        existing H2 line. `--tag` must be one of those two exact forms
        (R-fct-inbox-03); refuses if the entry already carries a tag.

Plus one repair verb for the row that has no address at all (T162):
    state mint-id <anchor> Backlog <T+|F+|T042> --match "<title substring>"
        Gives an EXISTING id-less Backlog row a row-id and a matching
        `^block-anchor`. Every other verb addresses a row by its bolded label,
        so a row whose bold span is prose is unbracketable, uncloseable and
        uncountable, and hand-typing an id is the backlog hand-edit every gate
        here forbids. This is that one operation, done through the sanctioned
        path.

Plus two standalone domains for planning state that lives outside the
Backlog/label model:
    state status set   [--anchor A] FACET CELL [--note TEXT]    # F130
    state status show  [--anchor A] [FACET]                     # F130
    state roadmap status get  [--anchor A] (--feature F<n> | --milestone M-<Name>[.<n>])    # F145
    state roadmap status set  [--anchor A] (--feature F<n> | --milestone M-<Name>[.<n>]) --state {checked|unchecked|deferred}  # F145
    state roadmap migrate     [--anchor A] M-<Name> --date YYYY-MM-DD     # F145
"""
from __future__ import annotations

import argparse
import importlib.util
import os
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

# --- Warden self-fire (fork 9 option A, 2026-07-13) -------------------------
# Script-written files bypass Warden's PostToolUse hook (agent tool calls
# only), so writer scripts report their own writes through the same dispatch
# path. Best-effort: Warden off/uninstalled means silence; never raises.
try:
    import importlib.util as _wsf_il
    _WSF_PATH = ((Path.home() / ".claude" / "skills").resolve().parent
                 / "warden" / "engine" / "warden_selffire.py")
    _wsf_spec = _wsf_il.spec_from_file_location("warden_selffire", _WSF_PATH)
    _warden_selffire = _wsf_il.module_from_spec(_wsf_spec)
    _wsf_spec.loader.exec_module(_warden_selffire)
except Exception:
    _warden_selffire = None


def _selffire(path):
    """Report a just-written markdown file to Warden (best-effort)."""
    if _warden_selffire is not None:
        _warden_selffire.fire_write(path)
# ---------------------------------------------------------------------------



# Load backlog-edit.py as a module so we can reuse its helpers.
_SCRIPT_DIR = Path(__file__).resolve().parent
_BE_PATH = _SCRIPT_DIR / "backlog-edit.py"
_spec = importlib.util.spec_from_file_location("backlog_edit", _BE_PATH)
if _spec is None or _spec.loader is None:
    print(f"state: cannot load {_BE_PATH}", file=sys.stderr)
    sys.exit(2)
be = importlib.util.module_from_spec(_spec)
sys.modules["backlog_edit"] = be
_spec.loader.exec_module(be)


# ============================================================
# Anchor resolution
# ============================================================


def resolve_anchor(anchor_arg):
    """Resolve the mandatory `<anchor>` positional to (slug, anchor_path).

    Two modes: a directory holding `.anchor`, or a slug looked up by the vault
    scan. Slug is the normal form; the path form exists for anchors not yet
    reachable by name.

    F293 deleted the third mode — walking cwd upward to the nearest `.anchor`
    whenever the anchor was omitted. `state` is a called tool, not a typed one,
    and an address whose meaning depends on where the caller happened to be
    standing is (Dan, 2026-08-01) *"a bug waiting to happen"*: the identical
    command writes to a different anchor from a different directory, and
    nothing in the output says which one it picked. Removing inference is also
    what lets the anchor be positional — a positional cannot be optional in
    the middle of other positionals, which is the whole reason it was a flag.

    Nothing here consults the working directory. A *relative path* argument
    still resolves against it, as any path argument does, but that is the
    caller naming a location rather than `state` guessing one.
    """
    # Mode 1: path
    p = Path(anchor_arg).expanduser()
    if p.is_dir() and (p / ".anchor").exists():
        p = p.resolve()
        return _slug_from_anchor_path(p), p
    # Mode 2: slug
    backlog = be.find_backlog(anchor_arg)
    if backlog is not None:
        anchor_path = backlog.parent.parent  # backlog is at {anchor}/{anchor} Track/
        return anchor_arg, anchor_path
    raise be.BacklogEditError(
        f"anchor {anchor_arg!r}: not a directory with .anchor, and no "
        f"'{anchor_arg} Backlog.md' found in vault"
    )


_ANCHOR_SLUG_RE = re.compile(r"^slug:\s*(\S+)\s*$")


def _slug_from_anchor_path(anchor_path):
    """Derive slug from the `.anchor` file's `slug:` line.

    The `.anchor` file is YAML-shaped; the first `slug:` line carries the
    canonical slug (e.g. `SKA`), which differs from the folder name
    (`Skill Agent`) for most anchors. Falls back to the folder name only
    when `.anchor` is missing or carries no `slug:` line.
    """
    anchor_file = anchor_path / ".anchor"
    if anchor_file.is_file():
        try:
            for line in anchor_file.read_text(encoding="utf-8").splitlines():
                m = _ANCHOR_SLUG_RE.match(line)
                if m:
                    return m.group(1)
        except OSError:
            pass
    return anchor_path.name


# ============================================================
# Body sourcing
# ============================================================


def read_body(args):
    """Get body from -m, --from-file, or stdin."""
    inline = getattr(args, "inline", None)
    from_file = getattr(args, "from_file", None)
    if inline is not None:
        return inline
    if from_file is not None:
        p = Path(from_file).expanduser()
        if not p.is_file():
            raise be.BacklogEditError(f"--from-file path not found: {p}")
        return p.read_text(encoding="utf-8")
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return ""


# ============================================================
# Slug support — extend Q-management
# ============================================================


_SLUG_TAG_RE = re.compile(r"\[slug:\s*([a-z0-9][a-z0-9_\-]*)\]")


def _slug_in_line(line):
    m = _SLUG_TAG_RE.search(line)
    return m.group(1) if m else None


def _find_q_bullet_by_slug(lines, slug):
    """Find a Q-bullet by its [slug: NAME] tag. Returns same shape as
    be._find_q_bullet: (start, end, indent) or None."""
    for i, line in enumerate(lines):
        m = be._Q_HEADER_BULLET_RE.match(line)
        if not m:
            continue
        # Confirm in Open Questions pending area
        section = be._section_at(lines, i)
        if section != "Open Questions:Pending":
            continue
        # Slug may be on the header line or in the body — gather full bullet first
        # to scan for the slug tag.
        indent = m.group(1)
        end = len(lines)
        for j in range(i + 1, len(lines)):
            l = lines[j]
            if l.startswith("#"):
                end = j
                break
            mh = be._Q_HEADER_BULLET_RE.match(l)
            if mh and (len(l) - len(l.lstrip())) <= len(indent):
                end = j
                break
        block = "\n".join(lines[i:end])
        if _slug_in_line(block) == slug:
            return (i, end, indent)
    return None


def _resolve_q_identifier(lines, q_num, slug):
    """Locate a Q by either q_num or slug. Returns (start, end, indent, q_num).
    Raises BacklogEditError on miss / ambiguity."""
    if q_num is not None and slug is not None:
        raise be.BacklogEditError("specify either -n N or --slug NAME, not both")
    if q_num is not None:
        loc = _find_pending_q(lines, q_num)
        if loc is None:
            raise be.BacklogEditError(f"Q{q_num} not found in pending Open Questions")
        s, e = loc
        return s, e, "", q_num
    if slug is not None:
        loc = _find_q_bullet_by_slug(lines, slug)
        if loc is None:
            raise be.BacklogEditError(f"Q with --slug {slug!r} not found in pending Open Questions")
        s, e, ind = loc
        m = be._Q_HEADER_BULLET_RE.match(lines[s])
        return s, e, ind, int(m.group(2))
    raise be.BacklogEditError("must specify either -n N or --slug NAME")


# ============================================================
# Row-edit delegation — shared by the Backlog item verbs
# ============================================================


_ARROW_POINTER_RE = re.compile(r"→\s+\[\[[^\]]+\]\]")


def _carry_doc_pointer(old_body, new_body):
    """T174 — `--body` is a whole-body REPLACEMENT, so a caller passing a
    completion write-up silently deleted the row's `→ [[doc]]` pointer, the only
    edge from the backlog row to its feature doc. Worse, the F102 check noticed
    the pointer was gone and responded by *skipping* the `## Status` block check
    — spending the one signal that could have caught it on excusing it.

    Carry a leading pointer across when the new body has none. Deliberately not
    a refusal: the overwhelmingly common case is a caller who wants to say more
    about the row, not one who wants to sever it from its doc. A caller who
    genuinely means to drop the pointer passes `--drop-pointer`.
    """
    if not old_body or not new_body:
        return new_body, None
    if _ARROW_POINTER_RE.search(new_body):
        return new_body, None
    m = _ARROW_POINTER_RE.search(old_body)
    if not m:
        return new_body, None
    pointer = m.group(0)
    return f"{pointer} · {new_body}", pointer


def _delegate_row_edit(slug, horizon, row_id_arg, status, title, body,
                       title_provided, body_provided,
                       verify_text=None, next_text=None, pending_subs=None,
                       why_user=None, user_text=None, why_user_action=None,
                       drop_pointer=False):
    """Delegate to backlog-edit's perform_edit machinery, mirroring its main()."""
    if status != "delete" and status != "same":
        # Validate status bracket against the closed canonical set.
        be.validate_status(status)
        # Validate horizon
        if horizon != "same":
            horizon_check = horizon.lstrip("# ").strip()
            if horizon_check not in be.VALID_HORIZONS:
                raise be.BacklogEditError(
                    f"invalid horizon '{horizon}' "
                    f"(expected one of {sorted(be.VALID_HORIZONS)} or 'same')"
                )

    backlog_path = be.find_backlog(slug)
    if backlog_path is None:
        raise be.BacklogEditError(f"no '{slug} Backlog.md' under vault root")
    # F247 — heal any prior raw hand-edit BEFORE this write, so a stale banner
    # (backlog changed outside `state`) is re-derived rather than compounded.
    complaint = be.heal_backlog_if_stale(slug, backlog_path)
    if complaint:
        print(complaint, file=sys.stderr)
    icebox_path = be.find_icebox(slug)

    if row_id_arg in ("Fnew", "Bnew", "Tnew"):
        kind = row_id_arg[0]
        num = be.mint_cross_file_id(backlog_path, icebox_path, kind)
        row_id_arg = be.format_row_id(kind, num)

    src_file, dst_file, dst_horizon = be.resolve_files_for_edit(
        slug, backlog_path, horizon, row_id_arg, status,
    )

    # T174 — carry the existing row's `→ [[doc]]` pointer onto a replacement body
    # that lacks one. Runs before every write path, including the cross-file move,
    # so no caller can lose the edge by choosing a different verb.
    if body_provided and not drop_pointer and status != "delete":
        existing = None
        for probe in (src_file, dst_file):
            if probe is None:
                continue
            try:
                existing = be.read_full_row(probe, row_id_arg)
            except Exception:
                existing = None
            if existing is not None:
                break
        if existing is not None:
            body, carried = _carry_doc_pointer(existing.get("body", ""), body)
            if carried:
                print(
                    f"note: carried the row's doc pointer onto the new body — {carried} "
                    f"(T174; pass --drop-pointer to sever it deliberately)",
                    file=sys.stderr,
                )

    if src_file is not None:
        # F250 #1/#2/#4 — cross-file move (Backlog↔Icebox). Read the source
        # row's FULL content BEFORE any write, so a bare `set --horizon Icebox`
        # (no --title/--body) preserves title/body/status/sub-bullets instead of
        # rebuilding the row from nothing and writing the literal `[same]`
        # bracket (#1). Insert into the DESTINATION FIRST — all destination
        # guards (F171/F240/F102/F242) run there — and delete from the source
        # ONLY after the destination write succeeds, so a refused destination can
        # never leave the row deleted from BOTH files (#2). read_full_row raises
        # on a malformed source row rather than moving-and-wiping it (#4).
        src_row = be.read_full_row(src_file, row_id_arg)
        if src_row is not None:
            if not title_provided and title == "":
                title, title_provided = src_row["title"], True
            if not body_provided and body == "":
                body, body_provided = src_row["body"], True
            if status == "same":
                status = src_row["status"]
            if verify_text is None:
                verify_text = src_row["verify"]
            if next_text is None:
                next_text = src_row["next"]
            if user_text is None:
                user_text = src_row.get("user")
            if not pending_subs and src_row["other_subs"]:
                pending_subs = src_row["other_subs"]
        result = be.perform_edit(
            dst_file, dst_horizon, row_id_arg, status,
            title, body, title_provided, body_provided,
            verify_text=verify_text, next_text=next_text,
            pending_subs=pending_subs, why_user=why_user,
            user_text=user_text, why_user_action=why_user_action,
        )
        # Destination write landed on disk → now safe to remove the source row.
        be.perform_edit(
            src_file, "same", row_id_arg, "delete",
            "", "", False, False,
        )
    else:
        result = be.perform_edit(
            dst_file, dst_horizon, row_id_arg, status,
            title, body, title_provided, body_provided,
            verify_text=verify_text, next_text=next_text,
            pending_subs=pending_subs, why_user=why_user,
            user_text=user_text, why_user_action=why_user_action,
        )
    be.append_messages(slug, result["summary"], backlog_path)
    be.write_state(slug, result)
    be.refresh_q_md(slug)
    # F247 — stamp the FINAL backlog content (after perform_edit + refresh_q_md,
    # which may itself have repaired the backlog) so a `state`-driven write always
    # leaves a valid state:backlog stamp; the next call then only heals on a
    # genuine out-of-band hand-edit.
    try:
        _bl_lines = backlog_path.read_text(encoding="utf-8").splitlines(keepends=True)
        _bl_stamped = be.restamp_backlog(_bl_lines)
        if _bl_stamped != _bl_lines:
            be.write_backlog_lines(backlog_path, _bl_stamped)
    except OSError:
        pass
    # F145 auto-sync — a Done transition on an F-row flips the matching roadmap
    # checkbox (if the F-number appears on the roadmap). Same post-condition slot
    # `task update` already uses for refresh_q_md; failure here is non-fatal.
    if status not in ("delete", "same") and status.startswith("Done") \
            and row_id_arg.upper().startswith("F"):
        sync_msg = _sync_roadmap_on_done(slug, backlog_path, row_id_arg)
        if sync_msg:
            print(f"{slug}: {sync_msg}")
    # T124 — report the horizon the row ACTUALLY sits under, not the one asked
    # for. `refresh_q_md` above runs audit-q --fix, and C15 moves a `[Waiting]`
    # row back to `## Later` regardless of what was requested — so `state set
    # <row> --horizon Now` printed `updated <row> in Now [Waiting]` over a row
    # that never left Later. The summary is built inside `perform_edit`, before
    # any of that, so it could only ever report the request.
    #
    # That is what turned a placement policy into an invisible failure: two live
    # ATT rows were believed promoted and were in fact parked, where
    # `_row_should_render` admits only Questions/Verify* — so they rendered in
    # no section of queries.md at all. The policy itself is deliberate and
    # stays: 109 Later Waiting/Blocked rows vault-wide are correctly quiet, and
    # Dan already ruled on this axis ("a blocker for something parked in Later
    # is not a blocker, it is a note"). What was missing is that nothing told
    # the author their row had just gone silent.
    summary = result["summary"]
    # A terminal row moves to `## Done` by design, not by the C15/C16 park, so
    # reporting that move as a surprise would cry wolf on the commonest write
    # there is — and a note that fires when nothing is wrong is how a true one
    # gets ignored.
    terminal = str(result.get("status") or "").startswith("Done")
    if status != "delete" and not terminal:
        landed = _row_horizon_on_disk(backlog_path, result["row_id"])
        asked = result.get("h2_name")
        if landed and asked and landed != asked:
            summary = summary.replace(f" in {asked} ", f" in {landed} ", 1)
            print(f"{slug}: note — asked for `## {asked}`, the row landed in "
                  f"`## {landed}` (audit-q C15/C16 park "
                  f"[Waiting]/[Blocked]/[Watching] rows there).")
            if landed == "Later" and not _renders_under_later(result["status"]):
                print(f"{slug}: ⚠ a [{result['status']}] row in `## Later` "
                      f"renders in NO section of queries.md — if it needs the "
                      f"user, bracket it [User] or [Questions]; if it needs an "
                      f"agent, it belongs on an active horizon under a bracket "
                      f"that survives there.")
    print(f"{slug}: {summary}")
    return 0


def _row_horizon_on_disk(backlog_path, row_id):
    """The `## ` section a row physically sits under right now, or None.

    Read from disk deliberately, and only after every post-edit pass has run —
    the point is to report what the file says rather than what the writer
    intended, which is the same reason `verify_write_landed` re-reads (T050).
    """
    try:
        _lines, _h2, row_index = be.scan_backlog(backlog_path.read_text())
    except (OSError, be.BacklogEditError):
        return None
    entry = row_index.get(row_id)
    return entry[2] if entry else None


def _renders_under_later(status):
    """Whether a bracket is visible in queries.md while parked in `## Later`.

    Mirrors `_row_should_render`'s Later arm in queries-render.py. Duplicated
    rather than imported because that is a hyphenated script this module does
    not load — but the pairing is exactly the T120 shape (a checker and its
    fixer drifting apart), so a third bracket admitted on either side must be
    added to the other.
    """
    return bool(status) and ("Questions" in status or status.startswith("Verify"))


def _sync_roadmap_on_done(slug, backlog_path, row_id):
    """F145 — on a feature-doc Done transition, grep the roadmap for the
    F-number marker and flip its checkbox to `[x]`. Returns a one-line summary
    if a checkbox was flipped, else None. Never raises (best-effort post-cond).
    """
    try:
        roadmap = backlog_path.parent.parent / f"{slug} Design" / f"{slug} Roadmap.md"
        if not roadmap.exists():
            return None
        text = roadmap.read_text(encoding="utf-8")
        lines = text.splitlines()
        fnum = _feature_num(row_id)
        # F250 #6 — auto-sync flips ONLY the feature's own inline roadmap row:
        #   * inline checkbox bullets only — never a milestone `## [ ] M…` heading
        #     (a milestone's box reflects the whole milestone, not one feature);
        #   * the row's PRIMARY (first) F-ref must be this feature — so a prose
        #     cross-ref like `… de-risks [[F247]]` on the F250 row never causes
        #     F247's Done to flip the F250 row;
        #   * only an unchecked `[ ]` box flips — a deferred `[~]` or already
        #     `[x]` box is left untouched;
        #   * unique-match discipline (mirrors `_find_roadmap_entry`) — 0 matches
        #     means nothing to sync, >1 means ambiguous so refuse to guess.
        matches = []
        for i, line in enumerate(lines):
            bm = _INLINE_CHECKBOX_RE.match(line)
            if not bm:
                continue
            fnums = [int(n) for n in _F_REF_RE.findall(bm.group("rest"))]
            if fnums and fnums[0] == fnum:
                matches.append((i, bm.group("box")))
        if len(matches) != 1:
            return None
        idx, box = matches[0]
        if box != " ":
            return None
        lines[idx] = _set_box_on_line(lines[idx], "x")
        be._write_feature_lines(roadmap, lines)
        _selffire(roadmap)
        return f"roadmap auto-sync — flipped {row_id} checkbox to [x]"
    except (be.BacklogEditError, OSError, UnicodeDecodeError):
        return None


# ============================================================
# Q subcommands
# ============================================================


def _clamp_h2_end_to_h1(lines, h2_start, h2_end):
    """Tighten an H2 content range from be._find_h2 (generic H2-line to
    next-'## '-line) to stop at the doc's H1 if the H1 falls inside that
    range. `## Open Questions` sat ABOVE the H1 in legacy docs (pre-F241
    placement, per [[DAS ask-format]]); be._find_h2 doesn't know that
    convention, so when there's no OTHER '## ' heading between a legacy Open
    Questions block and the doc's first real H2, the computed end wanders
    through the H1 line and all body prose — defeating any "is this block
    empty" check and mis-siting insertions. Only ever narrows the range,
    never changes behavior for a genuinely doc-body-scoped H2. (Found via
    F236 v2 smoke-testing — confirmed pre-existing across 52 vault docs
    carrying a residual empty `## Open Questions` H2 from this exact gap;
    left untouched in backlog-edit.py's `-Q resolve`/`-Q remove`, which this
    v2 work doesn't otherwise modify.)
    """
    for k in range(h2_start + 1, h2_end):
        if lines[k].startswith("# ") and not lines[k].startswith("## "):
            return k
    return h2_end


# ------------------------------------------------------------------
# F291 — the two-zone Open Questions block
#
# A resolved question does not leave the block. It moves to a second zone at
# the bottom (`### Resolved`) and stays there until the LAST question of the
# round lands, at which point `state` deletes the block and writes every
# entry to the top of the doc's bottom `## Resolved` in one machine-authored
# write. Two consequences the old delete-at-Phase-2 / recreate-at-Phase-3
# lifecycle did not have: the open count is a prefix length rather than a
# scan, and a question arriving mid-round is not a structural event at all.

_Q_OPTION_RE = re.compile(r"^(\s*)- \*\*\(([^)]{1,4})\)\*\*\s*(.*)$")
_Q_FIELD_RE = re.compile(r"^\s*- \*\*([A-Za-z][A-Za-z -]*):\*\*\s*(.*)$")
_Q_ANCHOR_RE = re.compile(r"\s*(\^[\w-]+)\s*$")


def _oneline(parts):
    """Join a sub-bullet's continuation lines into one line. The archive keeps
    every option, one line each (F291 Q1=B) — the compression is structural
    (drop the wrapping), never lossy (no truncation)."""
    return re.sub(r"\s+", " ", " ".join(p.strip() for p in parts if p.strip())).strip()


def _parse_q_block(block_lines):
    """Split a pending Q bullet into the pieces the resolved entry is built
    from: title, block-ID, the question's own prose, the labeled options, and
    the Recommendation — which becomes the LEAN.

    Everything else in the bullet (Damage, On answer, the `why-ask`
    annotation) is scaffolding for the ASK, spent once the question is
    answered, and is deliberately not carried into the archive.
    """
    header = block_lines[0]
    anchor = ""
    m = _Q_ANCHOR_RE.search(header)
    if m:
        anchor = m.group(1)
        header = header[:m.start()]
    # Two header shapes: the bullet `state` writes, and the H3 a hand-authored
    # block uses. In the bullet the question rides the header after the bold
    # title; in the H3 it is the prose underneath, so `prose` collects it.
    hm = re.match(r"^\s*- \*\*Q\d+\s+—\s+(.*?)\*\*\s*(?:[—-]\s*)?(.*)$", header)
    h3 = re.match(r"^\s*###\s+Q\d+\s+—\s+(.*)$", header)
    if hm:
        title, question = hm.group(1).strip(), hm.group(2).strip()
    elif h3:
        title, question = h3.group(1).strip(), ""
    else:
        title, question = "Untitled", re.sub(r"^\s*-\s+", "", header).strip()
    # A question resolved in PROSE — the state this feature exists to absorb —
    # usually announces itself in the heading (`— RESOLVED 2026-08-01`). The
    # entry stamps `(resolved <date>)` itself, so keeping the marker would say
    # it twice; drop it rather than carry a title that reads as a stutter.
    title = re.sub(r"\s*[—-]\s*RESOLVED\b.*$", "", title).strip() or title
    options, lean, cur, prose = [], "", None, []
    seen_field = False
    for line in block_lines[1:]:
        om = _Q_OPTION_RE.match(line)
        if om:
            options.append([om.group(2).strip(), [om.group(3)]])
            cur = options[-1][1]
            seen_field = True
            continue
        fm = _Q_FIELD_RE.match(line)
        if fm:
            field = fm.group(1).strip().lower()
            seen_field = True
            if field == "recommendation":
                cur = [fm.group(2)]
                lean = cur
            else:
                cur = None       # Damage / On answer — ask scaffolding, dropped
            continue
        if cur is not None and line.strip():
            cur.append(line)
        elif not seen_field:
            prose.append(line)
    if not question and prose:
        question = "\n".join(prose).strip()
    return {
        "title": title,
        "anchor": anchor,
        "question": question,
        "options": [(letter, _oneline(parts)) for letter, parts in options],
        "lean": _oneline(lean) if lean else "",
    }


def _resolve_outcome(choice, options, q_num):
    """Turn `--choice` into the `**Resolved:**` line, refusing an option letter
    that is not on the list.

    The flag stays REQUIRED with `none` as a legal value (F291, revised
    2026-08-01). An omitted flag cannot be distinguished from the agent
    forgetting to pass one, so optionality would turn a real signal into an
    ambiguity — the T079 failure mode (a write reporting success while quietly
    doing nothing), and there is no reason to build a second instance of it on
    purpose. Requiring an explicit `none` forces a positive statement that the
    outcome fell outside the option list.
    """
    raw = (choice or "").strip()
    if not raw:
        raise be.BacklogEditError(
            f"resolve requires --choice for Q{q_num} — an option letter "
            '("(B)"), or `none` when the outcome fell outside every listed '
            'option (`--choice "none — handed to DMP F005"`).'
        )
    nm = re.match(r"^none\b\s*[—-]?\s*(.*)$", raw, re.I)
    if nm:
        rest = nm.group(1).strip()
        return "none of the above" + (f" — {rest}" if rest else "")
    letter = raw.strip("()").strip()
    listed = {L.strip("()").strip(): text for L, text in options}
    if options and letter not in listed:
        names = ", ".join(f"({L})" for L, _ in options)
        raise be.BacklogEditError(
            f"resolve refused: Q{q_num} has no option ({letter}) — the listed "
            f"options are {names}. Pass one of those, or `--choice none` if "
            "the resolution landed outside the list (that is legal and "
            "recorded as such)."
        )
    text = listed.get(letter, "")
    return f"({letter})" + (f" — {text}" if text else "")


def _format_resolved_entry(q_num, parsed, outcome, note, today):
    """The archived entry: question → resolution → options → lean (F291).

    Inverts the old layout, which led with `**Choice:**` and buried the
    question inside a `> Original Q context:` quote at the bottom — forcing a
    reader past the answer to find out what was asked. Lean and Resolved are
    separate lines on purpose: one records what was advised, the other what
    happened, and the delta between them is the calibration signal that the
    single conflated `**Choice:**` line destroyed.
    """
    out = ["", f"### Q{q_num} — {parsed['title']} (resolved {today})"]
    # The block-ID rides the question line — it is the address the backlog row,
    # Q.md, and chat asks point at, so dropping it at migration would break
    # every inbound link to the decision. Headings cannot carry one.
    q_line = parsed["question"] or parsed["title"]
    if parsed["anchor"]:
        q_line = f"{q_line} {parsed['anchor']}"
    out += [q_line.rstrip(), "", f"**Resolved:** {outcome}", ""]
    if note.strip():
        out += [note.rstrip(), ""]
    for letter, text in parsed["options"]:
        out.append(f"- **({letter})** {text}".rstrip())
    if parsed["options"]:
        out.append("")
    if parsed["lean"]:
        out += [f"**Lean:** {parsed['lean']}", ""]
    return out


_Q_ZONE_HEADS = ("### Resolved", "### Removed")


def _pending_q_heads(lines):
    """([(q_num, line_idx), …], zone_start) for the block's UNRESOLVED zone.

    The zone ends at the first `### Resolved` / `### Removed` heading, so the
    open count is a prefix length rather than a scan. It is NOT "the first
    `### ` line": a question may itself be written as an H3 (`### Q2 — …`, the
    shape audit-q F012 taught the checkers to read, and the shape every
    question on F294 uses), so only the two ZONE names end the zone. Both Q
    shapes are recognized above it.
    """
    rng = be._open_questions_range(lines)
    if rng is None:
        return [], None
    start, end = rng
    heads = []
    for k in range(start + 1, end):
        if lines[k].strip() in _Q_ZONE_HEADS:
            end = k
            break
        m = be._Q_HEADER_BULLET_RE.match(lines[k]) or be._Q_HEADER_H3_RE.match(lines[k])
        if m:
            heads.append((int(m.group(2)), k))
    return heads, end


def _find_pending_q(lines, q_num):
    """(start, end) of Q<n> in the unresolved zone, either shape, or None."""
    heads, zone_end = _pending_q_heads(lines)
    for i, (num, s) in enumerate(heads):
        if num == q_num:
            return (s, heads[i + 1][1] if i + 1 < len(heads) else zone_end)
    return None


def _zone_range(lines, oq_start, oq_end, name):
    """(start, end) of the block's `### {name}` zone, or None.

    NOT be._find_h3_in_h2 — that ends the range at the next `### `, and a
    zone's own entries ARE `### Q<n>` H3s, so it would report the zone as
    ending at its first entry and every append would land at the top. A zone
    runs to the next ZONE heading (the sibling `### Resolved`/`### Removed`)
    or to the end of the block.
    """
    zones = ("### Resolved", "### Removed")
    start = None
    for i in range(oq_start + 1, oq_end):
        if lines[i].strip() == f"### {name}":
            start = i
            break
    if start is None:
        return None
    end = oq_end
    for j in range(start + 1, oq_end):
        if lines[j].strip() in zones or lines[j].startswith("## "):
            end = j
            break
    return (start, end)


def _insert_into_resolved_zone(lines, entry_lines):
    """Append an entry to the block's `### Resolved` zone, creating the zone if
    this is the round's first resolution. Ordered above `### Removed` when both
    exist, so the block reads unresolved → resolved → removed."""
    oq_start, oq_end = be._open_questions_range(lines)
    zone = _zone_range(lines, oq_start, oq_end, "Resolved")
    if zone is None:
        removed = _zone_range(lines, oq_start, oq_end, "Removed")
        insert_at = removed[0] if removed is not None else oq_end
        while insert_at > oq_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        return lines[:insert_at] + ["", "### Resolved"] + entry_lines + lines[insert_at:]
    z_start, z_end = zone
    insert_at = z_end
    while insert_at > z_start + 1 and not lines[insert_at - 1].strip():
        insert_at -= 1
    return lines[:insert_at] + entry_lines + lines[insert_at:]


def _migrate_block_to_resolved(lines):
    """The last resolve of a round: delete the Open Questions block and write
    its entries to the TOP of the bottom `## Resolved`, above anything already
    there — so the section reads newest-batch-first, interleaving migrated
    rounds with F068 auto-decisions in rough chronological order.

    Machine-authored because this is the single highest-drift moment in the
    lifecycle — the one write that touches every question at once — and
    because it needs no judgment: `state` already holds each question's text,
    its options, the chosen letter, and the note. The agent contributes
    nothing but an opportunity to typo.
    """
    oq_start, oq_end = be._open_questions_range(lines)
    entries = []
    for k in range(oq_start + 1, oq_end):
        ln = lines[k]
        if ln.strip() in ("### Resolved", "### Removed"):
            continue
        if ln.startswith("### "):
            entries.append([ln])
        elif entries:
            entries[-1].append(ln)
    entries = [e for e in ([_trim_blanks(e) for e in entries]) if e]
    drop_end = oq_end
    while drop_end < len(lines) and not lines[drop_end].strip():
        drop_end += 1
    lines = lines[:oq_start] + lines[drop_end:]
    if not entries:
        return lines, 0

    # T085 — merge, don't clobber. F291 released the guard on `## Resolved`,
    # so an agent can now write a `### Q<n>` entry there BEFORE calling
    # resolve — and this migration would then write a SECOND entry for the
    # same question. That is worse than a duplicate record: both carry
    # `^F<n>-Q<n>`, putting one block-ID in a file twice, which is the F281
    # collision class at document scale and which no audit check looks for.
    lines, (rh2_start, rh2_end) = be._ensure_bottom_resolved_h2(lines)
    lines, kept = _merge_prewritten(lines, entries, rh2_start, rh2_end)
    if not entries:
        return lines, len(kept)

    lines, (rh2_start, _rh2_end) = be._ensure_bottom_resolved_h2(lines)
    payload = []
    for e in entries:
        payload.extend(e)
        payload.append("")
    tail = lines[rh2_start + 1:]
    while tail and not tail[0].strip():
        tail.pop(0)
    lines = lines[:rh2_start + 1] + [""] + payload + tail
    return lines, len(entries) + len(kept)


# Lines a downstream reader depends on, and so the only ones grafted into an
# agent-written entry that lacks them. Everything else about that entry —
# wording, ordering, extra prose — is left exactly as written.
_MERGE_CRITICAL = ("**Resolved:**", "**Lean:**")
_MERGE_OPTION_RE = re.compile(r"^\s*- \*\*\([A-Za-z]\)\*\*")

# The address the backlog row, Q.md, and every chat ask point at. Two entries
# are the same entry when they carry the same one — never when their headings
# merely read alike (T155).
_Q_BLOCK_ID_RE = re.compile(r"\^([A-Za-z][A-Za-z0-9]*-Q\d+)\b")


def _entry_block_id(block):
    for ln in block:
        m = _Q_BLOCK_ID_RE.search(ln)
        if m:
            return m.group(1)
    return None


def _merge_prewritten(lines, entries, rh2_start, rh2_end):
    """Fold every entry whose BLOCK-ID already appears under the bottom
    `## Resolved` into that existing entry, and drop it from `entries` so the
    caller does not append a second copy.

    The agent's text WINS. It is normally better-reasoned than a generated
    stub — the agent wrote it while holding the discussion that produced the
    decision — so only missing machine-critical content is grafted on, at the
    end, where it cannot reorder anything. The alternatives were all worse: a
    hard error forces a delete-and-retry dance over something recoverable,
    writing both leaves the duplicate this exists to prevent, and a silent
    skip loses the signal that two writers touched one entry.

    **Matching is on the block-ID, not the H3 title (T155).** It used to be
    `### Q(\\d+)\\b`, which made `### Q1's answer is superseded — …` — the
    normal, correct way to record a supersession, since a supersession is
    *supposed* to name the question it supersedes — read as the entry that IS
    Q1. The migrating machine entry was then dropped in its favour, taking the
    question text, the option list, the `**Lean:**` line, and the `^F<n>-Q<n>`
    block-ID with it, under a message that read as a courteous merge. So the
    collision fired precisely when the record was most valuable, and an H3 that
    merely *mentions* a Q-number now never shadows the entry that carries it.

    Returns (lines, [Q-numbers merged]); mutates `entries` in place.
    """
    existing = {}
    heads = [k for k in range(rh2_start + 1, min(rh2_end, len(lines)))
             if lines[k].startswith("### ")]
    for i, k in enumerate(heads):
        stop = heads[i + 1] if i + 1 < len(heads) else min(rh2_end, len(lines))
        bid = _entry_block_id(lines[k:stop])
        if bid:
            existing[bid] = k
    if not existing:
        return lines, []

    kept = []
    # Highest line first: grafting shifts every index below the splice.
    todo = []
    for entry in list(entries):
        m = be._Q_HEADER_H3_RE.match(entry[0])
        bid = _entry_block_id(entry)
        if m and bid and bid in existing:
            todo.append((existing[bid], int(m.group(2)), entry))
    for at, q_num, entry in sorted(todo, reverse=True):
        entries.remove(entry)
        kept.append(q_num)
        end = at + 1
        while end < len(lines) and not lines[end].startswith("#"):
            end += 1
        block = lines[at:end]
        graft = []
        for marker in _MERGE_CRITICAL:
            if any(marker in b for b in block):
                continue
            graft += [l for l in entry[1:] if l.lstrip().startswith(marker)]
        if not any(_MERGE_OPTION_RE.match(b) for b in block):
            graft += [l for l in entry[1:] if _MERGE_OPTION_RE.match(l)]
        if graft:
            lines = (lines[:at] + _trim_blanks(list(block)) + [""]
                     + graft + [""] + lines[end:])
        print(f"  Q{q_num} already had a Resolved entry (same block-ID); "
              "kept yours"
              + (f" (grafted {len(graft)} missing line(s))" if graft else ""),
              file=sys.stderr)
    return lines, sorted(kept)


def _trim_blanks(block):
    while block and not block[-1].strip():
        block.pop()
    return block


def _tidy_open_questions_spacing(lines):
    """Collapse blank runs inside the block to a single separator, and leave
    exactly one before the next H2. Each `define` leaves its own trailing
    blank, so a three-question round accumulates a run of them, and re-zoning
    a question carries that run down with it."""
    rng = be._open_questions_range(lines)
    if rng is None:
        return lines
    start, end = rng
    body = []
    for ln in lines[start:end]:
        if not ln.strip() and body and not body[-1].strip():
            continue
        body.append(ln)
    if body and body[-1].strip():
        body.append("")
    return lines[:start] + body + lines[end:]


def _q_answer_core(slug, feature_path, q_num, q_slug, choice, body):
    """`<doc> Q<n> resolve` — annotate in place, and migrate the whole block
    when this was the last unresolved question (F291).

    Nothing relocates until the last one lands: the question moves to the
    block's resolved zone keeping its full option list, with the resolution
    appended below it. The duplication between option B and the resolution's
    restatement of B is safe *because* `state` writes both and nothing may
    hand-edit either — redundancy is only hazardous when two copies can drift
    independently, and the guard is what makes that impossible.
    """
    text = feature_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    start, end, _, q_num = _resolve_q_identifier(lines, q_num, q_slug)
    parsed = _parse_q_block(_trim_blanks(lines[start:end]))
    outcome = _resolve_outcome(choice, parsed["options"], q_num)
    entry = _format_resolved_entry(q_num, parsed, outcome, body,
                                   date.today().isoformat())
    lines = lines[:start] + lines[end:]
    lines = _insert_into_resolved_zone(lines, entry)
    lines = _tidy_open_questions_spacing(lines)
    still_open = [n for n, _ in _pending_q_heads(lines)[0]]
    migrated = 0
    if not still_open:
        lines, migrated = _migrate_block_to_resolved(lines)
    lines = be.restamp_open_questions(lines)
    be._write_feature_lines(feature_path, lines)
    _selffire(feature_path)
    summary = f"resolved Q{q_num} ({outcome.split(' — ')[0]}) in {feature_path.name}"
    if migrated:
        summary += (f" — last of the round; migrated {migrated} entr"
                    f"{'y' if migrated == 1 else 'ies'} to ## Resolved and "
                    "retired the block")
    else:
        summary += f" — {len(still_open)} still open"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _q_remove_core(slug, feature_path, q_num, q_slug, reason):
    """Block-surgery for Q-remove, called by the `remove <anchor> <doc> Q<n>` verb
    against any resolved doc path (F236) — see `_q_answer_core`."""
    text = feature_path.read_text(encoding="utf-8")
    reason = reason or "no reason provided"
    lines = text.splitlines()
    start, end, _, q_num = _resolve_q_identifier(lines, q_num, q_slug)
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*Q\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    original_body = "\n".join(lines[start:end]).rstrip()
    today = date.today().isoformat()
    h3_lines = [
        "",
        f"### Q{q_num} — {title} (removed {today} — {reason})",
        "",
        "> Original Q context (preserved for audit trail):",
    ]
    for ol in original_body.splitlines():
        h3_lines.append(f"> {ol}")
    h3_lines.append("")
    lines = lines[:start] + lines[end:]
    oq = be._find_h2(lines, "Open Questions")
    if oq is None:
        lines, (oq_start, oq_end) = be._ensure_open_questions_h2(lines)
    else:
        oq_start, oq_end = oq
        oq_end = _clamp_h2_end_to_h1(lines, oq_start, oq_end)
    removed = _zone_range(lines, oq_start, oq_end, "Removed")
    if removed is None:
        insert_at = oq_end
        while insert_at > oq_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + ["", "### Removed", ""] + h3_lines[1:] + lines[insert_at:]
    else:
        r_start, r_end = removed
        insert_at = r_end
        while insert_at > r_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    lines = be.restamp_open_questions(lines)
    be._write_feature_lines(feature_path, lines)
    _selffire(feature_path)
    summary = f"removed Q{q_num} from {feature_path.name} (reason: {reason})"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _post_conditions_and_print(slug, feature_path, summary):
    """Run F127 post-conditions; print summary + any warnings."""
    warnings = be._post_conditions(slug, feature_path)
    # Q-mutations change banner counts ([N Questions]) and bracket state, so the
    # anchor's Q.md section must be regenerated — same refresh `state task` runs.
    # Keeps Q.md current entirely through `state`; no separate queries-render call.
    be.refresh_q_md(slug)
    print(f"{slug}: {summary}")
    for w in warnings:
        print(f"  warn: {w}", file=sys.stderr)


# ============================================================
# Status subcommands (F130) — manage {slug} Status.md per-facet planning state
# ============================================================


VALID_STATUS_CELLS = (
    "none",
    "MVP-agent", "MVP-user",
    "Full-agent", "Full-user",
)

# Declared facet order — used by /plan picker tie-break + bare `status show`.
DEFAULT_STATUS_FACETS = ("prd", "ux", "architecture", "testing", "roadmap")

_STATUS_LINE_RE = re.compile(r"^([a-z][a-z0-9_]*):\:\s*(.*)$")


def _status_path(slug, anchor_path):
    """{slug} Status.md lives in the Track folder next to Backlog/Icebox/etc.

    Layout is 2-level ({anchor}/{slug} Track/) since the Docs-folder collapse;
    the old 3-level {slug} Docs/{slug} Track/ path was a phantom (no such dir
    exists), so `status show` read all-none and `status set` refused. (F250#5)
    """
    return anchor_path / f"{slug} Track" / f"{slug} Status.md"


def _ensure_status_file(slug, anchor_path):
    """Create {slug} Status.md with all default facets at `none` if absent.

    Fails if the Track folder doesn't exist (caller's anchor is malformed).
    """
    path = _status_path(slug, anchor_path)
    if path.exists():
        return path
    if not path.parent.exists():
        raise be.BacklogEditError(
            f"can't create {path.name}: parent {path.parent} doesn't exist"
        )
    body_lines = [
        "---",
        "description: planning status — per-facet tier+approver; consumed by /plan",
        "---",
        "",
        f"# [[{slug}]] Status",
        "",
    ]
    for facet in DEFAULT_STATUS_FACETS:
        body_lines.append(f"{facet}:: none")
    body_lines.append("")
    path.write_text("\n".join(body_lines), encoding="utf-8")
    _selffire(path)
    return path


def _parse_status_lines(text):
    """Return list of (facet, body) in file order. body == 'none' or '<cell> (date) — note'."""
    out = []
    for line in text.splitlines():
        m = _STATUS_LINE_RE.match(line)
        if m:
            out.append((m.group(1), m.group(2).strip()))
    return out


def cmd_status_set(slug, anchor_path, args):
    """Set or overwrite a facet's status cell."""
    facet = args.facet.lower()
    cell = args.cell
    note = (args.note or "").strip()

    if not re.match(r"^[a-z][a-z0-9_]*$", facet):
        raise be.BacklogEditError(
            f"invalid facet {facet!r}; expected lowercase letters / digits / underscore"
        )
    if cell not in VALID_STATUS_CELLS:
        raise be.BacklogEditError(
            f"invalid cell {cell!r}; expected one of {list(VALID_STATUS_CELLS)}"
        )
    if cell.endswith("-user") and not note:
        raise be.BacklogEditError(
            f"--note is required when setting {cell} "
            "(user rationale is institutional memory; pass --note \"<one-line>\")"
        )

    path = _ensure_status_file(slug, anchor_path)
    today = date.today().isoformat()

    if cell == "none":
        new_line = f"{facet}:: none"
    else:
        new_line = f"{facet}:: {cell} ({today})"
        if note:
            new_line += f" — {note}"

    lines = path.read_text(encoding="utf-8").splitlines()
    facet_pat = re.compile(rf"^{re.escape(facet)}::")
    replaced = False
    out_lines = []
    for line in lines:
        if facet_pat.match(line):
            out_lines.append(new_line)
            replaced = True
        else:
            out_lines.append(line)
    if not replaced:
        # Append before trailing blank line if present, else at end
        while out_lines and out_lines[-1] == "":
            out_lines.pop()
        out_lines.append(new_line)
        out_lines.append("")
    else:
        # Ensure file ends with single trailing newline
        while len(out_lines) >= 2 and out_lines[-1] == "" and out_lines[-2] == "":
            out_lines.pop()
        if not out_lines or out_lines[-1] != "":
            out_lines.append("")

    path.write_text("\n".join(out_lines), encoding="utf-8")
    _selffire(path)
    note_tail = f" — {note}" if note else ""
    print(f"{slug}: status {facet} → {cell}{note_tail}")
    return 0


def cmd_status_show(slug, anchor_path, args):
    """Print one or all facet status lines.

    With no argument: print every DEFAULT_STATUS_FACETS in declared order,
    then any extra facets in file-order. Missing facets default to `none`.
    """
    requested = args.facet.lower() if args.facet else None
    path = _status_path(slug, anchor_path)
    found = {}
    file_order = []
    if path.exists():
        for facet, body in _parse_status_lines(path.read_text(encoding="utf-8")):
            if facet not in found:
                file_order.append(facet)
            found[facet] = body

    if requested:
        body = found.get(requested, "none")
        print(f"{requested}:: {body}")
        return 0

    for facet in DEFAULT_STATUS_FACETS:
        body = found.get(facet, "none")
        print(f"{facet}:: {body}")
    for facet in file_order:
        if facet not in DEFAULT_STATUS_FACETS:
            print(f"{facet}:: {found[facet]}")
    return 0


# ============================================================
# Roadmap subcommands (F145) — status get/set + whole-milestone migrate
# ============================================================
#
# The roadmap lives at `{slug} Design/{slug} Roadmap.md`; the Completed Roadmap
# is its sibling. Milestone headings carry a checkbox in the title:
#   ## [ ] M-Store — Persistence Layer
#   ### [x] M-Store.1 — SQLite schema  [F050]
# Sub-items may also be inline bullets:  `- [x] [[F017 — ...]] — ...`.
#
# These commands mutate roadmap files in place. They are deliberately
# defensive — every parse failure raises BacklogEditError with the offending
# context rather than corrupting the file.


# Milestone heading: hashes, checkbox, identifier, trailing text.
_MILESTONE_HEADING_RE = re.compile(
    r"^(?P<hashes>#{1,3})\s+\[(?P<box>[ x~])\]\s+(?P<ident>M[-\w.]*)(?P<rest>.*)$"
)
# Inline checkbox bullet carrying an `[[F<n>` wiki-link or an `[F<n>]` marker.
_INLINE_CHECKBOX_RE = re.compile(r"^(?P<indent>\s*)- \[(?P<box>[ x~])\]\s+(?P<rest>.*)$")
# `[F123]` marker / `[[F123 — ...` wiki-link F-number extractor.
_F_REF_RE = re.compile(r"\[\[?F(\d+)\b")

# State name → checkbox character.
_STATE_TO_BOX = {"checked": "x", "unchecked": " ", "deferred": "~"}
_BOX_TO_STATE = {"x": "checked", " ": "unchecked", "~": "deferred"}


def _roadmap_path(slug, anchor_path, completed=False):
    """`{slug} Design/{slug} [Completed ]Roadmap.md` — the canonical location.

    Falls back to a vault-walk via find_backlog's anchor when the Design folder
    isn't directly under anchor_path (sub-anchors, linked-mode, etc.).
    """
    suffix = "Completed Roadmap.md" if completed else "Roadmap.md"
    direct = anchor_path / f"{slug} Design" / f"{slug} {suffix}"
    if direct.exists():
        return direct
    # Vault-walk: locate `{slug} {suffix}` near the backlog.
    backlog = be.find_backlog(slug)
    design_dir = backlog.parent.parent / f"{slug} Design"
    cand = design_dir / f"{slug} {suffix}"
    return cand  # may not exist yet (Completed Roadmap is created on first migrate)


def _find_roadmap_entry(lines, feature=None, milestone=None):
    """Locate a roadmap entry by F-number or milestone id.

    Returns (line_index, kind, current_box) where kind is 'heading' or 'inline'.
    Raises BacklogEditError on miss / ambiguity.
    """
    if (feature is None) == (milestone is None):
        raise be.BacklogEditError("specify exactly one of --feature F<n> / --milestone M-<Name>")
    matches = []
    for i, line in enumerate(lines):
        hm = _MILESTONE_HEADING_RE.match(line)
        if hm:
            if milestone is not None and hm.group("ident") == milestone:
                matches.append((i, "heading", hm.group("box")))
            elif feature is not None:
                fnums = [int(n) for n in _F_REF_RE.findall(hm.group("rest"))]
                if _feature_num(feature) in fnums:
                    matches.append((i, "heading", hm.group("box")))
            continue
        bm = _INLINE_CHECKBOX_RE.match(line)
        if bm:
            if milestone is not None:
                # An inline bullet naming the milestone id literally.
                if re.search(rf"\bM-?{re.escape(milestone[2:])}\b", bm.group("rest")) \
                        and milestone.startswith("M-"):
                    matches.append((i, "inline", bm.group("box")))
            elif feature is not None:
                fnums = [int(n) for n in _F_REF_RE.findall(bm.group("rest"))]
                if _feature_num(feature) in fnums:
                    matches.append((i, "inline", bm.group("box")))
    if not matches:
        ref = milestone or feature
        raise be.BacklogEditError(f"no roadmap entry found for {ref!r}")
    if len(matches) > 1:
        ref = milestone or feature
        ln = ", ".join(str(i + 1) for i, _, _ in matches)
        raise be.BacklogEditError(
            f"multiple roadmap entries match {ref!r} (lines {ln}); "
            f"narrow by --milestone with full sub-position or fix duplicates"
        )
    return matches[0]


def _feature_num(feature):
    """Normalize 'F145' / 'f145' / '145' → int 145."""
    m = re.match(r"^[Ff]?(\d+)$", feature.strip())
    if not m:
        raise be.BacklogEditError(f"invalid --feature {feature!r} (expected F<n>)")
    return int(m.group(1))


def _set_box_on_line(line, new_box):
    """Replace the checkbox char on a milestone heading or inline bullet."""
    hm = _MILESTONE_HEADING_RE.match(line)
    if hm:
        return f"{hm.group('hashes')} [{new_box}] {hm.group('ident')}{hm.group('rest')}"
    bm = _INLINE_CHECKBOX_RE.match(line)
    if bm:
        return f"{bm.group('indent')}- [{new_box}] {bm.group('rest')}"
    raise be.BacklogEditError(f"cannot set checkbox on non-milestone line: {line!r}")


def cmd_roadmap_status_get(slug, anchor_path, args):
    """Print a roadmap entry's current checkbox state."""
    path = _roadmap_path(slug, anchor_path)
    if not path.exists():
        raise be.BacklogEditError(f"no roadmap at {path}")
    lines = path.read_text(encoding="utf-8").splitlines()
    idx, kind, box = _find_roadmap_entry(lines, args.feature, args.milestone)
    state = _BOX_TO_STATE.get(box, "unknown")
    ref = args.milestone or args.feature
    print(f"{slug}: {ref} → {state} (line {idx + 1})")
    return 0


def cmd_roadmap_status_set(slug, anchor_path, args):
    """Set a roadmap entry's checkbox state by F-number or milestone id."""
    if args.state not in _STATE_TO_BOX:
        raise be.BacklogEditError(
            f"invalid --state {args.state!r}; expected one of {list(_STATE_TO_BOX)}"
        )
    path = _roadmap_path(slug, anchor_path)
    if not path.exists():
        raise be.BacklogEditError(f"no roadmap at {path}")
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    idx, kind, old_box = _find_roadmap_entry(lines, args.feature, args.milestone)
    new_box = _STATE_TO_BOX[args.state]
    lines[idx] = _set_box_on_line(lines[idx], new_box)
    be._write_feature_lines(path, lines)
    _selffire(path)
    ref = args.milestone or args.feature
    print(f"{slug}: roadmap {ref} {_BOX_TO_STATE[old_box]} → {args.state} (line {idx + 1})")
    return 0


def _extract_milestone_section(lines, milestone):
    """Extract a whole top-level milestone H2 section.

    Returns (start_idx, end_idx) where the slice lines[start:end] covers the
    `## [ ] M-<Name> …` heading through (and including) the trailing `### .`
    separator if present, up to but excluding the next `## ` H2 (or EOF).
    Raises BacklogEditError if the milestone isn't a top-level H2.
    """
    start = None
    for i, line in enumerate(lines):
        hm = _MILESTONE_HEADING_RE.match(line)
        if hm and hm.group("ident") == milestone and len(hm.group("hashes")) == 2:
            start = i
            break
    if start is None:
        raise be.BacklogEditError(
            f"milestone {milestone!r} not found as a top-level (## H2) heading"
        )
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if re.match(r"^## ", lines[j]):
            end = j
            break
    # Trim trailing blank lines out of the section (they stay with the source).
    sec_end = end
    while sec_end > start + 1 and lines[sec_end - 1].strip() == "":
        sec_end -= 1
    return start, sec_end, end


def _milestone_all_complete(section_lines):
    """True if the milestone heading is [x] AND no sub-item is unchecked `[ ]`.

    Deferred `[~]` sub-items are allowed (they migrate in their deferred state).
    """
    heading = section_lines[0]
    hm = _MILESTONE_HEADING_RE.match(heading)
    if not hm or hm.group("box") != "x":
        return False
    for line in section_lines[1:]:
        bm = _INLINE_CHECKBOX_RE.match(line)
        sm = _MILESTONE_HEADING_RE.match(line)
        box = (bm.group("box") if bm else (sm.group("box") if sm else None))
        if box == " ":
            return False
    return True


_STANDALONE_GROUPING_RE = re.compile(
    r"^## Completed standalone features\b", re.IGNORECASE
)


def _ensure_completed_roadmap(slug, completed_path):
    """Create the Completed Roadmap with an H1 if absent. Returns its text."""
    if completed_path.exists():
        return completed_path.read_text(encoding="utf-8")
    if not completed_path.parent.exists():
        raise be.BacklogEditError(
            f"can't create {completed_path.name}: parent "
            f"{completed_path.parent} doesn't exist"
        )
    header = f"# {slug} Completed Roadmap\n\n"
    completed_path.write_text(header, encoding="utf-8")
    _selffire(completed_path)
    return header


def cmd_roadmap_migrate(slug, anchor_path, args):
    """Atomically migrate a whole completed milestone from Roadmap to Completed
    Roadmap, preserving checkbox states + adding a `migrated <date>` note.

    Steps:
      1. Extract the `## [x] M-<Name> …` section from the live Roadmap.
      2. Verify it's complete (heading [x], no [ ] sub-items).
      3. Stamp the heading with `(migrated YYYY-MM-DD)`.
      4. Seal the current standalone grouping in the Completed Roadmap and
         insert the migrated milestone below it; open a fresh standalone
         grouping at the top.
      5. Remove the section from the live Roadmap.
    """
    milestone = args.milestone
    if not milestone.startswith("M-"):
        raise be.BacklogEditError(f"milestone must be named form M-<Name>, got {milestone!r}")
    date_str = args.date  # required by the parser; never call Date.now() unguarded
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", date_str):
        raise be.BacklogEditError(f"--date must be YYYY-MM-DD, got {date_str!r}")

    roadmap = _roadmap_path(slug, anchor_path)
    if not roadmap.exists():
        raise be.BacklogEditError(f"no roadmap at {roadmap}")
    rm_text = roadmap.read_text(encoding="utf-8")
    rm_lines = rm_text.splitlines()

    start, sec_end, next_h2 = _extract_milestone_section(rm_lines, milestone)
    section = rm_lines[start:sec_end]
    if not _milestone_all_complete(section):
        raise be.BacklogEditError(
            f"milestone {milestone!r} is not fully complete "
            f"(heading must be [x] and no sub-item may be [ ]); "
            f"refusing to migrate. Mark it complete first or salvage sub-items."
        )

    # Stamp the heading with the migrated-date note (idempotent: don't double-stamp).
    hm = _MILESTONE_HEADING_RE.match(section[0])
    rest = hm.group("rest").rstrip()
    if "(migrated " not in rest:
        rest = f"{rest} (migrated {date_str})"
    migrated_heading = f"## [x] {hm.group('ident')}{rest}"
    migrated_section = [migrated_heading] + section[1:]

    # --- Build the new Completed Roadmap ---
    completed = _roadmap_path(slug, anchor_path, completed=True)
    comp_text = _ensure_completed_roadmap(slug, completed)
    comp_lines = comp_text.splitlines()

    # Find the H1 line.
    h1_idx = next((i for i, l in enumerate(comp_lines) if l.startswith("# ")), -1)
    insert_base = h1_idx + 1 if h1_idx >= 0 else 0

    # Seal the existing top standalone grouping (if any) by leaving it in place,
    # then insert the migrated milestone just below it; finally open a fresh
    # standalone grouping at the very top.
    fresh_grouping = [
        "",
        f"## Completed standalone features (since {milestone} migration, {date_str})",
        "",
    ]
    # Locate the first existing standalone grouping after the H1 (the current one).
    existing_group_idx = None
    for i in range(insert_base, len(comp_lines)):
        if _STANDALONE_GROUPING_RE.match(comp_lines[i]):
            existing_group_idx = i
            break

    if existing_group_idx is not None:
        # End of the existing (now-sealed) grouping = next H2 or EOF.
        seal_end = len(comp_lines)
        for j in range(existing_group_idx + 1, len(comp_lines)):
            if comp_lines[j].startswith("## "):
                seal_end = j
                break
        # Trim trailing blanks of the sealed grouping.
        while seal_end > existing_group_idx + 1 and comp_lines[seal_end - 1].strip() == "":
            seal_end -= 1
        # New layout: H1 + fresh grouping + sealed grouping + migrated milestone + rest.
        new_comp = (
            comp_lines[:insert_base]
            + fresh_grouping
            + comp_lines[existing_group_idx:seal_end]
            + [""]
            + migrated_section
            + [""]
            + comp_lines[seal_end:]
        )
    else:
        # No existing grouping — start fresh grouping then the milestone.
        new_comp = (
            comp_lines[:insert_base]
            + fresh_grouping
            + migrated_section
            + [""]
            + comp_lines[insert_base:]
        )
    completed.write_text("\n".join(new_comp).rstrip("\n") + "\n", encoding="utf-8")
    _selffire(completed)

    # --- Remove the milestone from the live Roadmap ---
    # Drop lines[start:next_h2] (heading through the blank run before next H2).
    del rm_lines[start:next_h2]
    # Collapse any doubled blank lines left at the seam.
    cleaned = []
    for i, l in enumerate(rm_lines):
        if l.strip() == "" and cleaned and cleaned[-1].strip() == "":
            continue
        cleaned.append(l)
    roadmap.write_text("\n".join(cleaned).rstrip("\n") + "\n", encoding="utf-8")
    _selffire(roadmap)

    print(f"{slug}: migrated {milestone} → {completed.name} (migrated {date_str}); "
          f"sealed standalone grouping + opened fresh one")
    return 0


# ============================================================
# Address resolution — <anchor> <doc> <label> (F236, verb-first since F293)
#   state [-a ANCHOR] <doc> <label> <verb> [flags] [< body]
#
# <doc>   Backlog (case-insensitive) | wiki-name | path to a .md file
# <label> LETTERS+DIGITS — Q7 / V3 / F157 / T8 — the "queries" umbrella term
# <verb>  define | resolve | remove
#
# Additive: task/q/status/roadmap keep working unchanged. Dispatch in main()
# routes here whenever the first positional isn't one of those domain names.
# ============================================================


_LABEL_RE = re.compile(r"^([A-Z]+)(\d+|\+)$")
# F250 #11 — `/symlinks/` (dotfile-mirror trees) and `/Closet/` (parked copies)
# are the two places a live doc is duplicated on disk; walking them makes a
# single real doc surface as multiple candidates → false "ambiguous" refusal.
_SKIP_PATH_FRAGMENTS = (
    "/.trash/", "/Yore/", "/_ARCHIVES_/", "/Versions/", "/symlinks/", "/Closet/",
)


def parse_label(label):
    """Split a label into (letters, number). `number` is an int (Q7, V3,
    F157, T8) or the literal string `"+"` for an auto-mint label (F+, T+,
    Q+, V+ — only legal with `define`). Raises on anything not matching
    `^[A-Z]+(\\d+|\\+)$`."""
    m = _LABEL_RE.match(label)
    if not m:
        raise be.BacklogEditError(
            f"invalid label {label!r} — expected LETTERS+DIGITS or "
            f"LETTERS+'+' to auto-mint (e.g. Q7, V3, F157, T8, F+, T+)"
        )
    num = m.group(2)
    return m.group(1), (num if num == "+" else int(num))


# T086 — the row-scoped address. `Backlog T041.Q1` names question 1 hosted
# INSIDE row T041, which is neither a doc-hosted Q (`<doc> Q<n>`) nor an F275
# standalone Q-row (`Backlog Q<n>`) and so had no address at all: the only way
# to touch one was to rewrite the whole row, the exact hand-edit the F247 stamp
# exists to detect.
#
# Dotted rather than a fourth positional or a flag, because F293 settled the
# grammar hours before this was built and the settlement is what makes the
# choice cheap: the label slot is the third positional, `<row>.<Q<n>>` extends
# what goes IN that slot, and every verb, anchor and doc argument stays where
# it was. A `--q 1` flag would have put the same information outside the
# address, where `show` and `resolve` would each have to opt into it.
#
# `.+` is greedy on purpose: an R-row's handle is a dotted name-path
# (`R-Scaffolding.5.2`), so the row part must be allowed to contain dots and
# the LAST `.Q<digits>` is the question. Anything else is not a row-scoped
# address and falls through to the ordinary label parser untouched.
_ROW_Q_LABEL_RE = re.compile(r"^(?P<row>.+)\.Q(?P<q>\d+)$")


def parse_row_q_label(label):
    """(row_label, q_num) for `T041.Q1`, or None when this is a plain label."""
    m = _ROW_Q_LABEL_RE.match(label)
    if not m:
        return None
    return m.group("row"), int(m.group("q"))


def _find_doc_by_basename(root, target_lower):
    """Case-insensitive `.md` basename search under root, skipping noisy
    path fragments (mirrors be.SKIP_PATH_FRAGMENTS's spirit with the
    spec's own skip-list). Returns a list of matching Paths."""
    matches = []
    root = Path(root)
    if not root.is_dir():
        return matches
    # F250 #11 — `followlinks=True` + duplicate on-disk copies can surface the
    # SAME real doc more than once; dedupe by resolved path so an identity-equal
    # file never reads as an ambiguous multi-candidate hit.
    seen = set()
    for r, dirs, files in os.walk(root, followlinks=True):
        rp = r + "/"
        if any(frag in rp for frag in _SKIP_PATH_FRAGMENTS):
            dirs[:] = []
            continue
        for f in files:
            if f.lower() == target_lower:
                p = Path(r) / f
                key = p.resolve()
                if key in seen:
                    continue
                seen.add(key)
                matches.append(p)
    return matches


def resolve_doc(doc_arg, slug, anchor_path):
    """Resolve the `<doc>` token of the address.

    Returns ('backlog', path) for the literal `Backlog`, or ('doc', path)
    for anything else. Path mode (absolute/relative path ending in `.md` or
    containing a `/`) resolves directly. Wiki-name mode (no slash, no `.md`)
    resolves case-insensitively by basename — anchor tree first, then the
    vault root. Zero matches errors; multiple matches errors listing every
    candidate (never guess).

    T082 — the KIND is decided by WHICH FILE resolved, not by which spelling the
    caller used. `Backlog`, `Tink Backlog`, `Tink Backlog.md` and an absolute
    path to the same file are all the backlog. Previously only the bare keyword
    took the backlog branch, so the full-name form resolved the right file and
    then rejected `F+` as an "unknown query kind" — an error that named
    `Tink Backlog.md` as the target while listing the labels valid "on Backlog".
    It cost an agent three wrong turns and produced a false "state is broken"
    report to Dan.
    """
    kind, path = _resolve_doc_path(doc_arg, slug, anchor_path)
    if kind == "doc":
        try:
            if path.resolve() == be.find_backlog(slug).resolve():
                return ("backlog", path)
        except Exception:
            pass          # anchor has no backlog — an ordinary doc, then
    return (kind, path)


def _resolve_doc_path(doc_arg, slug, anchor_path):
    """Locate the file named by `<doc>`. The kind returned here is provisional;
    `resolve_doc` re-classifies a path that turns out to be the backlog."""
    if doc_arg.strip().lower() == "backlog":
        return ("backlog", be.find_backlog(slug))

    if "/" in doc_arg or doc_arg.endswith(".md") or doc_arg.startswith("~"):
        p = Path(doc_arg).expanduser()
        p = p.resolve() if p.is_absolute() else (Path.cwd() / p).resolve()
        if not p.is_file():
            raise be.BacklogEditError(f"doc path not found: {p}")
        return ("doc", p)

    target_lower = f"{doc_arg}.md".lower()
    anchor_matches = _find_doc_by_basename(anchor_path, target_lower)
    if anchor_matches:
        if len(anchor_matches) > 1:
            cand = "\n  ".join(str(m) for m in anchor_matches)
            raise be.BacklogEditError(
                f"ambiguous doc name {doc_arg!r} — multiple candidates under "
                f"the anchor:\n  {cand}\nUse a path instead to disambiguate."
            )
        return ("doc", anchor_matches[0])

    vault_matches = _find_doc_by_basename(be.VAULT_ROOT, target_lower)
    if not vault_matches:
        raise be.BacklogEditError(
            f"no doc found matching {doc_arg!r} (.md) under the anchor or "
            f"vault root {be.VAULT_ROOT}"
        )
    if len(vault_matches) > 1:
        cand = "\n  ".join(str(m) for m in vault_matches)
        raise be.BacklogEditError(
            f"ambiguous doc name {doc_arg!r} — multiple candidates in the "
            f"vault:\n  {cand}\nUse a path instead to disambiguate."
        )
    return ("doc", vault_matches[0])


def _validate_ask_format_body(body):
    """Write-time gate for `Q<n> define` bodies — refuses anything that
    doesn't carry the ask-format basics: ≥2 own-line labeled option bullets
    AND a `- **Recommendation:**` line at indent 0 (value may be `None`).
    The full discipline (block-IDs, strength labels, spacing) is enforced by
    /audit q; this just keeps a flatfooted question from entering at all.
    Per [[DAS ask-format]].
    """
    option_re = re.compile(r"^\s*-\s+\*\*\([A-Za-z0-9]+\)\*\*", re.MULTILINE)
    options = option_re.findall(body)
    if len(options) < 2:
        raise be.BacklogEditError(
            "define refused: ask-format requires ≥2 labeled option "
            "bullets, each on its own line (e.g. `- **(A)** ...`); found "
            f"{len(options)}. See [[DAS ask-format]]."
        )
    rec_re = re.compile(r"^\s*-\s+\*\*Recommendation:\*\*", re.MULTILINE)  # `^\s*-`: a standalone Backlog Q-row (F275) carries Recommendation as an indented sub-bullet
    if not rec_re.search(body):
        raise be.BacklogEditError(
            "define refused: ask-format requires a `- **Recommendation:**` "
            "line at indent 0 (value may be `None`). See [[DAS ask-format]]."
        )


def _run_question_gates(q_num, body, why_ask, require_on_answer=False):
    """Shared write-time question-gate sequence, single-sourced for both the
    doc-scoped `Q<n> define` (_q_define_core) and the standalone Backlog `Q<n>`
    row (F275 M2). In order: ask-format (≥2 options + Recommendation);
    optionally the F275 `On answer:` clause (hard-required on standalone Q
    rows, M3); the F270 Damage field; and — for a surfacing category — the
    F257 who-should-decide gate followed by the T160 risk-of-the-lean gate.
    Returns (body, auto_resolve, reason_cat, reason_why); `reason_cat` names
    whichever route auto-resolved the question (a F270 Damage class, or T160's
    `interpretation`), and `body` may gain a `· *why-ask:*` annotation. Raises
    BacklogEditError on any refusal. `q_num` is the display number for
    messages (the row/Q number)."""
    _validate_ask_format_body(body)
    if require_on_answer and not _ON_ANSWER_RE.search(body):
        raise be.BacklogEditError(
            f"define refused: a standalone Q row (Q{q_num}) requires a "
            "`- **On answer:**` line stating the concrete consequence of each "
            "answer (F275 M3) — e.g. `- **On answer:** (A) → <do X>; (B) → "
            "<do Y>`. An agent that cannot state what changes has a musing, "
            "not a question. See [[DAS ask-format]]."
        )
    # F270 — the Damage field decides surface vs auto-resolve. waste/priority
    # never reach the user: they skip the F257 why-ask gate (which would refuse
    # a Lean-without-why-ask) and are resolved to the agent's lean by the caller.
    damage_cat, damage_why = be.parse_damage(body)
    if damage_cat is None:
        sys.stderr.write(
            f"⚠ Q{q_num} has no `- **Damage:**` line, so it was SURFACED by default.\n"
            "  → Re-run this same define with a Damage line appended to the Q body — the\n"
            "    first word is the category, then one sentence on what breaks if you guess wrong:\n"
            "      • waste / priority                        → auto-resolved for you, never reaches the user\n"
            "      • irreversible / locking / taste / other  → surfaces to the user\n"
            "    e.g.  `- **Damage:** waste — a wrong pick just re-runs one step`\n"
            "    A waste/priority re-run replaces this surfaced Q and auto-resolves it.\n"
            "  See [[DAS ask-format]] § The Damage field.\n"
        )
    auto_resolve = damage_cat in be.DAMAGE_AUTO_RESOLVE
    reason_cat, reason_why = damage_cat, damage_why
    if not auto_resolve:
        # Surface: the Damage line IS the justification (subsumes --why-ask).
        gate_why = why_ask or (f"{damage_cat}: {damage_why}" if damage_cat else None)
        body = be.question_mint_gate(q_num, body, gate_why)  # F257 who-should-decide gate
        # T160 — last, and only on the surfacing path, because it is the gate
        # about the ANSWER rather than about the question: a Q that F270 has
        # already routed away from the user has no lean left to defend. Its own
        # `interpretation` class is a second auto-resolve door, and it takes
        # over the reason slot when it fires, so the banner and the recorded
        # note say which of the two routes actually closed the question.
        risk_cat, risk_why = be.risk_of_lean_gate(
            q_num, body, be.recommendation_strength(body))
        if risk_cat in be.RISK_AUTO_RESOLVE:
            auto_resolve = True
            reason_cat, reason_why = risk_cat, risk_why
    return body, auto_resolve, reason_cat, reason_why


def _auto_resolve_note(cat, why):
    """The note recorded on a question that closed itself."""
    return f"auto-resolved ({cat})" + (f" — {why}" if why else "")


def _auto_resolve_banner(label, cat, choice):
    """The one line the agent is told when a Q never reaches the user.

    Names WHICH of the two routes closed it. They are different rules with
    different arguments, and an agent that reads "waste/priority never reach the
    user" over a question closed by T160 will look for a Damage line it never
    wrote — the same mis-attribution that would let it re-file to get past the
    gate, which is exactly what happened to F217 Q4 under F270 alone.
    """
    if cat in be.RISK_AUTO_RESOLVE:
        field, rule = "the stated risk of the lean", (
            "the only casualty you could name was your own reading of the "
            "request, and a risk that lives inside your head is a question you "
            "are asking yourself (T160)")
    else:
        field, rule = "damage", "waste/priority never reach the user (F270)"
    return (f"⚑ {label} auto-resolved — {field} was **{cat}**, picked "
            f"{choice}; not surfaced — {rule}. Proceed with that choice.")


# ------------------------------------------------------------------
# Backlog target (F/T/C labels)


_MINT_PLACEHOLDER_RE = re.compile(r"\*\*[FTCQ]\+(\s+—)")  # F250#8: C+ was omitted → `C+ define` never rewrote the placeholder; F275: Q+ for standalone question rows
_REC_BULLET_RE = re.compile(r"^\s*-\s+\*\*Recommendation:\*\*")  # MUX T042 — the one bullet allowed to keep its trailing blank (audit-q C20)
# T137 — the bullets that may legally follow a Recommendation and still count as
# part of it for C20's separator: F270's Damage and F275 M3's On-answer. Both
# post-date the C20 rule, which is why the separator logic only knew about the
# Recommendation line itself. Extend this set whenever a new continuation is
# minted, or that Q shape becomes unauthorable through `state` again.
_REC_CONTINUATION_RE = re.compile(
    r"^\s*-\s+\*\*(?:Damage|On answer|Risk of \([A-Za-z]\w*\)):\*\*")
_ON_ANSWER_RE = re.compile(r"^\s*-\s+\*\*On answer:\*\*", re.MULTILINE)  # F275 M3 — the resumption clause, hard-required on standalone Q rows


def _row_define(slug, backlog_path, label, args, minted=False, raw_override=None):
    """`Backlog <F|T> define` — create-or-replace the whole row. The body IS
    the complete row markdown (`- **<label> — Title** [Status] — body`),
    optionally followed by indented sub-bullets. Routes through
    `_delegate_row_edit` (same guard machinery `task create`/`update` use) so
    status/Verify/Next/Questions promises still enforce.

    `minted=True` (F+/T+ auto-mint, F236) means `label` is the freshly-minted
    id and the caller's body may still carry the `F+`/`T+` placeholder (e.g.
    `- **F+ — Title** [Status]`) — the first occurrence is swapped for the
    real label before parsing. A body that already names the minted label
    directly (no placeholder) is left alone (no double-substitution).

    `raw_override` (F275) lets a caller that already read+transformed the body
    (the standalone-Q path, which runs the question gates first) hand the final
    markdown in directly, since stdin can only be read once."""
    raw = raw_override if raw_override is not None else read_body(args)
    if not raw.strip():
        raise be.BacklogEditError(
            "define requires a body via stdin or --body — the complete row "
            f"markdown (`- **{label} — Title** [Status] — body`, optionally "
            "followed by indented sub-bullets)"
        )
    body_lines = raw.rstrip("\n").splitlines()
    first = body_lines[0].strip()
    if minted:
        first = _MINT_PLACEHOLDER_RE.sub(f"**{label}\\1", first, count=1)
        body_lines[0] = first
    m = be.ROW_FULL_RE.match(first)
    if not m or m.group("rid") != label:
        raise be.BacklogEditError(
            f"define body's first line doesn't parse as a row for {label}: "
            f"expected `- **{label} — Title** [Status] — body`, got {first!r}"
        )
    title = (m.group("title") or "").strip()
    status = m.group("status").strip()
    row_body = (m.group("body") or "").strip()
    # Blank lines are dropped from a row body EXCEPT the one immediately after a
    # `- **Recommendation:**` bullet, which audit-q C20 requires as the separator
    # between a Q group and whatever follows it. Without this carve-out C20 is
    # unsatisfiable for every row-hosted question: fixing C9 (add a Recommendation
    # bullet) is what makes C20 reachable at all, and the blank it then demands
    # used to be stripped right back out here — a permanent finding floor on every
    # anchor. Safe because a row's extent is delimited by the next row start or H2,
    # never by a blank line (`backlog-edit.py` scan_backlog / boundary_lines), so a
    # blank inside a body does not split the row. See MUX T042.
    sub_lines = []
    for l in body_lines[1:]:
        if l.strip():
            sub_lines.append(l)
        elif sub_lines and _REC_BULLET_RE.match(sub_lines[-1]):
            sub_lines.append("")
    # A Recommendation that ends the body needs the separator too, and a trailing
    # blank can never arrive here — `raw.rstrip("\n")` above eats it — so add it
    # unconditionally rather than relying on the caller to supply one.
    #
    # T137 — the separator belongs after the last CONTINUATION of the
    # Recommendation, not after the Recommendation line. This test was written
    # when `- **Recommendation:**` was the last thing a Q could carry; F270 then
    # added `- **Damage:**` and F275 M3 `- **On answer:**`, both of which sit
    # after it. An inline row-Q ending in `On answer:` therefore got no blank,
    # C20 fired on every one, and the finding was unfixable through the
    # sanctioned path — the caller could supply the blank and `raw.rstrip("\n")`
    # would eat it. Same shape as T120: a writer and a checker holding different
    # beliefs, with the writer winning on disk.
    if sub_lines and (_REC_BULLET_RE.match(sub_lines[-1])
                      or (_REC_CONTINUATION_RE.match(sub_lines[-1])
                          and any(_REC_BULLET_RE.match(l) for l in sub_lines))):
        sub_lines.append("")

    # A `- **Next:**` / `- **Verify:**` sub-bullet in the define body IS the
    # status promise — thread it through the guard (which otherwise refuses
    # Ready/Active/Verify rows as promise-less) and let perform_edit place it,
    # rather than raw-attaching it after the guard already rejected the row.
    next_text = verify_text = user_text = None
    kept_subs = []
    for l in sub_lines:
        nm = re.match(r"^\s*-\s+\*\*Next:\*\*\s*(.+)$", l)
        vm = re.match(r"^\s*-\s+\*\*Verify:\*\*\s*(.+)$", l)
        um = re.match(r"^\s*-\s+\*\*User:\*\*\s*(.+)$", l)
        if nm and next_text is None:
            next_text = nm.group(1).strip()
        elif vm and verify_text is None:
            verify_text = vm.group(1).strip()
        elif um and user_text is None:
            user_text = um.group(1).strip()
        else:
            kept_subs.append(l)
    sub_lines = kept_subs

    icebox_path = be.find_icebox(slug)
    exists = be.row_in_file(backlog_path, label) or bool(
        icebox_path and be.row_in_file(icebox_path, label)
    )
    if args.horizon:
        horizon = args.horizon
    elif exists:
        horizon = "same"
    else:
        horizon = "Now"

    # Sub-bullets ride through perform_edit (pending_subs) so they land in the
    # SAME write as the row — attaching them after _delegate_row_edit let the
    # in-delegate refresh_q_md audit a sub-bullet-less row (C24 --fix then
    # rebracketed a fresh [Questions] T-row to [Ready]; bit T010 2026-07-13).
    return _delegate_row_edit(
        slug, horizon, label, status, title, row_body,
        title_provided=True, body_provided=True,
        verify_text=verify_text, next_text=next_text,
        pending_subs=sub_lines,
        why_user=getattr(args, "why_user", None),
        user_text=user_text,
        why_user_action=getattr(args, "why_user_action", None),
    )


_ROW_Q_HEADER_RE = re.compile(r"^(\s*)-\s+\*\*Q(\d+)\b")
_ROW_SUB_RE = re.compile(r"^\s+-\s")


def _row_q_spans(lines, row_start, row_end):
    """[(q_num, start, end), …] for the PENDING questions hosted by a row.

    A question's span runs to the next sub-bullet at its OWN indent — its
    options and Recommendation are indented deeper and belong to it, while a
    sibling `- **Next:**` at the same depth does not. Restricting to the
    pending prefix is `be.row_pending_q_lines`'s job, applied first, so an
    already-archived question is invisible here rather than resolvable twice.
    """
    sub = lines[row_start + 1:row_end]
    pending = be.row_pending_q_lines(sub)
    heads = []
    for k, line in enumerate(pending):
        m = _ROW_Q_HEADER_RE.match(line)
        if m:
            heads.append((int(m.group(2)), len(m.group(1)), k))
    spans = []
    for i, (num, indent, k) in enumerate(heads):
        end = len(pending)
        for j in range(k + 1, len(pending)):
            m2 = _ROW_SUB_RE.match(pending[j])
            if m2 and len(pending[j]) - len(pending[j].lstrip()) <= indent:
                end = j
                break
        while end > k + 1 and not pending[end - 1].strip():
            end -= 1
        spans.append((num, row_start + 1 + k, row_start + 1 + end))
    return spans


def _format_row_resolved_q(q_num, parsed, outcome, note, today, indent):
    """The archived row-Q, as nested bullets in the same order the doc-side
    entry uses — question, then resolution, then the options, then the lean.

    Deliberately the same reading order as `_format_resolved_entry`, and for
    the same reason: leading with the answer buries what was asked, and the
    lean is kept apart from the outcome because the delta between advice and
    decision is the calibration signal a single conflated line destroys. Only
    the markup differs, because a row cannot carry headings.
    """
    pad = " " * indent
    head = f"{pad}- **Q{q_num} — {parsed['title']}** (resolved {today})"
    if parsed["anchor"]:
        head += f" {parsed['anchor']}"
    out = [head]
    if parsed["question"]:
        out.append(f"{pad}  - {parsed['question']}")
    out.append(f"{pad}  - **Resolved:** {outcome}")
    if note.strip():
        for ln in note.strip().splitlines():
            out.append(f"{pad}  - {ln.strip()}" if ln.strip() else "")
    for letter, text in parsed["options"]:
        out.append(f"{pad}  - **({letter})** {text}".rstrip())
    if parsed["lean"]:
        out.append(f"{pad}  - **Lean:** {parsed['lean']}")
    return out


def _row_q_resolve(slug, backlog_path, row_label, q_num, args):
    """`resolve <anchor> Backlog <row>.Q<n>` — answer a row-hosted question in
    place (T086).

    The question does not leave the row. It moves below a `- **Resolved**`
    sub-bullet keeping its full option list, with the resolution written under
    it — the row-scoped mirror of what F291 does to a doc's Open Questions
    block, down to the zone being a boundary the open count reads as a prefix.

    It differs from the doc side in one way, and the difference is forced: a
    doc's block is deleted and migrated once the last question lands, because
    the block is scaffolding around the questions. A row is not scaffolding —
    it is the work item, and it outlives every question asked about it — so
    there is nowhere to migrate TO and the archive stays where it is.

    The `[N Questions]` bracket is recomputed here rather than left to the
    audit that follows. audit-q would eventually reach the same number, but
    "eventually" is a window in which the row's bracket contradicts its own
    contents, and the bracket is what the queue counts.
    """
    choice = getattr(args, "choice", None)
    note = read_body(args)
    icebox_path = be.find_icebox(slug)
    src_file = None
    if be.row_in_file(backlog_path, row_label):
        src_file = backlog_path
    elif icebox_path and be.row_in_file(icebox_path, row_label):
        src_file = icebox_path
    if src_file is None:
        raise be.BacklogEditError(
            f"{row_label} not found in {backlog_path.name} or Icebox — "
            f"nothing to resolve"
        )
    complaint = be.heal_backlog_if_stale(slug, src_file)
    if complaint:
        print(complaint, file=sys.stderr)

    lines = src_file.read_text(encoding="utf-8").splitlines()
    span = _row_span(lines, row_label)
    if span is None:
        raise be.BacklogEditError(f"{row_label} not found in {src_file.name}")
    row_start, row_end = span
    spans = _row_q_spans(lines, row_start, row_end)
    match = [s for s in spans if s[0] == q_num]
    if not match:
        open_qs = ", ".join(f"Q{n}" for n, _, _ in spans) or "none"
        raise be.BacklogEditError(
            f"{row_label} has no pending Q{q_num} — open questions on this "
            f"row: {open_qs}. (An already-resolved question stays in the "
            f"row's `- **Resolved**` zone and cannot be resolved twice; "
            f"`state show {slug} Backlog {row_label}` prints the whole row.)"
        )
    _, q_start, q_end = match[0]
    q_lines = lines[q_start:q_end]
    indent = len(q_lines[0]) - len(q_lines[0].lstrip())
    # No de-indenting: every regex `_parse_q_block` uses is anchored `^\s*`,
    # so the row's nesting depth reads the same as a doc block's zero depth.
    parsed = _parse_q_block(_trim_blanks(q_lines))
    outcome = _resolve_outcome(choice, parsed["options"], q_num)
    entry = _format_row_resolved_q(q_num, parsed, outcome, note,
                                   date.today().isoformat(), indent)

    lines = lines[:q_start] + lines[q_end:]
    row_start, row_end = _row_span(lines, row_label)
    zone_at = None
    for k in range(row_start + 1, row_end):
        if be._ROW_Q_ZONE_HEAD_RE.match(lines[k]):
            zone_at = k
            break
    if zone_at is None:
        insert = row_end
        while insert > row_start + 1 and not lines[insert - 1].strip():
            insert -= 1
        lines = (lines[:insert] + [f"{' ' * indent}{be.ROW_Q_RESOLVED_HEAD}"]
                 + entry + lines[insert:])
    else:
        insert = row_end
        while insert > zone_at + 1 and not lines[insert - 1].strip():
            insert -= 1
        lines = lines[:insert] + entry + lines[insert:]

    row_start, row_end = _row_span(lines, row_label)
    still_open = be.count_row_pending_qs(lines[row_start + 1:row_end])
    lines = _rebracket_questions_row(lines, row_start, still_open)
    keep = [l + "\n" for l in lines]
    keep = be.restamp_backlog(keep)
    be.write_backlog_lines(src_file, keep)
    be._selffire(src_file)

    summary = (f"resolved {row_label}.Q{q_num} ({outcome.split(' — ')[0]}) "
               f"in {src_file.name} — {still_open} still open on the row")
    _post_conditions_and_print(slug, src_file, summary)
    return 0


_QUESTIONS_BRACKET_RE = re.compile(r"^(-\s+\*\*.+?\*\*\s+\[)(\d+\s+)?Questions?(\])")


def _rebracket_questions_row(lines, row_start, still_open):
    """Recount a `[N Questions]` bracket after one of the row's questions lands.

    Touches ONLY a Questions bracket. A row can legitimately host questions
    while bracketed something else — T041 sat at `[Ready]` with three open Qs,
    which is a separate defect and not this verb's to decide — and silently
    rewriting such a row's status would make `resolve` a status-changing verb
    behind the caller's back.

    At zero the bracket is left alone rather than guessed at. What a
    question-free row should say next is a real judgment ([Ready] needs a
    `- **Next:**` per F171, [Done] needs the work to be finished), audit-q's
    C24 already reports the staleness with that judgment attached, and a wrong
    guess here would be a status transition nobody asked for.
    """
    m = _QUESTIONS_BRACKET_RE.match(lines[row_start])
    if not m or still_open == 0:
        return lines
    bracket = "Questions" if still_open == 1 else f"{still_open} Questions"
    lines[row_start] = _QUESTIONS_BRACKET_RE.sub(
        lambda mm: f"{mm.group(1)}{bracket}{mm.group(3)}", lines[row_start], count=1)
    return lines


def _row_resolve(slug, backlog_path, label, args):
    """`Backlog <F|T> resolve` — move the row to `## Done` [Done], appending
    `— resolved <date>: <body>` to the row body."""
    resolution = read_body(args)
    icebox_path = be.find_icebox(slug)
    src_file = None
    if be.row_in_file(backlog_path, label):
        src_file = backlog_path
    elif icebox_path and be.row_in_file(icebox_path, label):
        src_file = icebox_path
    if src_file is None:
        raise be.BacklogEditError(
            f"{label} not found in {backlog_path.name} or Icebox — nothing to resolve"
        )
    lines0 = src_file.read_text(encoding="utf-8").splitlines()
    row_i = None
    for i, line in enumerate(lines0):
        rm = be.ROW_HEADER_RE.match(line)
        if rm and len(rm.group(1)) == 0 and rm.group(2) == label:
            row_i = i
            break
    existing_title, existing_body = (
        be.parse_existing_row(lines0[row_i]) if row_i is not None else ("", "")
    )
    today = date.today().isoformat()
    note = f"resolved {today}"
    if resolution.strip():
        note += f": {resolution.strip()}"
    new_body = f"{existing_body} — {note}" if existing_body else note
    return _delegate_row_edit(
        slug, "Done", label, "Done", existing_title, new_body,
        title_provided=True, body_provided=True,
    )


def _row_set(slug, backlog_path, label, args):
    """`Backlog <F|T> set` — partial row update: only the fields named by a
    flag change; everything else (title/body/status/horizon) is left as-is.
    Unlike `define` (which replaces the row wholesale from one full markdown
    line), `set` takes each field via its own flag and never reads a body
    from stdin or --from-file."""
    if not any([args.status, args.horizon, args.title is not None,
                args.inline is not None, args.next_step is not None,
                args.verify is not None, getattr(args, "user", None) is not None]):
        raise be.BacklogEditError(
            "set requires at least one of --status / --horizon / --title / "
            "--body / --next / --verify / --user"
        )
    # `set` used to refuse --from-file here at runtime, because v2 declared all
    # thirteen flags globally and every verb inherited every one of them. F293
    # gives each verb its own subparser, so the flag `set` does not accept is
    # simply a flag `set` does not declare — argparse rejects it by name.
    return _delegate_row_edit(
        slug, args.horizon or "same", label, args.status or "same",
        args.title or "", args.inline or "",
        title_provided=args.title is not None,
        body_provided=args.inline is not None,
        verify_text=args.verify, next_text=args.next_step,
        why_user=getattr(args, "why_user", None),
        user_text=getattr(args, "user", None),
        drop_pointer=getattr(args, "drop_pointer", False),
        why_user_action=getattr(args, "why_user_action", None),
    )


def _row_verb(slug, backlog_path, label, verb, args, minted=False):
    if verb == "define":
        return _row_define(slug, backlog_path, label, args, minted=minted)
    if verb == "set":
        return _row_set(slug, backlog_path, label, args)
    if verb == "resolve":
        return _row_resolve(slug, backlog_path, label, args)
    if verb == "remove":
        # T064 — echo what is about to be lost, read BEFORE the delete.
        # A row `remove` is a HARD delete: the row line and every sub-bullet
        # under it go, with none of the `### Removed` audit trail a Q gets.
        # `show` serves the caller who looks first; this serves the one who
        # does not, which is why a `remove --dry-run` was dropped rather than
        # built — a dry run only helps someone who already suspected they
        # needed one. Echoed to stderr so stdout stays the status line.
        src = backlog_path.read_text(encoding="utf-8").splitlines(keepends=True)
        span = _row_span(src, label)
        deleted = src[span[0]:span[1]] if span is not None else None
        rc = _delegate_row_edit(
            slug, "same", label, "delete", "", "",
            title_provided=False, body_provided=False,
        )
        if deleted:
            print(f"{slug}: removed markdown was —", file=sys.stderr)
            sys.stderr.write("".join(deleted))
            if not deleted[-1].endswith("\n"):
                sys.stderr.write("\n")
        return rc
    raise be.BacklogEditError(f"unknown verb {verb!r} for a Backlog row")


# ------------------------------------------------------------------
# T162 — `mint-id`: give an existing id-less row an address
#
# A Backlog row's identity is the bolded prefix `ROW_HEADER_RE` reads, and every
# verb in this file addresses a row by that label and nothing else. A row whose
# bold span is prose — `- **Session name unification across HA and MuxUX**
# [Blocked F052] — …` — therefore has no address at all: `set`, `resolve`,
# `remove` and `show` can none of them name it, no count sees it, and the only
# way to give it one was to type the id into the backlog by hand, which is the
# write every gate here exists to prevent. That is a closed loop, and this verb
# is the one operation that opens it.
#
# The id is written in BOTH places, and they must be the same string: the bolded
# `**T042 — …**` is what `state` resolves, the trailing `^T042` is what an
# inbound `[[HA Backlog#^T042|T042]]` resolves, and a row whose two handles
# disagree is addressable by exactly one of its readers.
#
# The row is named by a substring of its title because that is the only handle
# an id-less row has. Ambiguity refuses rather than picks — minting onto the
# wrong row would hand a real id to the wrong body and leave the intended row
# still unreachable, and neither half of that is visible afterwards.

_IDLESS_ROW_RE = re.compile(
    r"^- \*\*(?P<label>.+?)\*\*\s+\[(?P<status>[^\]]*)\](?P<rest>.*?)\s*$")

_MINTABLE_KINDS = ("F", "T", "C", "B", "Q")

# A row's block anchor sits in one of exactly two places: at end of line (the
# authored form, `… body. ^F135`) or immediately after the status bracket (the
# older form still live on HA's `Rename \`patch\` → \`anchor\`` row,
# `[Blocked] ^patch-anchor-rename — parked …`). Both are searched, and NOTHING
# else is: a bare `\s\^\w+` scan would also hit a `^`-anchored regex quoted in a
# row body, and a false positive here refuses a repair that was legitimate.
_ANCHOR_AFTER_BRACKET_RE = re.compile(r"\]\s+(\^[\w.+\-]+)(?=\s|$)")


def _row_block_anchor(line):
    """The `^block-anchor` token a row line already carries, or None."""
    m = be._TRAILING_ANCHORS_RE.search(line)
    if m:
        return m.group(0).strip().split()[-1]
    m = _ANCHOR_AFTER_BRACKET_RE.search(line)
    return m.group(1) if m else None


def _idless_rows(lines):
    """[(idx, title, status)] for every top-level row carrying no row-id.

    "Row-shaped" is the bold-label + `[Status]` bracket shape the backlog's own
    grammar uses; "id-less" is that shape MINUS a `ROW_HEADER_RE` match, which
    is precisely the set no verb can address. Read from the same `ROW_HEADER_RE`
    the editors use rather than a private idea of what an id looks like, so the
    census cannot drift from the addressing it is a census of.

    One false-positive class is known and deliberately not filtered: a prose
    definition-list bullet that QUOTES a row shape (ATT Backlog's `- **Row
    shape** — \\`**F<NNN> — …** [<State>] — …\\``) is row-shaped by this test and
    is not a row. No structural signal separates the two, so the protection is
    the caller's, not the scanner's: `--match` is an explicit substring the
    operator supplies, and an ambiguous one refuses rather than picking. Read
    the listing before minting onto anything you did not put there.
    """
    out = []
    for i, line in enumerate(lines):
        if be.ROW_HEADER_RE.match(line):
            continue
        m = _IDLESS_ROW_RE.match(line.rstrip("\n"))
        if not m:
            continue
        out.append((i, m.group("label").strip(), m.group("status")))
    return out


def _row_mint_id(slug, backlog_path, label_arg, args):
    """`state mint-id <anchor> Backlog <T+|T042> --match "<title text>"`."""
    letters, num = parse_label(label_arg)
    if letters not in _MINTABLE_KINDS:
        raise be.BacklogEditError(
            f"mint-id: {letters!r} is not a row namespace — valid kinds are "
            f"{'/'.join(_MINTABLE_KINDS)} (e.g. T+, F+, T042)")
    match = (args.match or "").strip()
    if not match:
        raise be.BacklogEditError(
            "mint-id requires --match \"<substring of the row's title>\" — an "
            "id-less row has no other handle")

    # F247 — heal any prior raw hand-edit BEFORE this write, exactly as
    # `_delegate_row_edit` does, so the stamp this call leaves is honest.
    complaint = be.heal_backlog_if_stale(slug, backlog_path)
    if complaint:
        print(complaint, file=sys.stderr)

    raw = backlog_path.read_text(encoding="utf-8")
    lines = raw.splitlines(keepends=True)
    census = _idless_rows(lines)
    hits = [c for c in census if match.lower() in c[1].lower()]
    if not hits:
        listing = "\n".join(f"    line {i + 1}: {t}" for i, t, _s in census)
        raise be.BacklogEditError(
            f"mint-id: no id-less row in {backlog_path.name} whose title "
            f"contains {match!r}.\n"
            f"  Id-less rows in this file:\n{listing or '    (none)'}")
    if len(hits) > 1:
        listing = "\n".join(f"    line {i + 1}: {t}" for i, t, _s in hits)
        raise be.BacklogEditError(
            f"mint-id: --match {match!r} names {len(hits)} id-less rows, and an "
            f"id belongs to exactly one row — narrow the match:\n{listing}")

    idx, title, _status = hits[0]
    line = lines[idx].rstrip("\n")

    held = _row_block_anchor(line)
    if held:
        raise be.BacklogEditError(
            f"mint-id refused: that row already carries the block anchor "
            f"`{held}`, and every inbound `[[{backlog_path.stem}#{held}|…]]` "
            f"wiki-link in the vault resolves through it. Minting would have to "
            f"replace it, breaking each of those links silently — the one "
            f"failure mode a link cannot report. Give the row the id its anchor "
            f"already names, or leave it as it is.")

    icebox_path = be.find_icebox(slug)
    if num == "+":
        new_id = be.format_row_id(
            letters, be.mint_cross_file_id(backlog_path, icebox_path, letters))
    else:
        new_id = be.format_row_id(letters, num)
        _l, _h, row_index = be.scan_backlog(raw)
        if new_id in row_index:
            raise be.BacklogEditError(
                f"mint-id: {new_id} already names a row in "
                f"{backlog_path.name} — pick another number, or pass "
                f"{letters}+ to mint the next free one")
        if icebox_path is not None and be.row_in_file(icebox_path, new_id):
            raise be.BacklogEditError(
                f"mint-id: {new_id} already names a row in "
                f"{icebox_path.name} — the backlog and icebox share one "
                f"namespace, so that id is taken")

    # Splice rather than rebuild. Everything after the bold span — the bracket,
    # the em-dash, the body, its internal `**bold**` runs — is content this verb
    # has no opinion about, and a reconstruction is a chance to lose some of it.
    new_line = line.replace("- **", f"- **{new_id} — ", 1) + f" ^{new_id}\n"
    lines[idx] = new_line

    be.write_backlog_lines(backlog_path, lines)

    # T050 — prove it landed by re-reading the DISK, and prove the specific
    # thing this verb promises: that the row is now ADDRESSABLE. Parsing the
    # written line back through `ROW_FULL_RE` and finding it in `scan_backlog`'s
    # index is the same pair of reads every other verb goes through to reach a
    # row, so a pass here means `set`/`resolve`/`show` can reach it too.
    disk = backlog_path.read_text(encoding="utf-8").splitlines(keepends=True)
    _l2, _h2, disk_index = be.scan_backlog("".join(disk))
    landed = disk_index.get(new_id)
    parsed = None
    if landed is not None:
        parsed = be.ROW_FULL_RE.match(disk[landed[0]].rstrip("\n"))
    if landed is None or parsed is None or parsed.group("rid") != new_id:
        backlog_path.write_text(raw, encoding="utf-8")   # T128 — undo, then raise
        raise be.BacklogEditError(
            f"mint-id: {new_id} did not become addressable on disk "
            f"({'row not indexed' if landed is None else 'row line does not parse'})"
            f" — the backlog has been restored to its pre-call bytes.")
    if f"^{new_id}" not in disk[landed[0]]:
        backlog_path.write_text(raw, encoding="utf-8")
        raise be.BacklogEditError(
            f"mint-id: {new_id} landed as a row-id but its `^{new_id}` block "
            f"anchor is missing, so inbound wiki-links would not resolve — "
            f"the backlog has been restored to its pre-call bytes.")

    _selffire(backlog_path)
    horizon = _row_horizon_on_disk(backlog_path, new_id) or "?"
    short = title if len(title) <= 60 else title[:57] + "…"
    summary = f"minted {new_id} onto the id-less row '{short}' in {horizon}"
    be.append_messages(slug, summary, backlog_path)
    be.write_state(slug, {"row_id": new_id, "verb": "mint-id",
                          "h2_name": horizon,
                          "status": (parsed.group("status") or "").strip()})
    be.refresh_q_md(slug)
    try:
        _bl = backlog_path.read_text(encoding="utf-8").splitlines(keepends=True)
        _st = be.restamp_backlog(_bl)
        if _st != _bl:
            be.write_backlog_lines(backlog_path, _st)
    except OSError:
        pass
    print(f"{slug}: {summary}")
    return 0


def cmd_mint_id(slug, anchor_path, args):
    doc_kind, doc_path = resolve_doc(args.doc, slug, anchor_path)
    if doc_kind != "backlog":
        raise be.BacklogEditError(
            "mint-id is Backlog-only — an id-less ROW is the only thing that "
            "has no address; a doc's Q/V items are numbered by construction")
    return _row_mint_id(slug, doc_path, args.label, args)


def _q_row_to_done(body, resolved_note):
    """F275 — rewrite a standalone Q-row's first line so an auto-resolved
    (waste/priority) row lands `[Done]` with the resolution appended to its
    body, mirroring `_row_resolve`'s note shape. The option/Recommendation/
    On-answer sub-bullets ride through unchanged (audit trail)."""
    lines = body.splitlines()
    today = date.today().isoformat()
    first = re.sub(r"\[[^\]]+\]", "[Done]", lines[0], count=1)
    lines[0] = first.rstrip() + f" — resolved {today}: {resolved_note}"
    return "\n".join(lines)


def _backlog_q_define(slug, backlog_path, label, args, minted=False):
    """`Backlog Q<n> define` (F275 M2) — mint a feature-less standalone
    question row: a sibling to F/T rows, but the row body IS the question, so
    it runs the same ask-format + F270 Damage + F257 gates as a doc-scoped Q,
    PLUS the hard-required F275 `On answer:` clause (M3). A waste/priority
    Damage auto-resolves to the agent's lean and lands `[Done]` (never
    surfaces); everything else lands `[Questions]` and renders under
    `## Questions` via the mechanical render."""
    raw = read_body(args)
    if not raw.strip():
        raise be.BacklogEditError(
            "define requires a body via stdin or --body — the complete Q-row "
            f"markdown (`- **{label} — <question>?** [Questions] — <context>`) "
            "followed by indented `- **(A)**`/`- **(B)**` options, a "
            "`- **Recommendation:**`, a `- **Damage:**`, a `- **On answer:**`, "
            "and — when the Recommendation carries a Lean/Strong — a "
            "`- **Risk of (X):**` naming the leaned option (T160)."
        )
    # Swap the `Q+` placeholder to the minted id up front so the gates and the
    # row parser both see the real label (matches _row_define's minted swap).
    if minted:
        raw = _MINT_PLACEHOLDER_RE.sub(f"**{label}\\1", raw, count=1)
    q_num = int(re.match(r"^Q(\d+)$", label).group(1))
    gated, auto_resolve, damage_cat, damage_why = _run_question_gates(
        q_num, raw, getattr(args, "why_ask", None), require_on_answer=True)
    choice = None
    if auto_resolve:
        choice = be.leaned_choice(gated)
        gated = _q_row_to_done(gated, _auto_resolve_note(damage_cat, damage_why))
        args.horizon = "Done"
    # minted=False: the placeholder swap already happened above; pass the gated
    # body straight through (stdin was already consumed by read_body).
    result = _row_define(slug, backlog_path, label, args, minted=False,
                            raw_override=gated)
    if auto_resolve:
        print(_auto_resolve_banner(label, damage_cat, choice))
    return result


# ------------------------------------------------------------------
# Q labels on any doc


def _q_define_core(slug, feature_path, q_num, body, why_ask=None):
    """`<doc> Q<n> define` — create-or-replace Q<n> in place. Reuses
    be._find_q_bullet / be._format_q_bullet / be._ensure_open_questions_h2 —
    the same formatting the legacy `q add`/`q rewrite` verbs use — so define
    subsumes both without duplicating the bullet-formatting logic."""
    # Normalize: callers may pass the full bullet (`- **Q<n> — …` header line,
    # or `- **Q+ — …` on a mint) or just the body content. be._format_q_bullet
    # already accepts the pre-formatted `**Q<n> — …` form — rewrite a `Q+`
    # placeholder to the assigned number, strip only the leading `- ` dash so
    # it takes that branch (never double-wraps), and drop any caller-supplied
    # trailing block-anchor on the first line (the canonical one is re-added).
    if re.match(rf"^\s*-?\s*\*\*Q(?:{q_num}|\+)\s+—", body):
        first, sep, rest = body.partition("\n")
        first = re.sub(r"^\s*-\s+", "", first)
        first = re.sub(r"^(\s*)\*\*Q\+(\s+—)", rf"\g<1>**Q{q_num}\g<2>", first)
        first = re.sub(r"\s+\^[\w-]+\s*$", "", first)
        body = first + (sep + rest if sep else "")
    # Doc-scoped Q: no `On answer:` requirement yet (F275 M3 is standalone-row-
    # only until proven; "once proven, every surfaced Q" is the future).
    body, auto_resolve, damage_cat, damage_why = _run_question_gates(
        q_num, body, why_ask, require_on_answer=False)
    text = feature_path.read_text(encoding="utf-8")
    container_id = _container_id_for_doc(feature_path)
    lines = text.splitlines()
    loc = be._find_q_bullet(lines, q_num)
    new_bullet = be._format_q_bullet(q_num, container_id, body)
    if loc is not None:
        start, end, _ = loc
        body_lines = new_bullet.splitlines()
        # `_find_q_bullet`'s range absorbs the blank line that separated the Q
        # block from whatever follows it, so a bare splice deletes that
        # separator and glues the next `## H2` onto the last bullet —
        # R-progressive-02 then fires on the doc the define just wrote. Put the
        # blank back when the following line needs one. (Observed three times in
        # one session on F237 / F282 / F217, 2026-07-30.)
        if end < len(lines) and lines[end].strip():
            body_lines.append("")
        lines = lines[:start] + body_lines + lines[end:]
        verb_done = "redefined"
    else:
        lines, (h2_start, h2_end) = be._ensure_open_questions_h2(lines)
        # Clamp to the H1 boundary — see _clamp_h2_end_to_h1. Needed here
        # too: be._ensure_open_questions_h2 returns the EXISTING block's
        # range (via be._find_h2) when Open Questions already has a pending
        # Q, and without the clamp a second `define` on the same doc lands
        # its bullet below the H1 instead of inside the pending block.
        h2_end = _clamp_h2_end_to_h1(lines, h2_start, h2_end)
        insert_at = h2_end
        for j in range(h2_start + 1, h2_end):
            if lines[j].startswith("### "):
                insert_at = j
                break
        while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        new_lines = ["", new_bullet] if insert_at > 0 and lines[insert_at - 1].strip() else [new_bullet]
        new_lines = new_lines + [""]
        lines = lines[:insert_at] + new_lines + lines[insert_at:]
        verb_done = "defined"
    lines = be.restamp_open_questions(lines)
    be._write_feature_lines(feature_path, lines)
    _selffire(feature_path)
    if auto_resolve:
        # waste/priority never reach the user — the Q is now written to
        # ## Open Questions; immediately resolve it in place to the agent's lean
        # and tell the agent it was handled (no refusal to work around, per F270).
        choice = be.leaned_choice(body)
        _q_answer_core(slug, feature_path, q_num, None, choice,
                       _auto_resolve_note(damage_cat, damage_why))
        print(_auto_resolve_banner(f"Q{q_num}", damage_cat, choice))
        return 0
    summary = f"{verb_done} Q{q_num} in {feature_path.name}"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _q_revalidate_core(slug, feature_path):
    """`<doc> revalidate` (F241) — validate-then-stamp, never bless-blind.
    Runs every pending Q in the ## Open Questions block through the same
    ask-format gates as `Q+ define`; a format-invalid block is refused with
    the same message define would give. A valid block is rewritten
    canonically (legacy above-the-H1 blocks relocate below the H1) and
    re-stamped. This is the recovery verb after a hand-edit trips the
    integrity-stamp warning; there is deliberately NO blind `--valid` flag
    (it would launder hand-edits past the format gates)."""
    text = feature_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    rng = be._open_questions_range(lines)
    if rng is None:
        print(f"{slug}: no ## Open Questions block in {feature_path.name} — "
              "nothing to revalidate")
        return 0
    start, end = rng
    # Collect pending Q bullets — top-level, outside ### Resolved/Removed.
    q_slices = []
    in_h3 = False
    k = start + 1
    while k < end:
        line = lines[k]
        if line.startswith("### "):
            in_h3 = True
            k += 1
            continue
        m = be._Q_HEADER_BULLET_RE.match(line)
        if m and not in_h3:
            indent = m.group(1)
            j = k + 1
            while j < end:
                nxt = lines[j]
                if nxt.startswith("#"):
                    break
                mh = be._Q_HEADER_BULLET_RE.match(nxt)
                if mh and (len(nxt) - len(nxt.lstrip())) <= len(indent):
                    break
                j += 1
            q_slices.append((int(m.group(2)), k, j))
            k = j
            continue
        k += 1
    # Gate every pending Q through the same ask-format + F257 who-should-decide
    # checks as define (why_ask=None here — an already-vetted Q carries its
    # `*why-ask:*` annotation and is grandfathered; a hand-authored Lean/Strong
    # without one is caught, matching what define would have refused).
    for q_num, s, e in q_slices:
        block = "\n".join(lines[s:e])
        try:
            _validate_ask_format_body(block)
            be.question_mint_gate(q_num, block, None)
        except be.BacklogEditError as err:
            reason = (str(err).replace("backlog_edit: ", "")
                      .replace("define refused: ", ""))
            raise be.BacklogEditError(
                f"revalidate refused: Q{q_num} fails ask-format — {reason} "
                f"Fix the content, or re-issue it through "
                f"`state \"{feature_path.stem}\" Q{q_num} define`."
            )
    # Canonical placement — legacy above-the-H1 blocks relocate below the H1.
    h1_idx = None
    for i, ln in enumerate(lines):
        if ln.startswith("# ") and not ln.startswith("## "):
            h1_idx = i
            break
    relocated = False
    if h1_idx is not None and start < h1_idx:
        block = lines[start:end]
        while block and not block[-1].strip():
            block.pop()
        del lines[start:end]
        while start < len(lines) and not lines[start].strip():
            del lines[start]
        h1_idx = None
        for i, ln in enumerate(lines):
            if ln.startswith("# ") and not ln.startswith("## "):
                h1_idx = i
                break
        insert_at = len(lines)
        for j in range(h1_idx + 1, len(lines)):
            if lines[j].startswith("## "):
                insert_at = j
                break
        lines = lines[:insert_at] + block + [""] + lines[insert_at:]
        relocated = True
    # Phase 2, idempotently (T042). A block that resolved its last Q but kept a
    # stale placeholder line never transitioned, and no verb could clear it —
    # the pathguard (correctly) refuses hand-editing the region, so the anchor
    # was stuck in a groomed state it could not leave. Doing it here makes
    # revalidate the sanctioned repair for that state as well as for a bad stamp.
    lines, phase2 = be.drop_open_questions_if_empty(lines)
    if not phase2:
        lines = be.restamp_open_questions(lines)
    be._write_feature_lines(feature_path, lines)
    _selffire(feature_path)
    if phase2:
        summary = (f"retired the spent ## Open Questions block in "
                   f"{feature_path.name} — no pending questions remained")
    else:
        summary = (f"revalidated Open Questions in {feature_path.name} — "
                   f"{len(q_slices)} pending Q pass ask-format, stamp refreshed"
                   + (", block relocated below the H1" if relocated else ""))
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _query_verb(slug, doc_path, q_num, verb, args):
    if verb == "define":
        body = read_body(args)
        if not body.strip():
            raise be.BacklogEditError("define requires a body via stdin or --body")
        return _q_define_core(slug, doc_path, q_num, body,
                              why_ask=getattr(args, "why_ask", None))
    if verb == "resolve":
        # The required-ness of --choice, and the legality of `none`, live in
        # _resolve_outcome — it is the only place that can see the option list
        # and so the only place that can say what a valid value would be.
        body = read_body(args)
        return _q_answer_core(slug, doc_path, q_num, None, args.choice, body)
    if verb == "remove":
        return _q_remove_core(slug, doc_path, q_num, None, args.reason)
    raise be.BacklogEditError(f"unknown verb {verb!r} for a Q label")


# ------------------------------------------------------------------
# V (verification) labels on any doc — new in F236


_V_HEADER_BULLET_RE = re.compile(r"^(\s*)- \*\*V(\d+)\b")
_V_HEADER_H3_RE = re.compile(r"^(\s*)### V(\d+)\b")


def _next_v_number(doc_text):
    """Lowest unused V-number across pending `## Verifications` bullets +
    bottom `## Resolved` `### V<n>` H3s. Mirrors be._next_q_number for the V
    namespace (F236 V+ auto-mint)."""
    used = set()
    for line in doc_text.splitlines():
        m = _V_HEADER_BULLET_RE.match(line) or _V_HEADER_H3_RE.match(line)
        if m:
            used.add(int(m.group(2)))
    n = 1
    while n in used:
        n += 1
    return n


def _container_id_for_doc(doc_path):
    """Block-id container token for ANY doc target: the F-number for a
    feature doc (`F<n> — Title.md`), else a block-id-safe (`[\\w-]`)
    sanitization of the doc's stem.

    be._container_id_for_feature does the F-number half but returns the raw
    (unsanitized) stem on fallback — safe there because the legacy Q verbs
    only ever call it with a real `F<n> — Title.md` feature doc (never hits
    the fallback in practice). F236 generalized Q/V to ANY doc, so a doc like
    `Smoke Design.md` DOES hit the fallback, and its stem's spaces/em-dashes
    would otherwise land unsanitized inside an Obsidian block-id (`^Smoke
    Design-Q1` — invalid, contains a literal space). Sanitize here instead.

    All three filename forms resolve to the same bare `F298` — the legacy
    `F298 — Title.md`, the slug-prefixed `Tink F298 — Title.md` (F298), and the
    fused `TINK298 - Title.md` (F300, where the `F` is reconstructed rather
    than matched). The slug is redundant inside a doc that already lives in
    that anchor's folder, and keeping the container bare is what stops the
    fallback below from minting `^TINK298---Title-Q1` and stranding every
    `^F<n>-Q<n>` deep link.
    """
    return be.feature_number(doc_path.stem) or re.sub(
        r"[^\w\-]", "-", doc_path.stem)


def _v_format_bullet(v_num, container_id, body):
    """Wrap a V-define body into `- **V<n> — <title>** — <rest> ^<container>-V<n>`.

    If body is already pre-formatted (`**V<n> — Title** — rest`, copy-pasted
    from an existing bullet), normalize the number and reuse it verbatim.
    Otherwise the first line's text (up to an em-dash, if present) becomes
    the title; anything after — on that line or subsequent lines — becomes
    the trailing body.
    """
    body = body.strip()
    # `V+` placeholder (mint form) normalizes like an explicit number — the
    # canonical v_num is stamped into the rebuilt bullet either way.
    m = re.match(r"^-?\s*\*\*V(?:\d+|\+)\s+—\s+(.+?)\*\*(?:\s+—\s+(.*))?$", body, re.DOTALL)
    if m:
        title = m.group(1).strip()
        rest = (m.group(2) or "").strip()
    else:
        lines = body.splitlines()
        first = lines[0].strip()
        rest_lines = [l.strip() for l in lines[1:] if l.strip()]
        if " — " in first:
            title, _, tail = first.partition(" — ")
            title = title.strip()
            rest = tail.strip()
        else:
            title, rest = first, ""
        if rest_lines:
            extra = " ".join(rest_lines)
            rest = f"{rest} {extra}".strip()
    suffix = f" — {rest}" if rest else ""
    anchor = re.sub(r"[^\w\-]", "-", f"{container_id}-V{v_num}")
    return f"- **V{v_num} — {title}**{suffix} ^{anchor}"


def _find_v_bullet(lines, v_num):
    """Locate the pending `V<n>` bullet inside `## Verifications` (excluding
    any `### Resolved`/`### Removed` sub-sections). Mirrors be._find_q_bullet
    scoped to the Verifications H2. Returns (start, end, indent) or None."""
    h2 = be._find_h2(lines, "Verifications")
    if h2 is None:
        return None
    h2_start, h2_end = h2
    in_h3 = None
    for i in range(h2_start + 1, h2_end):
        line = lines[i]
        if line.startswith("### "):
            in_h3 = line.strip()[4:]
            continue
        m = _V_HEADER_BULLET_RE.match(line)
        if m and int(m.group(2)) == v_num and in_h3 is None:
            indent = m.group(1)
            end = h2_end
            for j in range(i + 1, h2_end):
                l = lines[j]
                if l.startswith("### "):
                    end = j
                    break
                mm = _V_HEADER_BULLET_RE.match(l)
                if mm and (len(l) - len(l.lstrip())) <= len(indent):
                    end = j
                    break
            return (i, end, indent)
    return None


def _ensure_verifications_h2(lines):
    """Ensure a `## Verifications` H2 exists — directly after
    `## Success Criteria` when present, else before `## Status`, else at the
    end of the doc. Returns lines (possibly modified) AND (h2_start, h2_end)."""
    existing = be._find_h2(lines, "Verifications")
    if existing is not None:
        return lines, existing
    sc = be._find_h2(lines, "Success Criteria")
    if sc is not None:
        _, sc_end = sc
        insert_at = sc_end
        lines = lines[:insert_at] + ["", "## Verifications", ""] + lines[insert_at:]
        return lines, (insert_at + 1, insert_at + 3)
    st = be._find_h2(lines, "Status")
    if st is not None:
        st_start, _ = st
        lines = lines[:st_start] + ["## Verifications", "", ""] + lines[st_start:]
        return lines, (st_start, st_start + 2)
    if lines and lines[-1].strip():
        lines.append("")
    lines.append("## Verifications")
    lines.append("")
    return lines, (len(lines) - 2, len(lines))


def _v_define_core(slug, doc_path, v_num, body):
    """`<doc> V<n> define` — create-or-replace the V-bullet under
    `## Verifications`."""
    text = doc_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    container_id = _container_id_for_doc(doc_path)
    loc = _find_v_bullet(lines, v_num)
    new_bullet = _v_format_bullet(v_num, container_id, body)
    if loc is not None:
        start, end, _ = loc
        lines = lines[:start] + [new_bullet] + lines[end:]
        verb_done = "redefined"
    else:
        lines, (h2_start, h2_end) = _ensure_verifications_h2(lines)
        insert_at = h2_end
        for j in range(h2_start + 1, h2_end):
            if lines[j].startswith("### "):
                insert_at = j
                break
        while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        new_lines = ["", new_bullet] if insert_at > h2_start + 1 and lines[insert_at - 1].strip() else [new_bullet]
        new_lines = new_lines + [""]
        lines = lines[:insert_at] + new_lines + lines[insert_at:]
        verb_done = "defined"
    be._write_feature_lines(doc_path, lines)
    summary = f"{verb_done} V{v_num} in {doc_path.name}"
    _post_conditions_and_print(slug, doc_path, summary)
    return 0


def _v_resolve_core(slug, doc_path, v_num, body):
    """`<doc> V<n> resolve` — move the V-bullet to the bottom `## Resolved`
    as `### V<n> — Title` with `**Result:** <body> (<date>)`. Drops
    `## Verifications` if that was the last item (mirrors Q's Phase-2
    empty-block cleanup)."""
    text = doc_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    loc = _find_v_bullet(lines, v_num)
    if loc is None:
        raise be.BacklogEditError(
            f"V{v_num} not found in ## Verifications of {doc_path.name}"
        )
    start, end, _ = loc
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*V\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    today = date.today().isoformat()
    result_text = body.strip() or "confirmed"
    h3_lines = [
        "",
        f"### V{v_num} — {title}",
        f"**Result:** {result_text} ({today})",
        "",
    ]
    lines = lines[:start] + lines[end:]
    h2 = be._find_h2(lines, "Verifications")
    if h2 is not None:
        h2_start, h2_end = h2
        empty = True
        for k in range(h2_start + 1, h2_end):
            if lines[k].strip():
                empty = False
                break
        if empty:
            drop_end = h2_end
            while drop_end < len(lines) and not lines[drop_end].strip():
                drop_end += 1
            if drop_end < len(lines):
                lines = lines[:h2_start] + lines[drop_end:]
            else:
                lines = lines[:h2_start]
    lines, (rh2_start, rh2_end) = be._ensure_bottom_resolved_h2(lines)
    insert_at = rh2_end
    while insert_at > rh2_start + 1 and not lines[insert_at - 1].strip():
        insert_at -= 1
    lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    be._write_feature_lines(doc_path, lines)
    summary = f"resolved V{v_num} in {doc_path.name}"
    _post_conditions_and_print(slug, doc_path, summary)
    return 0


def _v_remove_core(slug, doc_path, v_num, reason):
    """`<doc> V<n> remove` — soft-delete, mirroring Q remove: move to a
    `### Removed` H3 nested inside `## Verifications` (audit trail)."""
    text = doc_path.read_text(encoding="utf-8")
    reason = reason or "no reason provided"
    lines = text.splitlines()
    loc = _find_v_bullet(lines, v_num)
    if loc is None:
        raise be.BacklogEditError(
            f"V{v_num} not found in ## Verifications of {doc_path.name}"
        )
    start, end, _ = loc
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*V\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    original_body = "\n".join(lines[start:end]).rstrip()
    today = date.today().isoformat()
    h3_lines = [
        "",
        f"### V{v_num} — {title} (removed {today} — {reason})",
        "",
        "> Original V context (preserved for audit trail):",
    ]
    for ol in original_body.splitlines():
        h3_lines.append(f"> {ol}")
    h3_lines.append("")
    lines = lines[:start] + lines[end:]
    h2 = be._find_h2(lines, "Verifications")
    if h2 is None:
        lines, (h2_start, h2_end) = _ensure_verifications_h2(lines)
    else:
        h2_start, h2_end = h2
    removed = be._find_h3_in_h2(lines, h2_start, h2_end, "Removed")
    if removed is None:
        insert_at = h2_end
        while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + ["", "### Removed", ""] + h3_lines[1:] + lines[insert_at:]
    else:
        r_start, r_end = removed
        insert_at = r_end
        while insert_at > r_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    be._write_feature_lines(doc_path, lines)
    summary = f"removed V{v_num} from {doc_path.name} (reason: {reason})"
    _post_conditions_and_print(slug, doc_path, summary)
    return 0


def _verify_verb(slug, doc_path, v_num, verb, args):
    if verb == "define":
        body = read_body(args)
        if not body.strip():
            raise be.BacklogEditError("define requires a body via stdin or --body")
        return _v_define_core(slug, doc_path, v_num, body)
    if verb == "resolve":
        body = read_body(args)
        return _v_resolve_core(slug, doc_path, v_num, body)
    if verb == "remove":
        return _v_remove_core(slug, doc_path, v_num, args.reason)
    raise be.BacklogEditError(f"unknown verb {verb!r} for a V label")


# ------------------------------------------------------------------
# Top-level dispatch + CLI


def cmd_item(slug, anchor_path, args):
    doc_kind, doc_path = resolve_doc(args.doc, slug, anchor_path)
    row_q = parse_row_q_label(args.label)
    if row_q is not None:
        row_label, q_num = row_q
        if doc_kind != "backlog":
            raise be.BacklogEditError(
                f"{args.label} is a row-scoped address and rows live on the "
                f"Backlog, not {doc_path.name}. A question hosted by a DOC is "
                f"addressed as `{doc_path.stem} Q{q_num}` — no row prefix.")
        if args.verb != "resolve":
            raise be.BacklogEditError(
                f"{args.verb} does not take a row-scoped question address. "
                f"Only `resolve` does (T086): a row's inline Q is written by "
                f"`define`/`set` on the row itself, so the address it needs is "
                f"the one verb that answers a single question in place.")
        return _row_q_resolve(slug, doc_path, row_label, q_num, args)
    letters, num = parse_label(args.label)
    if num == "+" and args.verb != "define":
        raise be.BacklogEditError(
            f"auto-mint label {args.label} is only valid with define"
        )
    if args.verb == "set" and doc_kind != "backlog":
        raise be.BacklogEditError("set is Backlog-only — Q/V items use define")
    if doc_kind == "backlog" and letters == "Q":
        # F275 M2 — standalone feature-less question row (the row body IS the
        # question). define runs the ask-format/Damage/On-answer gates;
        # set/resolve/remove reuse the ordinary row machinery.
        if args.verb == "define":
            if num == "+":
                mint_num = be.mint_cross_file_id(doc_path, be.find_icebox(slug), "Q")
                label = be.format_row_id("Q", mint_num)
            else:
                label = args.label
            return _backlog_q_define(slug, doc_path, label, args, minted=(num == "+"))
        return _row_verb(slug, doc_path, args.label, args.verb, args)
    if doc_kind == "backlog" and letters in ("F", "T", "C"):
        if num == "+":
            mint_num = be.mint_cross_file_id(doc_path, be.find_icebox(slug), letters)
            label = be.format_row_id(letters, mint_num)
            return _row_verb(slug, doc_path, label, args.verb, args, minted=True)
        return _row_verb(slug, doc_path, args.label, args.verb, args)
    if doc_kind == "doc" and letters == "Q":
        if num == "+":
            num = be._next_q_number(doc_path.read_text(encoding="utf-8"))
        return _query_verb(slug, doc_path, num, args.verb, args)
    if doc_kind == "doc" and letters == "V":
        if num == "+":
            num = _next_v_number(doc_path.read_text(encoding="utf-8"))
        return _verify_verb(slug, doc_path, num, args.verb, args)
    where = "Backlog" if doc_kind == "backlog" else doc_path.name
    raise be.BacklogEditError(
        f"unknown query kind {args.label!r} for {where} — valid labels: "
        f"F<n>/T<n>/C<n>/Q<n>/F+/T+/C+/Q+ on Backlog (Q = standalone question "
        f"row), Q<n>/V<n>/Q+/V+ on any other doc"
    )


def _row_span(lines, label):
    """(start, end) of a Backlog row and its indented sub-bullets, or None.

    The span ends at the next indent-0 row or the next H2 — the same boundary
    `be._ensure_subbullet` uses, so `show` and the editors agree on what a row
    IS. Trailing blank lines are trimmed off the end.
    """
    for i, line in enumerate(lines):
        rm = be.ROW_HEADER_RE.match(line)
        if not (rm and len(rm.group(1)) == 0 and rm.group(2) == label):
            continue
        end = len(lines)
        for j in range(i + 1, len(lines)):
            if be.H2_RE.match(lines[j].rstrip()):
                end = j
                break
            rm2 = be.ROW_HEADER_RE.match(lines[j])
            if rm2 and len(rm2.group(1)) == 0:
                end = j
                break
        while end > i + 1 and not lines[end - 1].strip():
            end -= 1
        return i, end
    return None


_ITEM_HEADER_RES = (be._Q_HEADER_BULLET_RE, be._Q_HEADER_H3_RE,
                    _V_HEADER_BULLET_RE, _V_HEADER_H3_RE)


def _doc_item_span(lines, letters, num):
    """(start, end) of a `Q<n>`/`V<n>` item ANYWHERE in a doc, or None.

    Deliberately not restricted to the pending zone: the whole point of a read
    verb is to answer "what does this item say" without the caller having to
    know which zone it is currently sitting in — unresolved, `### Resolved`,
    `### Removed`, or archived under the bottom `## Resolved`. The span ends at
    the next item header or the next heading of any level.
    """
    want = re.compile(rf"^(\s*)(?:- \*\*|### ){letters}{num}\b")
    for i, line in enumerate(lines):
        if not want.match(line):
            continue
        end = len(lines)
        for j in range(i + 1, len(lines)):
            if lines[j].startswith("#"):
                end = j
                break
            if any(rx.match(lines[j]) for rx in _ITEM_HEADER_RES):
                end = j
                break
        while end > i + 1 and not lines[end - 1].strip():
            end -= 1
        return i, end
    return None


def _show_row_q(slug, doc_kind, doc_path, row_label, q_num):
    """Print one row-hosted question — pending or already archived (T086).

    Reads BOTH zones, for the same reason `_doc_item_span` is not restricted to
    the pending one: a read verb answers "what does this say", and making the
    caller know which zone an item currently sits in to look at it defeats the
    verb. `resolve` is where the zones differ, and it says so when they do.
    """
    if doc_kind != "backlog":
        raise be.BacklogEditError(
            f"{row_label}.Q{q_num} is a row-scoped address and rows live on "
            f"the Backlog, not {doc_path.name}.")
    lines = doc_path.read_text(encoding="utf-8").splitlines()
    span = _row_span(lines, row_label)
    src = doc_path
    if span is None:
        icebox_path = be.find_icebox(slug)
        if icebox_path is not None:
            ice = icebox_path.read_text(encoding="utf-8").splitlines()
            span = _row_span(ice, row_label)
            if span is not None:
                lines, src = ice, icebox_path
    if span is None:
        raise be.BacklogEditError(f"{row_label} not found in {doc_path.name}")
    row_start, row_end = span
    hit = next((s for s in _row_q_spans(lines, row_start, row_end)
                if s[0] == q_num), None)
    zone = "pending"
    if hit is None:
        # Not in the prefix — look through the whole row, so an archived
        # question prints rather than reporting itself missing.
        for k in range(row_start + 1, row_end):
            m = _ROW_Q_HEADER_RE.match(lines[k])
            if m and int(m.group(2)) == q_num:
                indent = len(m.group(1))
                end = row_end
                for j in range(k + 1, row_end):
                    if (_ROW_SUB_RE.match(lines[j])
                            and len(lines[j]) - len(lines[j].lstrip()) <= indent):
                        end = j
                        break
                hit, zone = (q_num, k, end), "resolved"
                break
    if hit is None:
        raise be.BacklogEditError(
            f"{row_label} has no Q{q_num} in {src.name}")
    _, start, end = hit
    print(f"{slug}: {row_label}.Q{q_num} in {src.name} "
          f"(lines {start + 1}-{end}, {zone})", file=sys.stderr)
    sys.stdout.write("\n".join(_trim_blanks(lines[start:end])) + "\n")
    return 0


def cmd_show(slug, anchor_path, args):
    """T064 — `state show <anchor> <doc> <label>`: print an item's full markdown,
    sub-bullet span included, and do nothing else.

    `state` had no read verb at all: define/set/resolve/remove are every one of
    them writes, so an agent could create and mutate a row but never ask what
    one currently says. That hole is what made a malformed row unrecoverable —
    the only way through was `remove` (which deletes the row AND its
    sub-bullets outright) then `define`, and nothing let you look first.

    Named `show`, not `get`. `get` reads as the symmetric opposite of `set`,
    and the symmetry does not hold on two counts: `set` is rows-only by design
    while this reads rows, Qs and Vs on any doc, and `set` writes a FIELD
    (`--status Done`) whose true inverse returns one value, whereas this dumps
    the whole item. Git draws the same line for the same reason — `git show`
    displays an object, `git config --get` retrieves a value — and leaving
    `get` unspent keeps it available for scriptable field access later.

    Runs none of the mutation post-conditions: no audit-q, no Q.md refresh, no
    Messages.md entry. Reading is not an event. stdout is the item's markdown
    verbatim so it can be piped straight back into `define`; the locator goes
    to stderr.
    """
    doc_kind, doc_path = resolve_doc(args.doc, slug, anchor_path)
    row_q = parse_row_q_label(args.label)
    if row_q is not None:
        # T086 — `show` takes the row-scoped address too, and not as a
        # courtesy: T064 built this verb precisely so an item could be read
        # before it is written, and `resolve` is a write. Without it the only
        # way to see what `T041.Q1` says is to print the whole row and count
        # sub-bullets by eye — which is how the wrong Q gets answered.
        return _show_row_q(slug, doc_kind, doc_path, *row_q)
    letters, num = parse_label(args.label)
    if num == "+":
        raise be.BacklogEditError(
            f"{args.label} auto-mints a NEW number — there is nothing to show. "
            f"Pass an existing label.")

    lines = doc_path.read_text(encoding="utf-8").splitlines(keepends=True)
    if doc_kind == "backlog" and letters in ("F", "T", "C", "Q"):
        span = _row_span(lines, args.label)
        # A row may have been iceboxed rather than deleted; look there too,
        # exactly as resolve/remove do before reporting a row missing.
        if span is None:
            icebox_path = be.find_icebox(slug)
            if icebox_path is not None:
                ice = icebox_path.read_text(encoding="utf-8").splitlines(keepends=True)
                span = _row_span(ice, args.label)
                if span is not None:
                    lines, doc_path = ice, icebox_path
    elif letters in ("Q", "V"):
        span = _doc_item_span(lines, letters, num)
    else:
        raise be.BacklogEditError(
            f"unknown label kind {args.label!r} — show reads F/T/C/Q rows on "
            f"Backlog and Q/V items on any other doc")

    if span is None:
        raise be.BacklogEditError(
            f"{args.label} not found in {doc_path.name}")

    start, end = span
    print(f"{slug}: {args.label} in {doc_path.name} "
          f"(lines {start + 1}-{end})", file=sys.stderr)
    sys.stdout.write("".join(lines[start:end]))
    if lines[end - 1:end] and not lines[end - 1].endswith("\n"):
        sys.stdout.write("\n")
    return 0


# ============================================================
# T131 — the agent-inbox drop API (design: [[ATT045 - Agent inbox pattern]])
# ============================================================
#
# `drop` is the sender half of the inbox pattern: anyone — the user, another
# agent, a background process — appends one pending item to a target anchor's
# [[DAS Inbox]] file, and nothing executes it. It lives on `state` beside
# `define`/`set` (T131 Q1 → A) because every piece of plumbing it needs is
# already here: anchor resolution, the Track-folder path, the Warden self-fire,
# and the Messages log. A standalone binary would reimplement all four.
#
# Two things the format makes load-bearing, both from ATT F045:
#
#   * **An entry with NO status tag is PENDING.** Drain is what writes `DONE` or
#     `MOVED → {destination}` (R-fct-inbox-03). Absence of a tag is not a new
#     tag, which is why this needed no vocabulary change — so `drop` must never
#     write a backtick-wrapped token onto the H2 line, and it strips backticks
#     out of a derived topic for exactly that reason.
#   * **`--tag` is a message TYPE, not a status.** `fact` / `handoff` / `note` /
#     `nudge` describe what the message IS; `DONE` / `MOVED →` describe what has
#     happened to it. They are different vocabularies with different owners, so
#     the type rides an attribution line under the heading and never the
#     heading itself, where a reader (or R-fct-inbox-03) would read it as a
#     status.

_INBOX_TOPIC_MAX = 60


def _inbox_path(slug, anchor_path):
    """`{prefix} Track/{prefix} Inbox.md` for the target anchor.

    The file PREFIX is read off the anchor's own Backlog filename, not off the
    slug — those differ for every anchor whose display name is not already
    all-caps (`Scout Backlog.md` vs `slug: SCOUT`), the same trap
    `find_backlog`'s docstring names. Deriving from the slug would drop into a
    SECOND Track folder beside the real one, and nothing downstream would say
    which of the two an agent is supposed to read.
    """
    try:
        backlog = be.find_backlog(slug)
    except be.BacklogEditError:
        backlog = None
    if backlog is not None:
        prefix = backlog.name[: -len(" Backlog.md")]
        return be.anchor_track_dir(backlog) / f"{prefix} Inbox.md", backlog
    # No backlog — a Topic or Paper anchor can still receive drops. Fall back to
    # the Track folder itself, and refuse rather than guess when it is ambiguous.
    tracks = sorted(p for p in anchor_path.glob("* Track") if p.is_dir())
    if len(tracks) == 1:
        prefix = tracks[0].name[: -len(" Track")]
        return tracks[0] / f"{prefix} Inbox.md", None
    if not tracks:
        raise be.BacklogEditError(
            f"drop: {slug} has neither a '{slug} Backlog.md' nor a '* Track/' "
            f"folder, so an Inbox created here would sit where no reader looks. "
            f"Give the anchor its Track folder first (`/rewire the track`).")
    raise be.BacklogEditError(
        f"drop: {slug} has {len(tracks)} Track folders "
        f"({', '.join(t.name for t in tracks)}) and no Backlog to say which is "
        f"canonical — refusing to guess which one gets the Inbox.")


def _inbox_template(prefix):
    """The standard top-of-doc for a fresh Inbox, per [[DAS Inbox]] § Top of doc
    → `[[skills/rewire/SKILL]]` § Default doc top-of-file: frontmatter, H1, and
    the dispatch-table PLACEHOLDER. The placeholder's `| --- | |` row is the
    electric-zone separator — HookAnchor recomputes the table's rows below it,
    which is why the table is emitted empty rather than filled in here.

    The orientation sentence sits DIRECTLY under the H1, above the table, not
    below it: R-progressive-03 reads the head as breadcrumb → H1 → orientation,
    and Warden's audit-on-write fires on a fresh Inbox that puts the sentence
    after the table (observed on the first live drop).
    """
    return (
        "---\n"
        f"description: {prefix} inbox — raw input dropped for later processing.\n"
        "---\n"
        f"\n# {prefix} Inbox\n"
        "Drop zone for raw input; an entry with no status tag is pending, and "
        "draining writes `DONE` or `MOVED → {destination}` per [[DAS Inbox]].\n"
        f"\n| -[[{prefix} Inbox]]- | |\n"
        "| --- | --- |\n"
        "| --- | |\n"
    )


def _inbox_topic(message, explicit=None):
    """The `## YYYY-MM-DD — <Topic>` topic: `--topic` when given, else the
    message's opening sentence.

    Derived rather than required because the agreed signature is
    `drop(target, message, source, tag)` — there is no topic parameter, and a
    sender that has to invent a headline for a one-line note will invent a bad
    one. Cut at the first sentence end rather than at a character count: a
    message routinely opens with a complete short sentence, and a blind
    truncation would slice it mid-clause.

    Backticks are stripped. The one thing a topic must not do is look like a
    status: `## … — Topic  \\`DONE\\`` is how a drained entry is spelled, and a
    topic carrying a backtick-wrapped word would read as one to every reader
    and to R-fct-inbox-03.
    """
    if explicit and explicit.strip():
        topic = " ".join(explicit.split())
    else:
        first = next((l for l in message.splitlines() if l.strip()), "")
        first = re.sub(r"^[\s>#*\-]+", "", first).strip()
        m = re.search(r"[.!?](?:\s|$)", first)
        topic = " ".join((first[:m.start()] if m else first).split())
    topic = topic.replace("`", "").strip()
    if len(topic) > _INBOX_TOPIC_MAX:
        topic = topic[:_INBOX_TOPIC_MAX - 1].rstrip(" ,;:—-") + "…"
    if not topic:
        raise be.BacklogEditError(
            "drop: could not derive a topic from the message (it is empty once "
            "markers are stripped) — pass --topic \"<short headline>\"")
    return topic


def _format_inbox_entry(topic, message, source, tag, today):
    """One [[DAS Inbox]] entry: dated H2, optional attribution, blockquote.

    NO status tag on the H2 — that absence is the whole pending signal.
    """
    out = [f"## {today} — {topic}", ""]
    bits = []
    if source and source.strip():
        bits.append(f"from: {source.strip()}")
    if tag and tag.strip():
        bits.append(f"tag: {tag.strip()}")
    if bits:
        out.append("*" + " · ".join(bits) + "*")
        out.append("")
    for line in message.rstrip("\n").splitlines():
        out.append(f"> {line}" if line.strip() else ">")
    return "\n".join(out) + "\n"


def _insert_inbox_entry(text, entry):
    """Splice one entry in newest-first, above every existing dated section.

    "Above the first H2" is the whole placement rule: everything before it is
    the file's head — frontmatter, breadcrumb, H1, dispatch table, intro prose —
    and everything from it down is the reverse-chronological log this entry now
    leads.
    """
    lines = text.splitlines()
    idx = next((i for i, l in enumerate(lines) if l.startswith("## ")), None)
    body = entry.rstrip("\n") + "\n"
    if idx is None:
        head = text.rstrip("\n")
        return (head + "\n\n" + body) if head else body
    head = "\n".join(lines[:idx]).rstrip("\n")
    tail = "\n".join(lines[idx:]).rstrip("\n")
    return head + "\n\n" + body + "\n" + tail + "\n"


def cmd_drop(slug, anchor_path, args):
    """`state drop <anchor> "<message>" [--source S] [--tag T] [--topic H]`."""
    message = args.message
    if message is None:
        args.inline = None
        message = read_body(args)
    if not message or not message.strip():
        raise be.BacklogEditError(
            "drop requires a message — as the positional argument, via "
            "--from-file, or on stdin")

    inbox_path, backlog_path = _inbox_path(slug, anchor_path)
    prefix = inbox_path.name[: -len(" Inbox.md")]
    created = not inbox_path.is_file()
    before = None if created else inbox_path.read_text(encoding="utf-8")
    text = _inbox_template(prefix) if created else before

    topic = _inbox_topic(message, getattr(args, "topic", None))
    today = date.today().isoformat()
    entry = _format_inbox_entry(topic, message, args.source, args.tag, today)
    heading = f"## {today} — {topic}"

    inbox_path.parent.mkdir(parents=True, exist_ok=True)
    inbox_path.write_text(_insert_inbox_entry(text, entry), encoding="utf-8")

    # T050 — prove it landed by re-reading the DISK, and undo cleanly if not.
    # A drop is fire-and-forget by design (no reply, no ack), so the sender
    # never comes back to check: an unreported half-write here is a message
    # that was silently never delivered.
    landed = inbox_path.read_text(encoding="utf-8")
    first_line = next((l for l in message.splitlines() if l.strip()), "")
    if heading not in landed or f"> {first_line}" not in landed:
        if created:
            inbox_path.unlink(missing_ok=True)
        else:
            inbox_path.write_text(before, encoding="utf-8")
        raise be.BacklogEditError(
            f"drop: the entry did not land in {inbox_path.name} — "
            f"{'the file was removed' if created else 'the file has been restored'} "
            f"to its pre-call state.")

    _selffire(inbox_path)
    summary = (f"inbox drop → {prefix} Inbox '{topic}'"
               + (f" (from {args.source.strip()})" if args.source else "")
               + (" — inbox created" if created else ""))
    if backlog_path is not None:
        be.append_messages(slug, summary, backlog_path)
    print(f"{slug}: {summary}")
    return 0


# T131 leg 3 — the drain's sanctioned writer, paired with `drop` above.
#
# `drop` writes NO tag (that absence is the whole pending signal); `inbox-tag`
# writes exactly one, chosen from [[DAS Inbox]]'s two-value vocabulary
# (R-fct-inbox-03): `DONE` or `MOVED → {destination}`. Routing the write
# through `state` — rather than letting the `/inbox` skill hand-edit the
# markdown — means the vocabulary is enforced in one place instead of trusted
# to every caller, the same reason `drop` itself is a verb here and not a
# skill-side string splice.
_INBOX_MOVED_RE = re.compile(r"^MOVED\s*→\s*(\S.*)$")
_INBOX_H2_DATE_RE = re.compile(r"^## (\d{4}-\d{2}-\d{2}) — (.+)$")


def _normalize_inbox_tag(raw):
    """`DONE`, or `MOVED → {destination}` re-spaced to the canonical single
    space either side of the arrow — never a third spelling. A bare `MOVED`
    with no destination is refused: per [[DAS Inbox]] it leaves a later reader
    with no idea where the entry went, so it is treated as a malformed tag,
    not a degenerate valid one."""
    tag = (raw or "").strip()
    if tag == "DONE":
        return tag
    m = _INBOX_MOVED_RE.match(tag)
    if m:
        dest = m.group(1).strip()
        if "`" in dest:
            raise be.BacklogEditError(
                "inbox-tag: --tag destination cannot itself contain a "
                "backtick — it would break the tag's own backtick-wrapping")
        return f"MOVED → {dest}"
    raise be.BacklogEditError(
        f"inbox-tag: --tag must be exactly 'DONE' or 'MOVED → {{destination}}' "
        f"— the only two values [[DAS Inbox]] (R-fct-inbox-03) sanctions — "
        f"got {raw!r}")


def _load_audit_q():
    """Lazy-import `audit-q.py` for its `_INBOX_ENTRY_RE` / `_INBOX_DONE_RE` —
    the exact regexes `count_pending_inbox` counts against and the `Inbox N`
    banner is built from. `inbox-tag` reuses `_INBOX_DONE_RE` to detect an
    already-tagged entry rather than restating the tag-shape test — a second
    spelling of "what marks an entry processed" is exactly how a writer and
    the banner it feeds come to disagree. Loaded lazily (only by this verb) so
    every other `state` call doesn't pay a 6000-line-module import for a
    check it never uses."""
    path = (Path.home() / ".claude" / "skills" / "audit" / "scripts"
             / "audit-q.py")
    spec = importlib.util.spec_from_file_location("audit_q_shared", path)
    if spec is None or spec.loader is None:
        raise be.BacklogEditError(f"inbox-tag: cannot load {path}")
    mod = importlib.util.module_from_spec(spec)
    # Register before exec — audit-q.py's @dataclass classes resolve their own
    # module via sys.modules[cls.__module__] while executing, same reason
    # `state`'s own backlog-edit.py load (top of this file) registers first.
    sys.modules["audit_q_shared"] = mod
    spec.loader.exec_module(mod)
    return mod


def cmd_inbox_list(slug, anchor_path, args):
    """`state inbox-list <anchor> [--all]` — the drain's READ half, paired with
    `inbox-tag`'s write half.

    Prints every PENDING entry's markdown verbatim (heading + body) so the
    `/inbox` drain skill reads real content instead of re-deriving it from a
    summary. "Pending" is decided by walking the file with the exact regexes
    `count_pending_inbox` counts against (imported via `_load_audit_q`, same
    as `inbox-tag`) — a drain that disagreed with the `Inbox N` banner about
    which entries qualify is the exact failure this project already hit once.
    `--all` also lists already-processed entries (debugging only; the drain
    never acts on them).
    """
    inbox_path, _backlog_path = _inbox_path(slug, anchor_path)
    if not inbox_path.is_file():
        print(f"{slug}: no Inbox file at {inbox_path} — nothing pending",
              file=sys.stderr)
        return 0

    audit_q = _load_audit_q()
    lines = inbox_path.read_text(encoding="utf-8").splitlines()
    # Mirrors count_pending_inbox's own walk (audit-q.py) span-for-span, so
    # "pending" can never mean something different here than it does there:
    # an entry opens at its `## ` heading, stays pending until a sanctioned
    # tag appears anywhere inside it (heading or body), and closes at the
    # next `## ` heading or EOF.
    spans = []  # (start, end_exclusive, still_pending)
    start = None
    pending = False
    for i, line in enumerate(lines):
        if audit_q._INBOX_ENTRY_RE.match(line):
            if start is not None:
                spans.append((start, i, pending))
            start = i
            pending = not bool(audit_q._INBOX_DONE_RE.search(line))
        elif start is not None and audit_q._INBOX_DONE_RE.search(line):
            pending = False
    if start is not None:
        spans.append((start, len(lines), pending))

    shown = [s for s in spans if (args.all or s[2])]
    print(f"{slug}: {len(shown)} of {len(spans)} entries "
          f"{'shown' if args.all else 'pending'} in {inbox_path.name}",
          file=sys.stderr)
    for s, e, _is_pending in shown:
        sys.stdout.write("\n".join(lines[s:e]).rstrip("\n") + "\n\n")
    return 0


def cmd_inbox_tag(slug, anchor_path, args):
    """`state inbox-tag <anchor> --date D [--topic T] --tag TAG`.

    Locates the ONE pending-or-not entry dated `--date` (disambiguated by
    `--topic`, a case-insensitive substring, when more than one entry shares
    that date — same shape as `mint-id --match`), refuses if it already
    carries a tag, and appends the normalized tag to its existing H2 line
    verbatim — so the topic text on disk is never re-typed and can never
    drift from what `drop` originally wrote.
    """
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", args.date or ""):
        raise be.BacklogEditError(
            f"inbox-tag: --date must be YYYY-MM-DD — got {args.date!r}")
    tag = _normalize_inbox_tag(args.tag)

    inbox_path, _backlog_path = _inbox_path(slug, anchor_path)
    if not inbox_path.is_file():
        raise be.BacklogEditError(
            f"inbox-tag: no Inbox file at {inbox_path} — nothing to tag")

    audit_q = _load_audit_q()
    before = inbox_path.read_text(encoding="utf-8")
    lines = before.splitlines()

    topic_filter = (args.topic or "").strip().lower()
    matches = []
    for i, line in enumerate(lines):
        m = _INBOX_H2_DATE_RE.match(line)
        if not m or m.group(1) != args.date:
            continue
        if topic_filter and topic_filter not in m.group(2).lower():
            continue
        matches.append(i)

    if not matches:
        raise be.BacklogEditError(
            f"inbox-tag: no entry dated {args.date}"
            + (f" matching --topic {args.topic!r}" if args.topic else "")
            + f" in {inbox_path.name}")
    if len(matches) > 1:
        candidates = "; ".join(f'"{lines[i][3:][:60]}"' for i in matches)
        raise be.BacklogEditError(
            f"inbox-tag: {len(matches)} entries dated {args.date} — "
            f"disambiguate with --topic (candidates: {candidates})")

    idx = matches[0]
    if audit_q._INBOX_DONE_RE.search(lines[idx]):
        raise be.BacklogEditError(
            f"inbox-tag: {lines[idx][3:]!r} already carries a status tag — "
            f"inbox-tag never overwrites a processed entry")

    new_line = f"{lines[idx]}    `{tag}`"
    lines[idx] = new_line
    inbox_path.write_text("\n".join(lines) + "\n", encoding="utf-8")

    # T050 — prove it landed by re-reading the DISK, and undo cleanly if not.
    landed = inbox_path.read_text(encoding="utf-8")
    if new_line not in landed.splitlines():
        inbox_path.write_text(before, encoding="utf-8")
        raise be.BacklogEditError(
            f"inbox-tag: the tag did not land in {inbox_path.name} — the "
            f"file has been restored to its pre-call state.")

    _selffire(inbox_path)
    print(f"{slug}: inbox-tag {args.date} → `{tag}`")
    return 0


def cmd_revalidate(slug, anchor_path, args):
    """F241 — the doc verb: `state revalidate <anchor> <doc>`.

    v2 had to special-case this shape, because an address-first grammar cannot
    tell `<doc> <label> <verb>` from `<doc> <verb>` without looking at the last
    token — and the membership test that did so (F250 #12) hijacked dispatch
    whenever the word "revalidate" appeared in a --reason or a title. Verb-first
    makes the ambiguity impossible: the verb is read before anything else, and
    a verb that takes no label simply does not declare one.
    """
    doc_kind, doc_path = resolve_doc(args.doc, slug, anchor_path)
    if doc_kind != "doc":
        raise be.BacklogEditError(
            "revalidate targets a feature/PRD doc's ## Open Questions "
            "block, not the Backlog")
    return _q_revalidate_core(slug, doc_path)


# ============================================================
# F239 — crank exit handshake: `state triage` + `state crank`
# ============================================================

import hashlib
import json as _json
from datetime import datetime, timezone

_ANCHOR_SYSTEM_STATE = Path.home() / ".config" / "anchor-system"
_TRIAGE_DIR = _ANCHOR_SYSTEM_STATE / "triage"
_CRANK_DIR = _ANCHOR_SYSTEM_STATE / "crank"

# An executable Next is one the agent takes with zero user involvement NOW.
# An event-gated step ("re-run when…", "once the user…") is a [Waiting] body
# wearing a [Ready] bracket — the F187 failure that motivated F239.
_CONDITIONAL_NEXT_RE = re.compile(
    r"^(re-?run\s+when|when\s|whenever\s|once\s|await\s|after\s+the\s+user|if\s)",
    re.IGNORECASE,
)

_BANNER_NUM_RE = {
    # Zone 1, the two actionable classes: Ready (= [Ready]/[Agreed] +
    # [Active]/[Implementing], F260's fold) and User (= [Questions] + [User] +
    # [Designing]). F305 reverted the first label from `Runnable` back to
    # `Ready` and moved `Verify` out of the horizon group into the new zone-3
    # `Parked` class, which also folds in `[Blocked …]`.
    #
    # `Ready` and `Parked` are anchored on their surrounding separators. Both
    # words also appear as BRACKET names elsewhere on some lines, and an
    # unanchored `Ready\s+(\d+)` would happily match the wrong one.
    "runnable": re.compile(r"-  Ready\s+(\d+)"),
    "user": re.compile(r"User\s+(\d+)"),
    "verify": re.compile(r"\|   Parked\s+(\d+)"),
}


def _backlog_sha256(backlog_path):
    return hashlib.sha256(backlog_path.read_bytes()).hexdigest()


def _read_banner_counts(backlog_path, slug):
    """Ready/Questions/Verify counts scraped from the rendered `{slug} queries.md`
    banner H1. Single source of truth shared by cmd_triage / cmd_groom_list /
    cmd_summary_line, so the canonical line always matches what the user sees in
    queries.md / Q.md — the banner itself is produced upstream by queries-render.py."""
    queries_path = backlog_path.parent / f"{slug} queries.md"
    # F250 #9 (→ F254 C3) — never scrape a stale/absent render as authoritative.
    # cmd_triage re-renders before reading; cmd_summary_line / cmd_groom_list did
    # not, so a queries.md older than (or missing for) the current backlog fed
    # them stale counts. Re-render first when stale (best-effort; on failure we
    # fall through and read whatever exists).
    try:
        stale = (not queries_path.is_file()
                 or queries_path.stat().st_mtime < backlog_path.stat().st_mtime)
    except OSError:
        stale = True
    if stale:
        try:
            audit_scripts = Path.home() / ".claude" / "skills" / "audit" / "scripts"
            subprocess.run(
                [sys.executable, str(audit_scripts / "queries-render.py"), slug],
                capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            pass
    banner = ""
    if queries_path.is_file():
        for qline in queries_path.read_text(encoding="utf-8").splitlines():
            if qline.startswith("# "):  # banner H1 (frontmatter precedes it)
                banner = qline
                break
    counts = {}
    for key, rx in _BANNER_NUM_RE.items():
        bm = rx.search(banner)
        counts[key] = int(bm.group(1)) if bm else 0
    return counts


def _audit_q_backlog_findings(slug):
    """F258 — run audit-q backlog-scope --dry for `slug`; return
    (count, combined_output). `count` is None when audit-q is missing or its
    output is unparseable — the caller picks the polarity: `cmd_triage` fails
    CLOSED (None → refuse to stamp), the `groom-list` / Stop-hook worklist fails
    OPEN (None → count 0, never a spurious permanent block). Single source of
    truth for both audit-q gates (CLAUDE.md single-source rule)."""
    audit = Path.home() / ".claude" / "skills" / "audit" / "scripts" / "audit-q.py"
    if not audit.is_file():
        return None, ""
    try:
        r = subprocess.run(
            [sys.executable, str(audit),
             "--scope", "backlog", "--anchor", slug, "--dry"],
            capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        return None, str(e)
    out = (r.stdout or "") + (r.stderr or "")
    m = re.search(r"audit-q:\s+(\d+)\s+finding", out)
    return (int(m.group(1)) if m else None), out


def _triage_gate_findings(backlog_path):
    """The local mechanical gates: every [Ready]/[Active]/[Agreed] row carries
    an executable `- **Next:**`, and no bracket/H2 mismatch. Returns a list of
    finding strings — empty means the gates pass."""
    text = backlog_path.read_text(encoding="utf-8")
    lines, h2_index, row_index = be.scan_backlog(text)
    findings = []
    for rid, (start, end, h2, _indent) in row_index.items():
        m = be.ROW_FULL_RE.match(lines[start].rstrip("\n"))
        if not m:
            continue
        status = (m.group("status") or "").strip()
        if h2 == "Ready" and status not in ("Ready", "Active", "Agreed"):
            findings.append(
                f"{rid}: [{status}] row under ## Ready — rebracket or move it")
        if status.startswith("Done") and h2 != "Done":
            findings.append(
                f"{rid}: [Done] row under ## {h2} — move to ## Done")
        if status == "User":
            # F259 — a [User] row is a groomed, honestly-parked state (the
            # crank stops cleanly on it), but only when it carries the
            # `- **User:**` action naming what the user must do.
            user_text = be._extract_subbullet_text(lines[start:end], "User")
            if not user_text:
                findings.append(
                    f"{rid}: [User] with no `- **User:**` action — name the "
                    "user-only action (or rebracket [Ready] with a Next if the "
                    "agent can do it)")
        if status in ("Ready", "Active", "Agreed") and rid != "B-QFix":
            next_text = be._extract_subbullet_text(lines[start:end], "Next")
            if not next_text:
                findings.append(
                    f"{rid}: [{status}] with no `- **Next:**` step — "
                    "not actually executable")
            elif be.is_nonanswer(next_text):
                findings.append(
                    f'{rid}: [{status}] Next is a non-answer '
                    f'("{next_text.strip()[:60]}") — the agent punted the '
                    "groom; write a real first step or rebracket honestly")
            elif _CONDITIONAL_NEXT_RE.match(next_text.strip()):
                findings.append(
                    f'{rid}: [{status}] Next is event-gated ("{next_text.strip()[:60]}…") '
                    "— that is [Waiting], not [Ready]")
    return findings


def cmd_triage(slug, anchor_path, args):
    """Gated triage stamp (F239). Computes everything itself — takes no
    counts. Gates dirty → exit 1 printing the findings (the refusal IS the
    triage worklist). Gates clean → render, stamp, print the canonical line."""
    backlog_path = be.find_backlog(slug)
    findings = _triage_gate_findings(backlog_path)
    if findings:
        print(f"state triage: REFUSED — {len(findings)} gate finding(s); "
              "this list is the triage worklist:", file=sys.stderr)
        for f in findings:
            print(f"  - {f}", file=sys.stderr)
        return 1

    audit_scripts = Path.home() / ".claude" / "skills" / "audit" / "scripts"
    render = subprocess.run(
        [sys.executable, str(audit_scripts / "queries-render.py"), slug],
        capture_output=True, text=True, timeout=60)
    if render.returncode != 0:
        print("state triage: REFUSED — queries render failed:", file=sys.stderr)
        print((render.stderr or render.stdout).strip(), file=sys.stderr)
        return 1
    # F258 — shared helper; triage fails CLOSED (None → refuse).
    n_findings, out = _audit_q_backlog_findings(slug)
    if n_findings is None or n_findings > 0:
        label = ("unparseable audit-q output" if n_findings is None
                 else f"audit-q reports {n_findings} finding(s)")
        print(f"state triage: REFUSED — {label}:", file=sys.stderr)
        for line in out.strip().splitlines():
            print(f"  {line}", file=sys.stderr)
        return 1

    # Counts come from the just-rendered banner — one source of truth, so the
    # canonical line always matches what the user sees in queries.md / Q.md.
    counts = _read_banner_counts(backlog_path, slug)

    stamp_path = _TRIAGE_DIR / f"{slug}.json"
    prev = None
    if stamp_path.is_file():
        try:
            prev = _json.loads(stamp_path.read_text())
        except (ValueError, OSError):
            prev = None

    def _part(name, cur):
        prev_val = prev.get(name.lower()) if prev else None
        if prev_val is None or cur == prev_val:
            return f"{name} {cur}"
        d = cur - prev_val
        return f"{name} {cur} ({'+' if d > 0 else ''}{d})"

    # F305 — zone-1 label reverted to `Ready`; `Verify` became the `Parked`
    # class, which also folds in every `[Blocked …]` row.
    line = ("TRIAGE — " + _part("Ready", counts["runnable"])
            + " · " + _part("User", counts["user"])
            + f" · Parked {counts['verify']}")

    _TRIAGE_DIR.mkdir(parents=True, exist_ok=True)
    stamp_path.write_text(_json.dumps({
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "backlog_sha256": _backlog_sha256(backlog_path),
        "backlog_path": str(backlog_path),
        "runnable": counts["runnable"],
        "user": counts["user"],
        "verify": counts["verify"],
        "line": line,
    }, indent=2))
    print(line)
    return 0


def _blue(text):
    """Wrap the whole line in ANSI blue on a TTY (T034 rule 5). Respects NO_COLOR
    and no-ops when stdout is redirected, so piped/captured output stays plain."""
    if sys.stdout.isatty() and not os.environ.get("NO_COLOR"):
        return f"\033[34m{text}\033[0m"
    return text


def cmd_groom_list(slug, anchor_path, args):
    """F244 — the grooming-worklist presenter. Prints the ungroomed frontier
    (the same `_triage_gate_findings` the Stop-hook gates on), or an
    'all caught up' status line when the worklist is empty. Read-only: no
    render, no stamp. `--count` prints just the integer worklist size (the
    Stop-hook shells out for it — single source of truth)."""
    backlog_path = be.find_backlog(slug)
    findings = _triage_gate_findings(backlog_path)
    # F258 — the worklist also counts audit-q backlog warnings, so a crank stop
    # is blocked while any remain (matching what `state triage` already requires).
    # Fail-open: audit-q infra failure → 0, never a spurious permanent block.
    aq_n, _aq_out = _audit_q_backlog_findings(slug)
    aq = aq_n or 0
    total = len(findings) + aq
    if getattr(args, "count", False):
        print(total)
        return 0
    if findings or aq:
        print(f"grooming worklist — {total} item(s) not yet groomed:")
        for f in findings:
            print(f"  - {f}")
        if aq:
            print(f"  - audit-q: {aq} unresolved backlog finding(s) — run "
                  f"`/audit q --fix` (or `/groom`) to clear")
        return 0
    # Empty worklist — the "where do I stand" status line (F244 secondary UX).
    counts = _read_banner_counts(backlog_path, slug)
    r, q, v = counts.get("runnable", 0), counts.get("user", 0), counts.get("verify", 0)
    # T034 exact format (F260 relabel): `{SLUG}: {recommendation} . Groomed .
    # Ready N . User M . Parked K`. ENTIRE line blue (rule 5). `Groomed` is
    # fixed (this branch only runs once the worklist is empty — rule 3). The
    # recommendation slot (rule 2) carries only what this presenter can DERIVE;
    # context-window recs (`please /clear` / `please /compact`) are the agent's
    # to add at chat close (see [[SKA workflow]] § Never strand). Omit the slot
    # entirely when nothing applies (rule 2).
    if r == 0 and q == 0 and v == 0:
        rec = "all clear"                                    # distinct all-zero phrasing (rule 3)
    elif q > 0:
        rec = f"answer the {q} on your plate"
    elif r > 0:
        rec = "crank with '"
    else:                                                    # only Verify work — user-passive
        rec = ""
    rec_part = f"{rec} . " if rec else ""
    print(_blue(f"{slug}: {rec_part}Groomed . Ready {r} . User {q} . Parked {v}"))
    return 0


# F248 — recommendation directive → summary-line recommendation slot. The agent
# supplies only the directive (the compact/clear/crank call it must make explicitly
# at chat close); everything else in the line is derived by state. `nothing` is an
# alias for `crank`, `done` for `clear-all`. `answer` fills in the derived Q count.
_SUMMARY_REC = {
    "compact": lambda r, q, v: "please /compact",
    "clear": lambda r, q, v: "please /clear",
    "crank": lambda r, q, v: "crank with '",
    "nothing": lambda r, q, v: "crank with '",
    "answer": lambda r, q, v: f"answer the {q} on your plate",
    "clear-all": lambda r, q, v: "all clear",
    "done": lambda r, q, v: "all clear",
}


def cmd_summary_line(slug, anchor_path, args):
    """F248 — print the exact T034 closing/summary line the agent should show the
    user, verbatim. The counts (Ready/Questions/Verify), the ` . ` separators,
    the fixed `Groomed` token, and the whole-line TTY-blue are OWNED and derived
    here (same banner source as cmd_triage / cmd_groom_list), so they can never
    disagree with what the user sees. The agent supplies ONLY the recommendation,
    via the REQUIRED --recommend directive — the never-strand guard (F244): the
    line cannot be emitted without a stated compact/clear/crank/answer call.
    Read-only: no render, no stamp; the agent prints stdout verbatim."""
    backlog_path = be.find_backlog(slug)
    counts = _read_banner_counts(backlog_path, slug)
    r, q, v = counts.get("runnable", 0), counts.get("user", 0), counts.get("verify", 0)
    rec = _SUMMARY_REC[args.recommend](r, q, v)
    rec_part = f"{rec} . " if rec else ""
    print(_blue(f"{slug}: {rec_part}Groomed . Ready {r} . User {q} . Parked {v}"))
    return 0


def cmd_crank(slug, anchor_path, args):
    """Crank-session sentinel (F239) — arms/disarms the Stop-hook gate."""
    sentinel = _CRANK_DIR / f"{slug}.json"
    if args.subverb == "start":
        backlog_path = be.find_backlog(slug)
        _CRANK_DIR.mkdir(parents=True, exist_ok=True)
        sentinel.write_text(_json.dumps({
            "started": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "slug": slug,
            "anchor_path": str(anchor_path),
            "backlog_path": str(backlog_path),
            "blocks": 0,
        }, indent=2))
        print(f"{slug}: crank session started — stop gate armed "
              "(legal exits: empty frontier / CRANK READY with Ready > 0 / "
              "fresh `state triage` line; `state crank stop` disarms)")
        return 0
    if args.subverb == "stop":
        if sentinel.is_file():
            sentinel.unlink()
            print(f"{slug}: crank stop gate disarmed")
        else:
            print(f"{slug}: no crank session was armed")
        return 0
    if sentinel.is_file():
        print(sentinel.read_text().strip())
    else:
        print(f"{slug}: no crank session armed")
    return 0


_RETIRED_DOMAINS = {"task", "q", "question"}

# Verbs that address an item inside a doc: `<verb> <anchor> <doc> <label>`.
_ITEM_VERBS = ("define", "set", "resolve", "remove")

# Every top-level verb — item verbs, the doc verb, and the domain verbs. Only
# the tombstones read this, to tell a retired v2-form invocation (which leads
# with the address) from a plain typo.
_ALL_VERBS = _ITEM_VERBS + ("show", "mint-id", "drop", "inbox-list",
                            "inbox-tag", "revalidate", "status", "roadmap",
                            "triage", "crank", "groom-list", "summary-line")

_LABEL_HELP = ("item id — F<n>/T<n>/C<n>/Q<n> on Backlog, Q<n>/V<n> on any "
               "other doc; LETTERS+'+' auto-mints (F+, T+, C+, Q+, V+); "
               "<row>.Q<n> addresses a question hosted inside a Backlog row "
               "(resolve/show only)")


def _first_positional(argv):
    """First token of argv[1:] when it is not a flag, else None. Read only by
    the tombstones, which must fire before argparse turns an unknown verb into
    its own (less useful) error."""
    for tok in argv[1:]:
        return None if tok.startswith("-") else tok
    return None


def _add_address(sp, label_help=None):
    """The address positionals: `<anchor> <doc>`, plus `<label>` for the item
    verbs. These can be positional only because the verb comes first — v2 had
    to consume the address before it knew the verb, which is why the anchor
    had to be an optional flag (and an optional flag cannot be positional in
    the middle of other positionals)."""
    sp.add_argument("anchor",
                    help="anchor SLUG, or a path to a directory holding "
                         ".anchor — mandatory, never inferred from cwd")
    sp.add_argument("doc",
                    help="Backlog | wiki-name (no slash/.md) | path to a .md doc")
    if label_help:
        sp.add_argument("label", help=label_help)


def build_parser():
    p = argparse.ArgumentParser(
        prog="state",
        description=(
            "state v3 (F293) — verb-first: "
            "`state <verb> <anchor> <doc> [<label>] [flags] [< body]`. "
            "doc = Backlog | wiki-name | path. label = LETTERS+DIGITS, or "
            "LETTERS+'+' to auto-mint. Each verb owns its own flags, so "
            "`state <verb> --help` prints what that verb takes and nothing "
            "else. Full spec: ~/.claude/skills/workflow/DAS State.md."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subs = p.add_subparsers(dest="verb", required=True)

    # ---- item verbs: define | set | resolve | remove ----------------------

    d = subs.add_parser(
        "define",
        help="create-or-replace an item from a complete body (stdin/--body)")
    _add_address(d, _LABEL_HELP)
    d.add_argument("--horizon", default=None,
                   help="horizon for a NEW Backlog row (default: Now)")
    d.add_argument("--why-ask", dest="why_ask", default=None,
                   help="F257 — one sentence justifying why a Lean/Strong "
                        "Open Question is surfaced despite the agent having a "
                        "recommendation (high-stakes irreversibility: an "
                        "external action, an interface-sticky name/schema, an "
                        "architecture lock-in, a taste-only call). Required to "
                        "mint a Lean/Strong `Q<n>`; appended as `· *why-ask: …*`")
    d.add_argument("--why-user", dest="why_user", default=None,
                   help="F240 — one sentence naming the human faculty a "
                        "Verify/Verify-by/Watching check invokes (taste / "
                        "preference / ratification / passive-use); required "
                        "when a row enters that family. Appended to the "
                        "`- **Verify:**` sub-bullet as `· *why-user: …*`")
    d.add_argument("--why-user-action", dest="why_user_action", default=None,
                   help="F259 ownership gate (the F240 sibling) — one sentence "
                        "naming the credential or human-only faculty a [User] "
                        "action requires (a login only you hold, a GUI "
                        "permission dialog, a 2FA device). Required when a row "
                        "ENTERS [User]; appended to the `- **User:**` sub-bullet "
                        "as `· *why-user-action: …*`")
    d.add_argument("--body", dest="inline", default=None,
                   help="inline body (alternative to stdin)")
    d.add_argument("--from-file", dest="from_file", default=None,
                   help="read body from file (alternative to stdin)")

    s = subs.add_parser(
        "set",
        help="partial field update on a Backlog row — only flagged fields change")
    _add_address(s, _LABEL_HELP)
    s.add_argument("--status", default=None, help="new bracket status")
    s.add_argument("--horizon", default=None, help="move the row to this horizon")
    s.add_argument("--title", default=None, help="new title")
    s.add_argument("--next", dest="next_step", default=None,
                   help="`- **Next:**` no-user action")
    s.add_argument("--verify", default=None,
                   help="`- **Verify:**` yes/no question")
    s.add_argument("--user", dest="user", default=None,
                   help="F259 — `- **User:**` action a [User] row is gated on "
                        "(what YOU, the user, must do: log in, click a "
                        "permission dialog, enter a credential). Pair with "
                        "--status User + --why-user-action.")
    s.add_argument("--why-user", dest="why_user", default=None,
                   help="F240 — the human faculty a Verify check invokes; "
                        "required when a row enters that family")
    s.add_argument("--why-user-action", dest="why_user_action", default=None,
                   help="F259 — the credential or human-only faculty a [User] "
                        "action requires; required when a row ENTERS [User]")
    # No --body-from-stdin and no --from-file: `set` names each field with its
    # own flag and never reads a body stream. v2 declared --from-file globally
    # and then refused it here at runtime; the per-verb schema is the check.
    s.add_argument("--body", dest="inline", default=None, help="new row body")
    s.add_argument("--drop-pointer", dest="drop_pointer", action="store_true",
                   help="T174 — sever the row's `→ [[doc]]` pointer instead of "
                        "carrying it onto the new --body (default is to carry it)")

    r = subs.add_parser(
        "resolve",
        help="record an outcome — Backlog row to Done, or a Q/V to its resolved zone")
    _add_address(r, _LABEL_HELP)
    r.add_argument("--choice", default=None,
                   help='chosen option, e.g. "(A)" — required for a Q; '
                        '"none — <what happened instead>" when the outcome was '
                        'not one of the listed options')
    r.add_argument("--body", dest="inline", default=None,
                   help="inline body (alternative to stdin)")
    r.add_argument("--from-file", dest="from_file", default=None,
                   help="read body from file (alternative to stdin)")

    rm_ = subs.add_parser("remove", help="delete an item, echoing what was deleted")
    _add_address(rm_, _LABEL_HELP)
    rm_.add_argument("--reason", default=None,
                     help="short reason recorded in the audit trail")

    sh = subs.add_parser(
        "show",
        help="print an item's full markdown, sub-bullet span included (T064)")
    _add_address(sh, _LABEL_HELP)

    mi = subs.add_parser(
        "mint-id",
        help="T162 — give an EXISTING id-less Backlog row a row-id and a "
             "matching `^block-anchor`, so every other verb can address it")
    _add_address(mi, "the id to mint — T+/F+/C+ for the next free number in "
                     "that namespace, or an explicit id (T042) that must be "
                     "unused in both Backlog and Icebox")
    mi.add_argument("--match", required=True,
                    help="substring of the id-less row's title, "
                         "case-insensitive — the only handle such a row has. "
                         "Must name exactly ONE id-less row; zero or several "
                         "refuse and list the candidates")

    # ---- inbox verb -------------------------------------------------------

    dr = subs.add_parser(
        "drop",
        help="T131 — append one PENDING entry to a target anchor's "
             "[[DAS Inbox]]; creates the file on first drop. Nothing executes "
             "until that agent drains it")
    dr.add_argument("anchor",
                    help="TARGET anchor SLUG (whose inbox receives this), or a "
                         "path to a directory holding .anchor")
    dr.add_argument("message", nargs="?", default=None,
                    help="the message body — omit to read it from --from-file "
                         "or stdin")
    dr.add_argument("--source", default=None,
                    help="who is sending (user / atticus / muse) — rendered on "
                         "the entry's attribution line")
    dr.add_argument("--tag", default=None,
                    help="message TYPE (fact / handoff / note / nudge). NOT a "
                         "status: DONE / MOVED → are written by the drain, and "
                         "an entry with no status tag is what 'pending' means")
    dr.add_argument("--topic", default=None,
                    help="the dated H2's topic; derived from the message's "
                         "opening sentence when omitted")
    dr.add_argument("--from-file", dest="from_file", default=None,
                    help="read the message from a file (alternative to the "
                         "positional / stdin)")

    il = subs.add_parser(
        "inbox-list",
        help="T131 leg 3 — print every PENDING Inbox entry's markdown "
             "verbatim, for the `/inbox` drain skill to read")
    il.add_argument("anchor",
                    help="anchor SLUG whose Inbox is being drained, or a "
                         "path to a directory holding .anchor")
    il.add_argument("--all", action="store_true",
                    help="also list already-processed entries (debugging)")

    it = subs.add_parser(
        "inbox-tag",
        help="T131 leg 3 — write the sanctioned status tag onto one Inbox "
             "entry (marks it processed); pairs with `drop` at the sending "
             "end")
    it.add_argument("anchor",
                    help="anchor SLUG whose Inbox is being drained, or a "
                         "path to a directory holding .anchor")
    it.add_argument("--date", required=True,
                    help="the entry's YYYY-MM-DD, matching its H2")
    it.add_argument("--topic", default=None,
                    help="case-insensitive substring of the entry's topic — "
                         "required only to disambiguate two entries dated "
                         "the same day")
    it.add_argument("--tag", required=True,
                    help="'DONE' or 'MOVED → {destination}' — the only two "
                         "sanctioned values (R-fct-inbox-03); a bare 'MOVED' "
                         "with no destination is refused")

    # ---- doc verb ---------------------------------------------------------

    rv = subs.add_parser(
        "revalidate",
        help="F241 — validate-then-stamp a doc's ## Open Questions block "
             "after a hand-edit")
    _add_address(rv)

    # ---- domain verbs -----------------------------------------------------

    st = subs.add_parser(
        "status", help="manage {slug} Status.md per-facet planning status (F130)")
    st.add_argument("anchor", help="anchor SLUG or path to a directory holding .anchor")
    st_subs = st.add_subparsers(dest="subverb", required=True)

    sts = st_subs.add_parser("set", help="set a facet's status cell")
    sts.add_argument("facet",
                     help="facet name (prd, ux, architecture, testing, roadmap)")
    sts.add_argument("cell",
                     help="status cell (none, MVP-agent, MVP-user, Full-agent, Full-user)")
    sts.add_argument("--note", default=None,
                     help="one-line rationale (required for MVP-user / Full-user)")

    stsh = st_subs.add_parser("show", help="show one or all facet statuses")
    stsh.add_argument("facet", nargs="?", default=None,
                      help="facet name (omit to show all)")

    rm = subs.add_parser(
        "roadmap",
        help="manage {slug} Roadmap.md milestone state + migration (F145)")
    rm.add_argument("anchor", help="anchor SLUG or path to a directory holding .anchor")
    rm_subs = rm.add_subparsers(dest="subverb", required=True)

    rmst = rm_subs.add_parser("status", help="get/set a roadmap entry's checkbox state")
    rmst_subs = rmst.add_subparsers(dest="subsubverb", required=True)
    for sv, sv_help in (("get", "read a roadmap entry's checkbox state"),
                        ("set", "write a roadmap entry's checkbox state")):
        sp = rmst_subs.add_parser(sv, help=sv_help)
        sp.add_argument("--feature", default=None, help="identify entry by F<n>")
        sp.add_argument("--milestone", default=None,
                        help="identify entry by milestone id (M-<Name> or M-<Name>.<n>)")
        if sv == "set":
            sp.add_argument("--state", required=True,
                            choices=["checked", "unchecked", "deferred"],
                            help="new checkbox state")

    rmm = rm_subs.add_parser(
        "migrate", help="migrate a whole completed milestone to Completed Roadmap")
    rmm.add_argument("milestone", help="top-level milestone id, e.g. M-Store")
    rmm.add_argument("--date", required=True,
                     help="migration date YYYY-MM-DD (REQUIRED — never auto-now)")

    tr = subs.add_parser(
        "triage",
        help="verify the groomed-state gates, render, then stamp + print the "
             "canonical TRIAGE line; dirty gates refuse with the worklist (F239)")
    tr.add_argument("anchor", help="anchor SLUG or path to a directory holding .anchor")

    ck = subs.add_parser(
        "crank", help="crank-session sentinel: start | stop | status (F239)")
    ck.add_argument("anchor", help="anchor SLUG or path to a directory holding .anchor")
    ck.add_argument("subverb", choices=["start", "stop", "status"])

    gl = subs.add_parser(
        "groom-list",
        help="print the grooming worklist (ungroomed frontier), or an "
             "'all caught up' status line when empty (F244)")
    gl.add_argument("anchor", help="anchor SLUG or path to a directory holding .anchor")
    gl.add_argument("--count", action="store_true",
                    help="print only the integer worklist size")

    sl = subs.add_parser(
        "summary-line",
        help="print the exact T034 closing line the agent shows the user; "
             "counts + separators + blue owned by state, recommendation from "
             "--recommend (required) (F248)")
    sl.add_argument("anchor", help="anchor SLUG or path to a directory holding .anchor")
    sl.add_argument("--recommend", required=True,
                    choices=["compact", "clear", "crank", "nothing",
                             "answer", "clear-all", "done"],
                    help="the recommendation slot: compact→please /compact, "
                         "clear→please /clear, crank/nothing→crank with \', "
                         "answer→answer the N question(s), clear-all/done→all clear")

    return p


def _tombstone(argv):
    """Print the migration for a retired invocation shape, or None to proceed.

    Two shapes get a named message rather than argparse's generic "invalid
    choice". `state task` / `state q` were retired by F236. The whole v2
    address-first grammar was retired by F293 — and because it led with the
    doc, its first token is exactly the thing argparse now reads as a verb, so
    every surviving v2 call site lands here and is told what to type instead.
    """
    first = _first_positional(argv)
    if first is None:
        return None
    if first in _RETIRED_DOMAINS:
        if first == "task":
            return ("state: 'state task ...' was retired (F236) — use: "
                    "state <define|set|resolve|remove> <anchor> Backlog <F<n>|T<n>|F+|T+>")
        return ("state: 'state q ...' was retired (F236) — use: "
                "state <define|resolve|remove> <anchor> <doc> <Q<n>|Q+>")
    if first not in _ALL_VERBS:
        return (
            f"state: {first!r} is not a verb. The address-first v2 grammar "
            "(`state [-a ANCHOR] <doc> <label> <verb>`) was REMOVED in F293 — "
            "the verb comes first now and the anchor is a mandatory "
            "positional:\n"
            "    state <verb> <anchor> <doc> [<label>] [flags]\n"
            "    state set      Tink Backlog T075 --status Done\n"
            "    state resolve  Tink \"F293 — state CLI v3 — verb-first grammar\" Q1 "
            "--choice \'(B)\'\n"
            "    state show     Tink Backlog T041\n"
            "    state triage   Tink\n"
            "Verbs: " + " ".join(_ALL_VERBS)
        )
    return None


def main(argv):
    tomb = _tombstone(argv)
    if tomb is not None:
        print(tomb, file=sys.stderr)
        return 2

    parser = build_parser()
    args = parser.parse_args(argv[1:])

    try:
        slug, anchor_path = resolve_anchor(args.anchor)
    except be.BacklogEditError as e:
        print(f"state: {e}", file=sys.stderr)
        return 2

    try:
        if args.verb in _ITEM_VERBS:
            return cmd_item(slug, anchor_path, args)
        if args.verb == "show":
            return cmd_show(slug, anchor_path, args)
        if args.verb == "mint-id":
            return cmd_mint_id(slug, anchor_path, args)
        if args.verb == "drop":
            return cmd_drop(slug, anchor_path, args)
        if args.verb == "inbox-list":
            return cmd_inbox_list(slug, anchor_path, args)
        if args.verb == "inbox-tag":
            return cmd_inbox_tag(slug, anchor_path, args)
        if args.verb == "revalidate":
            return cmd_revalidate(slug, anchor_path, args)
        if args.verb == "triage":
            return cmd_triage(slug, anchor_path, args)
        if args.verb == "crank":
            return cmd_crank(slug, anchor_path, args)
        if args.verb == "groom-list":
            return cmd_groom_list(slug, anchor_path, args)
        if args.verb == "summary-line":
            return cmd_summary_line(slug, anchor_path, args)
        if args.verb == "status":
            if args.subverb == "set":
                return cmd_status_set(slug, anchor_path, args)
            if args.subverb == "show":
                return cmd_status_show(slug, anchor_path, args)
        elif args.verb == "roadmap":
            if args.subverb == "status":
                if args.subsubverb == "get":
                    return cmd_roadmap_status_get(slug, anchor_path, args)
                if args.subsubverb == "set":
                    return cmd_roadmap_status_set(slug, anchor_path, args)
            if args.subverb == "migrate":
                return cmd_roadmap_migrate(slug, anchor_path, args)
        print(f"state: unknown verb {args.verb}", file=sys.stderr)
        return 2
    except be.BacklogEditError as e:
        print(f"state: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

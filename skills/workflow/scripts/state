#!/usr/bin/env python3
"""state — canonical state editor (F129).

Refactor of `backlog-edit.py` to a verb-first CLI. See `~/.claude/skills/workflow/SKL State.md`
for the man-page-style reference (synopsis, anchor resolution, subcommands,
examples). Reuses all helpers from backlog-edit.py via importlib; only the
dispatch + new verbs (slug, anchor cwd-walkup, answer) are new.

Surface (terse):
    state task create  [--anchor A] --status S --title T [--horizon H] [--body B] [--kind F|T|B|R] [--entry E]
    state task update  [--anchor A] ROW-ID [--status S] [--horizon H] [--title T] [--body B]
    state task delete  [--anchor A] ROW-ID
    state q    add     [--anchor A] ROW-ID [--slug NAME] (-m T | --from-file P | <stdin>)
    state q    answer  [--anchor A] ROW-ID (-n N | --slug NAME) --choice OPT [BODY-source]
    state q    remove  [--anchor A] ROW-ID (-n N | --slug NAME) [--reason TEXT]
    state q    rewrite [--anchor A] ROW-ID (-n N | --slug NAME) [--slug NEW] [BODY-source]
    state status set   [--anchor A] FACET CELL [--note TEXT]    # F130
    state status show  [--anchor A] [FACET]                     # F130
    state roadmap status get  [--anchor A] (--feature F<n> | --milestone M-<Name>[.<n>])    # F145
    state roadmap status set  [--anchor A] (--feature F<n> | --milestone M-<Name>[.<n>]) --state {checked|unchecked|deferred}  # F145
    state roadmap migrate     [--anchor A] M-<Name> --date YYYY-MM-DD     # F145

F236 v2 — one address scheme (additive; the surface above keeps working):
    state [-a ANCHOR] <doc> <label> <verb> [--horizon H] [--choice X] [--reason R]
          [--body B | --from-file P] [< body]
        doc   = Backlog (case-insensitive) | wiki-name | path to a .md file
        label = LETTERS+DIGITS — Q7 / V3 (any doc) / F157 / T8 (Backlog only)
        verb  = define (create-or-replace) | resolve (move to Done/Resolved) |
                remove (soft-delete, audit trail preserved)
"""
from __future__ import annotations

import argparse
import importlib.util
import os
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

# Load backlog-edit.py as a module so we can reuse its helpers.
_SCRIPT_DIR = Path(__file__).resolve().parent
_BE_PATH = _SCRIPT_DIR / "backlog-edit.py"
_spec = importlib.util.spec_from_file_location("backlog_edit", _BE_PATH)
if _spec is None or _spec.loader is None:
    print(f"state: cannot load {_BE_PATH}", file=sys.stderr)
    sys.exit(2)
be = importlib.util.module_from_spec(_spec)
sys.modules["backlog_edit"] = be
_spec.loader.exec_module(be)


# ============================================================
# Anchor resolution
# ============================================================


def resolve_anchor(anchor_arg):
    """Resolve --anchor to (slug, anchor_path). Three modes:

    1. anchor_arg is a path containing .anchor (or is the path itself).
    2. anchor_arg is a slug; look it up via the vault scan.
    3. anchor_arg is None; walk cwd UP looking for .anchor.

    Errors if all three fail.
    """
    if anchor_arg:
        # Mode 1: path
        p = Path(anchor_arg).expanduser().resolve()
        if p.is_dir() and (p / ".anchor").exists():
            return _slug_from_anchor_path(p), p
        # Mode 2: slug
        backlog = be.find_backlog(anchor_arg)
        if backlog is not None:
            anchor_path = backlog.parent.parent  # backlog is at {anchor}/{anchor} Track/
            return anchor_arg, anchor_path
        raise be.BacklogEditError(
            f"--anchor {anchor_arg!r}: not a directory with .anchor, "
            f"and no '{anchor_arg} Backlog.md' found in vault"
        )
    # Mode 3: walk cwd UP
    cwd = Path.cwd()
    p = cwd
    while p != p.parent:
        if (p / ".anchor").exists():
            return _slug_from_anchor_path(p), p
        p = p.parent
    raise be.BacklogEditError(
        "no --anchor given and no .anchor ancestor of cwd "
        f"({cwd}). Specify --anchor PATH|SLUG."
    )


_ANCHOR_SLUG_RE = re.compile(r"^slug:\s*(\S+)\s*$")


def _slug_from_anchor_path(anchor_path):
    """Derive slug from the `.anchor` file's `slug:` line.

    The `.anchor` file is YAML-shaped; the first `slug:` line carries the
    canonical slug (e.g. `SKA`), which differs from the folder name
    (`Skill Agent`) for most anchors. Falls back to the folder name only
    when `.anchor` is missing or carries no `slug:` line.
    """
    anchor_file = anchor_path / ".anchor"
    if anchor_file.is_file():
        try:
            for line in anchor_file.read_text(encoding="utf-8").splitlines():
                m = _ANCHOR_SLUG_RE.match(line)
                if m:
                    return m.group(1)
        except OSError:
            pass
    return anchor_path.name


# ============================================================
# Body sourcing
# ============================================================


def read_body(args):
    """Get body from -m, --from-file, or stdin."""
    inline = getattr(args, "inline", None)
    from_file = getattr(args, "from_file", None)
    if inline is not None:
        return inline
    if from_file is not None:
        p = Path(from_file).expanduser()
        if not p.is_file():
            raise be.BacklogEditError(f"--from-file path not found: {p}")
        return p.read_text(encoding="utf-8")
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return ""


# ============================================================
# Slug support — extend Q-management
# ============================================================


_SLUG_TAG_RE = re.compile(r"\[slug:\s*([a-z0-9][a-z0-9_\-]*)\]")


def _slug_in_line(line):
    m = _SLUG_TAG_RE.search(line)
    return m.group(1) if m else None


def _find_q_bullet_by_slug(lines, slug):
    """Find a Q-bullet by its [slug: NAME] tag. Returns same shape as
    be._find_q_bullet: (start, end, indent) or None."""
    for i, line in enumerate(lines):
        m = be._Q_HEADER_BULLET_RE.match(line)
        if not m:
            continue
        # Confirm in Open Questions pending area
        section = be._section_at(lines, i)
        if section != "Open Questions:Pending":
            continue
        # Slug may be on the header line or in the body — gather full bullet first
        # to scan for the slug tag.
        indent = m.group(1)
        end = len(lines)
        for j in range(i + 1, len(lines)):
            l = lines[j]
            if l.startswith("#"):
                end = j
                break
            mh = be._Q_HEADER_BULLET_RE.match(l)
            if mh and (len(l) - len(l.lstrip())) <= len(indent):
                end = j
                break
        block = "\n".join(lines[i:end])
        if _slug_in_line(block) == slug:
            return (i, end, indent)
    return None


def _resolve_q_identifier(lines, q_num, slug):
    """Locate a Q by either q_num or slug. Returns (start, end, indent, q_num).
    Raises BacklogEditError on miss / ambiguity."""
    if q_num is not None and slug is not None:
        raise be.BacklogEditError("specify either -n N or --slug NAME, not both")
    if q_num is not None:
        loc = be._find_q_bullet(lines, q_num)
        if loc is None:
            raise be.BacklogEditError(f"Q{q_num} not found in pending Open Questions")
        s, e, ind = loc
        return s, e, ind, q_num
    if slug is not None:
        loc = _find_q_bullet_by_slug(lines, slug)
        if loc is None:
            raise be.BacklogEditError(f"Q with --slug {slug!r} not found in pending Open Questions")
        s, e, ind = loc
        m = be._Q_HEADER_BULLET_RE.match(lines[s])
        return s, e, ind, int(m.group(2))
    raise be.BacklogEditError("must specify either -n N or --slug NAME")


def _format_q_bullet_with_slug(q_num, container_id, body, slug):
    """Wrap a body into the canonical Q-bullet form with block-ID AND optional slug tag."""
    bullet = be._format_q_bullet(q_num, container_id, body)
    if slug:
        # Strip any existing [slug: ...] tag and add ours
        bullet = _SLUG_TAG_RE.sub("", bullet).rstrip()
        # Insert after block-ID, before any newline
        first_line, sep, rest = bullet.partition("\n")
        first_line = first_line.rstrip() + f" [slug: {slug}]"
        bullet = first_line + (sep + rest if sep else "")
    return bullet


# ============================================================
# Task subcommands
# ============================================================


def _roadmap_entry_to_name_path(entry):
    """Normalize a roadmap-entry reference to its bare name-path.

    'M-Scaffolding.5.2' → 'Scaffolding.5.2'   (strip the M- roadmap prefix)
    'R-Scaffolding.5.2' → 'Scaffolding.5.2'   (already a task ref)
    'Scaffolding.5.2'   → 'Scaffolding.5.2'   (bare)
    """
    e = (entry or "").strip()
    if e.startswith(("M-", "R-")):
        e = e[2:]
    return e


def _validate_roadmap_entry(slug, anchor_path, name_path):
    """Confirm `M-<name_path>` exists as an entry in `{slug} Roadmap.md` — a
    milestone heading (`## [ ] M-<Name>.<path> — …`) or an inline checklist
    item — before minting an R task against it. Raises with guidance on miss so
    an `R` handle can never point at a non-existent roadmap entry.
    """
    rp = _roadmap_path(slug, anchor_path)
    if not rp.exists():
        raise be.BacklogEditError(
            f"no '{slug} Roadmap.md' to reference — an R roadmap-task needs an "
            f"existing roadmap entry. File this as a backlog task instead (--kind T)."
        )
    milestone = "M-" + name_path
    tok = re.compile(rf"(?<![\w.\-]){re.escape(milestone)}(?![\w.\-])")
    for line in rp.read_text(encoding="utf-8").splitlines():
        hm = _MILESTONE_HEADING_RE.match(line)
        if hm and hm.group("ident") == milestone:
            return
        bm = _INLINE_CHECKBOX_RE.match(line)
        if bm and tok.search(bm.group("rest")):
            return
    raise be.BacklogEditError(
        f"roadmap entry '{milestone}' not found in '{rp.name}' — check the "
        f"name-path (a leaf or non-leaf entry), or add the entry to the roadmap first."
    )


def cmd_task_create(slug, anchor_path, args):
    """Mint a new row in the anchor's backlog.

    F / T / B → a monotonic minted number (`Fnew` / `Tnew` / `Bnew`; T and F are
    separate namespaces, both zero-padded triple-digit). R → a roadmap task whose
    handle is the referenced entry's name-path (`R-<Name>.<path>`), not a counter;
    requires `--entry`.
    """
    kind = (args.kind or "F").upper()
    if kind == "R":
        entry = getattr(args, "entry", None)
        if not entry:
            raise be.BacklogEditError(
                "task create --kind R requires --entry "
                "(the roadmap entry, e.g. --entry M-Scaffolding.5.2)"
            )
        name_path = _roadmap_entry_to_name_path(entry)
        _validate_roadmap_entry(slug, anchor_path, name_path)
        row_id_arg = "R-" + name_path
    else:
        row_id_arg = f"{kind}new"
    return _delegate_row_edit(
        slug, args.horizon or "Now", row_id_arg, args.status,
        args.title, args.body or "",
        title_provided=True, body_provided=bool(args.body),
        verify_text=getattr(args, "verify", None),
        next_text=getattr(args, "next", None),
    )


def cmd_task_update(slug, anchor_path, args):
    """Update properties of an existing row. At least one of --status/--horizon/
    --title/--body required."""
    if not any([args.status, args.horizon, args.title is not None, args.body is not None]):
        raise be.BacklogEditError(
            "task update requires at least one of --status / --horizon / --title / --body"
        )
    horizon = args.horizon or "same"
    status = args.status or "same"
    title = args.title if args.title is not None else ""
    body = args.body if args.body is not None else ""
    title_provided = args.title is not None
    body_provided = args.body is not None
    return _delegate_row_edit(
        slug, horizon, args.row_id, status,
        title, body,
        title_provided=title_provided, body_provided=body_provided,
        verify_text=getattr(args, "verify", None),
        next_text=getattr(args, "next", None),
    )


def cmd_task_delete(slug, anchor_path, args):
    """Delete a row entirely."""
    return _delegate_row_edit(
        slug, "same", args.row_id, "delete",
        "", "", title_provided=False, body_provided=False,
    )


def _delegate_row_edit(slug, horizon, row_id_arg, status, title, body,
                       title_provided, body_provided,
                       verify_text=None, next_text=None):
    """Delegate to backlog-edit's perform_edit machinery, mirroring its main()."""
    if status != "delete" and status != "same":
        # Validate status bracket against the closed canonical set.
        be.validate_status(status)
        # Validate horizon
        if horizon != "same":
            horizon_check = horizon.lstrip("# ").strip()
            if horizon_check not in be.VALID_HORIZONS:
                raise be.BacklogEditError(
                    f"invalid horizon '{horizon}' "
                    f"(expected one of {sorted(be.VALID_HORIZONS)} or 'same')"
                )

    backlog_path = be.find_backlog(slug)
    if backlog_path is None:
        raise be.BacklogEditError(f"no '{slug} Backlog.md' under vault root")
    icebox_path = be.find_icebox(slug)

    if row_id_arg in ("Fnew", "Bnew", "Tnew"):
        kind = row_id_arg[0]
        num = be.mint_cross_file_id(backlog_path, icebox_path, kind)
        row_id_arg = be.format_row_id(kind, num)

    src_file, dst_file, dst_horizon = be.resolve_files_for_edit(
        slug, backlog_path, horizon, row_id_arg, status,
    )

    if src_file is not None:
        be.perform_edit(
            src_file, "same", row_id_arg, "delete",
            "", "", False, False,
        )

    result = be.perform_edit(
        dst_file, dst_horizon, row_id_arg, status,
        title, body, title_provided, body_provided,
        verify_text=verify_text, next_text=next_text,
    )
    be.append_messages(slug, result["summary"], backlog_path)
    be.write_state(slug, result)
    be.refresh_q_md(slug)
    # F145 auto-sync — a Done transition on an F-row flips the matching roadmap
    # checkbox (if the F-number appears on the roadmap). Same post-condition slot
    # `task update` already uses for refresh_q_md; failure here is non-fatal.
    if status not in ("delete", "same") and status.startswith("Done") \
            and row_id_arg.upper().startswith("F"):
        sync_msg = _sync_roadmap_on_done(slug, backlog_path, row_id_arg)
        if sync_msg:
            print(f"{slug}: {sync_msg}")
    print(f"{slug}: {result['summary']}")
    return 0


def _sync_roadmap_on_done(slug, backlog_path, row_id):
    """F145 — on a feature-doc Done transition, grep the roadmap for the
    F-number marker and flip its checkbox to `[x]`. Returns a one-line summary
    if a checkbox was flipped, else None. Never raises (best-effort post-cond).
    """
    try:
        roadmap = backlog_path.parent.parent / f"{slug} Design" / f"{slug} Roadmap.md"
        if not roadmap.exists():
            return None
        text = roadmap.read_text(encoding="utf-8")
        lines = text.splitlines()
        fnum = _feature_num(row_id)
        changed = False
        for i, line in enumerate(lines):
            hm = _MILESTONE_HEADING_RE.match(line)
            bm = _INLINE_CHECKBOX_RE.match(line)
            rest = hm.group("rest") if hm else (bm.group("rest") if bm else None)
            box = hm.group("box") if hm else (bm.group("box") if bm else None)
            if rest is None:
                continue
            fnums = [int(n) for n in _F_REF_RE.findall(rest)]
            if fnum in fnums and box != "x":
                lines[i] = _set_box_on_line(line, "x")
                changed = True
        if not changed:
            return None
        roadmap.write_text("\n".join(lines) + ("\n" if text.endswith("\n") else ""),
                           encoding="utf-8")
        return f"roadmap auto-sync — flipped {row_id} checkbox to [x]"
    except (be.BacklogEditError, OSError, UnicodeDecodeError):
        return None


# ============================================================
# Q subcommands
# ============================================================


def cmd_q_add(slug, anchor_path, args):
    """Add a new Q to a feature doc."""
    feature_path = be._find_feature_doc(slug, args.row_id)
    text = feature_path.read_text(encoding="utf-8")
    container_id = be._container_id_for_feature(feature_path)
    body = read_body(args)
    if not body.strip():
        raise be.BacklogEditError("q add requires a body via stdin, --from-file, or -m")
    q_num = be._next_q_number(text)
    new_bullet = _format_q_bullet_with_slug(q_num, container_id, body, args.slug)
    lines = text.splitlines()
    lines, (h2_start, h2_end) = be._ensure_open_questions_h2(lines)
    insert_at = h2_end
    for j in range(h2_start + 1, h2_end):
        if lines[j].startswith("### "):
            insert_at = j
            break
    while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
        insert_at -= 1
    new_lines = ["", new_bullet] if insert_at > 0 and lines[insert_at - 1].strip() else [new_bullet]
    new_lines = new_lines + [""]
    lines = lines[:insert_at] + new_lines + lines[insert_at:]
    feature_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""),
        encoding="utf-8",
    )
    summary = f"added Q{q_num}" + (f" (slug: {args.slug})" if args.slug else "") + f" to {feature_path.name}"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _clamp_h2_end_to_h1(lines, h2_start, h2_end):
    """Tighten an H2 content range from be._find_h2 (generic H2-line to
    next-'## '-line) to stop at the doc's H1 if the H1 falls inside that
    range. `## Open Questions` sits ABOVE the H1 by design (Phase 1/2/3
    lifecycle, per [[DAS ask-format]]); be._find_h2 doesn't know that
    convention, so when there's no OTHER '## ' heading between the Open
    Questions block and the doc's first real H2, the computed end wanders
    through the H1 line and all body prose — defeating any "is this block
    empty" check and mis-siting insertions. Only ever narrows the range,
    never changes behavior for a genuinely doc-body-scoped H2. (Found via
    F236 v2 smoke-testing — confirmed pre-existing across 52 vault docs
    carrying a residual empty `## Open Questions` H2 from this exact gap;
    left untouched in backlog-edit.py's `-Q resolve`/`-Q remove`, which this
    v2 work doesn't otherwise modify.)
    """
    for k in range(h2_start + 1, h2_end):
        if lines[k].startswith("# ") and not lines[k].startswith("## "):
            return k
    return h2_end


def cmd_q_answer(slug, anchor_path, args):
    """Answer a Q — move to ## Resolved as ### Qn — Title H3."""
    feature_path = be._find_feature_doc(slug, args.row_id)
    body = read_body(args)
    return _q_answer_core(slug, feature_path, args.q_num, args.slug, args.choice, body)


def _q_answer_core(slug, feature_path, q_num, q_slug, choice, body):
    """Block-surgery for Q-answer, factored out of `feature_path` lookup (F236
    v2) so it runs against ANY doc path — the legacy `state q answer` locates
    feature_path by F-number first, then calls this same core."""
    text = feature_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    start, end, _, q_num = _resolve_q_identifier(lines, q_num, q_slug)
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*Q\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    original_body = "\n".join(lines[start:end]).rstrip()
    today = date.today().isoformat()
    h3_lines = [
        "",
        f"### Q{q_num} — {title} (resolved {today})",
        f"**Choice:** {choice}",
        "",
    ]
    if body.strip():
        h3_lines.append(body.rstrip())
        h3_lines.append("")
    h3_lines.append("> Original Q context:")
    for ol in original_body.splitlines():
        h3_lines.append(f"> {ol}")
    h3_lines.append("")
    lines = lines[:start] + lines[end:]
    lines, (rh2_start, rh2_end) = be._ensure_bottom_resolved_h2(lines)
    insert_at = rh2_end
    while insert_at > rh2_start + 1 and not lines[insert_at - 1].strip():
        insert_at -= 1
    lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    # Phase-2 transition: drop empty ## Open Questions
    oq = be._find_h2(lines, "Open Questions")
    if oq is not None:
        oq_start, oq_end = oq
        oq_end = _clamp_h2_end_to_h1(lines, oq_start, oq_end)
        empty = True
        for k in range(oq_start + 1, oq_end):
            if lines[k].strip() and not lines[k].startswith("### "):
                empty = False
                break
            if lines[k].startswith("### "):
                empty = False
                break
        if empty:
            drop_end = oq_end
            while drop_end < len(lines) and not lines[drop_end].strip():
                drop_end += 1
            if drop_end < len(lines):
                lines = lines[:oq_start] + lines[drop_end:]
            else:
                lines = lines[:oq_start]
    feature_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""),
        encoding="utf-8",
    )
    summary = f"answered Q{q_num} (choice {choice}) in {feature_path.name}"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def cmd_q_remove(slug, anchor_path, args):
    """Remove a Q — move body to ### Removed H3 for audit trail."""
    feature_path = be._find_feature_doc(slug, args.row_id)
    return _q_remove_core(slug, feature_path, args.q_num, args.slug, args.reason)


def _q_remove_core(slug, feature_path, q_num, q_slug, reason):
    """Block-surgery for Q-remove, factored out of `feature_path` lookup (F236
    v2) so it runs against ANY doc path — see `_q_answer_core`."""
    text = feature_path.read_text(encoding="utf-8")
    reason = reason or "no reason provided"
    lines = text.splitlines()
    start, end, _, q_num = _resolve_q_identifier(lines, q_num, q_slug)
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*Q\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    original_body = "\n".join(lines[start:end]).rstrip()
    today = date.today().isoformat()
    h3_lines = [
        "",
        f"### Q{q_num} — {title} (removed {today} — {reason})",
        "",
        "> Original Q context (preserved for audit trail):",
    ]
    for ol in original_body.splitlines():
        h3_lines.append(f"> {ol}")
    h3_lines.append("")
    lines = lines[:start] + lines[end:]
    oq = be._find_h2(lines, "Open Questions")
    if oq is None:
        lines, (oq_start, oq_end) = be._ensure_open_questions_h2(lines)
    else:
        oq_start, oq_end = oq
        oq_end = _clamp_h2_end_to_h1(lines, oq_start, oq_end)
    removed = be._find_h3_in_h2(lines, oq_start, oq_end, "Removed")
    if removed is None:
        insert_at = oq_end
        while insert_at > oq_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + ["", "### Removed", ""] + h3_lines[1:] + lines[insert_at:]
    else:
        r_start, r_end = removed
        insert_at = r_end
        while insert_at > r_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    feature_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""),
        encoding="utf-8",
    )
    summary = f"removed Q{q_num} from {feature_path.name} (reason: {reason})"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def cmd_q_rewrite(slug, anchor_path, args):
    """Overwrite a Q body (no --force gate; verb name IS the explicit intent).

    `--slug NAME` to identify the Q AND (if second occurrence on this verb)
    rename the slug. Per F129 spec: pass --slug once as identifier, OR pass
    -n for identification AND --slug NEW for renaming.
    """
    feature_path = be._find_feature_doc(slug, args.row_id)
    text = feature_path.read_text(encoding="utf-8")
    container_id = be._container_id_for_feature(feature_path)
    body = read_body(args)
    if not body.strip():
        raise be.BacklogEditError("q rewrite requires a body via stdin, --from-file, or -m")
    lines = text.splitlines()
    # If both -n and --slug given: -n identifies, --slug NEW renames/attaches
    # If only --slug given: identifies AND (if body has no slug) keeps it
    # If only -n given: identifies; preserve existing slug on the bullet
    if args.q_num is not None:
        # -n identifies; --slug (if given) is the NEW slug
        loc = be._find_q_bullet(lines, args.q_num)
        if loc is None:
            raise be.BacklogEditError(f"Q{args.q_num} not found in pending Open Questions")
        start, end, _ = loc
        q_num = args.q_num
        new_slug = args.slug  # None → preserve, value → set
    elif args.slug is not None:
        loc = _find_q_bullet_by_slug(lines, args.slug)
        if loc is None:
            raise be.BacklogEditError(f"Q with --slug {args.slug!r} not found in pending Open Questions")
        start, end, _ = loc
        m = be._Q_HEADER_BULLET_RE.match(lines[start])
        q_num = int(m.group(2))
        new_slug = args.slug  # preserve
    else:
        raise be.BacklogEditError("q rewrite requires -n N or --slug NAME to identify the Q")
    # If new_slug is None, try to preserve existing slug from the bullet
    if new_slug is None:
        old_block = "\n".join(lines[start:end])
        new_slug = _slug_in_line(old_block)
    new_bullet = _format_q_bullet_with_slug(q_num, container_id, body, new_slug)
    new_bullet_lines = new_bullet.splitlines()
    lines = lines[:start] + new_bullet_lines + lines[end:]
    feature_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""),
        encoding="utf-8",
    )
    slug_note = f" (slug: {new_slug})" if new_slug else ""
    summary = f"rewrote Q{q_num}{slug_note} in {feature_path.name}"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _post_conditions_and_print(slug, feature_path, summary):
    """Run F127 post-conditions; print summary + any warnings."""
    warnings = be._post_conditions(slug, feature_path)
    # Q-mutations change banner counts ([N Questions]) and bracket state, so the
    # anchor's Q.md section must be regenerated — same refresh `state task` runs.
    # Keeps Q.md current entirely through `state`; no separate queries-render call.
    be.refresh_q_md(slug)
    print(f"{slug}: {summary}")
    for w in warnings:
        print(f"  warn: {w}", file=sys.stderr)


# ============================================================
# Status subcommands (F130) — manage {slug} Status.md per-facet planning state
# ============================================================


VALID_STATUS_CELLS = (
    "none",
    "MVP-agent", "MVP-user",
    "Full-agent", "Full-user",
)

# Declared facet order — used by /plan picker tie-break + bare `status show`.
DEFAULT_STATUS_FACETS = ("prd", "ux", "architecture", "testing", "roadmap")

_STATUS_LINE_RE = re.compile(r"^([a-z][a-z0-9_]*):\:\s*(.*)$")


def _status_path(slug, anchor_path):
    """{slug} Status.md lives in the Track folder next to Backlog/Icebox/etc."""
    return anchor_path / f"{slug} Docs" / f"{slug} Track" / f"{slug} Status.md"


def _ensure_status_file(slug, anchor_path):
    """Create {slug} Status.md with all default facets at `none` if absent.

    Fails if the Track folder doesn't exist (caller's anchor is malformed).
    """
    path = _status_path(slug, anchor_path)
    if path.exists():
        return path
    if not path.parent.exists():
        raise be.BacklogEditError(
            f"can't create {path.name}: parent {path.parent} doesn't exist"
        )
    body_lines = [
        "---",
        "description: planning status — per-facet tier+approver; consumed by /plan",
        "---",
        "",
        f"# [[{slug}]] Status",
        "",
    ]
    for facet in DEFAULT_STATUS_FACETS:
        body_lines.append(f"{facet}:: none")
    body_lines.append("")
    path.write_text("\n".join(body_lines), encoding="utf-8")
    return path


def _parse_status_lines(text):
    """Return list of (facet, body) in file order. body == 'none' or '<cell> (date) — note'."""
    out = []
    for line in text.splitlines():
        m = _STATUS_LINE_RE.match(line)
        if m:
            out.append((m.group(1), m.group(2).strip()))
    return out


def cmd_status_set(slug, anchor_path, args):
    """Set or overwrite a facet's status cell."""
    facet = args.facet.lower()
    cell = args.cell
    note = (args.note or "").strip()

    if not re.match(r"^[a-z][a-z0-9_]*$", facet):
        raise be.BacklogEditError(
            f"invalid facet {facet!r}; expected lowercase letters / digits / underscore"
        )
    if cell not in VALID_STATUS_CELLS:
        raise be.BacklogEditError(
            f"invalid cell {cell!r}; expected one of {list(VALID_STATUS_CELLS)}"
        )
    if cell.endswith("-user") and not note:
        raise be.BacklogEditError(
            f"--note is required when setting {cell} "
            "(user rationale is institutional memory; pass --note \"<one-line>\")"
        )

    path = _ensure_status_file(slug, anchor_path)
    today = date.today().isoformat()

    if cell == "none":
        new_line = f"{facet}:: none"
    else:
        new_line = f"{facet}:: {cell} ({today})"
        if note:
            new_line += f" — {note}"

    lines = path.read_text(encoding="utf-8").splitlines()
    facet_pat = re.compile(rf"^{re.escape(facet)}::")
    replaced = False
    out_lines = []
    for line in lines:
        if facet_pat.match(line):
            out_lines.append(new_line)
            replaced = True
        else:
            out_lines.append(line)
    if not replaced:
        # Append before trailing blank line if present, else at end
        while out_lines and out_lines[-1] == "":
            out_lines.pop()
        out_lines.append(new_line)
        out_lines.append("")
    else:
        # Ensure file ends with single trailing newline
        while len(out_lines) >= 2 and out_lines[-1] == "" and out_lines[-2] == "":
            out_lines.pop()
        if not out_lines or out_lines[-1] != "":
            out_lines.append("")

    path.write_text("\n".join(out_lines), encoding="utf-8")
    note_tail = f" — {note}" if note else ""
    print(f"{slug}: status {facet} → {cell}{note_tail}")
    return 0


def cmd_status_show(slug, anchor_path, args):
    """Print one or all facet status lines.

    With no argument: print every DEFAULT_STATUS_FACETS in declared order,
    then any extra facets in file-order. Missing facets default to `none`.
    """
    requested = args.facet.lower() if args.facet else None
    path = _status_path(slug, anchor_path)
    found = {}
    file_order = []
    if path.exists():
        for facet, body in _parse_status_lines(path.read_text(encoding="utf-8")):
            if facet not in found:
                file_order.append(facet)
            found[facet] = body

    if requested:
        body = found.get(requested, "none")
        print(f"{requested}:: {body}")
        return 0

    for facet in DEFAULT_STATUS_FACETS:
        body = found.get(facet, "none")
        print(f"{facet}:: {body}")
    for facet in file_order:
        if facet not in DEFAULT_STATUS_FACETS:
            print(f"{facet}:: {found[facet]}")
    return 0


# ============================================================
# Roadmap subcommands (F145) — status get/set + whole-milestone migrate
# ============================================================
#
# The roadmap lives at `{slug} Design/{slug} Roadmap.md`; the Completed Roadmap
# is its sibling. Milestone headings carry a checkbox in the title:
#   ## [ ] M-Store — Persistence Layer
#   ### [x] M-Store.1 — SQLite schema  [F050]
# Sub-items may also be inline bullets:  `- [x] [[F017 — ...]] — ...`.
#
# These commands mutate roadmap files in place. They are deliberately
# defensive — every parse failure raises BacklogEditError with the offending
# context rather than corrupting the file.


# Milestone heading: hashes, checkbox, identifier, trailing text.
_MILESTONE_HEADING_RE = re.compile(
    r"^(?P<hashes>#{1,3})\s+\[(?P<box>[ x~])\]\s+(?P<ident>M[-\w.]*)(?P<rest>.*)$"
)
# Inline checkbox bullet carrying an `[[F<n>` wiki-link or an `[F<n>]` marker.
_INLINE_CHECKBOX_RE = re.compile(r"^(?P<indent>\s*)- \[(?P<box>[ x~])\]\s+(?P<rest>.*)$")
# `[F123]` marker / `[[F123 — ...` wiki-link F-number extractor.
_F_REF_RE = re.compile(r"\[\[?F(\d+)\b")

# State name → checkbox character.
_STATE_TO_BOX = {"checked": "x", "unchecked": " ", "deferred": "~"}
_BOX_TO_STATE = {"x": "checked", " ": "unchecked", "~": "deferred"}


def _roadmap_path(slug, anchor_path, completed=False):
    """`{slug} Design/{slug} [Completed ]Roadmap.md` — the canonical location.

    Falls back to a vault-walk via find_backlog's anchor when the Design folder
    isn't directly under anchor_path (sub-anchors, linked-mode, etc.).
    """
    suffix = "Completed Roadmap.md" if completed else "Roadmap.md"
    direct = anchor_path / f"{slug} Design" / f"{slug} {suffix}"
    if direct.exists():
        return direct
    # Vault-walk: locate `{slug} {suffix}` near the backlog.
    backlog = be.find_backlog(slug)
    design_dir = backlog.parent.parent / f"{slug} Design"
    cand = design_dir / f"{slug} {suffix}"
    return cand  # may not exist yet (Completed Roadmap is created on first migrate)


def _find_roadmap_entry(lines, feature=None, milestone=None):
    """Locate a roadmap entry by F-number or milestone id.

    Returns (line_index, kind, current_box) where kind is 'heading' or 'inline'.
    Raises BacklogEditError on miss / ambiguity.
    """
    if (feature is None) == (milestone is None):
        raise be.BacklogEditError("specify exactly one of --feature F<n> / --milestone M-<Name>")
    matches = []
    for i, line in enumerate(lines):
        hm = _MILESTONE_HEADING_RE.match(line)
        if hm:
            if milestone is not None and hm.group("ident") == milestone:
                matches.append((i, "heading", hm.group("box")))
            elif feature is not None:
                fnums = [int(n) for n in _F_REF_RE.findall(hm.group("rest"))]
                if _feature_num(feature) in fnums:
                    matches.append((i, "heading", hm.group("box")))
            continue
        bm = _INLINE_CHECKBOX_RE.match(line)
        if bm:
            if milestone is not None:
                # An inline bullet naming the milestone id literally.
                if re.search(rf"\bM-?{re.escape(milestone[2:])}\b", bm.group("rest")) \
                        and milestone.startswith("M-"):
                    matches.append((i, "inline", bm.group("box")))
            elif feature is not None:
                fnums = [int(n) for n in _F_REF_RE.findall(bm.group("rest"))]
                if _feature_num(feature) in fnums:
                    matches.append((i, "inline", bm.group("box")))
    if not matches:
        ref = milestone or feature
        raise be.BacklogEditError(f"no roadmap entry found for {ref!r}")
    if len(matches) > 1:
        ref = milestone or feature
        ln = ", ".join(str(i + 1) for i, _, _ in matches)
        raise be.BacklogEditError(
            f"multiple roadmap entries match {ref!r} (lines {ln}); "
            f"narrow by --milestone with full sub-position or fix duplicates"
        )
    return matches[0]


def _feature_num(feature):
    """Normalize 'F145' / 'f145' / '145' → int 145."""
    m = re.match(r"^[Ff]?(\d+)$", feature.strip())
    if not m:
        raise be.BacklogEditError(f"invalid --feature {feature!r} (expected F<n>)")
    return int(m.group(1))


def _set_box_on_line(line, new_box):
    """Replace the checkbox char on a milestone heading or inline bullet."""
    hm = _MILESTONE_HEADING_RE.match(line)
    if hm:
        return f"{hm.group('hashes')} [{new_box}] {hm.group('ident')}{hm.group('rest')}"
    bm = _INLINE_CHECKBOX_RE.match(line)
    if bm:
        return f"{bm.group('indent')}- [{new_box}] {bm.group('rest')}"
    raise be.BacklogEditError(f"cannot set checkbox on non-milestone line: {line!r}")


def cmd_roadmap_status_get(slug, anchor_path, args):
    """Print a roadmap entry's current checkbox state."""
    path = _roadmap_path(slug, anchor_path)
    if not path.exists():
        raise be.BacklogEditError(f"no roadmap at {path}")
    lines = path.read_text(encoding="utf-8").splitlines()
    idx, kind, box = _find_roadmap_entry(lines, args.feature, args.milestone)
    state = _BOX_TO_STATE.get(box, "unknown")
    ref = args.milestone or args.feature
    print(f"{slug}: {ref} → {state} (line {idx + 1})")
    return 0


def cmd_roadmap_status_set(slug, anchor_path, args):
    """Set a roadmap entry's checkbox state by F-number or milestone id."""
    if args.state not in _STATE_TO_BOX:
        raise be.BacklogEditError(
            f"invalid --state {args.state!r}; expected one of {list(_STATE_TO_BOX)}"
        )
    path = _roadmap_path(slug, anchor_path)
    if not path.exists():
        raise be.BacklogEditError(f"no roadmap at {path}")
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    idx, kind, old_box = _find_roadmap_entry(lines, args.feature, args.milestone)
    new_box = _STATE_TO_BOX[args.state]
    lines[idx] = _set_box_on_line(lines[idx], new_box)
    path.write_text("\n".join(lines) + ("\n" if text.endswith("\n") else ""),
                    encoding="utf-8")
    ref = args.milestone or args.feature
    print(f"{slug}: roadmap {ref} {_BOX_TO_STATE[old_box]} → {args.state} (line {idx + 1})")
    return 0


def _extract_milestone_section(lines, milestone):
    """Extract a whole top-level milestone H2 section.

    Returns (start_idx, end_idx) where the slice lines[start:end] covers the
    `## [ ] M-<Name> …` heading through (and including) the trailing `### .`
    separator if present, up to but excluding the next `## ` H2 (or EOF).
    Raises BacklogEditError if the milestone isn't a top-level H2.
    """
    start = None
    for i, line in enumerate(lines):
        hm = _MILESTONE_HEADING_RE.match(line)
        if hm and hm.group("ident") == milestone and len(hm.group("hashes")) == 2:
            start = i
            break
    if start is None:
        raise be.BacklogEditError(
            f"milestone {milestone!r} not found as a top-level (## H2) heading"
        )
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if re.match(r"^## ", lines[j]):
            end = j
            break
    # Trim trailing blank lines out of the section (they stay with the source).
    sec_end = end
    while sec_end > start + 1 and lines[sec_end - 1].strip() == "":
        sec_end -= 1
    return start, sec_end, end


def _milestone_all_complete(section_lines):
    """True if the milestone heading is [x] AND no sub-item is unchecked `[ ]`.

    Deferred `[~]` sub-items are allowed (they migrate in their deferred state).
    """
    heading = section_lines[0]
    hm = _MILESTONE_HEADING_RE.match(heading)
    if not hm or hm.group("box") != "x":
        return False
    for line in section_lines[1:]:
        bm = _INLINE_CHECKBOX_RE.match(line)
        sm = _MILESTONE_HEADING_RE.match(line)
        box = (bm.group("box") if bm else (sm.group("box") if sm else None))
        if box == " ":
            return False
    return True


_STANDALONE_GROUPING_RE = re.compile(
    r"^## Completed standalone features\b", re.IGNORECASE
)


def _ensure_completed_roadmap(slug, completed_path):
    """Create the Completed Roadmap with an H1 if absent. Returns its text."""
    if completed_path.exists():
        return completed_path.read_text(encoding="utf-8")
    if not completed_path.parent.exists():
        raise be.BacklogEditError(
            f"can't create {completed_path.name}: parent "
            f"{completed_path.parent} doesn't exist"
        )
    header = f"# {slug} Completed Roadmap\n\n"
    completed_path.write_text(header, encoding="utf-8")
    return header


def cmd_roadmap_migrate(slug, anchor_path, args):
    """Atomically migrate a whole completed milestone from Roadmap to Completed
    Roadmap, preserving checkbox states + adding a `migrated <date>` note.

    Steps:
      1. Extract the `## [x] M-<Name> …` section from the live Roadmap.
      2. Verify it's complete (heading [x], no [ ] sub-items).
      3. Stamp the heading with `(migrated YYYY-MM-DD)`.
      4. Seal the current standalone grouping in the Completed Roadmap and
         insert the migrated milestone below it; open a fresh standalone
         grouping at the top.
      5. Remove the section from the live Roadmap.
    """
    milestone = args.milestone
    if not milestone.startswith("M-"):
        raise be.BacklogEditError(f"milestone must be named form M-<Name>, got {milestone!r}")
    date_str = args.date  # required by the parser; never call Date.now() unguarded
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", date_str):
        raise be.BacklogEditError(f"--date must be YYYY-MM-DD, got {date_str!r}")

    roadmap = _roadmap_path(slug, anchor_path)
    if not roadmap.exists():
        raise be.BacklogEditError(f"no roadmap at {roadmap}")
    rm_text = roadmap.read_text(encoding="utf-8")
    rm_lines = rm_text.splitlines()

    start, sec_end, next_h2 = _extract_milestone_section(rm_lines, milestone)
    section = rm_lines[start:sec_end]
    if not _milestone_all_complete(section):
        raise be.BacklogEditError(
            f"milestone {milestone!r} is not fully complete "
            f"(heading must be [x] and no sub-item may be [ ]); "
            f"refusing to migrate. Mark it complete first or salvage sub-items."
        )

    # Stamp the heading with the migrated-date note (idempotent: don't double-stamp).
    hm = _MILESTONE_HEADING_RE.match(section[0])
    rest = hm.group("rest").rstrip()
    if "(migrated " not in rest:
        rest = f"{rest} (migrated {date_str})"
    migrated_heading = f"## [x] {hm.group('ident')}{rest}"
    migrated_section = [migrated_heading] + section[1:]

    # --- Build the new Completed Roadmap ---
    completed = _roadmap_path(slug, anchor_path, completed=True)
    comp_text = _ensure_completed_roadmap(slug, completed)
    comp_lines = comp_text.splitlines()

    # Find the H1 line.
    h1_idx = next((i for i, l in enumerate(comp_lines) if l.startswith("# ")), -1)
    insert_base = h1_idx + 1 if h1_idx >= 0 else 0

    # Seal the existing top standalone grouping (if any) by leaving it in place,
    # then insert the migrated milestone just below it; finally open a fresh
    # standalone grouping at the very top.
    fresh_grouping = [
        "",
        f"## Completed standalone features (since {milestone} migration, {date_str})",
        "",
    ]
    # Locate the first existing standalone grouping after the H1 (the current one).
    existing_group_idx = None
    for i in range(insert_base, len(comp_lines)):
        if _STANDALONE_GROUPING_RE.match(comp_lines[i]):
            existing_group_idx = i
            break

    if existing_group_idx is not None:
        # End of the existing (now-sealed) grouping = next H2 or EOF.
        seal_end = len(comp_lines)
        for j in range(existing_group_idx + 1, len(comp_lines)):
            if comp_lines[j].startswith("## "):
                seal_end = j
                break
        # Trim trailing blanks of the sealed grouping.
        while seal_end > existing_group_idx + 1 and comp_lines[seal_end - 1].strip() == "":
            seal_end -= 1
        # New layout: H1 + fresh grouping + sealed grouping + migrated milestone + rest.
        new_comp = (
            comp_lines[:insert_base]
            + fresh_grouping
            + comp_lines[existing_group_idx:seal_end]
            + [""]
            + migrated_section
            + [""]
            + comp_lines[seal_end:]
        )
    else:
        # No existing grouping — start fresh grouping then the milestone.
        new_comp = (
            comp_lines[:insert_base]
            + fresh_grouping
            + migrated_section
            + [""]
            + comp_lines[insert_base:]
        )
    completed.write_text("\n".join(new_comp).rstrip("\n") + "\n", encoding="utf-8")

    # --- Remove the milestone from the live Roadmap ---
    # Drop lines[start:next_h2] (heading through the blank run before next H2).
    del rm_lines[start:next_h2]
    # Collapse any doubled blank lines left at the seam.
    cleaned = []
    for i, l in enumerate(rm_lines):
        if l.strip() == "" and cleaned and cleaned[-1].strip() == "":
            continue
        cleaned.append(l)
    roadmap.write_text("\n".join(cleaned).rstrip("\n") + "\n", encoding="utf-8")

    print(f"{slug}: migrated {milestone} → {completed.name} (migrated {date_str}); "
          f"sealed standalone grouping + opened fresh one")
    return 0


# ============================================================
# F236 — state v2: one address scheme
#   state [-a ANCHOR] <doc> <label> <verb> [flags] [< body]
#
# <doc>   Backlog (case-insensitive) | wiki-name | path to a .md file
# <label> LETTERS+DIGITS — Q7 / V3 / F157 / T8 — the "queries" umbrella term
# <verb>  define | resolve | remove
#
# Additive: task/q/status/roadmap keep working unchanged. Dispatch in main()
# routes here whenever the first positional isn't one of those domain names.
# ============================================================


_V2_LABEL_RE = re.compile(r"^([A-Z]+)(\d+)$")
_V2_SKIP_PATH_FRAGMENTS = ("/.trash/", "/Yore/", "/_ARCHIVES_/", "/Versions/")


def parse_v2_label(label):
    """Split a v2 label into (letters, number). Raises on anything not
    matching `^[A-Z]+\\d+$` (Q7, V3, F157, T8)."""
    m = _V2_LABEL_RE.match(label)
    if not m:
        raise be.BacklogEditError(
            f"invalid label {label!r} — expected LETTERS+DIGITS "
            f"(e.g. Q7, V3, F157, T8)"
        )
    return m.group(1), int(m.group(2))


def _v2_find_by_basename(root, target_lower):
    """Case-insensitive `.md` basename search under root, skipping noisy
    path fragments (mirrors be.SKIP_PATH_FRAGMENTS's spirit with the v2
    spec's own skip-list). Returns a list of matching Paths."""
    matches = []
    root = Path(root)
    if not root.is_dir():
        return matches
    for r, dirs, files in os.walk(root, followlinks=True):
        rp = r + "/"
        if any(frag in rp for frag in _V2_SKIP_PATH_FRAGMENTS):
            dirs[:] = []
            continue
        for f in files:
            if f.lower() == target_lower:
                matches.append(Path(r) / f)
    return matches


def resolve_v2_doc(doc_arg, slug, anchor_path):
    """Resolve the `<doc>` token of the v2 grammar.

    Returns ('backlog', path) for the literal `Backlog`, or ('doc', path)
    for anything else. Path mode (absolute/relative path ending in `.md` or
    containing a `/`) resolves directly. Wiki-name mode (no slash, no `.md`)
    resolves case-insensitively by basename — anchor tree first, then the
    vault root. Zero matches errors; multiple matches errors listing every
    candidate (never guess).
    """
    if doc_arg.strip().lower() == "backlog":
        return ("backlog", be.find_backlog(slug))

    if "/" in doc_arg or doc_arg.endswith(".md") or doc_arg.startswith("~"):
        p = Path(doc_arg).expanduser()
        p = p.resolve() if p.is_absolute() else (Path.cwd() / p).resolve()
        if not p.is_file():
            raise be.BacklogEditError(f"doc path not found: {p}")
        return ("doc", p)

    target_lower = f"{doc_arg}.md".lower()
    anchor_matches = _v2_find_by_basename(anchor_path, target_lower)
    if anchor_matches:
        if len(anchor_matches) > 1:
            cand = "\n  ".join(str(m) for m in anchor_matches)
            raise be.BacklogEditError(
                f"ambiguous doc name {doc_arg!r} — multiple candidates under "
                f"the anchor:\n  {cand}\nUse a path instead to disambiguate."
            )
        return ("doc", anchor_matches[0])

    vault_matches = _v2_find_by_basename(be.VAULT_ROOT, target_lower)
    if not vault_matches:
        raise be.BacklogEditError(
            f"no doc found matching {doc_arg!r} (.md) under the anchor or "
            f"vault root {be.VAULT_ROOT}"
        )
    if len(vault_matches) > 1:
        cand = "\n  ".join(str(m) for m in vault_matches)
        raise be.BacklogEditError(
            f"ambiguous doc name {doc_arg!r} — multiple candidates in the "
            f"vault:\n  {cand}\nUse a path instead to disambiguate."
        )
    return ("doc", vault_matches[0])


def _validate_ask_format_body(body):
    """Write-time gate for `Q<n> define` bodies — refuses anything that
    doesn't carry the ask-format basics: ≥2 own-line labeled option bullets
    AND a `- **Recommendation:**` line at indent 0 (value may be `None`).
    The full discipline (block-IDs, strength labels, spacing) is enforced by
    /audit q; this just keeps a flatfooted question from entering at all.
    Per [[DAS ask-format]].
    """
    option_re = re.compile(r"^\s*-\s+\*\*\([A-Za-z0-9]+\)\*\*", re.MULTILINE)
    options = option_re.findall(body)
    if len(options) < 2:
        raise be.BacklogEditError(
            "define refused: ask-format requires ≥2 labeled option "
            "bullets, each on its own line (e.g. `- **(A)** ...`); found "
            f"{len(options)}. See [[DAS ask-format]]."
        )
    rec_re = re.compile(r"^-\s+\*\*Recommendation:\*\*", re.MULTILINE)
    if not rec_re.search(body):
        raise be.BacklogEditError(
            "define refused: ask-format requires a `- **Recommendation:**` "
            "line at indent 0 (value may be `None`). See [[DAS ask-format]]."
        )


# ------------------------------------------------------------------
# v2 — Backlog target (F/T labels)


def _attach_raw_subbullets(file_path, row_id, sub_lines):
    """Best-effort: insert literal sub-bullet lines verbatim directly under
    row_id's header line in file_path. Used by `Backlog <F|T> define` to
    carry through any indented sub-bullets present in the define body beyond
    the single row line. No-op if the row isn't found in this file."""
    if not sub_lines:
        return
    text = file_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    row_i = None
    for i, line in enumerate(lines):
        rm = be.ROW_HEADER_RE.match(line)
        if rm and len(rm.group(1)) == 0 and rm.group(2) == row_id:
            row_i = i
            break
    if row_i is None:
        return
    normalized = [sl if sl.startswith(" ") else f"  {sl}" for sl in sub_lines]
    lines = lines[:row_i + 1] + normalized + lines[row_i + 1:]
    file_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""), encoding="utf-8"
    )


def _v2_row_define(slug, backlog_path, label, args):
    """`Backlog <F|T> define` — create-or-replace the whole row. The body IS
    the complete row markdown (`- **<label> — Title** [Status] — body`),
    optionally followed by indented sub-bullets. Routes through
    `_delegate_row_edit` (same guard machinery `task create`/`update` use) so
    status/Verify/Next/Questions promises still enforce."""
    raw = read_body(args)
    if not raw.strip():
        raise be.BacklogEditError(
            "define requires a body via stdin or --body — the complete row "
            f"markdown (`- **{label} — Title** [Status] — body`, optionally "
            "followed by indented sub-bullets)"
        )
    body_lines = raw.rstrip("\n").splitlines()
    first = body_lines[0].strip()
    m = be.ROW_FULL_RE.match(first)
    if not m or m.group("rid") != label:
        raise be.BacklogEditError(
            f"define body's first line doesn't parse as a row for {label}: "
            f"expected `- **{label} — Title** [Status] — body`, got {first!r}"
        )
    title = (m.group("title") or "").strip()
    status = m.group("status").strip()
    row_body = (m.group("body") or "").strip()
    sub_lines = [l for l in body_lines[1:] if l.strip()]

    icebox_path = be.find_icebox(slug)
    exists = be.row_in_file(backlog_path, label) or bool(
        icebox_path and be.row_in_file(icebox_path, label)
    )
    if args.horizon:
        horizon = args.horizon
    elif exists:
        horizon = "same"
    else:
        horizon = "Now"

    result_code = _delegate_row_edit(
        slug, horizon, label, status, title, row_body,
        title_provided=True, body_provided=True,
    )
    if sub_lines:
        icebox_path = be.find_icebox(slug)  # may have just been created
        dst = backlog_path if be.row_in_file(backlog_path, label) else icebox_path
        if dst is not None:
            _attach_raw_subbullets(dst, label, sub_lines)
    return result_code


def _v2_row_resolve(slug, backlog_path, label, args):
    """`Backlog <F|T> resolve` — move the row to `## Done` [Done], appending
    `— resolved <date>: <body>` to the row body."""
    resolution = read_body(args)
    icebox_path = be.find_icebox(slug)
    src_file = None
    if be.row_in_file(backlog_path, label):
        src_file = backlog_path
    elif icebox_path and be.row_in_file(icebox_path, label):
        src_file = icebox_path
    if src_file is None:
        raise be.BacklogEditError(
            f"{label} not found in {backlog_path.name} or Icebox — nothing to resolve"
        )
    lines0 = src_file.read_text(encoding="utf-8").splitlines()
    row_i = None
    for i, line in enumerate(lines0):
        rm = be.ROW_HEADER_RE.match(line)
        if rm and len(rm.group(1)) == 0 and rm.group(2) == label:
            row_i = i
            break
    existing_title, existing_body = (
        be.parse_existing_row(lines0[row_i]) if row_i is not None else ("", "")
    )
    today = date.today().isoformat()
    note = f"resolved {today}"
    if resolution.strip():
        note += f": {resolution.strip()}"
    new_body = f"{existing_body} — {note}" if existing_body else note
    return _delegate_row_edit(
        slug, "Done", label, "Done", existing_title, new_body,
        title_provided=True, body_provided=True,
    )


def _v2_row(slug, backlog_path, label, verb, args):
    if verb == "define":
        return _v2_row_define(slug, backlog_path, label, args)
    if verb == "resolve":
        return _v2_row_resolve(slug, backlog_path, label, args)
    if verb == "remove":
        return _delegate_row_edit(
            slug, "same", label, "delete", "", "",
            title_provided=False, body_provided=False,
        )
    raise be.BacklogEditError(f"unknown verb {verb!r} for a Backlog row")


# ------------------------------------------------------------------
# v2 — Q labels on any doc


def _q_define_core(slug, feature_path, q_num, body):
    """`<doc> Q<n> define` — create-or-replace Q<n> in place. Reuses
    be._find_q_bullet / be._format_q_bullet / be._ensure_open_questions_h2 —
    the same formatting the legacy `q add`/`q rewrite` verbs use — so define
    subsumes both without duplicating the bullet-formatting logic."""
    # Normalize: callers may pass the full bullet (`- **Q<n> — …` header line)
    # or just the body content. be._format_q_bullet already accepts the
    # pre-formatted `**Q<n> — …` form — strip only the leading `- ` dash so it
    # takes that branch (never double-wraps), and drop any caller-supplied
    # trailing block-anchor on the first line (the canonical one is re-added).
    if re.match(rf"^\s*-\s+\*\*Q{q_num}\s+—", body):
        first, sep, rest = body.partition("\n")
        first = re.sub(r"^\s*-\s+", "", first)
        first = re.sub(r"\s*\^\S+\s*$", "", first)
        body = first + (sep + rest if sep else "")
    _validate_ask_format_body(body)
    text = feature_path.read_text(encoding="utf-8")
    container_id = _v2_container_id_for_doc(feature_path)
    lines = text.splitlines()
    loc = be._find_q_bullet(lines, q_num)
    new_bullet = be._format_q_bullet(q_num, container_id, body)
    if loc is not None:
        start, end, _ = loc
        lines = lines[:start] + new_bullet.splitlines() + lines[end:]
        verb_done = "redefined"
    else:
        lines, (h2_start, h2_end) = be._ensure_open_questions_h2(lines)
        # Clamp to the H1 boundary — see _clamp_h2_end_to_h1. Needed here
        # too: be._ensure_open_questions_h2 returns the EXISTING block's
        # range (via be._find_h2) when Open Questions already has a pending
        # Q, and without the clamp a second `define` on the same doc lands
        # its bullet below the H1 instead of inside the pending block.
        h2_end = _clamp_h2_end_to_h1(lines, h2_start, h2_end)
        insert_at = h2_end
        for j in range(h2_start + 1, h2_end):
            if lines[j].startswith("### "):
                insert_at = j
                break
        while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        new_lines = ["", new_bullet] if insert_at > 0 and lines[insert_at - 1].strip() else [new_bullet]
        new_lines = new_lines + [""]
        lines = lines[:insert_at] + new_lines + lines[insert_at:]
        verb_done = "defined"
    feature_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""),
        encoding="utf-8",
    )
    summary = f"{verb_done} Q{q_num} in {feature_path.name}"
    _post_conditions_and_print(slug, feature_path, summary)
    return 0


def _v2_query(slug, doc_path, q_num, verb, args):
    if verb == "define":
        body = read_body(args)
        if not body.strip():
            raise be.BacklogEditError("define requires a body via stdin or --body")
        return _q_define_core(slug, doc_path, q_num, body)
    if verb == "resolve":
        if not args.choice:
            raise be.BacklogEditError(
                'resolve requires --choice "(A)" for a Q label'
            )
        body = read_body(args)
        return _q_answer_core(slug, doc_path, q_num, None, args.choice, body)
    if verb == "remove":
        return _q_remove_core(slug, doc_path, q_num, None, args.reason)
    raise be.BacklogEditError(f"unknown verb {verb!r} for a Q label")


# ------------------------------------------------------------------
# v2 — V (verification) labels on any doc — new in F236


_V_HEADER_BULLET_RE = re.compile(r"^(\s*)- \*\*V(\d+)\b")


def _v2_container_id_for_doc(doc_path):
    """Block-id container token for ANY v2 doc target: the F-number for a
    feature doc (`F<n> — Title.md`), else a block-id-safe (`[\\w-]`)
    sanitization of the doc's stem.

    be._container_id_for_feature does the F-number half but returns the raw
    (unsanitized) stem on fallback — safe there because the legacy Q verbs
    only ever call it with a real `F<n> — Title.md` feature doc (never hits
    the fallback in practice). v2 generalizes Q/V to ANY doc, so a doc like
    `Smoke Design.md` DOES hit the fallback, and its stem's spaces/em-dashes
    would otherwise land unsanitized inside an Obsidian block-id (`^Smoke
    Design-Q1` — invalid, contains a literal space). Sanitize here instead.
    """
    m = re.match(r"^(F\d+)\s+—", doc_path.stem)
    if m:
        return m.group(1)
    return re.sub(r"[^\w\-]", "-", doc_path.stem)


def _v_format_bullet(v_num, container_id, body):
    """Wrap a V-define body into `- **V<n> — <title>** — <rest> ^<container>-V<n>`.

    If body is already pre-formatted (`**V<n> — Title** — rest`, copy-pasted
    from an existing bullet), normalize the number and reuse it verbatim.
    Otherwise the first line's text (up to an em-dash, if present) becomes
    the title; anything after — on that line or subsequent lines — becomes
    the trailing body.
    """
    body = body.strip()
    m = re.match(r"^-?\s*\*\*V\d+\s+—\s+(.+?)\*\*(?:\s+—\s+(.*))?$", body, re.DOTALL)
    if m:
        title = m.group(1).strip()
        rest = (m.group(2) or "").strip()
    else:
        lines = body.splitlines()
        first = lines[0].strip()
        rest_lines = [l.strip() for l in lines[1:] if l.strip()]
        if " — " in first:
            title, _, tail = first.partition(" — ")
            title = title.strip()
            rest = tail.strip()
        else:
            title, rest = first, ""
        if rest_lines:
            extra = " ".join(rest_lines)
            rest = f"{rest} {extra}".strip()
    suffix = f" — {rest}" if rest else ""
    anchor = re.sub(r"[^\w\-]", "-", f"{container_id}-V{v_num}")
    return f"- **V{v_num} — {title}**{suffix} ^{anchor}"


def _find_v_bullet(lines, v_num):
    """Locate the pending `V<n>` bullet inside `## Verifications` (excluding
    any `### Resolved`/`### Removed` sub-sections). Mirrors be._find_q_bullet
    scoped to the Verifications H2. Returns (start, end, indent) or None."""
    h2 = be._find_h2(lines, "Verifications")
    if h2 is None:
        return None
    h2_start, h2_end = h2
    in_h3 = None
    for i in range(h2_start + 1, h2_end):
        line = lines[i]
        if line.startswith("### "):
            in_h3 = line.strip()[4:]
            continue
        m = _V_HEADER_BULLET_RE.match(line)
        if m and int(m.group(2)) == v_num and in_h3 is None:
            indent = m.group(1)
            end = h2_end
            for j in range(i + 1, h2_end):
                l = lines[j]
                if l.startswith("### "):
                    end = j
                    break
                mm = _V_HEADER_BULLET_RE.match(l)
                if mm and (len(l) - len(l.lstrip())) <= len(indent):
                    end = j
                    break
            return (i, end, indent)
    return None


def _ensure_verifications_h2(lines):
    """Ensure a `## Verifications` H2 exists — directly after
    `## Success Criteria` when present, else before `## Status`, else at the
    end of the doc. Returns lines (possibly modified) AND (h2_start, h2_end)."""
    existing = be._find_h2(lines, "Verifications")
    if existing is not None:
        return lines, existing
    sc = be._find_h2(lines, "Success Criteria")
    if sc is not None:
        _, sc_end = sc
        insert_at = sc_end
        lines = lines[:insert_at] + ["", "## Verifications", ""] + lines[insert_at:]
        return lines, (insert_at + 1, insert_at + 3)
    st = be._find_h2(lines, "Status")
    if st is not None:
        st_start, _ = st
        lines = lines[:st_start] + ["## Verifications", "", ""] + lines[st_start:]
        return lines, (st_start, st_start + 2)
    if lines and lines[-1].strip():
        lines.append("")
    lines.append("## Verifications")
    lines.append("")
    return lines, (len(lines) - 2, len(lines))


def _v_define_core(slug, doc_path, v_num, body):
    """`<doc> V<n> define` — create-or-replace the V-bullet under
    `## Verifications`."""
    text = doc_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    container_id = _v2_container_id_for_doc(doc_path)
    loc = _find_v_bullet(lines, v_num)
    new_bullet = _v_format_bullet(v_num, container_id, body)
    if loc is not None:
        start, end, _ = loc
        lines = lines[:start] + [new_bullet] + lines[end:]
        verb_done = "redefined"
    else:
        lines, (h2_start, h2_end) = _ensure_verifications_h2(lines)
        insert_at = h2_end
        for j in range(h2_start + 1, h2_end):
            if lines[j].startswith("### "):
                insert_at = j
                break
        while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        new_lines = ["", new_bullet] if insert_at > h2_start + 1 and lines[insert_at - 1].strip() else [new_bullet]
        new_lines = new_lines + [""]
        lines = lines[:insert_at] + new_lines + lines[insert_at:]
        verb_done = "defined"
    doc_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""), encoding="utf-8"
    )
    summary = f"{verb_done} V{v_num} in {doc_path.name}"
    _post_conditions_and_print(slug, doc_path, summary)
    return 0


def _v_resolve_core(slug, doc_path, v_num, body):
    """`<doc> V<n> resolve` — move the V-bullet to the bottom `## Resolved`
    as `### V<n> — Title` with `**Result:** <body> (<date>)`. Drops
    `## Verifications` if that was the last item (mirrors Q's Phase-2
    empty-block cleanup)."""
    text = doc_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    loc = _find_v_bullet(lines, v_num)
    if loc is None:
        raise be.BacklogEditError(
            f"V{v_num} not found in ## Verifications of {doc_path.name}"
        )
    start, end, _ = loc
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*V\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    today = date.today().isoformat()
    result_text = body.strip() or "confirmed"
    h3_lines = [
        "",
        f"### V{v_num} — {title}",
        f"**Result:** {result_text} ({today})",
        "",
    ]
    lines = lines[:start] + lines[end:]
    h2 = be._find_h2(lines, "Verifications")
    if h2 is not None:
        h2_start, h2_end = h2
        empty = True
        for k in range(h2_start + 1, h2_end):
            if lines[k].strip():
                empty = False
                break
        if empty:
            drop_end = h2_end
            while drop_end < len(lines) and not lines[drop_end].strip():
                drop_end += 1
            if drop_end < len(lines):
                lines = lines[:h2_start] + lines[drop_end:]
            else:
                lines = lines[:h2_start]
    lines, (rh2_start, rh2_end) = be._ensure_bottom_resolved_h2(lines)
    insert_at = rh2_end
    while insert_at > rh2_start + 1 and not lines[insert_at - 1].strip():
        insert_at -= 1
    lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    doc_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""), encoding="utf-8"
    )
    summary = f"resolved V{v_num} in {doc_path.name}"
    _post_conditions_and_print(slug, doc_path, summary)
    return 0


def _v_remove_core(slug, doc_path, v_num, reason):
    """`<doc> V<n> remove` — soft-delete, mirroring Q remove: move to a
    `### Removed` H3 nested inside `## Verifications` (audit trail)."""
    text = doc_path.read_text(encoding="utf-8")
    reason = reason or "no reason provided"
    lines = text.splitlines()
    loc = _find_v_bullet(lines, v_num)
    if loc is None:
        raise be.BacklogEditError(
            f"V{v_num} not found in ## Verifications of {doc_path.name}"
        )
    start, end, _ = loc
    header = lines[start]
    title_m = re.match(r"^\s*- \*\*V\d+\s+—\s+([^*]+?)\*\*", header)
    title = title_m.group(1).strip() if title_m else "Untitled"
    original_body = "\n".join(lines[start:end]).rstrip()
    today = date.today().isoformat()
    h3_lines = [
        "",
        f"### V{v_num} — {title} (removed {today} — {reason})",
        "",
        "> Original V context (preserved for audit trail):",
    ]
    for ol in original_body.splitlines():
        h3_lines.append(f"> {ol}")
    h3_lines.append("")
    lines = lines[:start] + lines[end:]
    h2 = be._find_h2(lines, "Verifications")
    if h2 is None:
        lines, (h2_start, h2_end) = _ensure_verifications_h2(lines)
    else:
        h2_start, h2_end = h2
    removed = be._find_h3_in_h2(lines, h2_start, h2_end, "Removed")
    if removed is None:
        insert_at = h2_end
        while insert_at > h2_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + ["", "### Removed", ""] + h3_lines[1:] + lines[insert_at:]
    else:
        r_start, r_end = removed
        insert_at = r_end
        while insert_at > r_start + 1 and not lines[insert_at - 1].strip():
            insert_at -= 1
        lines = lines[:insert_at] + h3_lines + lines[insert_at:]
    doc_path.write_text(
        "\n".join(lines) + ("\n" if text.endswith("\n") else ""), encoding="utf-8"
    )
    summary = f"removed V{v_num} from {doc_path.name} (reason: {reason})"
    _post_conditions_and_print(slug, doc_path, summary)
    return 0


def _v2_verify(slug, doc_path, v_num, verb, args):
    if verb == "define":
        body = read_body(args)
        if not body.strip():
            raise be.BacklogEditError("define requires a body via stdin or --body")
        return _v_define_core(slug, doc_path, v_num, body)
    if verb == "resolve":
        body = read_body(args)
        return _v_resolve_core(slug, doc_path, v_num, body)
    if verb == "remove":
        return _v_remove_core(slug, doc_path, v_num, args.reason)
    raise be.BacklogEditError(f"unknown verb {verb!r} for a V label")


# ------------------------------------------------------------------
# v2 — top-level dispatch + CLI


def cmd_v2(slug, anchor_path, args):
    doc_kind, doc_path = resolve_v2_doc(args.doc, slug, anchor_path)
    letters, num = parse_v2_label(args.label)
    if doc_kind == "backlog" and letters in ("F", "T"):
        return _v2_row(slug, doc_path, args.label, args.verb, args)
    if doc_kind == "doc" and letters == "Q":
        return _v2_query(slug, doc_path, num, args.verb, args)
    if doc_kind == "doc" and letters == "V":
        return _v2_verify(slug, doc_path, num, args.verb, args)
    where = "Backlog" if doc_kind == "backlog" else doc_path.name
    raise be.BacklogEditError(
        f"unknown query kind {args.label!r} for {where} — valid labels: "
        f"F<n>/T<n> on Backlog, Q<n>/V<n> on any other doc"
    )


_V2_LEGACY_DOMAINS = {"task", "q", "question", "status", "roadmap"}


def _first_positional(argv):
    """First non-flag positional in argv[1:], skipping -a/--anchor's value.
    None if there isn't one (bare `-h`, an unrecognized leading flag, or no
    args at all) — main() falls back to the legacy parser in that case."""
    i = 1
    while i < len(argv):
        tok = argv[i]
        if tok in ("-a", "--anchor"):
            i += 2
            continue
        if tok.startswith("--anchor="):
            i += 1
            continue
        if tok.startswith("-"):
            return None
        return tok
    return None


def build_v2_parser():
    p = argparse.ArgumentParser(
        prog="state",
        description=(
            "state v2 (F236) — one address scheme: "
            "`state [-a ANCHOR] <doc> <label> <verb> [< body]`. "
            "doc = Backlog | wiki-name | path. label = LETTERS+DIGITS "
            "(Q7, V3, F157, T8). verb = define | resolve | remove."
        ),
    )
    p.add_argument("-a", "--anchor", default=None,
                   help="anchor path or slug; defaults to cwd-walkup to .anchor")
    p.add_argument("doc", help="Backlog | wiki-name (no slash/.md) | path to a .md doc")
    p.add_argument("label", help="LETTERS+DIGITS — Q7, V3, F157, T8")
    p.add_argument("verb", choices=["define", "resolve", "remove"])
    p.add_argument("--horizon", default=None,
                   help="horizon for a NEW Backlog row on define (default: Now)")
    p.add_argument("--choice", default=None,
                   help='chosen option, e.g. "(A)" — required for `Q<n> resolve`')
    p.add_argument("--reason", default=None,
                   help="short reason recorded in the audit trail (remove)")
    p.add_argument("--body", dest="inline", default=None,
                   help="inline body (alternative to stdin)")
    p.add_argument("--from-file", dest="from_file", default=None,
                   help="read body from file (alternative to stdin)")
    return p


def main_v2(argv):
    parser = build_v2_parser()
    args = parser.parse_args(argv[1:])
    try:
        slug, anchor_path = resolve_anchor(args.anchor)
    except be.BacklogEditError as e:
        print(f"state: {e}", file=sys.stderr)
        return 2
    try:
        return cmd_v2(slug, anchor_path, args)
    except be.BacklogEditError as e:
        print(f"state: {e}", file=sys.stderr)
        return 1


# ============================================================
# CLI dispatch
# ============================================================


def build_parser():
    p = argparse.ArgumentParser(
        prog="state",
        description=(
            "Canonical state editor for backlog rows AND feature-doc Open "
            "Questions. Full spec: ~/.claude/skills/workflow/SKL State.md."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("-a", "--anchor", default=None,
                   help="anchor path or slug; defaults to cwd-walkup to .anchor")
    subs = p.add_subparsers(dest="domain", required=True)

    # task domain
    task = subs.add_parser("task", help="manage backlog rows")
    task_subs = task.add_subparsers(dest="verb", required=True)

    tc = task_subs.add_parser("create", help="mint a new row")
    tc.add_argument("--status", required=True, help="bracket text (Designing, Ready, Verify, ...)")
    tc.add_argument("--title", required=True, help="row title")
    tc.add_argument("--horizon", default="Now", help="horizon (default: Now)")
    tc.add_argument("--body", default="", help="row body (wiki-link / description)")
    tc.add_argument("--kind", default="F", choices=["F", "B", "T", "R"],
                    help="row kind: F (feature, has a doc) / T (backlog task) / "
                         "B (legacy backlog item) / R (roadmap task — needs --entry)")
    tc.add_argument("--entry",
                    help="roadmap entry name-path for --kind R "
                         "(e.g. M-Scaffolding.5.2); the handle becomes R-<name-path>")
    tc.add_argument("--verify", default=None,
                    help="`- **Verify:**` yes/no question (required when status "
                         "is Watching/Verify)")
    tc.add_argument("--next", default=None,
                    help="`- **Next:**` no-user action (required when status "
                         "is Ready/Active)")

    tu = task_subs.add_parser("update", help="modify an existing row")
    tu.add_argument("row_id", help="F<NNN>, B<id>, or <ANCHOR>-F<NNN>")
    tu.add_argument("--status", default=None)
    tu.add_argument("--horizon", default=None)
    tu.add_argument("--title", default=None)
    tu.add_argument("--body", default=None)
    tu.add_argument("--verify", default=None,
                    help="`- **Verify:**` yes/no question (required when setting "
                         "a Watching/Verify status without an existing one)")
    tu.add_argument("--next", default=None,
                    help="`- **Next:**` no-user action (required when setting a "
                         "Ready/Active status without an existing one)")

    td = task_subs.add_parser("delete", help="remove a row entirely (rare)")
    td.add_argument("row_id", help="F<NNN> or B<id>")

    # q domain
    q = subs.add_parser("q", aliases=["question"],
                        help="manage feature-doc Open Questions")
    q_subs = q.add_subparsers(dest="verb", required=True)

    qa = q_subs.add_parser("add", help="add a new Q (auto-mints next Q-number)")
    qa.add_argument("row_id", help="F<NNN> of the row whose doc holds the Qs")
    qa.add_argument("--slug", default=None, help="attach semantic slug")
    qa.add_argument("-m", dest="inline", default=None, help="inline body (short Qs)")
    qa.add_argument("--from-file", dest="from_file", default=None,
                    help="read body from file (long Qs)")

    qan = q_subs.add_parser("answer", help="answer a Q (move to ## Resolved)")
    qan.add_argument("row_id")
    qan.add_argument("-n", dest="q_num", type=int, default=None,
                     help="identify Q by number")
    qan.add_argument("--slug", default=None, help="identify Q by slug")
    qan.add_argument("--choice", required=True,
                     help="chosen option label, e.g. '(A)'")
    qan.add_argument("-m", dest="inline", default=None)
    qan.add_argument("--from-file", dest="from_file", default=None)

    qr = q_subs.add_parser("remove", help="soft-delete (preserves audit trail)")
    qr.add_argument("row_id")
    qr.add_argument("-n", dest="q_num", type=int, default=None)
    qr.add_argument("--slug", default=None)
    qr.add_argument("--reason", default=None,
                    help="short reason stamped in ### Removed H3 title")

    qrw = q_subs.add_parser("rewrite",
                            help="overwrite Q body (verb IS the intent; no --force needed)")
    qrw.add_argument("row_id")
    qrw.add_argument("-n", dest="q_num", type=int, default=None)
    qrw.add_argument("--slug", default=None,
                     help="identify by slug, OR (with -n) rename the slug")
    qrw.add_argument("-m", dest="inline", default=None)
    qrw.add_argument("--from-file", dest="from_file", default=None)

    # status domain (F130) — manage {slug} Status.md per-facet planning state
    st = subs.add_parser("status",
                         help="manage {slug} Status.md per-facet planning status (F130)")
    st_subs = st.add_subparsers(dest="verb", required=True)

    sts = st_subs.add_parser("set", help="set a facet's status cell")
    sts.add_argument("facet",
                     help="facet name (prd, ux, architecture, testing, roadmap)")
    sts.add_argument("cell",
                     help="status cell (none, MVP-agent, MVP-user, Full-agent, Full-user)")
    sts.add_argument("--note", default=None,
                     help="one-line rationale (required for MVP-user / Full-user)")

    stsh = st_subs.add_parser("show", help="show one or all facet statuses")
    stsh.add_argument("facet", nargs="?", default=None,
                      help="facet name (omit to show all)")

    # roadmap domain (F145) — milestone status get/set + whole-milestone migrate
    rm = subs.add_parser("roadmap",
                         help="manage {slug} Roadmap.md milestone state + migration (F145)")
    rm_subs = rm.add_subparsers(dest="verb", required=True)

    rmst = rm_subs.add_parser("status", help="get/set a roadmap entry's checkbox state")
    rmst_subs = rmst.add_subparsers(dest="subverb", required=True)
    for sv, sv_help in (("get", "read a roadmap entry's checkbox state"),
                        ("set", "write a roadmap entry's checkbox state")):
        sp = rmst_subs.add_parser(sv, help=sv_help)
        sp.add_argument("--feature", default=None, help="identify entry by F<n>")
        sp.add_argument("--milestone", default=None,
                        help="identify entry by milestone id (M-<Name> or M-<Name>.<n>)")
        if sv == "set":
            sp.add_argument("--state", required=True,
                            choices=["checked", "unchecked", "deferred"],
                            help="new checkbox state")

    rmm = rm_subs.add_parser("migrate",
                             help="migrate a whole completed milestone to Completed Roadmap")
    rmm.add_argument("milestone", help="top-level milestone id, e.g. M-Store")
    rmm.add_argument("--date", required=True,
                     help="migration date YYYY-MM-DD (REQUIRED — never auto-now)")

    return p


def main(argv):
    # F236 v2 dispatch — when the first positional isn't one of the legacy
    # domain names (task/q/question/status/roadmap), parse it as the v2
    # grammar: state [-a ANCHOR] <doc> <label> <verb>.
    first = _first_positional(argv)
    if first is not None and first not in _V2_LEGACY_DOMAINS:
        return main_v2(argv)

    parser = build_parser()
    args = parser.parse_args(argv[1:])

    try:
        slug, anchor_path = resolve_anchor(args.anchor)
    except be.BacklogEditError as e:
        print(f"state: {e}", file=sys.stderr)
        return 2

    try:
        if args.domain == "task":
            if args.verb == "create":
                return cmd_task_create(slug, anchor_path, args)
            if args.verb == "update":
                return cmd_task_update(slug, anchor_path, args)
            if args.verb == "delete":
                return cmd_task_delete(slug, anchor_path, args)
        elif args.domain in ("q", "question"):
            if args.verb == "add":
                return cmd_q_add(slug, anchor_path, args)
            if args.verb == "answer":
                return cmd_q_answer(slug, anchor_path, args)
            if args.verb == "remove":
                return cmd_q_remove(slug, anchor_path, args)
            if args.verb == "rewrite":
                return cmd_q_rewrite(slug, anchor_path, args)
        elif args.domain == "status":
            if args.verb == "set":
                return cmd_status_set(slug, anchor_path, args)
            if args.verb == "show":
                return cmd_status_show(slug, anchor_path, args)
        elif args.domain == "roadmap":
            if args.verb == "status":
                if args.subverb == "get":
                    return cmd_roadmap_status_get(slug, anchor_path, args)
                if args.subverb == "set":
                    return cmd_roadmap_status_set(slug, anchor_path, args)
            if args.verb == "migrate":
                return cmd_roadmap_migrate(slug, anchor_path, args)
        print(f"state: unknown verb {args.domain} {args.verb}", file=sys.stderr)
        return 2
    except be.BacklogEditError as e:
        print(f"state: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

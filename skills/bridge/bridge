#!/bin/bash
# bridge — the packaged bridge dispatcher (SKA F279).
#
# Agents invoke this by full path (~/.claude/skills/bridge/bridge) — it rides
# the skills repo, so it exists on any provisioned machine. Never improvise
# raw ssh for remote-control work; every bridge operation is a verb here.
#
# Verbs:
#   bridge tmux <host> [--session S] [--agent SLUG] [--force] [--force-server] [--viewer]
#       Flagship connect. Ensures (a) a tmux session on the remote, launched
#       in a Terminal window on the REMOTE'S OWN SCREEN (the glanceable
#       viewer, and the TCC-blessed context that gives panes FDA / Screen
#       Recording / Accessibility), and (b) a LOCAL tmux session ssh-attached
#       to it. Session name defaults to bridge-<host> on BOTH sides — that
#       session is SHARED across every agent working the same host.
#       T171: the session is NOT the drive/read surface — every agent gets
#       its own WINDOW inside it (bridge-<host>:agent-<slug>), so two agents
#       never share a keyboard. Agent identity: --agent <slug>, else
#       $BRIDGE_AGENT, else REFUSE. T176 measured that the harness exposes no
#       per-agent value at all (session id, pid and socket are identical
#       across an orchestrator and its subagents), so there is nothing
#       honest to derive from — no silent shared-window fallback. An
#       occupancy preflight refuses to reuse a window that is busy or was
#       written to in the last 30s, naming the occupant.
#       Drive it (ssh one-shot against the REMOTE server, explicit target —
#       NOT the local wrapper session, whose relayed keystrokes follow
#       whatever window is remotely selected and would reintroduce the bug):
#         ssh user@host.local "tmux send-keys -t bridge-<host>:agent-<slug> '<cmd>' Enter"
#         ssh user@host.local "tmux capture-pane -t bridge-<host>:agent-<slug> -p"
#       --force recreates only MY window; --force-server does the old
#       session-wide kill-server restart (destroys every agent's window —
#       only for a genuinely SSH-launched/non-Aqua server).
#   bridge install <host> [--profile P] [--dry-run]
#       Idempotent converge — "make it so." Env files (claude-provision),
#       launchd-durable Syncthing on the remote, provision stamp. Re-run any
#       time; `refresh` is an alias. With --profile <name> also walks that
#       capability profile (probe each row; run install action on FAIL;
#       re-probe once). --dry-run prints the plan without side effects.
#   bridge sync <host>         Verify/revive the Syncthing sync (status now;
#       full share creation stays in syncthing-helper.py).
#   bridge skills <host>       Ensure the remote's ~/.claude/skills tracks the
#       skills repo named in config (vault-synced copy preferred, clone else).
#   bridge doctor <host> [--profile P]
#       Read-only deep diagnosis. Never mutates. With --profile <name>, walks
#       that capability profile (probe each row, PASS/FAIL + repair hint) in
#       addition to the standard checks. Profiles live in profile-<name>.sh.
#
# A sub-second PREFLIGHT runs automatically before every verb: local checks
# always (~10ms), one remote ping only when a warm ControlMaster socket
# exists. All bridge ssh uses ControlPersist, so sockets stay warm.

set -u
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_DIR="$HOME/.config/bridge"
STATE_DIR="$CONFIG_DIR/state"
mkdir -p "$STATE_DIR"
STAMP_MAX_AGE_DAYS=14

VERB="${1:-help}"; shift || true
HOST="${1:-}"; [ $# -gt 0 ] && shift
SESSION=""
MODE="ensure"
PROFILE=""
DRY_RUN=0
AGENT_FLAG=""
JOB_NAME=""
JOB_SCRIPT=""
STALL=600                      # F054: seconds of no output AND no CPU before STALLED
WATCH=0                        # F054: block until the job reaches a terminal verdict
UNTIL="stall"                  # F054: watch --until stall|done
STALL_SET=""                   # F054: `bridge stall` new tolerance (0 = dismiss)
for arg in "$@"; do
  case "$arg" in
    --session) : ;;             # value captured next loop via flag
    --session=*) SESSION="${arg#*=}" ;;
    --profile) : ;;             # value captured next loop
    --profile=*) PROFILE="${arg#*=}" ;;
    --agent)   : ;;             # value captured next loop
    --agent=*) AGENT_FLAG="${arg#*=}" ;;
    --job)     : ;;
    --job=*)   JOB_NAME="${arg#*=}" ;;
    --script)  : ;;
    --script=*) JOB_SCRIPT="${arg#*=}" ;;
    --stall)   : ;;
    --stall=*) STALL="${arg#*=}" ;;
    --viewer)  MODE="viewer" ;;
    --force)   MODE="force" ;;         # T171: window-scoped now — recreates only MY window
    --force-server) MODE="force-server" ;;  # T171: the old session-wide meaning, renamed+separated
    --dry-run) DRY_RUN=1 ;;
    --watch)   WATCH=1 ;;
    --until)   : ;;
    --until=*) UNTIL="${arg#*=}" ;;
    *) case "${PREV:-}" in
         --session) [ -z "$SESSION" ] && SESSION="$arg" ;;
         --profile) [ -z "$PROFILE" ] && PROFILE="$arg" ;;
         --agent)   [ -z "$AGENT_FLAG" ] && AGENT_FLAG="$arg" ;;
         --job)     [ -z "$JOB_NAME" ] && JOB_NAME="$arg" ;;
         --script)  [ -z "$JOB_SCRIPT" ] && JOB_SCRIPT="$arg" ;;
         --stall)   STALL="$arg" ;;
         --until)   UNTIL="$arg" ;;
         # A bare number is `bridge stall <host> --job <n> <seconds>` -- only
         # when it follows no value-taking flag, so `--stall 25` is untouched.
         *) case "$VERB:$arg" in stall:[0-9]*) STALL_SET="$arg" ;; esac ;;
       esac ;;
  esac
  PREV="$arg"
done

say()  { printf '%s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

require_host() { [ -n "$HOST" ] || fail "usage: bridge $VERB <host> [options]"; }

# Source profile-<name>.sh (F027) and run its walker in the given mode.
# Returns 0 iff every countable row PASSes at the end. Callers set SSH,
# SESSION, TARGET via resolve_target before invoking.
#   $1 name (e.g. "full")   $2 mode (probe|install|dry-run)
run_profile_walk() {
  local name="$1" mode="$2"
  local pf="$SCRIPT_DIR/profile-$name.sh"
  [ -f "$pf" ] || { say "  FAIL  profile  no such profile: $name (looked at $pf)"; return 1; }
  # shellcheck source=/dev/null
  . "$pf"
  local walker="profile_${name}_walk"
  declare -f "$walker" >/dev/null || { say "  FAIL  profile  $pf defines no $walker function"; return 1; }
  "$walker" "$mode"
}

resolve_target() {
  case "$HOST" in *.local|*.*) TARGET="$HOST" ;; *) TARGET="$HOST.local" ;; esac
  CTL="$STATE_DIR/cm-$TARGET.sock"
  SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8
       -o ControlMaster=auto -o "ControlPath=$CTL" -o ControlPersist=600
       "$USER@$TARGET")
  [ -z "$SESSION" ] && SESSION="bridge-${HOST%%.*}"
  LOCAL_SESSION="bridge-${HOST%%.*}"
  STAMP_CACHE="$STATE_DIR/stamp-$TARGET"
}

# ------------------------------------------------------------ agent identity
# T171: every drive/read verb must be window-scoped, not session-scoped, or
# two agents on the same host share one keyboard. Resolve a per-agent slug
# that is (a) stable for the life of one agent session, (b) human-readable
# in `tmux list-windows`. Precedence: explicit --agent > $BRIDGE_AGENT >
# refuse. There is no third source, and that is a measurement, not an
# omission.
#
# T176 (measured 2026-08-08, orchestrator + two subagents fanned out of one
# session, each printing its own environment): the Claude Code harness
# exposes NO per-agent identifier. All three saw the identical
# CLAUDE_CODE_SESSION_ID, the identical CLAUDE_PID (25716 — subagents run
# in-process, so the pid is the CLI's), the identical
# CLAUDE_CODE_MESSAGING_SOCKET (derived from that pid), CLAUDE_CODE_CHILD_
# SESSION=1 in all three including the orchestrator, and $PPID identical
# because every Bash-tool child is a direct child of the one CLI process.
# Nothing in `env` names a task or an agent.
#
# So the earlier fallback — basename($PWD)-${CLAUDE_CODE_SESSION_ID:0:8} —
# handed one window to every agent of a fan-out: precisely the configuration
# T171 exists to prevent, and the configuration this vault actually runs in.
# Deriving from a session id is not a weak identity, it is a WRONG one, and a
# wrong identity that usually works is worse than none: it makes the
# occupancy preflight fire routinely, and a routine refusal teaches agents to
# reach for --force. Refusing up front costs one flag and cannot be wrong.
# No silent fallback to a shared/default window — fail loudly instead
# (that silent fallback IS the T171 bug).
sanitize_slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//'; }

resolve_agent() {
  local raw
  if [ -n "$AGENT_FLAG" ]; then
    raw="$AGENT_FLAG"
  elif [ -n "${BRIDGE_AGENT:-}" ]; then
    raw="$BRIDGE_AGENT"
  else
    fail "cannot determine agent identity — pass --agent <slug> (or export \$BRIDGE_AGENT once, at the top of your session).
  Suggested:  --agent $(sanitize_slug "$(basename "$PWD")")-1
  There is deliberately no auto-derivation. Measured 2026-08-08 (T176): the Claude Code
  harness exposes NO per-agent value — an orchestrator and two subagents fanned out of one
  session all report the same CLAUDE_CODE_SESSION_ID, the same CLAUDE_PID, the same
  messaging socket, and CLAUDE_CODE_CHILD_SESSION=1. Deriving from any of them would give
  every agent of a fan-out the SAME window, which is the T171 bug it was meant to prevent.
  Pick a slug that says who you are; it shows up in \`tmux list-windows\` and in the
  occupancy refusal any other agent gets."
  fi
  AGENT_SLUG="$(sanitize_slug "$raw")"
  [ -n "$AGENT_SLUG" ] || fail "agent identity sanitizes to empty string (raw: '$raw') — pass a usable --agent <slug>"
  WINDOW="agent-$AGENT_SLUG"
}

# Record who owns a window (T171 B — "naming the occupant"). Stored as a
# tmux window user-option so it lives exactly as long as the window does.
tag_window() {  # $1 = "session:window"
  local who
  who="$AGENT_SLUG @ $(hostname -s 2>/dev/null || echo local-mac) since $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "${SSH[@]}" "$TMUX_BIN set-window-option -t '$1' @bridge_occupant '$who'" 2>/dev/null
}

BUSY_WINDOW_SECS=30   # T171 B: refuse to reuse a window written to more recently than this

# Occupancy preflight (T171 B). Refuses — loudly, naming the occupant — to
# reuse an existing window that shows live occupancy: a foreground process
# that isn't an idle shell, or a write within BUSY_WINDOW_SECS. This is the
# backstop for when (A)'s agent-id derivation still collides (e.g. two
# different --agent invocations pick the same slug). Never silently
# degrades to "just use it anyway."
check_occupancy() {  # $1 = "session:window" (caller confirmed the window exists)
  local target="$1" wname busy_cmd last_active now_r occupant
  wname="${target#*:}"
  busy_cmd=$("${SSH[@]}" "$TMUX_BIN list-panes -t '$target' -F '#{pane_current_command}'" 2>/dev/null \
             | grep -Ev '^-?(zsh|bash|sh)$' | head -1)
  occupant=$("${SSH[@]}" "$TMUX_BIN show-window-options -t '$target' -v '@bridge_occupant'" 2>/dev/null)
  [ -n "$occupant" ] || occupant="(untagged — not created by bridge)"
  if [ -n "$busy_cmd" ]; then
    fail "occupied — window '$target' has a live foreground process ('$busy_cmd'); occupant: $occupant. Refusing to hand a second agent the same keyboard (T171) — pick a distinct --agent slug, or confirm it's safe and retarget by hand."
  fi
  last_active=$("${SSH[@]}" "$TMUX_BIN list-windows -t $SESSION -F '#{window_name} #{window_activity}'" 2>/dev/null \
             | awk -v w="$wname" '$1==w{print $2}')
  now_r=$("${SSH[@]}" 'date +%s' 2>/dev/null)
  if [ -n "$last_active" ] && [ -n "$now_r" ]; then
    local age=$(( now_r - last_active ))
    if [ "$age" -lt "$BUSY_WINDOW_SECS" ]; then
      fail "occupied — window '$target' was written to ${age}s ago (< ${BUSY_WINDOW_SECS}s); occupant: $occupant. Refusing to hand a second agent the same keyboard (T171) — pick a distinct --agent slug, or wait."
    fi
  fi
}

# ---------------------------------------------------------------- preflight
preflight() {
  local warn=0
  [ -f "$CONFIG_DIR/config.yaml" ] || { say "PRE   ⚠ no $CONFIG_DIR/config.yaml"; warn=1; }
  # stamp age from local cache (written by install / refreshed by doctor)
  if [ -f "$STAMP_CACHE" ]; then
    local age_days=$(( ( $(date +%s) - $(stat -f %m "$STAMP_CACHE") ) / 86400 ))
    if [ "$age_days" -gt "$STAMP_MAX_AGE_DAYS" ]; then
      say "PRE   ⚠ provision stamp ${age_days}d old — run: bridge install $HOST"; warn=1
    fi
  else
    [ "$VERB" != "install" ] && { say "PRE   ⚠ never installed — run: bridge install $HOST"; warn=1; }
  fi
  # remote ping only over a warm socket (fast); cold socket = skip silently
  if ssh -o "ControlPath=$CTL" -O check "$USER@$TARGET" 2>/dev/null; then
    "${SSH[@]}" "tmux has-session -t $SESSION 2>/dev/null" \
      || { [ "$VERB" != "tmux" ] && say "PRE   ⚠ remote session '$SESSION' absent — run: bridge tmux $HOST"; warn=1; }
  fi
  [ "$warn" = 0 ] && say "PRE   ok"
  return 0
}

remote_tmux_bin() {
  TMUX_BIN=$("${SSH[@]}" 'zsh -lc "which tmux" 2>/dev/null' | tail -1)
  case "$TMUX_BIN" in /*) : ;; *) fail "tmux not found on $TARGET (install it, or use screen — SKILL.md Step 4)";; esac
}

open_command() {  # $1 = body — write + open a .command in the remote Aqua session
  local f="/tmp/bridge-$SESSION.command"
  "${SSH[@]}" "cat > $f && chmod +x $f && open $f" <<EOF
#!/bin/bash
# written by bridge (F279) — safe to delete
$1
EOF
}

hold_caffeinate() {  # ATT F022 — keep the remote awake while a bridge is up
  # WHY THIS IS NOT `ssh host "caffeinate -is <cmd>"`, which is what the row
  # originally specified. Work does not travel through ssh one-shots here. The
  # one-shot runs `tmux send-keys` and returns in milliseconds; the command it
  # typed then runs in a pane owned by the tmux SERVER, outside that ssh
  # entirely. Wrapping the one-shot would start a caffeinate, hold an assertion
  # for the length of a keystroke, and release it before the work began -- a
  # guard that reports success and protects nothing, while `pmset -g assertions`
  # sampled at the right instant would even confirm it "works".
  #
  # So the assertion is held by a process whose LIFETIME MATCHES THE WORK: a
  # dedicated window in the session, running `caffeinate -is`. Kill the window,
  # the session, or the server and the process dies with it and macOS drops the
  # assertion -- which is why there is no reaping step. Nothing to leak, because
  # nothing outlives the thing it was protecting.
  local w="$SESSION:caffeinate"
  if "${SSH[@]}" "$TMUX_BIN list-windows -t $SESSION -F '#{window_name}' 2>/dev/null" \
       | grep -qx caffeinate; then
    say "PASS  awake   '$w' already holding the assertion"
  else
    "${SSH[@]}" "$TMUX_BIN new-window -d -t $SESSION -n caffeinate 'caffeinate -is'"
    say "PASS  awake   '$w' created — holds caffeinate -is for the session's life"
  fi
  if [ "$(caffeinate_state)" = held ]; then
    say "PASS  awake   $HOST holds PreventUserIdleSystemSleep for THIS window's caffeinate"
  else
    say "WARN  awake   no assertion from our caffeinate on $HOST — it may idle-sleep mid-job"
  fi
}

caffeinate_state() {  # echoes held | absent — ground truth from the power manager
  # Two traps, both hit while building this (2026-08-13):
  #
  # 1. MATCH OUR OWN PID, not the word "caffeinate". Any tool on the machine may
  #    hold a caffeinate assertion -- this laptop had an unrelated 300-second one
  #    running during the very test that was supposed to prove the mechanism. A
  #    check that greps for the name reports PASS on someone else's assertion and
  #    keeps reporting it after ours has died.
  #
  # 2. CAPTURE `pmset -g assertions` BEFORE MATCHING. `pmset -g assertions |
  #    grep -q ...` returned no-match against output that demonstrably contained
  #    the line, reproducibly, while the same match against a captured variable
  #    succeeded every time. Whatever pmset does when its stdout closes early,
  #    the pipe form cannot be trusted -- so this uses `case` on a captured
  #    string and no pipe at all.
  "${SSH[@]}" "p=\$($TMUX_BIN list-panes -t '$SESSION:caffeinate' -F '#{pane_pid}' 2>/dev/null | tr -d '[:space:]')
a=\$(pmset -g assertions 2>/dev/null)
if [ -n \"\$p\" ]; then case \"\$a\" in *\"pid \$p(caffeinate)\"*) echo held;; *) echo absent;; esac
else echo absent; fi"
}

# ---------------------------------------------------------------- tmux verb
cmd_tmux() {
  require_host; resolve_target; preflight; resolve_agent
  "${SSH[@]}" 'true' 2>/dev/null || fail "reach — ssh key-auth to $TARGET failed"
  say "PASS  reach   $TARGET"
  local console_user
  console_user=$("${SSH[@]}" 'stat -f %Su /dev/console' 2>/dev/null)
  { [ -n "$console_user" ] && [ "$console_user" != "root" ]; } \
    || fail "gui — no user logged into $HOST's console; the viewer window cannot open"
  say "PASS  gui     console user: $console_user"
  remote_tmux_bin
  say "PASS  tmux    $TMUX_BIN"
  say "PASS  agent   $AGENT_SLUG  → window '$WINDOW'"

  local WTARGET="$SESSION:$WINDOW"

  # Aqua-launched server? If the server exists but was SSH-launched, panes
  # have no window-server access. Aqua-ness is a SERVER-WIDE property (not
  # per-window) so recovery is a full server restart — inherently
  # destructive to every agent's window, hence gated behind --force-server
  # (not the window-scoped --force) and a busy-panes-across-the-server
  # refusal.
  local have_server aqua
  have_server=$("${SSH[@]}" "tmux ls >/dev/null 2>&1 && echo yes || echo no")
  aqua=$("${SSH[@]}" "tmux show-environment -g 2>/dev/null" | grep -c 'TERM_PROGRAM=Apple_Terminal' || true)

  if [ "$have_server" = "yes" ] && [ "$aqua" -ge 1 ]; then
    # good server — ensure the shared host session exists (session is
    # shared by design; windows are what isolate agents within it — T171)
    if ! "${SSH[@]}" "tmux has-session -t $SESSION 2>/dev/null"; then
      "${SSH[@]}" "$TMUX_BIN new -d -s $SESSION"
    fi
  else
    if [ "$have_server" = "yes" ]; then
      local busy
      busy=$("${SSH[@]}" "tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_command}' 2>/dev/null" \
             | awk '$2 !~ /^(zsh|bash|sh|-zsh|-bash|caffeinate)$/')
      if [ -n "$busy" ] && [ "$MODE" != "force-server" ]; then
        fail "busy panes across the server — refusing a full restart that would kill EVERY agent's window, not just mine (--force-server to override; this is destructive to all windows):
$busy"
      fi
    fi
    say "....  (re)launching tmux server from $HOST's Aqua Terminal — SERVER-WIDE, kills every existing window"
    open_command "$TMUX_BIN kill-server 2>/dev/null
sleep 1
$TMUX_BIN new -d -A -s $SESSION"
    sleep 4
  fi

  say "....  waiting for remote session '$SESSION'"
  local ok=no i
  for i in $(seq 1 15); do
    "${SSH[@]}" "tmux has-session -t $SESSION 2>/dev/null" && { ok=yes; break; }
    sleep 2
  done
  [ "$ok" = "yes" ] || fail "remote session '$SESSION' did not come up — check $HOST's screen"
  aqua=$("${SSH[@]}" "tmux show-environment -g 2>/dev/null" | grep -c 'TERM_PROGRAM=Apple_Terminal' || true)
  [ "$aqua" -ge 1 ] && say "PASS  launch  Aqua (Terminal) context" \
                    || say "WARN  launch  server not Aqua-launched — capabilities will be degraded"

  # ---- per-agent WINDOW (T171 A) — the actual drive/read surface, never
  # the bare session. (T171 B) occupancy preflight guards reuse of an
  # existing window that isn't mine.
  local window_exists
  window_exists=$("${SSH[@]}" "$TMUX_BIN list-windows -t $SESSION -F '#{window_name}' 2>/dev/null" \
                   | grep -qx "$WINDOW" && echo yes || echo no)
  if [ "$window_exists" = "yes" ]; then
    if [ "$MODE" = "force" ]; then
      say "....  --force: recreating window '$WTARGET' fresh (mine only — other agents' windows untouched)"
      "${SSH[@]}" "$TMUX_BIN kill-window -t '$WTARGET'" 2>/dev/null
      "${SSH[@]}" "$TMUX_BIN new-window -t $SESSION -n $WINDOW"
      say "PASS  window  '$WTARGET' recreated"
    else
      check_occupancy "$WTARGET"
      say "PASS  window  '$WTARGET' reused (occupancy check clear)"
    fi
  else
    "${SSH[@]}" "$TMUX_BIN new-window -t $SESSION -n $WINDOW"
    say "PASS  window  '$WTARGET' created"
  fi
  tag_window "$WTARGET"
  hold_caffeinate

  # local twin session, ssh-attached — OPTIONAL convenience viewer only
  # (a human can `tmux attach -t bridge-<host>` on the laptop to watch).
  # T171: this is NOT the drive/read surface — a client attached to a
  # LOCAL wrapper session relays raw keystrokes over the ssh pty into
  # whatever window is currently selected REMOTELY, and tmux shares one
  # "current window" per session across every attached client, local or
  # remote. That relay is the exact mechanism that let two agents' input
  # interleave before this fix. Drive/read below instead run tmux commands
  # directly against the remote server (ssh one-shot, explicit
  # session:window target) — that addressing is independent of any
  # client's current view, so it can't collide.
  if tmux has-session -t "$LOCAL_SESSION" 2>/dev/null; then
    say "PASS  local   session '$LOCAL_SESSION' already up (viewer only)"
  else
    tmux new-session -d -s "$LOCAL_SESSION" \
      "ssh -t -o ControlMaster=auto -o 'ControlPath=$CTL' -o ControlPersist=600 $USER@$TARGET 'tmux attach -t $WTARGET'"
    say "PASS  local   session '$LOCAL_SESSION' created (ssh-attached, viewer only)"
  fi

  say "....  opening viewer window on $HOST's display, focused on '$WTARGET'"
  open_command "exec $TMUX_BIN attach -t '$WTARGET'"

  # capability check (screen-check probes inside the mux server, its own
  # scratch window — doesn't touch any agent's window)
  "$SCRIPT_DIR/screen-check.sh" "$HOST" "$SESSION" || {
    say "WARN  capabilities incomplete — if launch is Aqua, grant Terminal on $HOST:"
    say "      System Settings → Privacy & Security → Full Disk Access + Screen Recording + Accessibility,"
    say "      then quit & reopen Terminal there and re-run: bridge tmux $HOST"
  }

  say ""
  say "Viewer  : Terminal window on $HOST's screen, attached to '$WTARGET'"
  say "Drive   : ssh $USER@$TARGET \"tmux send-keys -t '$WTARGET' '<cmd>' Enter\""
  say "Read    : ssh $USER@$TARGET \"tmux capture-pane -t '$WTARGET' -p\""
}

# ------------------------------------------------------------- install verb
cmd_install() {
  require_host; resolve_target; preflight
  say "== bridge install $HOST — idempotent converge =="
  # 1. env files (claude-provision: ~/.claude, ~/.config includes, bin utils)
  python3 "$SCRIPT_DIR/claude-provision.py" apply --host "$TARGET" || fail "claude-provision apply failed"
  # 2. skills repo wiring
  cmd_skills_inner
  # 3. launchd-durable Syncthing on the remote (F279 Q2)
  local st_bin
  st_bin=$("${SSH[@]}" 'zsh -lc "which syncthing" 2>/dev/null; for p in ~/bin/syncthing /opt/homebrew/bin/syncthing /usr/local/bin/syncthing; do [ -x "$p" ] && { echo "$p"; break; }; done' | grep '^/' | tail -1)
  case "$st_bin" in
    /*)
      "${SSH[@]}" "mkdir -p ~/Library/LaunchAgents && cat > ~/Library/LaunchAgents/net.syncthing.syncthing.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.syncthing.syncthing</string>
  <key>ProgramArguments</key><array>
    <string>$st_bin</string><string>serve</string><string>--no-browser</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
EOF
      # bootstrap (idempotent: bootout first, ignore failures), only if not already running under launchd
      "${SSH[@]}" 'UID_N=$(id -u); launchctl bootout gui/$UID_N/net.syncthing.syncthing 2>/dev/null; pkill -x syncthing 2>/dev/null; sleep 1; launchctl bootstrap gui/$UID_N ~/Library/LaunchAgents/net.syncthing.syncthing.plist && echo LAUNCHD-OK'
      say "PASS  syncd   launchd agent installed (KeepAlive, RunAtLoad)"
      ;;
    *) say "WARN  syncd   syncthing not found on $TARGET — sync bridge unavailable" ;;
  esac
  # 4. provision stamp — remote record + local cache (preflight reads the cache)
  "${SSH[@]}" "mkdir -p ~/.config/bridge && date -u +%Y-%m-%dT%H:%M:%SZ > ~/.config/bridge/stamp"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$STAMP_CACHE"
  say "PASS  stamp   provision stamp written (remote + local cache)"
  # 5. optional profile walk (F027) — probe every row, install-on-FAIL, re-probe
  if [ -n "$PROFILE" ]; then
    local mode=install; [ "$DRY_RUN" = 1 ] && mode=dry-run
    say "== profile: $PROFILE ($mode) =="
    run_profile_walk "$PROFILE" "$mode" || say "WARN  profile  one or more capabilities still failing after install pass"
  fi
  say "== install complete — run: bridge doctor $HOST for the full read-only audit =="
}

# -------------------------------------------------------------- skills verb
cmd_skills_inner() {
  # Repo-pull skills (F279 Q1): config names the repo; bridge stays generic.
  #   skills_repo:
  #     path: <path that exists on both machines — e.g. the vault-synced repo>
  #     url:  <git url, used to clone when path is absent on the remote>
  local path url
  path=$(python3 - <<'EOF'
import yaml, pathlib
cfg = yaml.safe_load(open(pathlib.Path.home() / ".config/bridge/config.yaml")) or {}
sr = cfg.get("skills_repo", {})
print(sr.get("path", ""))
print(sr.get("url", ""))
EOF
)
  url=$(echo "$path" | sed -n 2p); path=$(echo "$path" | sed -n 1p)
  if [ -z "$path" ]; then
    say "WARN  skills  no skills_repo in config.yaml — skipping repo wiring (rsync copy from claude-provision still applies)"
    return 0
  fi
  local rpath="${path/#$HOME/\$HOME}"
  if "${SSH[@]}" "test -d \"$rpath/skills\""; then
    "${SSH[@]}" "if [ ! -L ~/.claude/skills ] || [ \"\$(readlink ~/.claude/skills)\" != \"$rpath/skills\" ]; then rm -rf ~/.claude/skills && ln -s \"$rpath/skills\" ~/.claude/skills; fi && echo SKILLS-LINKED"
    say "PASS  skills  ~/.claude/skills → $rpath/skills (repo-synced)"
  elif [ -n "$url" ]; then
    "${SSH[@]}" "git clone \"$url\" \"$rpath\" && rm -rf ~/.claude/skills && ln -s \"$rpath/skills\" ~/.claude/skills && echo SKILLS-CLONED" \
      && say "PASS  skills  cloned $url → $rpath, linked" \
      || say "WARN  skills  clone failed (no git auth on remote?) — rsync copy from claude-provision still applies"
  else
    say "WARN  skills  repo path absent on remote and no url configured — rsync copy still applies"
  fi
}

cmd_skills() { require_host; resolve_target; preflight; cmd_skills_inner; }

# ---------------------------------------------------------------- sync verb
cmd_sync() {
  require_host; resolve_target; preflight
  python3 "$SCRIPT_DIR/syncthing-helper.py" status --host "$TARGET"
}

# -------------------------------------------------------------- doctor verb
cmd_doctor() {
  require_host; resolve_target
  say "== bridge doctor $HOST — read-only =="
  local pass=0 warnc=0
  check() { # $1 label, $2 ok(yes/no), $3 detail
    if [ "$2" = "yes" ]; then say "  PASS  $1  $3"; pass=$((pass+1));
    else say "  FAIL  $1  $3"; warnc=$((warnc+1)); fi
  }
  "${SSH[@]}" 'true' 2>/dev/null && check reach yes "ssh key-auth ($TARGET)" || { check reach no "ssh unreachable"; say "== doctor: unreachable =="; return 1; }
  local aqua sess stamp ctrl_ok syncd
  aqua=$("${SSH[@]}" "tmux show-environment -g 2>/dev/null" | grep -c 'TERM_PROGRAM=Apple_Terminal' || true)
  [ "$aqua" -ge 1 ] && check launch yes "tmux server Aqua-launched" || check launch no "server SSH-launched or absent — run: bridge tmux $HOST"
  sess=$("${SSH[@]}" "tmux ls 2>/dev/null" | tr '\n' ' ')
  [ -n "$sess" ] && check mux yes "sessions: $sess" || check mux no "no tmux sessions"
  # T176: who holds which window. A collision is otherwise invisible until an
  # agent reproduces it, and since T176 removed auto-derivation the failure a
  # human needs to SEE is two agents that chose the same --agent slug by hand.
  # Read-only, and never a FAIL — it is a census, not a check.
  local wins
  wins=$("${SSH[@]}" "tmux list-windows -t '$SESSION' -F '#{window_name}|#{pane_current_command}|#{window_activity}|#{@bridge_occupant}'" 2>/dev/null)
  if [ -n "$wins" ]; then
    say "  ----  agents  windows in '$SESSION' (T176 occupancy census):"
    local now_r; now_r=$("${SSH[@]}" 'date +%s' 2>/dev/null)
    printf '%s\n' "$wins" | while IFS='|' read -r wn cmd act occ; do
      [ -n "$wn" ] || continue
      age="?"
      if [ -n "$now_r" ] && [ -n "$act" ]; then age="$((now_r - act))s ago"; fi
      if [ -z "$occ" ]; then occ="(untagged — not created by bridge)"; fi
      say "        $wn  [$cmd, last write $age]  occupant: $occ"
    done
  else
    say "  ----  agents  no windows in '$SESSION' (nobody attached yet)"
  fi
  "$SCRIPT_DIR/screen-check.sh" "$HOST" "$SESSION" >/dev/null 2>&1 \
    && check tcc yes "FDA + screen grab OK inside mux server" \
    || check tcc no "capabilities incomplete — see: bridge tmux $HOST output for the grant walk"
  syncd=$("${SSH[@]}" "pgrep -x syncthing >/dev/null && echo yes || echo no")
  check syncd "$syncd" "syncthing daemon on remote"
  "${SSH[@]}" 'launchctl print gui/$(id -u)/net.syncthing.syncthing >/dev/null 2>&1' \
    && check launchd yes "syncthing under launchd (survives reboot)" \
    || check launchd no "syncthing not launchd-managed — run: bridge install $HOST"
  stamp=$("${SSH[@]}" "cat ~/.config/bridge/stamp 2>/dev/null")
  [ -n "$stamp" ] && check stamp yes "provisioned $stamp" || check stamp no "never installed — run: bridge install $HOST"
  ctrl_ok=$("${SSH[@]}" "test -x ~/bin/ctrl && echo yes || echo no")
  check ctrl "$ctrl_ok" "~/bin/ctrl on remote"
  # ATT F022. Asks the power manager, not tmux: a `caffeinate` window can exist
  # with a dead pane, and the question is whether the machine will idle-sleep
  # out from under a running job -- which only pmset can answer.
  # doctor is read-only and must never abort, so resolve tmux WITHOUT
  # remote_tmux_bin's fail-on-missing — a remote with no tmux should report a
  # failed row here, not take the whole diagnosis down.
  TMUX_BIN=$("${SSH[@]}" 'zsh -lc "which tmux" 2>/dev/null' | tail -1)
  case "$TMUX_BIN" in /*) awake=$(caffeinate_state) ;; *) awake=absent ;; esac
  [ "$awake" = held ] && check awake yes "idle-sleep held off by this session's caffeinate" \
                      || check awake no "no caffeinate assertion — $HOST may idle-sleep mid-job; run: bridge tmux $HOST"
  tmux has-session -t "$LOCAL_SESSION" 2>/dev/null \
    && check local yes "local session '$LOCAL_SESSION' up" \
    || check local no "no local session — run: bridge tmux $HOST"
  say "== doctor: $pass pass, $warnc fail =="
  local base_rc=0; [ "$warnc" = 0 ] || base_rc=1
  if [ -n "$PROFILE" ]; then
    run_profile_walk "$PROFILE" probe
    local prof_rc=$?
    [ "$prof_rc" = 0 ] || base_rc=1
  fi
  return "$base_rc"
}

# ------------------------------------------------------- run / jobs (F054)
# Launching an unattended job and arming its liveness watch are ONE action, so
# the watch cannot be forgotten. That is the whole design: on 2026-08-09 a
# remote verification was reported as running for 105 minutes while wedged, and
# the rule requiring a live timer already existed and had been read.
JOBS_DIR="$STATE_DIR/jobs"

cmd_run() {
  require_host; resolve_target; resolve_agent
  [ -n "$JOB_NAME" ] || fail "usage: bridge run <host> --job <name> --script <local-path> [--stall <seconds>]"
  [ -n "$JOB_SCRIPT" ] || fail "--script <local-path> required"
  [ -f "$JOB_SCRIPT" ] || fail "no such script: $JOB_SCRIPT"
  case "$JOB_NAME" in *[!A-Za-z0-9_-]*) fail "job name must be [A-Za-z0-9_-]: $JOB_NAME";; esac
  preflight

  # Refuse to clobber a live job's log rather than silently interleaving two
  # runs into one file, which would make both unreadable and neither obviously
  # wrong.
  local existing
  existing=$("${SSH[@]}" "head -1 \$HOME/.bridge-jobs/$JOB_NAME.status 2>/dev/null" || true)
  case "$existing" in
    RUNNING*) fail "job '$JOB_NAME' is already RUNNING on $HOST — pick another name, or check it: bridge jobs $HOST" ;;
  esac

  "${SSH[@]}" 'mkdir -p ~/.bridge-jobs ~/.bridge-bin' >/dev/null 2>&1
  scp -q -o "ControlPath=$CTL" "$SCRIPT_DIR/job-wrapper.sh" "$SCRIPT_DIR/job-status.sh" \
      "$USER@$TARGET:.bridge-bin/" || fail "could not copy the wrapper to $HOST"
  scp -q -o "ControlPath=$CTL" "$JOB_SCRIPT" "$USER@$TARGET:.bridge-jobs/$JOB_NAME.sh" \
      || fail "could not copy the job script to $HOST"

  local win="job-$JOB_NAME"
  "${SSH[@]}" "tmux kill-window -t '$SESSION:$win' 2>/dev/null; \
               tmux new-window -t '$SESSION' -n '$win' -d \
                 'bash \$HOME/.bridge-bin/job-wrapper.sh $JOB_NAME \$HOME/.bridge-jobs/$JOB_NAME.sh'" \
    || fail "could not launch the job window on $HOST"

  mkdir -p "$JOBS_DIR/$HOST"
  # No prior sample yet -- the first `bridge jobs` establishes the baseline. A
  # stall is a change over time, so the very first check can only say RUNNING.
  printf 'stall=%s\nlaunched=%s\nagent=%s\n' "$STALL" "$(date +%s)" "$AGENT_SLUG" \
    > "$JOBS_DIR/$HOST/$JOB_NAME.job"
  rm -f "$JOBS_DIR/$HOST/$JOB_NAME.sample"

  say "launched '$JOB_NAME' on $HOST (window $SESSION:$win, stall threshold ${STALL}s)"
  say "  log:   ~/.bridge-jobs/$JOB_NAME.log   on $HOST"
  if [ "$WATCH" = 1 ]; then
    say "  ALSO ARM THE DONE-WATCHER, in a second background call — it rides through"
    say "  a stall, so a job that recovers still reports instead of finishing silently:"
    say "    bridge watch $HOST --job $JOB_NAME --until done"
    watch_loop "$JOB_NAME"
    return $?
  fi
  say "  check: bridge jobs $HOST      <- do this instead of tailing the log"
  say "  NOTE: nothing will wake you. For an unattended job use --watch and run"
  say "        this call in the background; its exit IS the wake-up."
}

cmd_jobs() {
  require_host; resolve_target
  mkdir -p "$JOBS_DIR/$HOST"
  local raw
  raw=$("${SSH[@]}" 'bash $HOME/.bridge-bin/job-status.sh 2>/dev/null' || true)
  if [ -z "$raw" ]; then say "no jobs recorded on $HOST"; return 0; fi

  local bad=0
  say "== jobs on $HOST =="
  while IFS='|' read -r name status start end lmt cpu procs now; do
    [ -n "$name" ] || continue
    local sfile="$JOBS_DIR/$HOST/$name.sample"
    local jfile="$JOBS_DIR/$HOST/$name.job"
    # A missing .job file means local state was lost (or the job was launched
    # from another machine). Falling back silently would report a 600s default
    # as if it were the configured threshold, so the fallback is LABELLED.
    local stall=600 stall_src=""
    if [ -f "$jfile" ]; then
      stall=$(sed -n 's/^stall=//p' "$jfile" | head -1)
    else
      stall_src=" [default threshold — no local record of this job]"
    fi
    [ -n "$stall" ] || stall=600

    # `since` is measured from the last time PROGRESS was seen, never from the
    # last time anybody looked. Resetting the baseline on every check made the
    # detector unfireable: polling every 15s against a 600s threshold left
    # `since` permanently at 15s, so a genuinely wedged job read RUNNING for
    # ever. Caught by the fixtures 2026-08-09, and it is the same shape as
    # [[project_probe_that_can_never_pass]] — a check that cannot go red.
    local p_lmt=-1 p_cpu=-1 p_at=0 p_prog=0
    if [ -f "$sfile" ]; then
      p_lmt=$(sed -n 's/^log_mtime=//p' "$sfile" | head -1)
      p_cpu=$(sed -n 's/^cpu=//p' "$sfile" | head -1)
      p_at=$(sed -n 's/^at=//p' "$sfile" | head -1)
      p_prog=$(sed -n 's/^last_progress=//p' "$sfile" | head -1)
    fi
    [ -n "${p_prog:-}" ] || p_prog=0

    local new_prog="$now"
    local age=$(( now - ${start:-now} ))
    [ -n "$end" ] && age=$(( end - ${start:-end} ))
    local quiet=$(( now - ${lmt:-0} ))
    local verdict detail

    case "$status" in
      DONE*)   verdict="DONE";   detail="ran ${age}s, ${status#DONE }" ;;
      FAILED*) verdict="FAILED"; detail="ran ${age}s, ${status#FAILED }"; bad=1 ;;
      RUNNING*)
        if [ "${procs:-0}" -eq 0 ]; then
          # RUNNING on disk but no process in the group: the wrapper died
          # without reaching its trap. Distinct from a stall and reported so.
          verdict="GONE"; detail="status says RUNNING but no process survives"; bad=1
        elif [ "$p_at" -eq 0 ]; then
          verdict="RUNNING"; detail="${age}s in, baseline sample taken (first check cannot judge)"
          new_prog="$now"
        else
          local dcpu=$(( ${cpu:-0} - p_cpu ))
          local moved_log=0; [ "${lmt:-0}" -gt "$p_lmt" ] && moved_log=1
          if [ "$dcpu" -gt 0 ] || [ "$moved_log" -eq 1 ]; then
            new_prog="$now"                      # progress observed — clock resets
          else
            new_prog="$p_prog"                   # nothing moved — clock keeps running
          fi
          local since=$(( now - new_prog ))
          local dismissed=""
          [ -f "$jfile" ] && dismissed=$(sed -n 's/^dismissed=//p' "$jfile" | head -1)
          if [ -n "$dismissed" ] || [ "$stall" = 0 ]; then
            verdict="RUNNING"
            detail="${age}s in, quiet ${quiet}s — stall alarm dismissed by hand, not by evidence"
          elif [ "$since" -ge "$stall" ]; then
            verdict="STALLED"
            detail="no output and NO CPU for ${since}s (threshold ${stall}s) — $procs proc(s) present but not executing"
            bad=1
          else
            verdict="RUNNING"
            detail="${age}s in, +${dcpu}s CPU, last progress ${since}s ago, quiet ${quiet}s, $procs proc(s)"
          fi
        fi ;;
      *) verdict="UNKNOWN"; detail="status file says '$status'"; bad=1 ;;
    esac

    printf '  %-8s %-22s %s%s\n' "$verdict" "$name" "$detail" "$stall_src"
    printf 'log_mtime=%s\ncpu=%s\nat=%s\nlast_progress=%s\n' \
      "${lmt:-0}" "${cpu:-0}" "${now:-0}" "$new_prog" > "$sfile"
  done <<EOF
$raw
EOF
  [ "$bad" -eq 0 ] || { say "== attention needed =="; return 1; }
  return 0
}



# ------------------------------------------------------- stall retune (F054)
# Change a live job's stall tolerance, or dismiss it. `0` means "stop calling
# this a stall" -- an explicit act, recorded with a timestamp, because the thing
# being turned off is an alarm and turning an alarm off should leave a trace.
cmd_stall() {
  require_host; resolve_target
  [ -n "$JOB_NAME" ] || fail "usage: bridge stall <host> --job <name> <seconds>   (0 = dismiss)"
  [ -n "$STALL_SET" ] || fail "give a new tolerance in seconds, or 0 to dismiss"
  local jfile="$JOBS_DIR/$HOST/$JOB_NAME.job"
  mkdir -p "$JOBS_DIR/$HOST"
  [ -f "$jfile" ] || printf 'launched=%s\n' "$(date +%s)" > "$jfile"
  local rest; rest=$(grep -v '^stall=' "$jfile" 2>/dev/null | grep -v '^dismissed=' || true)
  if [ "$STALL_SET" = 0 ]; then
    printf '%s\nstall=0\ndismissed=%s\n' "$rest" "$(date +%s)" > "$jfile"
    say "stall alarm DISMISSED for '$JOB_NAME' on $HOST — it will no longer be reported as stalled."
    say "  The job is untouched and still running; only the alarm is off."
    say "  Re-arm any time:  bridge stall $HOST --job $JOB_NAME <seconds>"
  else
    printf '%s\nstall=%s\n' "$rest" "$STALL_SET" > "$jfile"
    rm -f "$JOBS_DIR/$HOST/$JOB_NAME.sample"   # fresh baseline for the new tolerance
    say "stall tolerance for '$JOB_NAME' on $HOST is now ${STALL_SET}s (baseline reset)."
    say "  Re-arm the watcher:  bridge watch $HOST --job $JOB_NAME --stall $STALL_SET"
  fi
}

# ---------------------------------------------------------------- watch (F054)
# Block until this job reaches a verdict, then exit. Run it in the BACKGROUND
# from the agent's side (`run_in_background: true`) and its exit becomes the one
# wake-up: silence while the job is healthy, exactly one interruption when it
# finishes or wedges.
#
# One interruption, not one per state change. STALLED is reported and the watch
# ENDS -- a stalled job can recover (a drive wakes up), and deciding whether to
# re-arm is a judgement, not something a loop should make silently. The
# alternative, notifying on every transition, is how a watcher becomes noise and
# then becomes ignored.
watch_loop() {
  local name="$1"
  local interval=$(( STALL / 4 ))
  [ "$interval" -lt 15 ] && interval=15
  [ "$interval" -gt 60 ] && interval=60
  # A backstop, not a policy: a watcher that outlives its usefulness is a
  # process nobody remembers starting.
  local deadline=$(( $(date +%s) + 86400 ))
  if [ "$UNTIL" = "done" ]; then
    say "watching '$name' until it FINISHES (checking every ${interval}s; rides through stalls)"
  else
    say "watching '$name' (checking every ${interval}s; one report at DONE/FAILED/STALLED)"
  fi
  while :; do
    sleep "$interval"
    local out line verdict
    out=$(cmd_jobs 2>/dev/null || true)
    line=$(printf '%s\n' "$out" | awk -v n="$name" '$2 == n {print; exit}')
    verdict=$(printf '%s' "$line" | awk '{print $1}')
    if [ "$UNTIL" = "done" ] && [ "$verdict" = "STALLED" ]; then
      # The done-watcher deliberately rides THROUGH a stall. A stalled job can
      # come back -- the drive gets replugged, the volume wakes -- and if the
      # only watcher had exited at the stall, that recovery would complete in
      # silence and nothing would say so. This is the watcher that cannot be
      # forgotten, because forgetting is not one of its states.
      continue
    fi
    case "$verdict" in
      DONE|FAILED|GONE|STALLED)
        say ""
        say "== $verdict: $name =="
        say "${line# }"
        say "-- last 25 lines of its log --"
        "${SSH[@]}" "tail -25 \$HOME/.bridge-jobs/$name.log 2>/dev/null" || true
        case "$verdict" in DONE) return 0 ;; *) return 1 ;; esac ;;
    esac
    if [ "$(date +%s)" -ge "$deadline" ]; then
      say "== WATCH EXPIRED: $name has not finished after 24h =="
      say "   Not a verdict about the job — the watcher stopped, the job did not."
      return 2
    fi
  done
}

cmd_watch() {
  require_host; resolve_target
  [ -n "$JOB_NAME" ] || fail "usage: bridge watch <host> --job <name> [--stall <seconds>]"
  watch_loop "$JOB_NAME"
}

# ------------------------------------------------------------------- verbs
case "$VERB" in
  tmux)             cmd_tmux ;;
  run)              cmd_run ;;
  watch)            cmd_watch ;;
  stall)            cmd_stall ;;
  jobs)             cmd_jobs ;;
  install|refresh)  cmd_install ;;
  skills)           cmd_skills ;;
  sync)             cmd_sync ;;
  doctor)           cmd_doctor ;;
  help|--help|-h)   sed -n '2,48p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) fail "unknown verb '$VERB' — verbs: tmux, run, jobs, install (alias refresh), skills, sync, doctor" ;;
esac

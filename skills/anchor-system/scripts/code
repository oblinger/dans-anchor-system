#!/usr/bin/env python3
"""code — anchor↔repo tool: the `mirror:` doc-mirror engine (+ shelved sparse-link verbs).

Primary verb — the Two-Way Doc Mirror (DAS Code Repository § Doc Mirror):

  code sync <anchor> [--dry] [--init] [--take-here P ...] [--take-there P ...]

An anchor's `.anchor` carries a `mirror:` list; each route keeps two local
folders in sync — `here:` (relative to the anchor root, confined to it) and
`there:` (an absolute path, typically inside a repo working tree), with
`direction:` two-way (default) | push | pull. Three-way sync per file (here /
there / last-synced hash manifest, stored in the enclosing repo's
.git/anchor-sync/): forward transfers freely; backward transfers ONLY changes
that are committed in the enclosing git repo — uncommitted there-side edits
are quarantined and flagged, never transported. With no enclosing repo the
engine degrades to plain three-way folder sync with conflict flags.
Both-sides-changed is a conflict, resolved explicitly with
--take-here/--take-there; take flags resolve only paths flagged this run
('all' = every flagged path, but resolutions that would DELETE a file always
need the path spelled out explicitly). There-side files are stamped read-only
(the there side is not an authoring surface). A first run with no manifest
baselines: equal files seed the manifest, one-side-only files copy, differing
files surface as conflicts — but when both trees are non-empty and differ,
--init must be passed explicitly (a lost manifest also loses deletion
history, so silent re-baselining could resurrect deleted files).

Legacy verbs (sparse-link realization of `remotes:` — SHELVED per the F188
redesign 2026-07-12; kept for fixture history, do not use on live anchors):

  code link    <anchor>  [--apply]   set up every declared checkout (idempotent)
  code reattach <anchor> [--apply]   rebuild any missing/detached checkout
  code status  <anchor>              report declared-vs-on-disk for each checkout
  code audit   <anchor>              read-only verification (exit!=0 on drift)

`.anchor` is parsed as plain YAML (no `---` fences). The tool never runs git
commit/add.
"""
import argparse
import os
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.stderr.write("code: PyYAML is required (pip install pyyaml)\n")
    sys.exit(2)


# ── ANSI helpers ──────────────────────────────────────────────────────────────
def _c(code, s):
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else s


def ok(s):    return _c("32", s)
def warn(s):  return _c("33", s)
def err(s):   return _c("31", s)
def dim(s):   return _c("2", s)
def bold(s):  return _c("1", s)


class CodeError(Exception):
    """A user-facing, non-destructive failure."""


# ── data model ────────────────────────────────────────────────────────────────
@dataclass
class Checkout:
    repo: str
    frm: object         # 'from': str subtree/glob, list of them, or '.' = whole repo
    at_raw: str         # as written in .anchor
    at: Path            # resolved absolute path
    is_anchor_root: bool  # at == the anchor dir itself

    def frm_items(self):
        """The declared subtrees as a list; None when '.' (whole repo)."""
        if self.frm == ".":
            return None
        return self.frm if isinstance(self.frm, list) else [self.frm]

    def frm_disp(self):
        items = self.frm_items()
        return ", ".join(items) if items else "."

    def label(self):
        return f"{self.repo} [from {self.frm_disp()} → at {self.at_raw}]"


@dataclass
class RepoGroup:
    repo: str
    checkouts: list = field(default_factory=list)
    main: Checkout = None     # the checkout that hosts the clone / main worktree


# ── parsing ───────────────────────────────────────────────────────────────────
def find_anchor_file(anchor_path: Path) -> Path:
    """Resolve the .anchor file for an anchor given a dir or the file itself."""
    anchor_path = anchor_path.expanduser().resolve()
    if anchor_path.is_file() and anchor_path.name == ".anchor":
        return anchor_path
    if anchor_path.is_dir():
        cand = anchor_path / ".anchor"
        if cand.is_file():
            return cand
        raise CodeError(f"no .anchor file in {anchor_path}")
    raise CodeError(f"not an anchor dir or .anchor file: {anchor_path}")


def resolve_at(at_raw: str, anchor_dir: Path) -> tuple:
    """Return (resolved_abs_path, is_anchor_root)."""
    if at_raw in (".", "", None):
        return anchor_dir, True
    p = Path(os.path.expanduser(at_raw))
    if not p.is_absolute():
        p = anchor_dir / p
    p = p.resolve()
    return p, (p == anchor_dir)


def load_anchor(anchor_path: Path):
    """Return (anchor_dir, anchor_file, parsed_yaml, list[RepoGroup], code_field)."""
    anchor_file = find_anchor_file(anchor_path)
    anchor_dir = anchor_file.parent
    text = anchor_file.read_text()
    try:
        data = yaml.safe_load(text) or {}
    except yaml.YAMLError as e:
        raise CodeError(f"could not parse {anchor_file} as YAML: {e}")
    if not isinstance(data, dict):
        raise CodeError(f"{anchor_file}: top-level YAML is not a mapping")

    remotes = data.get("remotes")
    if not remotes:
        raise CodeError(
            f"{anchor_file}: no `remotes:` list — this is not a Sparse-Linked anchor"
        )
    if not isinstance(remotes, list):
        raise CodeError(f"{anchor_file}: `remotes:` must be a list")

    checkouts = []
    for i, entry in enumerate(remotes):
        if not isinstance(entry, dict):
            raise CodeError(f"{anchor_file}: remotes[{i}] is not a mapping")
        repo = entry.get("repo")
        if not repo:
            raise CodeError(f"{anchor_file}: remotes[{i}] missing required `repo`")
        frm_raw = entry.get("from") or "."
        if isinstance(frm_raw, list):
            items = [str(x).strip() for x in frm_raw if str(x).strip()]
            frm = items if items else "."
        else:
            frm = str(frm_raw).strip() or "."
        at_raw = (entry.get("at") or ".").strip()
        at, is_root = resolve_at(at_raw, anchor_dir)
        checkouts.append(Checkout(repo, frm, at_raw, at, is_root))

    # group by repo, preserve declaration order
    groups = {}
    order = []
    for co in checkouts:
        if co.repo not in groups:
            groups[co.repo] = RepoGroup(co.repo)
            order.append(co.repo)
        groups[co.repo].checkouts.append(co)

    repo_groups = [groups[r] for r in order]
    for g in repo_groups:
        g.main = _pick_main(g.checkouts)

    code_field = data.get("code")
    return anchor_dir, anchor_file, data, repo_groups, code_field


def _pick_main(checkouts: list) -> Checkout:
    """The checkout that hosts the real clone / main worktree.

    Prefer an off-mount checkout (keeps the heavy object store out of the
    vault); among those prefer `from: .` (the largest slice). If every
    checkout lands at the anchor root, the first one becomes the in-place clone.
    """
    offmount = [c for c in checkouts if not c.is_anchor_root]
    if offmount:
        whole = [c for c in offmount if c.frm == "."]
        return whole[0] if whole else offmount[0]
    return checkouts[0]


# ── sparse cone derivation ────────────────────────────────────────────────────
def _norm_subtree(frm: str) -> str:
    return "/" + frm.strip("/") + "/"


def expected_patterns(co: Checkout, group: RepoGroup):
    """Derive the non-cone sparse-checkout patterns for one checkout.

    Returns None when no sparse cone is needed (whole repo, no siblings claiming
    a subtree), else a list of gitignore-style include/negate lines.

    Root-level FILES of the repo materialize in every checkout (mirroring git
    cone-mode semantics) — that's what lets the anchor page / CLAUDE.md live at
    the vault anchor root while tracked in the one repo. Root-level DIRECTORIES
    belong to exactly one checkout.
    """
    siblings = [c for c in group.checkouts if c is not co]
    if co.frm == ".":
        claimed = sorted({_norm_subtree(f) for c in siblings
                          for f in (c.frm_items() or [])})
        if not claimed:
            return None  # plain whole-repo checkout — no sparse needed
        return ["/*"] + [f"!{c}" for c in claimed]
    # subtree checkout: root files + the declared subtree(s)
    return ["/*", "!/*/"] + [_norm_subtree(f) for f in co.frm_items()]


# ── git helpers ───────────────────────────────────────────────────────────────
def git(args, cwd=None, check=True, capture=True):
    res = subprocess.run(
        ["git"] + args, cwd=cwd, text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if check and res.returncode != 0:
        msg = (res.stderr or res.stdout or "").strip()
        raise CodeError(f"git {' '.join(args)} failed: {msg}")
    return res


def is_git_worktree(path: Path) -> bool:
    if not path.exists():
        return False
    res = git(["-C", str(path), "rev-parse", "--is-inside-work-tree"], check=False)
    return res.returncode == 0 and res.stdout.strip() == "true"


def worktree_toplevel(path: Path):
    res = git(["-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    if res.returncode != 0:
        return None
    return Path(res.stdout.strip()).resolve()


def clone_remote_url(path: Path):
    res = git(["-C", str(path), "remote", "get-url", "origin"], check=False)
    return res.stdout.strip() if res.returncode == 0 else None


def registered_worktrees(clone: Path):
    res = git(["-C", str(clone), "worktree", "list", "--porcelain"], check=False)
    paths = []
    if res.returncode == 0:
        for line in res.stdout.splitlines():
            if line.startswith("worktree "):
                paths.append(Path(line[len("worktree "):]).resolve())
    return paths


def default_branch(clone: Path):
    res = git(["-C", str(clone), "rev-parse", "--abbrev-ref", "HEAD"], check=False)
    b = res.stdout.strip()
    if b and b != "HEAD":
        return b
    res = git(["-C", str(clone), "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
              check=False)
    ref = res.stdout.strip()
    return ref.split("/", 1)[1] if "/" in ref else (ref or "main")


def sparse_file(path: Path):
    res = git(["-C", str(path), "rev-parse", "--git-path", "info/sparse-checkout"],
              check=False)
    if res.returncode != 0:
        return None
    gp = Path(res.stdout.strip())
    if not gp.is_absolute():
        gp = (path / gp).resolve()
    return gp


def actual_patterns(path: Path):
    """Current sparse patterns for a worktree, or None if sparse not enabled."""
    res = git(["-C", str(path), "config", "core.sparseCheckout"], check=False)
    if res.stdout.strip() != "true":
        return None
    sf = sparse_file(path)
    if not sf or not sf.exists():
        return []
    return [ln.strip() for ln in sf.read_text().splitlines()
            if ln.strip() and not ln.strip().startswith("#")]


def patterns_match(expected, actual) -> bool:
    if expected is None:
        return actual is None or actual == []
    if actual is None:
        return False
    return set(expected) == set(actual)


# ── plan / action engine ──────────────────────────────────────────────────────
class Runner:
    def __init__(self, apply: bool):
        self.apply = apply
        self.actions = 0

    def do(self, desc, fn):
        """Record/print one action; execute it only when --apply."""
        self.actions += 1
        if self.apply:
            print("  " + ok("apply ") + desc)
            fn()
        else:
            print("  " + warn("plan  ") + desc)

    def note(self, desc):
        print("  " + dim("ok    " + desc))


def _set_sparse(path: Path, patterns):
    if patterns is None:
        # whole repo — make sure sparse is off
        git(["-C", str(path), "sparse-checkout", "disable"], check=False)
        return
    git(["-C", str(path), "sparse-checkout", "init", "--no-cone"])
    sf = sparse_file(path)
    sf.parent.mkdir(parents=True, exist_ok=True)
    sf.write_text("\n".join(patterns) + "\n")
    git(["-C", str(path), "sparse-checkout", "reapply"])


def _setup_main(group: RepoGroup, r: Runner):
    co = group.main
    pats = expected_patterns(co, group)
    cone = co.frm_disp() if co.frm != "." else "(whole)"

    # already a valid clone?
    if is_git_worktree(co.at) and worktree_toplevel(co.at) == co.at:
        url = clone_remote_url(co.at)
        if url == co.repo:
            if patterns_match(pats, actual_patterns(co.at)):
                r.note(f"clone present + sparse ok at {co.at} [{cone}]")
            else:
                r.do(f"reset sparse cone at {co.at} → {pats}",
                     lambda: _set_sparse(co.at, pats))
            return
        raise CodeError(
            f"{co.at} is a git work tree but origin={url!r} != declared repo "
            f"{co.repo!r}; refusing to touch it")

    if co.at.exists() and not co.is_anchor_root and any(co.at.iterdir()):
        raise CodeError(f"clone target {co.at} exists and is non-empty; refusing "
                        f"to clobber — move it aside or remove it first")

    if co.is_anchor_root:
        # in-place init: preserve untracked vault files (.anchor, existing docs)
        def _inplace():
            git(["init", str(co.at)])
            git(["-C", str(co.at), "remote", "add", "origin", co.repo], check=False)
            git(["-C", str(co.at), "fetch", "origin"])
            br = default_branch_after_fetch(co.at)
            _set_sparse(co.at, pats)
            git(["-C", str(co.at), "checkout", br])
        r.do(f"in-place clone {co.repo} at anchor root {co.at} [{cone}] "
             f"(preserves untracked files)", _inplace)
    else:
        def _clone():
            co.at.parent.mkdir(parents=True, exist_ok=True)
            git(["clone", co.repo, str(co.at)])
            _set_sparse(co.at, pats)
        r.do(f"clone {co.repo} → {co.at} [{cone}]", _clone)


def default_branch_after_fetch(path: Path):
    res = git(["-C", str(path), "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
              check=False)
    if res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip().split("/", 1)[1]
    for cand in ("main", "master"):
        if git(["-C", str(path), "rev-parse", "--verify", f"origin/{cand}"],
               check=False).returncode == 0:
            return cand
    # fall back to first remote branch
    res = git(["-C", str(path), "branch", "-r"], check=False)
    for ln in res.stdout.splitlines():
        ln = ln.strip()
        if ln and "->" not in ln:
            return ln.split("/", 1)[1]
    return "main"


def _setup_worktree(group: RepoGroup, co: Checkout, r: Runner):
    clone = group.main.at
    pats = expected_patterns(co, group)
    cone = co.frm_disp() if co.frm != "." else "(whole)"

    # already a registered worktree?
    if co.at.exists() and is_git_worktree(co.at) and co.at in registered_worktrees(clone):
        if patterns_match(pats, actual_patterns(co.at)):
            r.note(f"worktree present + sparse ok at {co.at} [{cone}]")
        else:
            r.do(f"reset sparse cone at {co.at} → {pats}",
                 lambda: _set_sparse(co.at, pats))
        return

    # guard: anchor-root worktree may only hold .anchor (+ nothing else untracked)
    preserved = None
    if co.at.exists():
        entries = [p for p in co.at.iterdir() if p.name not in (".git",)]
        if co.is_anchor_root and {p.name for p in entries} <= {".anchor"}:
            preserved = co.at / ".anchor" if (co.at / ".anchor").exists() else None
        elif entries:
            raise CodeError(
                f"worktree target {co.at} is non-empty (not just .anchor); refusing "
                f"to clobber — migrate its contents into {co.repo} first")

    branch = None

    def _add():
        nonlocal branch
        branch = default_branch(clone)
        tmp = None
        if preserved is not None:
            tmp = preserved.parent.parent / (".anchor.codetmp")
            preserved.rename(tmp)
        if co.at.exists():
            co.at.rmdir()
        git(["-C", str(clone), "worktree", "add", "--detach", str(co.at), branch])
        if tmp is not None:
            tmp.rename(co.at / ".anchor")
        _set_sparse(co.at, pats)

    r.do(f"add worktree at {co.at} [{cone}] (detached @ default branch, "
         f"shares {clone}/.git)", _add)


def cmd_link(anchor_path, apply, reattach=False):
    anchor_dir, anchor_file, data, groups, code_field = load_anchor(anchor_path)
    mode = "reattach" if reattach else "link"
    print(bold(f"code {mode}: {anchor_file}"))
    print(dim(f"  anchor dir: {anchor_dir}"))
    r = Runner(apply)
    for g in groups:
        print(bold(f"\nrepo {g.repo}  ({len(g.checkouts)} checkout"
                   f"{'s' if len(g.checkouts) != 1 else ''})"))
        if reattach and g.main.at.exists() and is_git_worktree(g.main.at):
            # clear stale worktree registrations so missing trees can be re-added
            git(["-C", str(g.main.at), "worktree", "prune"], check=False)
        _setup_main(g, r)
        for co in g.checkouts:
            if co is g.main:
                continue
            _setup_worktree(g, co, r)

    _report_code_field(groups, code_field)
    print()
    if apply:
        print(ok(f"done — {r.actions} action(s) executed"))
    else:
        print(warn(f"dry-run — {r.actions} action(s) planned; re-run with --apply"))
    return 0


def _code_checkout(groups):
    """The checkout that `code:` should point at — the off-mount code slice."""
    for g in groups:
        offmount = [c for c in g.checkouts if not c.is_anchor_root]
        whole = [c for c in offmount if c.frm == "."]
        if whole:
            return whole[0]
        if offmount:
            return offmount[0]
    return None


def _report_code_field(groups, code_field):
    cc = _code_checkout(groups)
    if cc is None:
        return
    if code_field is None:
        print(dim(f"\n  note: no `code:` field set; code checkout is at {cc.at}"))
        return
    declared = Path(os.path.expanduser(code_field)).resolve()
    if declared == cc.at:
        print(dim(f"\n  code: {code_field} ✓ matches code checkout {cc.at}"))
    else:
        print(warn(f"\n  code: {code_field} → {declared} does NOT match code "
                   f"checkout {cc.at}"))


# ── status / audit ────────────────────────────────────────────────────────────
def _inspect(groups, code_field):
    """Return (rows, problems). rows: list of dicts; problems: list of str."""
    rows = []
    problems = []
    for g in groups:
        clone = g.main.at
        clone_ok = is_git_worktree(clone) and clone_remote_url(clone) == g.repo
        for co in g.checkouts:
            pats = expected_patterns(co, g)
            wt_present = co.at.exists() and is_git_worktree(co.at)
            shared = False
            sparse_ok = None
            if wt_present:
                if co is g.main:
                    shared = True
                else:
                    shared = co.at in registered_worktrees(clone)
                sparse_ok = patterns_match(pats, actual_patterns(co.at))
            row = {
                "co": co, "is_main": co is g.main,
                "clone_ok": clone_ok, "wt_present": wt_present,
                "shared": shared, "sparse_ok": sparse_ok,
                "cone": co.frm_disp(),
            }
            rows.append(row)
            if not wt_present:
                problems.append(f"{co.label()}: working tree missing at {co.at}")
            else:
                if not co.is_anchor_root and not shared:
                    problems.append(
                        f"{co.label()}: at {co.at} is NOT a worktree of clone {clone} "
                        f"(not sharing one .git)")
                if sparse_ok is False:
                    problems.append(
                        f"{co.label()}: sparse cone at {co.at} does not match declared "
                        f"from={co.frm_disp()} (expected {pats}, got {actual_patterns(co.at)})")
            if not clone_ok and co is g.main:
                problems.append(f"{g.repo}: clone at {clone} missing or wrong origin")

    # code: field
    cc = _code_checkout(groups)
    if cc is not None and code_field is not None:
        declared = Path(os.path.expanduser(code_field)).resolve()
        if declared != cc.at:
            problems.append(
                f"code: {code_field} ({declared}) != code checkout at {cc.at}")
    return rows, problems


def cmd_status(anchor_path):
    anchor_dir, anchor_file, data, groups, code_field = load_anchor(anchor_path)
    print(bold(f"code status: {anchor_file}"))
    rows, problems = _inspect(groups, code_field)
    print()
    hdr = f"  {'checkout':46} {'clone':6} {'worktree':9} {'shared':7} {'sparse':7}"
    print(bold(hdr))
    for row in rows:
        co = row["co"]
        name = co.label()
        if len(name) > 45:
            name = name[:44] + "…"

        def mark(v, true="yes", false="NO", na="-"):
            if v is None:
                return dim(na)
            return ok(true) if v else err(false)

        role = " (main)" if row["is_main"] else ""
        print(f"  {name:46} "
              f"{mark(row['clone_ok']):>15} "
              f"{mark(row['wt_present']):>18} "
              f"{mark(True if row['shared'] else (None if not row['wt_present'] else False)):>16} "
              f"{mark(row['sparse_ok']):>16}{role}")

    cc = _code_checkout(groups)
    print()
    if cc is not None:
        if code_field is None:
            print(dim(f"  code: (unset) — code checkout at {cc.at}"))
        else:
            declared = Path(os.path.expanduser(code_field)).resolve()
            good = declared == cc.at
            print(f"  code: {code_field} → "
                  + (ok("matches") if good else err("MISMATCH"))
                  + f" code checkout {cc.at}")

    print()
    if problems:
        print(err(f"{len(problems)} problem(s):"))
        for p in problems:
            print("  - " + p)
        return 1
    print(ok("clean — every declared checkout matches disk"))
    return 0


def cmd_audit(anchor_path):
    """Read-only structural verification of a Sparse-Linked anchor.

    Used by /audit structure (see audit/anchor/audit-structure.md). Prints
    findings and exits non-zero on any drift. Never modifies anything.
    """
    try:
        anchor_dir, anchor_file, data, groups, code_field = load_anchor(anchor_path)
    except CodeError as e:
        # not a sparse-linked anchor → nothing to check, exit clean
        if "no `remotes:`" in str(e):
            print(dim("code audit: no remotes: — not a Sparse-Linked anchor (skip)"))
            return 0
        raise
    rows, problems = _inspect(groups, code_field)

    # complementary-cone check: checkouts sharing a repo must not overlap
    for g in groups:
        pairs = [(c, f.strip("/")) for c in g.checkouts
                 for f in (c.frm_items() or [])]
        for i in range(len(pairs)):
            for j in range(i + 1, len(pairs)):
                (ca, a), (cb, b) = pairs[i], pairs[j]
                if ca is cb:
                    continue
                if a == b or a.startswith(b + "/") or b.startswith(a + "/"):
                    problems.append(
                        f"{g.repo}: checkouts {a!r} and {b!r} overlap — sparse cones "
                        f"are not complementary")

    print(bold(f"code audit: {anchor_file}"))
    if problems:
        print(err(f"  {len(problems)} finding(s):"))
        for p in problems:
            print("  - " + p)
        return 1
    print(ok("  Sparse-Linked anchor verified — cones complementary, "
             "worktrees shared, code: agrees"))
    return 0


# ── mirror sync (`mirror:` — DAS Code Repository § Doc Mirror) ───────────────
import hashlib
import json
import shutil
import stat
import unicodedata

SYNC_IGNORED = {".git", ".DS_Store", ".anchor", ".obsidian"}
DIRECTIONS = {"two-way", "push", "pull"}


@dataclass
class MirrorRoute:
    here_raw: str
    there_raw: str
    direction: str
    here: Path            # resolved absolute (anchor_dir / here_raw)
    there: Path           # resolved absolute


def load_mirror(anchor_path: Path):
    """Return (anchor_dir, anchor_file, list[MirrorRoute])."""
    anchor_file = find_anchor_file(Path(anchor_path))
    anchor_dir = anchor_file.parent
    try:
        data = yaml.safe_load(anchor_file.read_text()) or {}
    except yaml.YAMLError as e:
        raise CodeError(f"could not parse {anchor_file} as YAML: {e}")
    if not isinstance(data, dict):
        raise CodeError(f"{anchor_file}: top-level YAML is not a mapping")
    mirror = data.get("mirror")
    if not mirror:
        raise CodeError(f"{anchor_file}: no `mirror:` list — nothing to sync")
    if not isinstance(mirror, list):
        raise CodeError(f"{anchor_file}: `mirror:` must be a list")
    routes = []
    for i, e in enumerate(mirror):
        if not isinstance(e, dict):
            raise CodeError(f"{anchor_file}: mirror[{i}] is not a mapping")
        here_raw = e.get("here")
        there_raw = e.get("there")
        if not here_raw or not there_raw:
            raise CodeError(f"{anchor_file}: mirror[{i}] needs both `here:` and `there:`")
        if Path(here_raw).is_absolute():
            raise CodeError(f"{anchor_file}: mirror[{i}] `here:` must be relative "
                            f"to the anchor root, got {here_raw!r}")
        there = Path(os.path.expanduser(str(there_raw)))
        if not there.is_absolute():
            raise CodeError(f"{anchor_file}: mirror[{i}] `there:` must be an absolute "
                            f"(or ~) path, got {there_raw!r} — never resolved "
                            f"against `code:` (R-code-repository-04)")
        direction = str(e.get("direction", "two-way")).strip()
        if direction not in DIRECTIONS:
            raise CodeError(f"{anchor_file}: mirror[{i}] direction {direction!r} "
                            f"not in {sorted(DIRECTIONS)}")
        here = (anchor_dir / here_raw).resolve()
        if not here.is_relative_to(anchor_dir):
            raise CodeError(f"{anchor_file}: mirror[{i}] `here:` resolves outside "
                            f"the anchor root: {here_raw!r} → {here}")
        routes.append(MirrorRoute(str(here_raw), str(there_raw), direction,
                                  here, there.resolve()))

    def _nested(a: Path, b: Path) -> bool:
        return a == b or a.is_relative_to(b) or b.is_relative_to(a)

    for i, a in enumerate(routes):
        for j, b in enumerate(routes):
            if i < j and _nested(a.here, b.here):
                raise CodeError(f"{anchor_file}: mirror routes overlap on the here "
                                f"side: {a.here_raw!r} and {b.here_raw!r}")
            if i < j and _nested(a.there, b.there):
                raise CodeError(f"{anchor_file}: mirror routes overlap on the there "
                                f"side: {a.there} and {b.there}")
            if _nested(a.here, b.there):
                raise CodeError(f"{anchor_file}: mirror here {a.here} overlaps "
                                f"there {b.there} — routes would fight")
    return anchor_dir, anchor_file, routes


def _file_hash(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def _walk_files(root: Path):
    """(relpath(str, posix) → absolute Path) for regular files under root,
    plus the relpaths of symlinks encountered (skipped, never mirrored)."""
    out, symlinks = {}, []
    if not root.exists():
        return out, symlinks
    for dirpath, dirnames, filenames in os.walk(root):
        keep = []
        for d in dirnames:
            if d in SYNC_IGNORED:
                continue
            if (Path(dirpath) / d).is_symlink():
                symlinks.append((Path(dirpath) / d).relative_to(root).as_posix() + "/")
            else:
                keep.append(d)
        dirnames[:] = keep
        for fn in filenames:
            if fn in SYNC_IGNORED:
                continue
            p = Path(dirpath) / fn
            if p.is_symlink():
                symlinks.append(p.relative_to(root).as_posix())
                continue
            out[p.relative_to(root).as_posix()] = p
    return out, symlinks


def _git_ctx(there: Path):
    """(toplevel, gitdir, dirty_relpaths, prefix) for the repo enclosing
    `there`, or None. `prefix` is there's path relative to the toplevel in
    git's own casing (rev-parse --show-prefix) — path math against `there` as
    declared crashes on a case mismatch (Audit 2026-07-12 Finding 7)."""
    probe, missing = (there, False) if there.exists() else (there.parent, True)
    if not probe.exists():
        return None
    res = git(["-C", str(probe), "rev-parse", "--show-toplevel"], check=False)
    if res.returncode != 0:
        return None
    top = Path(res.stdout.strip()).resolve()
    res = git(["-C", str(probe), "rev-parse", "--show-prefix"], check=False)
    prefix = res.stdout.strip()
    if missing:
        prefix += there.name + "/"
    res = git(["-C", str(top), "rev-parse", "--git-dir"], check=False)
    gd = Path(res.stdout.strip())
    gitdir = gd if gd.is_absolute() else (top / gd).resolve()
    # -z: NUL-separated, paths never C-quoted (Audit 2026-07-12 Finding 2);
    # --ignored=matching: gitignored files count as dirty, never "committed"
    res = git(["-C", str(probe), "status", "--porcelain", "-z",
               "--untracked-files=all", "--ignored=matching", "--", "."],
              check=False)
    dirty = set()
    tokens = (res.stdout or "").split("\0")
    i = 0
    while i < len(tokens):
        entry = tokens[i]
        i += 1
        if len(entry) < 4:
            continue
        xy = entry[:2]
        dirty.add(unicodedata.normalize("NFC", entry[3:]))
        if "R" in xy or "C" in xy:  # rename/copy: next token is the source path
            if i < len(tokens):
                dirty.add(unicodedata.normalize("NFC", tokens[i]))
                i += 1
    return top, gitdir, dirty, prefix


def _manifest_path(anchor_dir: Path, route: MirrorRoute, gitdir) -> Path:
    key = hashlib.sha1(
        f"{anchor_dir}|{route.here_raw}|{route.there}".encode()).hexdigest()[:16]
    if gitdir is not None:
        return gitdir / "anchor-sync" / f"{key}.json"
    return (Path("~/.config/anchor-system/sync-manifests").expanduser()
            / f"{key}.json")


def _load_manifest(path: Path):
    """The manifest's files dict, or None when no manifest exists yet."""
    if path.is_file():
        try:
            data = json.loads(path.read_text())
            return data.get("files", {})
        except (json.JSONDecodeError, OSError):
            raise CodeError(
                f"corrupt sync manifest {path} — inspect it before removing: "
                f"without it deletion history is lost and deleted files can "
                f"resurrect on the re-baseline (which then needs --init)")
    return None


def _save_manifest(path: Path, anchor_dir, route, files: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps({
        "version": 1,
        "anchor": str(anchor_dir),
        "here": route.here_raw,
        "there": str(route.there),
        "files": dict(sorted(files.items())),
    }, indent=1) + "\n")
    os.replace(tmp, path)  # atomic — a killed sync never truncates the manifest


def _acquire_lock(mpath: Path) -> Path:
    """O_EXCL lockfile beside the manifest; guards concurrent syncs of a route."""
    lock = mpath.with_suffix(".lock")
    lock.parent.mkdir(parents=True, exist_ok=True)
    for _ in range(2):
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(fd, str(os.getpid()).encode())
            os.close(fd)
            return lock
        except FileExistsError:
            try:
                pid = int(lock.read_text().strip() or "0")
            except (OSError, ValueError):
                pid = 0
            alive = False
            if pid:
                try:
                    os.kill(pid, 0)
                    alive = True
                except ProcessLookupError:
                    alive = False
                except PermissionError:
                    alive = True
            if alive:
                raise CodeError(f"another sync of this route is running "
                                f"(pid {pid}, lock {lock}) — wait for it, or "
                                f"remove the lock if it is stale")
            lock.unlink(missing_ok=True)  # stale holder — reclaim and retry
    raise CodeError(f"could not acquire sync lock {lock}")


def _strip_write(p: Path):
    mode = p.stat().st_mode
    if mode & 0o222:  # mask write bits only — forcing 0444 would strip the
        p.chmod(mode & ~0o222)  # exec bit and leave the file git-dirty forever


def _copy_to_there(src: Path, dst: Path):
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists():
        dst.chmod(dst.stat().st_mode | stat.S_IWUSR)
        dst.unlink()
    shutil.copy2(src, dst)
    _strip_write(dst)  # the there side is not an authoring surface


def _copy_to_here(src: Path, dst: Path):
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    dst.chmod(dst.stat().st_mode | 0o644)  # writable here; exec bit preserved


def _delete_there(p: Path):
    if p.exists():
        p.chmod(p.stat().st_mode | stat.S_IWUSR)
        p.unlink()


def _norm_rel(rel: str) -> str:
    """Collision key: APFS is case-insensitive and normalization-insensitive."""
    return unicodedata.normalize("NFC", rel).casefold()


def _dir_blocked(root: Path, rel: str):
    """First ancestor dir of root/rel that exists as a non-directory, or None."""
    p = root
    for part in rel.split("/")[:-1]:
        p = p / part
        if p.exists() and not p.is_dir():
            return p
    return None


def sync_route(anchor_dir: Path, route: MirrorRoute, dry: bool,
               take_here: set, take_there: set, init: bool = False):
    """Sync one route.

    Returns (counters dict, flags list[str], consumed_here, consumed_there) —
    the consumed sets record which --take-* entries actually resolved a
    flagged path, so unmatched take arguments can be reported instead of
    silently ignored.
    """
    if not route.here.exists():
        raise CodeError(f"here route missing on disk: {route.here}")
    ctx = _git_ctx(route.there)
    top, gitdir, dirty, prefix = ctx if ctx else (None, None, set(), "")

    mpath = _manifest_path(anchor_dir, route, gitdir)
    lock = None if dry else _acquire_lock(mpath)
    try:
        return _sync_route_locked(anchor_dir, route, dry, take_here, take_there,
                                  init, top, dirty, prefix, mpath)
    finally:
        if lock is not None:
            lock.unlink(missing_ok=True)


def _sync_route_locked(anchor_dir, route, dry, take_here, take_there,
                       init, top, dirty, prefix, mpath):
    manifest = _load_manifest(mpath)
    here_files, here_links = _walk_files(route.here)
    there_files, there_links = _walk_files(route.there)

    if manifest is None:
        manifest = {}
        if here_files and there_files and not init:
            differs = set(here_files) != set(there_files) or any(
                _file_hash(here_files[r]) != _file_hash(there_files[r])
                for r in here_files)
            if differs:
                raise CodeError(
                    f"no sync manifest for {route.here_raw} ↔ {route.there} and "
                    f"the two sides differ — a lost manifest also loses deletion "
                    f"history, so re-baselining silently could resurrect deleted "
                    f"files; pass --init to baseline (preview with --dry --init)")

    def committed(rel: str) -> bool:
        """True iff the there-side file's state arrived via git history."""
        if top is None:
            return True  # no enclosing repo — plain three-way folder sync
        return unicodedata.normalize("NFC", prefix + rel) not in dirty

    counters = {"forward": 0, "backward": 0, "deleted_there": 0,
                "deleted_here": 0, "seeded": 0, "in_sync": 0}
    flags = []
    flagged = set()   # rels flagged this run — exempt from read-only stamping
    new_manifest = {}
    consumed_here, consumed_there = set(), set()

    for rel in sorted(here_links):
        flags.append(f"note: symlink skipped (never mirrored): {rel} [here]")
    for rel in sorted(there_links):
        flags.append(f"note: symlink skipped (never mirrored): {rel} [there]")

    def matches(rel, tset, consumed, destructive):
        # 'all' resolves flagged paths by copying only — a resolution that
        # would DELETE a file always needs the path spelled out explicitly
        # (Audit 2026-07-12 Finding 1)
        if rel in tset:
            consumed.add(rel)
            return True
        if not destructive and "all" in tset:
            consumed.add("all")
            return True
        return False

    all_rels = set(here_files) | set(there_files) | set(manifest)
    by_norm = {}
    for rel in all_rels:
        by_norm.setdefault(_norm_rel(rel), []).append(rel)
    collided = set()
    for group in by_norm.values():
        if len(group) == 1:
            continue
        # case/normalization variants are one on-disk file per side on APFS —
        # treating them as distinct rels clobbers (Audit 2026-07-12 Finding 3)
        collided.update(group)
        h_rels = [r for r in group if r in here_files]
        t_rels = [r for r in group if r in there_files]
        hashes = ({_file_hash(here_files[r]) for r in h_rels}
                  | {_file_hash(there_files[r]) for r in t_rels})
        if not hashes:
            continue  # every variant deleted on both sides — drops out
        if len(h_rels) <= 1 and len(t_rels) <= 1 and len(hashes) == 1:
            canon = h_rels[0] if h_rels else t_rels[0]
            counters["in_sync" if manifest.get(canon) else "seeded"] += 1
            new_manifest[canon] = next(iter(hashes))
        else:
            flags.append(f"CONFLICT: case/normalization collision — "
                         f"{', '.join(repr(r) for r in sorted(group))} name the "
                         f"same file on this filesystem; rename to a single form "
                         f"(nothing transported)")
            flagged.update(group)
            for r in group:
                if r in manifest:
                    new_manifest[r] = manifest[r]

    for rel in sorted(all_rels - collided):
        H = _file_hash(here_files[rel]) if rel in here_files else None
        T = _file_hash(there_files[rel]) if rel in there_files else None
        M = manifest.get(rel)
        hp, tp = route.here / rel, route.there / rel

        if ((H is not None and (tp.is_dir() or _dir_blocked(route.there, rel)))
                or (T is not None and (hp.is_dir() or _dir_blocked(route.here, rel)))):
            flags.append(f"CONFLICT: {rel} is a file on one side but a directory "
                         f"on the other — nothing transported")
            flagged.add(rel)
            if M is not None:
                new_manifest[rel] = M
            continue

        def forward():
            if not dry:
                _copy_to_there(hp, tp)
            counters["forward"] += 1
            new_manifest[rel] = H

        def backward():
            if not dry:
                _copy_to_here(tp, hp)
            counters["backward"] += 1
            new_manifest[rel] = T

        def resolve_take():
            """--take-* resolves only states this run would otherwise flag."""
            if matches(rel, take_here, consumed_here, destructive=H is None):
                if H is not None:
                    forward()
                else:
                    if not dry:
                        _delete_there(tp)
                    counters["deleted_there"] += 1
                return True
            if matches(rel, take_there, consumed_there, destructive=T is None):
                if T is not None:
                    backward()
                else:
                    if not dry:
                        hp.unlink()
                    counters["deleted_here"] += 1
                return True
            return False

        def flag(msg):
            flags.append(msg)
            flagged.add(rel)
            if M is not None:
                new_manifest[rel] = M

        if H is not None and H == T:
            counters["seeded" if M is None else "in_sync"] += 1
            new_manifest[rel] = H
        elif H is not None and T is not None:            # both exist, differ
            if M == T:                                    # here changed
                if route.direction != "pull":
                    forward()
                elif not resolve_take():
                    flag(f"drift: {rel} changed here but route is pull-only")
            elif M == H:                                  # there changed
                if route.direction == "push":
                    if not resolve_take():
                        flag(f"drift: {rel} changed there but route is push-only")
                elif committed(rel):
                    backward()
                elif not resolve_take():
                    flag(f"QUARANTINE: {rel} edited there UNCOMMITTED — "
                         f"never transported; fix at {tp} (or --take-there)")
            else:                                         # both changed
                if not resolve_take():
                    flag(f"CONFLICT: {rel} changed on both sides — resolve, "
                         f"then --take-here or --take-there")
        elif H is not None:                               # missing there
            if M is None:                                 # new here file
                if route.direction != "pull":
                    forward()
                elif not resolve_take():
                    flag(f"drift: {rel} added here but route is pull-only")
            elif M != H:                                  # here changed + there deleted
                if not resolve_take():
                    flag(f"CONFLICT: {rel} changed here but deleted there")
            else:                                         # there-side deletion
                if not resolve_take():
                    flag(f"deletion: {rel} deleted there — backward deletions "
                         f"are never auto-applied; --take-there {rel} to accept, "
                         f"--take-here {rel} to restore")
        elif T is not None:                               # missing here
            if M is None:                                 # new there file
                if route.direction == "push":
                    if not resolve_take():
                        flag(f"drift: {rel} added there but route is push-only")
                elif committed(rel):
                    backward()
                elif not resolve_take():
                    flag(f"QUARANTINE: {rel} added there UNCOMMITTED — "
                         f"never transported (or --take-there)")
            elif M == T:                                  # here deleted it
                if route.direction != "pull":
                    if not dry:
                        _delete_there(tp)
                    counters["deleted_there"] += 1
                elif not resolve_take():
                    flag(f"drift: {rel} deleted here but route is pull-only")
            else:                                         # here deleted + there changed
                if not resolve_take():
                    flag(f"CONFLICT: {rel} deleted here but changed there")
        # else: manifest-only entry (deleted both sides) — drops out

    if not dry:
        _save_manifest(mpath, anchor_dir, route, new_manifest)
        if route.direction in ("two-way", "push"):
            stamped, _ = _walk_files(route.there)
            for rel, p in stamped.items():
                if rel in flagged:
                    continue  # don't re-lock a file the flag says to fix in place
                _strip_write(p)
    return counters, flags, consumed_here, consumed_there


ROUTES_INDEX = Path.home() / ".config/anchor-system/mirror-routes.json"


def _publish_routes_index(anchor_file: Path, routes):
    """Refresh this anchor's entries in the mirror-routes index.

    The index is derived state consumed by the Warden `R-code-mirror` deny
    rule (repo-side edits redirected to the vault original) and by the
    nightly `km` commit sweep (which anchors to run `code sync` over).
    Regenerated on every `code sync`; entries for other anchors preserved.
    """
    entries = []
    if ROUTES_INDEX.is_file():
        try:
            entries = json.loads(ROUTES_INDEX.read_text()).get("routes", [])
        except (json.JSONDecodeError, OSError):
            entries = []
    key = str(anchor_file)
    entries = [e for e in entries if e.get("anchor") != key]
    for r in routes:
        entries.append({"anchor": key, "here": str(r.here),
                        "there": str(r.there), "direction": r.direction})
    ROUTES_INDEX.parent.mkdir(parents=True, exist_ok=True)
    tmp = ROUTES_INDEX.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(
        {"generated_by": "code sync",
         "routes": sorted(entries, key=lambda e: (e["anchor"], e["here"]))},
        indent=2) + "\n")
    tmp.replace(ROUTES_INDEX)


def cmd_sync(anchor_path, dry, take_here, take_there, init=False):
    anchor_dir, anchor_file, routes = load_mirror(anchor_path)
    _publish_routes_index(anchor_file, routes)
    mode = "dry-run" if dry else "sync"
    print(bold(f"code sync ({mode}): {anchor_file}"))
    any_flags = False
    th, tt = set(take_here), set(take_there)
    used_h, used_t = set(), set()
    for route in routes:
        print(bold(f"\n{route.here_raw}  ↔  {route.there}   [{route.direction}]"))
        counters, flags, ch, ct = sync_route(anchor_dir, route, dry, th, tt, init)
        used_h |= ch
        used_t |= ct
        parts = [f"{v} {k.replace('_', ' ')}" for k, v in counters.items() if v]
        print("  " + (dim("nothing to do") if not parts else ok(", ".join(parts))))
        for f in flags:
            if f.startswith("note:"):
                print("  " + dim(f))
                continue
            any_flags = True
            print("  " + (err(f) if f.startswith(("QUARANTINE", "CONFLICT"))
                          else warn(f)))
    for label, given, used in (("--take-here", th, used_h),
                               ("--take-there", tt, used_t)):
        for p in sorted(given - used):
            any_flags = True
            if p == "all":
                print(err(f"  {label} all matched no flagged path — deletions "
                          f"always need an explicit path"))
            else:
                print(err(f"  {label} {p!r} matched no flagged path — "
                          f"nothing was resolved for it"))
    print()
    if any_flags:
        print(err("flags present — nothing flagged was transported"))
        return 1
    print(ok("mirror clean" + (" (dry-run — no changes made)" if dry else "")))
    return 0


# ── CLI ───────────────────────────────────────────────────────────────────────
def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="code",
        description="Sparse-link tool realizing the remotes: anchor declaration.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    for name, helptext in [
        ("sync", "run the mirror: doc-mirror engine (three-way, git-aware)"),
        ("link", "SHELVED sparse-link: set up declared checkouts (DRY unless --apply)"),
        ("reattach", "SHELVED sparse-link: rebuild missing checkouts (DRY unless --apply)"),
        ("status", "report declared-vs-on-disk for each remotes: checkout"),
        ("audit", "read-only remotes: verification; exit!=0 on drift"),
    ]:
        p = sub.add_parser(name, help=helptext)
        p.add_argument("anchor", help="path to the anchor dir or its .anchor file")
        if name in ("link", "reattach"):
            p.add_argument("--apply", action="store_true",
                           help="execute the plan (default: dry-run)")
        if name == "sync":
            p.add_argument("--dry", action="store_true",
                           help="report what would happen; change nothing")
            p.add_argument("--init", action="store_true",
                           help="baseline a route that has no manifest when both "
                                "sides already hold differing content")
            p.add_argument("--take-here", action="append", default=[],
                           metavar="RELPATH",
                           help="resolve a flagged path by forcing here→there "
                                "('all' = every flagged path; deletions need "
                                "the explicit path)")
            p.add_argument("--take-there", action="append", default=[],
                           metavar="RELPATH",
                           help="resolve a flagged path by forcing there→here "
                                "('all' = every flagged path; deletions need "
                                "the explicit path)")

    args = parser.parse_args(argv)
    anchor = Path(args.anchor)
    try:
        if args.cmd == "sync":
            return cmd_sync(anchor, args.dry, args.take_here, args.take_there,
                            args.init)
        if args.cmd == "link":
            return cmd_link(anchor, args.apply)
        if args.cmd == "reattach":
            return cmd_link(anchor, args.apply, reattach=True)
        if args.cmd == "status":
            return cmd_status(anchor)
        if args.cmd == "audit":
            return cmd_audit(anchor)
    except CodeError as e:
        sys.stderr.write(err("code: ") + str(e) + "\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())

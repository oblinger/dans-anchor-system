#!/usr/bin/env bash
# muse — voice-memo pipeline entry point.
#
# Usage:
#   muse ingest <audio-path>   # process one .m4a end-to-end
#   muse ingest --sweep        # scan MUSE_JPR_DIR for unprocessed .m4a
#   muse -h | --help           # show this header
#
# Pipeline (per file):
#   1. Strip quarantine xattr
#   2. Compute audio SHA-256; skip if already in .muse.hashes
#   3. Whisper transcript via ~/bin/_transcribe
#   4. Title derivation via ~/bin/_askAI (tool-less; safe against injection)
#   5. Sanitize title → [A-Za-z0-9 _-]
#   6. Compute daily sequence letter (MMDD A/B/C ... by same-day count)
#   7. Write LST/Quick/MUSE MMDD X <title>.md with frontmatter + transcript
#   8. Prepend bullet to LST/Quick.md
#   9. Record hash in .muse.hashes
#  10. macOS notification
#
# Environment overrides (see SKILL.md § Config):
#   MUSE_QUICK_DIR MUSE_JPR_DIR MUSE_INLINE_MAX_CHARS MUSE_NOTIFICATION_SOUND
#   WHISPER_BIN WHISPER_MODEL FFMPEG_BIN ANTHROPIC_KEY_FILE ASKAI_MODEL

set -euo pipefail

MUSE_ITEMS_DIR="${MUSE_ITEMS_DIR:-$HOME/ob/kmr/Log/MUSE}"
# Two prepend targets (per user direction 2026-07-15):
#   MUSE_QUICK_FILE — user's daily Quick pane. Bare bullet (link or inline
#     text). No date/time — Quick is user-facing and stays lean.
#   MUSE_LOG_FILE  — MUSE's complete archive index. Every ingest lands here
#     including SUPPRESSED ones (which do NOT go to Quick). Date/time
#     prefix so the log doubles as an audit trail.
MUSE_QUICK_FILE="${MUSE_QUICK_FILE:-$HOME/ob/kmr/LST/Quick.md}"
MUSE_LOG_FILE="${MUSE_LOG_FILE:-$HOME/ob/kmr/Log/MUSE/Log Muse.md}"
MUSE_JPR_DIR="${MUSE_JPR_DIR:-$HOME/Library/Mobile Documents/iCloud~com~openplanetsoftware~Just-Press-Record/Documents}"
MUSE_INLINE_MAX_CHARS="${MUSE_INLINE_MAX_CHARS:-80}"
MUSE_NOTIFICATION_SOUND="${MUSE_NOTIFICATION_SOUND:-Tink}"
# Suppression thresholds for accidental / low-content recordings (per user
# 2026-07-14; three-part predicate per F001 2026-07-17). Suppressed items
# STILL write the item file + hashfile entry (audio history preserved, no
# reprocessing), they just DON'T get a bullet in the Inbox and DON'T fire a
# notification. Three-part predicate:
#
#   1. MIN_WORDS — total word count in the transcript. Catches empty /
#      near-empty captures ('Thank you.', a bare '.').
#
#   2. Trimmed-WPS floor — words-per-second computed AFTER subtracting long
#      silences (up to a percent-of-length cap). Catches silence-hallucination
#      recordings (10-min coughing → 46 'Thank you.' at ~0.15 wps overall)
#      but permits thoughtful pause-heavy dictations ('So the area bets,
#      [long think] a device bet, a data bet.') to pass.
#
#   3. Leading-burst override — if the first LEAD_WINDOW seconds contains
#      LEAD_MIN_SPEECH seconds of non-silence AND word_count >= LEAD_MIN_WORDS,
#      the recording bypasses the trimmed-wps check. Catches 'press record
#      with intent, speak the opening thought, trail off' dictations.
#
# Suppression fires if MIN_WORDS fails OR (trimmed-WPS fails AND leading-burst
# rescue fails). Any ffmpeg / silencedetect failure disables predicates 2 & 3
# (fall through to MIN_WORDS only) — probe failures MUST NOT suppress memos.
MUSE_MIN_WORDS="${MUSE_MIN_WORDS:-5}"
MUSE_SILENCE_NOISE_DB="${MUSE_SILENCE_NOISE_DB:--30dB}"
MUSE_SILENCE_MIN_GAP="${MUSE_SILENCE_MIN_GAP:-2.0}"
MUSE_SILENCE_TRIM_PCT="${MUSE_SILENCE_TRIM_PCT:-60}"
MUSE_TRIMMED_MIN_WPS="${MUSE_TRIMMED_MIN_WPS:-1.0}"
MUSE_LEAD_WINDOW="${MUSE_LEAD_WINDOW:-3.0}"
MUSE_LEAD_MIN_SPEECH="${MUSE_LEAD_MIN_SPEECH:-1.5}"
MUSE_LEAD_MIN_WORDS="${MUSE_LEAD_MIN_WORDS:-3}"

TRANSCRIBE_BIN="${TRANSCRIBE_BIN:-$HOME/bin/_transcribe}"
ASKAI_BIN="${ASKAI_BIN:-$HOME/bin/_askAI}"

# Concurrency lock state (F252 F2). MUSE_LOCK_OWNED_BY_ME makes acquire_lock
# re-entrant per process, so a sweep that holds the lock can call ingest_one
# without deadlocking on a re-acquire. Both must exist before `set -u` reads them.
MUSE_LOCK_OWNED_BY_ME="no"
MUSE_SWEEP_LOCKDIR=""
# F252 F7 — `timeout`/`gtimeout` if present (macOS ships neither by default;
# coreutils provides `gtimeout`). Empty → commands run unguarded (best-effort).
TIMEOUT_BIN="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
MUSE_IO_TIMEOUT="${MUSE_IO_TIMEOUT:-120}"   # seconds for a single hash/transcribe
# F252 F8c — a candidate that fails this many consecutive sweeps is marked in
# `.muse.failures` and skipped (with a periodic log) so a permanently-broken
# file stops burning file_stable + Whisper on every pass.
MUSE_MAX_FAILURES="${MUSE_MAX_FAILURES:-3}"

TITLE_SYSTEM='Give a 3-6 word title for this voice memo. Plain words, no punctuation, no quotes. Only respond with the title itself.'

log()  { printf 'muse: %s\n' "$*"        >&2; }
die()  { printf 'muse: %s\n' "$*"        >&2; exit 1; }
warn() { printf 'muse: warning: %s\n' "$*" >&2; }

require_deps() {
    [[ -x "$TRANSCRIBE_BIN" ]] || die "missing $TRANSCRIBE_BIN — build the _transcribe primitive"
    [[ -x "$ASKAI_BIN"      ]] || die "missing $ASKAI_BIN — build the _askAI primitive"
    command -v shasum   >/dev/null || die "shasum not found"
    command -v osascript >/dev/null || die "osascript not found (macOS only)"
}

sanitize_title() {
    local raw="$1"
    printf '%s' "$raw" \
        | tr -d '\r\n' \
        | tr -c 'A-Za-z0-9 _\-' ' ' \
        | tr -s ' ' \
        | sed -E 's/^ +| +$//g'
}

# fallback_title <transcript> — a title derived from the transcript itself, with
# no network, no credential and no cost. Used when the LLM titler is
# unreachable.
#
# WHY THIS EXISTS. Until 2026-08-20 a failure of the title call ended the
# ingest: `|| { warn ...; return 1; }` on a step that produces a decorative
# 3-6 word label. By then Whisper had ALREADY transcribed the memo, so the
# irreplaceable part -- the content -- was in hand and was thrown away because
# a cosmetic one could not be generated. Twenty real recordings were lost that
# way across 38 days when the Anthropic key was revoked (ATT T239).
#
# The pipeline already knew how to do this: the suppression branch above writes
# a locally-derived diagnostic title and never calls the LLM at all. The normal
# path was the only one without a fallback.
#
# Six words of the actual transcript is a genuinely serviceable title -- often
# better than a generated one, because it is what the person said. Notes titled
# this way carry `title_source: transcript` in their frontmatter so a later
# pass can upgrade them, which is a rename rather than a re-ingest.
fallback_title() {
    local words
    words="$(sanitize_title "$1" | cut -d' ' -f1-6)"
    words="${words:0:48}"
    printf '%s' "${words:-Untitled}"
}

# detect_silences <audio-file> — emits one 'start end' pair (seconds, floats)
# per detected silence >= MUSE_SILENCE_MIN_GAP seconds at noise floor
# MUSE_SILENCE_NOISE_DB. Empty output = no long silences (or ffmpeg failed —
# the caller distinguishes via return code). Silent-fallback bug avoidance:
# any ffmpeg failure returns non-zero and the caller falls through to the
# word-floor-only rule rather than silently suppressing every memo.
detect_silences() {
    local audio="$1"
    local ffmpeg_bin="${FFMPEG_BIN:-/opt/homebrew/bin/ffmpeg}"
    [[ -x "$ffmpeg_bin" ]] || ffmpeg_bin="$(command -v ffmpeg || true)"
    [[ -n "$ffmpeg_bin" ]] || return 1
    "$ffmpeg_bin" -nostats -hide_banner -i "$audio" \
        -af "silencedetect=noise=${MUSE_SILENCE_NOISE_DB}:d=${MUSE_SILENCE_MIN_GAP}" \
        -f null - 2>&1 \
        | awk '
            /silence_start:/ { for (i=1;i<=NF;i++) if ($i=="silence_start:") { start=$(i+1); break } }
            /silence_end:/   { for (i=1;i<=NF;i++) if ($i=="silence_end:")   { print start, $(i+1); break } }
        '
}

# From a JPR audio path like .../Documents/YYYY-MM-DD/HH-MM-SS.m4a extract
# the recording date/time. Falls back to file mtime if the path doesn't match.
audio_captured() {
    local audio="$1"
    local dir base ymd hms
    dir="$(dirname "$audio")"
    base="$(basename "$audio")"
    ymd="$(basename "$dir")"
    if [[ "$ymd" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && "$base" =~ ^([0-9]{2})-([0-9]{2})-([0-9]{2})\.[Mm]4[Aa]$ ]]; then
        hms="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
        printf '%s %s' "$ymd" "$hms"
        return
    fi
    # fallback: file mtime
    stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$audio"
}

# Given "YYYY-MM-DD HH:MM:SS" return "YYYY-MM-DD".
ymd_from_captured() {
    local captured="$1"
    printf '%s' "${captured%% *}"
}

# Compute next daily letter given YYYY-MM-DD and the items dir.
# Scans existing filenames for used single-letter tokens (A-Z) and returns
# max_used+1 — NOT the file count. Count-based assignment collides if any
# earlier item was deleted (observed 2026-07-14: after deleting a mid-day
# item and re-ingesting, count matched an existing later letter → two files
# with the same letter, breaking Obsidian's basename-resolution for links).
next_letter() {
    local ymd="$1"
    local items_dir="$2"
    local max_letter=""
    while IFS= read -r used; do
        [[ -z "$used" ]] && continue
        [[ -z "$max_letter" || "$used" > "$max_letter" ]] && max_letter="$used"
    done < <(find "$items_dir" -maxdepth 1 -type f -name "MUSE $ymd ?*.md" 2>/dev/null \
        | sed -nE "s|.*/MUSE ${ymd} ([A-Z]) .*|\1|p")
    if [[ -z "$max_letter" ]]; then
        printf 'A'
        return
    fi
    if [[ "$max_letter" < "Z" ]]; then
        local ord next_ord
        ord=$(printf '%d' "'$max_letter")
        next_ord=$((ord + 1))
        printf '%b' "$(printf '\\%03o' "$next_ord")"
    else
        # Past Z — AA, AB, ... for the unlikely >26-per-day case. Same
        # count-based fallback as the original code (past-Z collisions
        # weren't observed in the deletion-based repro).
        local count n first second f s
        count=$(find "$items_dir" -maxdepth 1 -type f -name "MUSE $ymd *.md" 2>/dev/null | wc -l | tr -d ' ')
        n=$((count - 26))
        first=$((n / 26))
        second=$((n % 26))
        f="$(printf '\\%03o' $((65 + first)))"
        s="$(printf '\\%03o' $((65 + second)))"
        printf '%b%b' "$f" "$s"
    fi
}

# F252 F7 — run a command under `timeout` when available, else unguarded. A
# dataless iCloud placeholder can pass file_stable (its size metadata is stable)
# yet block shasum/transcribe indefinitely (the EDEADLK class); the timeout
# degrades that to a non-zero exit so the caller warns-and-continues instead of
# wedging the whole sweep. Returns the wrapped command's exit code (124 on
# timeout when `timeout` is present).
_with_timeout() {
    local secs="$1"; shift
    if [[ -n "$TIMEOUT_BIN" ]]; then
        "$TIMEOUT_BIN" "$secs" "$@"
    else
        "$@"
    fi
}

sha256_of() {
    _with_timeout "$MUSE_IO_TIMEOUT" shasum -a 256 "$1" | awk '{print $1}'
}

# F252 F3 + F8a — look up a path in the hashfile by EXACT full-path match (not
# the old ` $path` substring grep, which F8a-matched `…/x.m4a.m4a`) and print
# the size recorded for it. Hashfile line formats:
#   new:    "<sha> <size> <path>"   → prints <size>
#   legacy: "<sha> <path>"          → prints "LEGACY"
# Exits 0 (found) or 1 (path not present). The path is everything after the
# 2nd field when the 2nd field is all-digits (a size), else after the 1st.
_recorded_size() {
    local hf="$1" path="$2"
    [[ -f "$hf" ]] || return 1
    awk -v want="$path" '
        {
            rest = substr($0, length($1) + 2)          # everything after <sha>
            n = split(rest, a, " ")
            if (n >= 2 && a[1] ~ /^[0-9]+$/) {          # new format: <size> <path>
                sz = a[1]
                p  = substr(rest, length(a[1]) + 2)
            } else {                                     # legacy: <path>
                sz = "LEGACY"
                p  = rest
            }
            if (p == want) { found = 1; last = sz }
        }
        END { if (found) { print last; exit 0 } else exit 1 }
    ' "$hf"
}

# F252 F8c — consecutive-failure tracking so a permanently-broken file stops
# burning file_stable + Whisper on every sweep. `.muse.failures` lines are
# "<count> <size> <path>"; the size lets a genuinely-changed file (iCloud
# finally materialized) reset the counter and get retried.
_failure_get() {   # echoes "<count> <size>" for path, or "0 -1" if absent
    local ff="$1" path="$2"
    [[ -f "$ff" ]] || { echo "0 -1"; return; }
    awk -v want="$path" '
        { p = substr($0, length($1) + length($2) + 3)
          if (p == want) { c = $1; s = $2; f = 1 } }
        END { if (f) print c, s; else print "0 -1" }
    ' "$ff"
}
_failure_bump() {  # <ff> <path> <size> — increment (reset to 1 on size change)
    local ff="$1" path="$2" size="$3" prev pc ps nc
    prev="$(_failure_get "$ff" "$path")"; pc="${prev%% *}"; ps="${prev##* }"
    nc=1; [[ "$ps" == "$size" ]] && nc=$((pc + 1))
    _failure_clear "$ff" "$path"
    printf '%s %s %s\n' "$nc" "$size" "$path" >> "$ff"
}
_failure_clear() { # <ff> <path> — drop this path's failure row (success/retry)
    local ff="$1" path="$2"
    [[ -f "$ff" ]] || return 0
    grep -vF -- " $path" "$ff" > "$ff.tmp" 2>/dev/null || true
    mv "$ff.tmp" "$ff" 2>/dev/null || true
}

# Prepend a bullet to the top of a target file (creates the file with a bare
# header if it doesn't exist). Used for Quick.md — a bare bullet list with no
# frontmatter or H1.
#
# F252 F8d — write the result back IN PLACE (`cat "$tmp" > "$target"`) rather
# than `mv`. `mv` swaps in a fresh inode and resets the mode to mktemp's 0600,
# which is the known Obsidian stale-buffer aggravator (cf. SYS T003): the editor
# still holds the old inode and can write its stale buffer back over muse's
# change. Truncate-and-rewrite keeps the target's inode and permissions.
prepend_line() {
    local target="$1"
    local line="$2"
    local tmp
    tmp="$(mktemp)"
    if [[ -f "$target" ]]; then
        printf '%s\n' "$line" > "$tmp"
        cat "$target" >> "$tmp"
        cat "$tmp" > "$target"
    else
        printf '%s\n' "$line" > "$target"
    fi
    rm -f "$tmp"
}

# Insert a bullet into the bullet list of a STRUCTURED log file (frontmatter →
# H1 → orientation → blank → bullets), keeping the list in strict newest-first
# CHRONOLOGICAL order. Used for MUSE_LOG_FILE.
#
# F252 F5 — the old strategy prepended before the first `- ` bullet
# unconditionally. When iCloud delivers an OLDER recording in a LATER sweep,
# unconditional prepend put its bullet ABOVE newer ones. Instead we splice the
# new bullet just above the first existing dated bullet whose timestamp is
# STRICTLY OLDER than the new one — so a late arrival lands in its correct slot
# and the Log stays time-ordered. Log bullets are `- YYYY-MM-DD HH:MM:SS  …`,
# so the 19-char timestamp sits at offset 3 and ISO order == chronological
# order (plain string compare). Non-dated `- ` lines (if any) are left in place
# and the new bullet falls through to them / to END. If the file doesn't exist,
# create it with the canonical MUSE log header first.
#
# F252 F8d — result written back in place (see prepend_line) to preserve the
# target's inode + mode.
#
# Args: <target> <captured "YYYY-MM-DD HH:MM:SS"> <full bullet line>
insert_log_bullet() {
    local target="$1"
    local captured="$2"
    local line="$3"
    local tmp
    tmp="$(mktemp)"
    if [[ ! -f "$target" ]]; then
        cat > "$target" <<'EOF'
---
description: MUSE ingest log — every recording listed with capture time, newest first.
---
# Log Muse

Complete audit trail of every MUSE ingest; suppressed items appear here too.

EOF
    fi
    awk -v new="$line" -v newts="$captured" '
        !inserted && /^- [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]/ {
            if (substr($0, 3, 19) < newts) { print new; inserted = 1 }
        }
        { print }
        END { if (!inserted) print new }
    ' "$target" > "$tmp"
    cat "$tmp" > "$target"
    rm -f "$tmp"
}

notify() {
    local msg="$1"
    osascript -e "display notification \"$msg\" with title \"MUSE\" sound name \"$MUSE_NOTIFICATION_SOUND\"" 2>/dev/null || true
}

# ---- Concurrency lock (F252 F1 + F2) --------------------------------------
# One mkdir-based lock (macOS lacks flock) serialises the hashfile / daily-letter
# / prepend critical section. F1 hardened stale reclaim (dead pid, or no-pid +
# age ceiling). F2 makes BOTH entry points take it: a sweep grabs it once around
# the whole loop (skip-if-held), and a manual `muse ingest <path>` grabs it too
# (short blocking wait), so a manual ingest racing a sweep can no longer
# double-process a file, collide on the daily letter, or lose a prepend.

_lock_dir() { printf '%s' "$MUSE_ITEMS_DIR/.muse.sweep.lock"; }

# Grab the lock ONCE, reclaiming a stale one. 0 = acquired, 1 = held by a live
# owner. Records $$ in the lockdir's pid file on success.
_try_lock() {
    local lockdir="$1"
    if mkdir "$lockdir" 2>/dev/null; then
        printf '%s\n' "$$" > "$lockdir/pid"
        return 0
    fi
    local lock_pid lock_stale="no"
    lock_pid="$(cat "$lockdir/pid" 2>/dev/null || true)"
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
        lock_stale="no"
    elif [[ -n "$lock_pid" ]]; then
        lock_stale="yes"           # recorded owner is dead
    else
        local lock_mtime now       # no readable pid — fall back to age ceiling
        lock_mtime="$(stat -f %m "$lockdir" 2>/dev/null || echo 0)"
        now="$(date +%s)"
        (( now - lock_mtime > 1800 )) && lock_stale="yes"
    fi
    if [[ "$lock_stale" == "yes" ]]; then
        warn "reclaiming stale lock (owner ${lock_pid:-unknown} gone)"
        rm -rf "$lockdir"
        if mkdir "$lockdir" 2>/dev/null; then
            printf '%s\n' "$$" > "$lockdir/pid"
            return 0
        fi
    fi
    return 1
}

# acquire_lock <skip|wait>. Re-entrant per process: if THIS process already
# holds it (a sweep calling ingest_one), returns 0 without re-locking. `skip`
# gives up immediately if held (sweep semantics — a later sweep will retry);
# `wait` blocks briefly then gives up (manual-ingest semantics — don't silently
# race, but don't hang forever). Sets the EXIT trap to release on the first
# acquire. Returns non-zero if the lock could not be taken.
acquire_lock() {
    local mode="$1"
    [[ "$MUSE_LOCK_OWNED_BY_ME" == "yes" ]] && return 0
    local lockdir; lockdir="$(_lock_dir)"
    MUSE_SWEEP_LOCKDIR="$lockdir"
    if [[ "$mode" == "wait" ]]; then
        local waited=0
        until _try_lock "$lockdir"; do
            if (( waited >= 30 )); then
                warn "lock still held (pid $(cat "$lockdir/pid" 2>/dev/null || echo unknown)) after ${waited}s — skipping"
                return 1
            fi
            sleep 2; waited=$((waited + 2))
        done
    else
        if ! _try_lock "$lockdir"; then
            log "another sweep is running (pid $(cat "$lockdir/pid" 2>/dev/null || echo unknown)) — skipping"
            return 1
        fi
    fi
    MUSE_LOCK_OWNED_BY_ME="yes"
    trap 'release_lock' EXIT
    return 0
}

# Release only if THIS process owns the lock (the sweep's trap, or a manual
# ingest's process-exit trap).
release_lock() {
    [[ "$MUSE_LOCK_OWNED_BY_ME" == "yes" ]] || return 0
    rm -rf "${MUSE_SWEEP_LOCKDIR:-/nonexistent}" 2>/dev/null || true
    MUSE_LOCK_OWNED_BY_ME="no"
}

# Ingest a single audio file. Prints nothing to stdout on success; logs to
# stderr; sends a notification.
ingest_one() {
    local audio="$1"

    # Per-file failure must NOT kill the whole sweep (die → exit 1 would abort
    # every remaining candidate; the sweep loop's `|| warn` cannot catch an
    # exit). Return non-zero so the loop continues — matches the transcribe /
    # empty-transcript per-file contract below.
    [[ -f "$audio" ]] || { warn "audio file not found (skipping): $audio"; return 1; }

    mkdir -p "$MUSE_ITEMS_DIR"
    mkdir -p "$(dirname "$MUSE_QUICK_FILE")"
    local hashfile="$MUSE_ITEMS_DIR/.muse.hashes"

    # F252 F2 — take the lock for the manual entry point too. When a sweep is
    # the caller it already owns the lock, so acquire_lock is a re-entrant no-op;
    # a bare `muse ingest <path>` acquires it here (short blocking wait) and the
    # process-exit trap releases it. This closes manual/sweep double-ingest,
    # daily-letter collision, and prepend lost-update.
    acquire_lock wait || { warn "could not acquire lock (skipping): $audio"; return 1; }

    # 1. quarantine
    xattr -d com.apple.quarantine "$audio" 2>/dev/null || true

    # 2. dedup — PATH-based (primary) + SHA-based (secondary).
    #
    # iCloud FileProvider re-materializes .m4a files with different container
    # metadata but identical audio, so the SHA changes without any actual
    # re-recording (verified 2026-07-12: 07-09/17-01-56.m4a came back with a
    # new SHA but a byte-identical whisper transcript). Path-check catches the
    # common case (each JPR HH-MM-SS.m4a filename is globally unique — same
    # path always means same recording). SHA-check remains as a fallback for
    # the edge case of the same audio arriving under a different path.
    local sha size
    # Poke iCloud FileProvider to materialize before hashing. On a placeholder,
    # `shasum` sees 0 readable bytes and returns the empty-string SHA even
    # though `stat` reports the file's final logical size. Reading a byte
    # triggers materialization; safe no-op on already-local files.
    head -c 1 "$audio" >/dev/null 2>&1 || true
    sha="$(sha256_of "$audio")" || true
    [[ -n "$sha" ]] || { warn "hash failed/timed out (skipping): $audio"; return 1; }
    # Refuse the empty-string SHA. Either the audio is 0 bytes (nothing to
    # ingest) or an iCloud placeholder was hashed before materialization
    # landed. Writing (empty-sha, real-size, path) to .muse.hashes poisons the
    # ledger — every subsequent sweep sees size-match and permanently skips
    # the file (19 memos silently lost this way before 2026-07-21). Return 1
    # so the sweep retries; a real placeholder materializes by next pass, a
    # genuinely-empty file burns out via the .muse.failures counter.
    if [[ "$sha" == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]]; then
        warn "empty-string SHA (unmaterialized placeholder or 0-byte file?) — refusing to record; retrying next sweep: $audio"
        return 1
    fi
    size="$(stat -f '%z' "$audio" 2>/dev/null || echo 0)"
    # PATH dedup (F3 + F8a) — exact full-path match. If the recorded size equals
    # the current on-disk size (or the entry is legacy / size-unknown) this is
    # the same file already ingested → skip. If the size DIFFERS, the earlier
    # ingest captured a truncated partial (iCloud stalled mid-materialize) and
    # the file has since completed → fall through and re-ingest the full file
    # (a genuine recording must never be locked out by a stale partial). The
    # path-first / SHA-advisory direction still holds — iCloud re-materializes
    # byte-identical audio under a new SHA (see [[gotcha-icloud-fileprovider-watchpaths]]).
    local rec_size
    if rec_size="$(_recorded_size "$hashfile" "$audio")"; then
        if [[ "$rec_size" == "LEGACY" || "$rec_size" == "$size" ]]; then
            log "SKIP already ingested (path): $audio"
            return 0
        fi
        warn "size changed since last ingest ($rec_size → $size) — re-ingesting partial-file recovery: $audio"
    fi
    if [[ -f "$hashfile" ]] && grep -q "^$sha " "$hashfile" 2>/dev/null; then
        # SHA collision at a DIFFERENT path. JPR filenames are globally unique,
        # so this shouldn't happen from real distinct recordings — but it does
        # (observed 2026-07-14: 23-05-30.m4a silently swallowed by an earlier
        # file's SHA). Log the collision twin for diagnosis and PROCEED — a
        # real recording must never disappear. If both are genuine same-audio
        # duplicates the user can dedup the resulting items manually.
        local twin
        # strip "<sha> " and an optional "<size> " to leave the path (F3 format)
        twin="$(grep "^$sha " "$hashfile" | head -1 | sed -E 's/^[a-f0-9]+ ([0-9]+ )?//')"
        warn "SHA-collision (different path) — proceeding: this=$audio twin=$twin"
    fi

    # 3. transcribe
    log "transcribing: $audio"
    local text
    # Per-file failures must NOT kill the whole sweep. Return non-zero so the
    # sweep loop's `|| warn "ingest failed: $candidate"` sees the failure and
    # continues to the next file. `die` (which does exit 1) would kill the
    # entire sweep — observed 2026-07-14 where a single iCloud-EDEADLK-stuck
    # file blocked 160 consecutive launchd sweep runs from processing
    # subsequent-day files (including the user's 11:23 dictation).
    text="$("$TRANSCRIBE_BIN" "$audio")" || { warn "transcribe failed (skipping): $audio"; return 1; }
    text="$(printf '%s' "$text" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
    [[ -n "$text" ]] || { warn "empty transcript (skipping): $audio"; return 1; }

    # 3b. suppression check — three-part predicate (F001 2026-07-17).
    #   Predicate 1: MIN_WORDS floor. Catches empty/near-empty captures.
    #   Predicate 2: trimmed-WPS floor on active_duration (silence-trimmed with
    #                percent-of-length cap). Catches silence-hallucinations.
    #   Predicate 3: leading-burst override — first LEAD_WINDOW seconds contain
    #                LEAD_MIN_SPEECH of non-silence + word_count >= LEAD_MIN_WORDS
    #                → recording bypasses predicate 2.
    # A probe failure (ffprobe or ffmpeg binary missing / per-file error) MUST
    # NOT suppress the memo: predicates 2 & 3 disable and MIN_WORDS alone
    # applies. The old `|| echo 0` fallback made wps=0.000 trip min-wps and
    # SILENTLY SUPPRESSED EVERY MEMO whenever a probe was unavailable — never
    # again. FFPROBE_BIN / FFMPEG_BIN are overridable and fall back to PATH.
    local suppress="no" word_count duration wps have_duration="no"
    local active_duration="0" trimmed_wps="0.000" leading_burst_passes="no"
    local total_silence="0" speech_in_lead="0" silences=""
    word_count="$(printf '%s' "$text" | wc -w | tr -d ' ')"

    local ffprobe_bin="${FFPROBE_BIN:-/opt/homebrew/bin/ffprobe}"
    [[ -x "$ffprobe_bin" ]] || ffprobe_bin="$(command -v ffprobe || true)"
    duration=""
    [[ -n "$ffprobe_bin" ]] && duration="$("$ffprobe_bin" -v error -show_entries format=duration -of csv=p=0 "$audio" 2>/dev/null || true)"
    if [[ -n "$duration" ]] && awk -v d="$duration" 'BEGIN { exit !(d > 0) }'; then
        have_duration="yes"
        wps="$(awk -v w="$word_count" -v d="$duration" 'BEGIN { printf "%.3f", w/d }')"
    else
        duration="0"
        wps="0.000"
    fi

    # Predicates 2 & 3 need ffmpeg silencedetect; if it fails, both disable
    # and we drop through to MIN_WORDS-only. Detect once, use twice.
    if [[ "$have_duration" == "yes" ]]; then
        silences="$(detect_silences "$audio" 2>/dev/null || true)"
        total_silence="$(printf '%s\n' "$silences" | awk 'NF==2 { s += ($2 - $1) } END { printf "%.3f", s+0 }')"
        active_duration="$(awk -v d="$duration" -v s="$total_silence" -v pct="$MUSE_SILENCE_TRIM_PCT" '
            BEGIN {
                cap = pct/100.0 * d;
                trim = (s < cap) ? s : cap;
                a = d - trim;
                if (a < 0.001) a = 0.001;
                printf "%.3f", a
            }')"
        trimmed_wps="$(awk -v w="$word_count" -v a="$active_duration" 'BEGIN { printf "%.3f", w/a }')"
        speech_in_lead="$(printf '%s\n' "$silences" | awk -v W="$MUSE_LEAD_WINDOW" '
            NF==2 {
                s = ($1 < 0) ? 0 : $1;
                e = ($2 > W) ? W : $2;
                if (s < W && e > s) sil += (e - s);
            }
            END { r = W - sil; if (r < 0) r = 0; printf "%.3f", r }')"
        if awk -v speech="$speech_in_lead" -v min_speech="$MUSE_LEAD_MIN_SPEECH" \
                -v wc="$word_count" -v min_wc="$MUSE_LEAD_MIN_WORDS" \
                'BEGIN { exit !(speech >= min_speech && wc >= min_wc) }'; then
            leading_burst_passes="yes"
        fi
    fi

    if (( word_count < MUSE_MIN_WORDS )); then
        suppress="min-words"
    elif [[ "$have_duration" == "yes" ]] \
         && [[ "$leading_burst_passes" != "yes" ]] \
         && awk -v twps="$trimmed_wps" -v min="$MUSE_TRIMMED_MIN_WPS" \
                'BEGIN { exit !(twps < min) }'; then
        suppress="trimmed-wps"
    fi

    local title_source="llm"

    # 4. title — skip the LLM call for suppressed items (fixed diagnostic title
    # tells you WHY it was suppressed when browsing the archive)
    local title
    if [[ "$suppress" != "no" ]]; then
        title_source="suppressed"
        if [[ "$suppress" == "min-words" ]]; then
            title="Suppressed $suppress ${word_count}w ${duration%.*}s"
        else
            title="Suppressed $suppress ${word_count}w ${duration%.*}s active=${active_duration%.*}s twps=${trimmed_wps}wps"
        fi
    else
        local raw_title
        # NEVER fatal. The transcript is already in hand at this point; losing
        # it because a decorative label could not be generated is a strictly
        # worse outcome than an imperfect label. See fallback_title.
        if raw_title="$("$ASKAI_BIN" "$TITLE_SYSTEM" "$text" 2>/dev/null)"; then
            title="$(sanitize_title "$raw_title")"
        else
            warn "title derivation failed -- keeping the memo with a transcript-derived title: $audio"
            title=""
        fi
        if [[ -z "$title" ]]; then
            title="$(fallback_title "$text")"
            title_source="transcript"
        fi
    fi

    # 6. sequence letter — date is YYYY-MM-DD, letter disambiguates same-day items
    local captured ymd letter
    captured="$(audio_captured "$audio")"
    ymd="$(ymd_from_captured "$captured")"
    letter="$(next_letter "$ymd" "$MUSE_ITEMS_DIR")"

    # 7. item file — always written; permanent archive under MUSE_ITEMS_DIR
    local item_base="MUSE $ymd $letter $title"
    local item_path="$MUSE_ITEMS_DIR/$item_base.md"
    log "writing item: $item_base.md"

    {
        printf -- '---\n'
        printf 'source_audio: %s\n' "$audio"
        printf 'captured: %s\n' "$captured"
        printf 'audio_sha256: %s\n' "$sha"
        printf 'state: %s\n' "$([[ "$suppress" != "no" ]] && echo "suppressed-$suppress" || echo "unreviewed")"
        printf 'title_source: %s\n' "$title_source"
        printf 'word_count: %s\n' "$word_count"
        printf 'audio_duration_s: %s\n' "$duration"
        printf 'words_per_second: %s\n' "$wps"
        printf 'active_duration_s: %s\n' "$active_duration"
        printf 'trimmed_wps: %s\n' "$trimmed_wps"
        printf -- '---\n\n'
        printf '%s\n' "$text"
    } > "$item_path"

    # 9. record hash — happens for BOTH suppressed and normal items so the
    # sweep doesn't reprocess. Suppression only affects downstream visibility.
    # F252 F3 — size is recorded between sha and path so a later size change
    # (partial-file completion) is detectable; path stays the LAST field so the
    # sha-prefix grep and exact-path lookup both keep working.
    printf '%s %s %s\n' "$sha" "$size" "$audio" >> "$hashfile"

    # URL-encode spaces in the Markdown link href (Obsidian cuts markdown
    # link URLs at the first bare space, which points every link at MUSE)
    local url_encoded="${item_base// /%20}.md"

    if [[ "$suppress" != "no" ]]; then
        # Log — MUSE audit trail is complete, includes suppressed items.
        # Quick — skipped (suppression exists precisely to hide these).
        # Notification — skipped.
        log "SUPPRESSED ($suppress ${word_count}w ${wps}wps): $item_base"
        insert_log_bullet "$MUSE_LOG_FILE" "$captured" "- $captured  [$title]($url_encoded)"
        return 0
    fi

    # 10. Prepend to two targets:
    #  - Quick: bare bullet (inline raw text if short, else linked title).
    #    No date/time — user's daily pane stays lean.
    #  - Log: dated link — MUSE's complete archive index.
    local text_len=${#text}
    local bullet
    if (( text_len <= MUSE_INLINE_MAX_CHARS )); then
        local inline
        inline="$(printf '%s' "$text" | tr '\n' ' ')"
        bullet="- $inline"
    else
        bullet="- [$title]($url_encoded)"
    fi
    prepend_line      "$MUSE_QUICK_FILE" "$bullet"
    insert_log_bullet "$MUSE_LOG_FILE" "$captured" "- $captured  [$title]($url_encoded)"

    # 11. notify
    notify "MUSE $ymd $letter: $title"
    log "OK $item_base"
}

# Wait until a file's size is stable (not still uploading / mid-materialize).
# Observed 2026-07-14: the launchd sweep picked up a JPR .m4a that iCloud was
# still incrementally materializing (grew from ~200 KB → 10.5 MB during
# processing). Result: SHA computed on a partial file didn't match the SHA
# computed on the final file → same recording ingested twice with two hashfile
# entries and two item files. Wait for two consecutive stat calls to agree on
# size before proceeding. Returns 0 on stable, 1 if it never stabilizes within
# the ~30s window (6 stats, 5s apart).
file_stable() {
    local f="$1" prev="" curr=""
    for _ in 1 2 3 4 5 6; do
        curr="$(stat -f '%z' "$f" 2>/dev/null)" || return 1
        if [[ -n "$prev" && "$curr" == "$prev" && "$curr" != "0" ]]; then
            return 0
        fi
        prev="$curr"
        sleep 5
    done
    return 1
}

# Scan MUSE_JPR_DIR for .m4a files not yet in .muse.hashes and ingest each.
# Concurrency: the shared lock (acquire_lock, F2) serialises sweeps AND manual
# ingests. The sweep grabs it once with `skip` semantics (a later launchd pass
# retries) and holds it across the whole loop; ingest_one sees it already owned
# and does not re-acquire.
ingest_sweep() {
    [[ -d "$MUSE_JPR_DIR" ]] || die "JPR dir not found: $MUSE_JPR_DIR"

    mkdir -p "$MUSE_ITEMS_DIR"
    mkdir -p "$(dirname "$MUSE_QUICK_FILE")"
    local hashfile="$MUSE_ITEMS_DIR/.muse.hashes"
    touch "$hashfile"
    local failfile="$MUSE_ITEMS_DIR/.muse.failures"

    # Acquire the shared lock (skip this pass if another sweep/ingest holds it).
    acquire_lock skip || return 0

    # Force iCloud to materialize any pending JPR files before scanning. iCloud
    # drops don't trigger FSEvents reliably (per muse gotcha), and the
    # FileProvider may leave watch-uploaded files as cloud-only placeholders
    # until something asks for them. brctl is a no-op for already-materialized
    # files. Best-effort — ignore errors.
    command -v brctl >/dev/null 2>&1 && brctl download "$MUSE_JPR_DIR" 2>/dev/null || true

    # Instrumented: log find visibility (helps diagnose TCC / iCloud-materialization
    # differences between launchd and interactive contexts). If found_count is
    # lower under launchd than an interactive shell, the launchd agent needs FDA
    # or the iCloud FileProvider is not exposing the same directory listing.
    #
    # Sort by path so oldest recordings process first — JPR names files
    # YYYY-MM-DD/HH-MM-SS.m4a which sorts lexicographic == chronological.
    # This matters for Quick.md ordering: muse always PREPENDS new bullets,
    # so processing oldest-first leaves newest at the TOP naturally. Observed
    # 2026-07-14: out-of-order sweep put a 9:48 bullet above an 11:23 bullet.
    local candidate count=0 found_count=0 csize fc fs
    while IFS= read -r candidate; do
        [[ -z "$candidate" ]] && continue
        found_count=$((found_count + 1))
        csize="$(stat -f '%z' "$candidate" 2>/dev/null || echo 0)"
        # Fast pre-check by EXACT path (F8a) so sweep skips known files without
        # hashing — BUT only when the recorded size matches (or is legacy): a
        # size change means a partial-file completion (F3), so let it through to
        # ingest_one for re-processing. ingest_one is still authoritative.
        local rec
        if rec="$(_recorded_size "$hashfile" "$candidate")"; then
            if [[ "$rec" == "LEGACY" || "$rec" == "$csize" ]]; then
                continue
            fi
        fi
        # F8c — skip a file that failed the last MUSE_MAX_FAILURES sweeps at the
        # same size (a size change resets the counter via _failure_bump).
        read -r fc fs <<< "$(_failure_get "$failfile" "$candidate")"
        if (( fc >= MUSE_MAX_FAILURES )) && [[ "$fs" == "$csize" ]]; then
            log "sweep: skipping repeatedly-failing file ($fc fails): $candidate"
            continue
        fi
        # Wait for iCloud materialization to finish before hashing/transcribing.
        if ! file_stable "$candidate"; then
            warn "size unstable after ~30s (still uploading?) — skipping: $candidate"
            continue
        fi
        if ingest_one "$candidate"; then
            count=$((count + 1))
            _failure_clear "$failfile" "$candidate"
        else
            warn "ingest failed: $candidate"
            _failure_bump "$failfile" "$candidate" "$csize"
        fi
    done < <(find "$MUSE_JPR_DIR" -type f -iname '*.m4a' 2>>/tmp/muse-find-stderr.log | sort)

    log "sweep: find returned $found_count candidates; ingested $count new"
    if [[ -s /tmp/muse-find-stderr.log ]]; then
        log "find stderr: $(tr '\n' '|' < /tmp/muse-find-stderr.log | head -c 400)"
        : > /tmp/muse-find-stderr.log
    fi
}

do_ingest() {
    require_deps
    if [[ "${1:-}" == "--sweep" ]]; then
        ingest_sweep
    elif [[ -n "${1:-}" ]]; then
        ingest_one "$1"
    else
        die "usage: muse ingest <audio-path> | --sweep"
    fi
}

# Run the CLI dispatch only when executed directly. When the script is `source`d
# (e.g. by the F252 unit-test harness) this guard skips dispatch so the function
# definitions load without running a sweep.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
    ingest)
        shift
        do_ingest "$@"
        ;;
    -h|--help|help|"")
        sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        die "unknown verb: $1 (try: muse ingest ... | muse --help)"
        ;;
esac
fi

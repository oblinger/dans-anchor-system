#!/usr/bin/env bash
# muse — voice-memo pipeline entry point.
#
# Usage:
#   muse ingest <audio-path>   # process one .m4a end-to-end
#   muse ingest --sweep        # scan MUSE_JPR_DIR for unprocessed .m4a
#   muse -h | --help           # show this header
#
# Pipeline (per file):
#   1. Strip quarantine xattr
#   2. Compute audio SHA-256; skip if already in .muse.hashes
#   3. Whisper transcript via ~/bin/_transcribe
#   4. Title derivation via ~/bin/_askAI (tool-less; safe against injection)
#   5. Sanitize title → [A-Za-z0-9 _-]
#   6. Compute daily sequence letter (MMDD A/B/C ... by same-day count)
#   7. Write LST/Quick/MUSE MMDD X <title>.md with frontmatter + transcript
#   8. Prepend bullet to LST/Quick.md
#   9. Record hash in .muse.hashes
#  10. macOS notification
#
# Environment overrides (see SKILL.md § Config):
#   MUSE_QUICK_DIR MUSE_JPR_DIR MUSE_INLINE_MAX_CHARS MUSE_NOTIFICATION_SOUND
#   WHISPER_BIN WHISPER_MODEL FFMPEG_BIN ANTHROPIC_KEY_FILE ASKAI_MODEL

set -euo pipefail

MUSE_ITEMS_DIR="${MUSE_ITEMS_DIR:-$HOME/ob/kmr/Log/MUSE}"
# Two prepend targets (per user direction 2026-07-15):
#   MUSE_QUICK_FILE — user's daily Quick pane. Bare bullet (link or inline
#     text). No date/time — Quick is user-facing and stays lean.
#   MUSE_LOG_FILE  — MUSE's complete archive index. Every ingest lands here
#     including SUPPRESSED ones (which do NOT go to Quick). Date/time
#     prefix so the log doubles as an audit trail.
MUSE_QUICK_FILE="${MUSE_QUICK_FILE:-$HOME/ob/kmr/LST/Quick.md}"
MUSE_LOG_FILE="${MUSE_LOG_FILE:-$HOME/ob/kmr/Log/MUSE/Log Muse.md}"
MUSE_JPR_DIR="${MUSE_JPR_DIR:-$HOME/Library/Mobile Documents/iCloud~com~openplanetsoftware~Just-Press-Record/Documents}"
MUSE_INLINE_MAX_CHARS="${MUSE_INLINE_MAX_CHARS:-80}"
MUSE_NOTIFICATION_SOUND="${MUSE_NOTIFICATION_SOUND:-Tink}"
# Suppression thresholds for accidental / low-content recordings (per user
# 2026-07-14). Suppressed items STILL write the item file + hashfile entry
# (audio history preserved, no reprocessing), they just DON'T get a bullet
# in the Inbox and DON'T fire a notification.
#   - MIN_WORDS: total word count in the transcript.
#     Catches empty / near-empty captures ('Thank you.', a bare '.').
#   - MIN_WPS: overall words-per-second (word_count / audio_duration_s).
#     Catches long silence-hallucination captures like a 10-min coughing
#     recording that produces 46 x 'Thank you.' (92 words / 600 s = 0.15 WPS).
# Legitimate short dictations pass on MIN_WPS (e.g. 'It is 9:48' → ~4 words
# / 6 s = 0.7 WPS). Items fail suppression only if they trip EITHER threshold.
MUSE_MIN_WORDS="${MUSE_MIN_WORDS:-5}"
MUSE_MIN_WPS="${MUSE_MIN_WPS:-0.5}"

TRANSCRIBE_BIN="${TRANSCRIBE_BIN:-$HOME/bin/_transcribe}"
ASKAI_BIN="${ASKAI_BIN:-$HOME/bin/_askAI}"

TITLE_SYSTEM='Give a 3-6 word title for this voice memo. Plain words, no punctuation, no quotes. Only respond with the title itself.'

log()  { printf 'muse: %s\n' "$*"        >&2; }
die()  { printf 'muse: %s\n' "$*"        >&2; exit 1; }
warn() { printf 'muse: warning: %s\n' "$*" >&2; }

require_deps() {
    [[ -x "$TRANSCRIBE_BIN" ]] || die "missing $TRANSCRIBE_BIN — build the _transcribe primitive"
    [[ -x "$ASKAI_BIN"      ]] || die "missing $ASKAI_BIN — build the _askAI primitive"
    command -v shasum   >/dev/null || die "shasum not found"
    command -v osascript >/dev/null || die "osascript not found (macOS only)"
}

sanitize_title() {
    local raw="$1"
    printf '%s' "$raw" \
        | tr -d '\r\n' \
        | tr -c 'A-Za-z0-9 _\-' ' ' \
        | tr -s ' ' \
        | sed -E 's/^ +| +$//g'
}

# From a JPR audio path like .../Documents/YYYY-MM-DD/HH-MM-SS.m4a extract
# the recording date/time. Falls back to file mtime if the path doesn't match.
audio_captured() {
    local audio="$1"
    local dir base ymd hms
    dir="$(dirname "$audio")"
    base="$(basename "$audio")"
    ymd="$(basename "$dir")"
    if [[ "$ymd" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && "$base" =~ ^([0-9]{2})-([0-9]{2})-([0-9]{2})\.[Mm]4[Aa]$ ]]; then
        hms="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
        printf '%s %s' "$ymd" "$hms"
        return
    fi
    # fallback: file mtime
    stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$audio"
}

# Given "YYYY-MM-DD HH:MM:SS" return "YYYY-MM-DD".
ymd_from_captured() {
    local captured="$1"
    printf '%s' "${captured%% *}"
}

# Compute next daily letter given YYYY-MM-DD and the items dir.
# Scans existing filenames for used single-letter tokens (A-Z) and returns
# max_used+1 — NOT the file count. Count-based assignment collides if any
# earlier item was deleted (observed 2026-07-14: after deleting a mid-day
# item and re-ingesting, count matched an existing later letter → two files
# with the same letter, breaking Obsidian's basename-resolution for links).
next_letter() {
    local ymd="$1"
    local items_dir="$2"
    local max_letter=""
    while IFS= read -r used; do
        [[ -z "$used" ]] && continue
        [[ -z "$max_letter" || "$used" > "$max_letter" ]] && max_letter="$used"
    done < <(find "$items_dir" -maxdepth 1 -type f -name "MUSE $ymd ?*.md" 2>/dev/null \
        | sed -nE "s|.*/MUSE ${ymd} ([A-Z]) .*|\1|p")
    if [[ -z "$max_letter" ]]; then
        printf 'A'
        return
    fi
    if [[ "$max_letter" < "Z" ]]; then
        local ord next_ord
        ord=$(printf '%d' "'$max_letter")
        next_ord=$((ord + 1))
        printf '%b' "$(printf '\\%03o' "$next_ord")"
    else
        # Past Z — AA, AB, ... for the unlikely >26-per-day case. Same
        # count-based fallback as the original code (past-Z collisions
        # weren't observed in the deletion-based repro).
        local count n first second f s
        count=$(find "$items_dir" -maxdepth 1 -type f -name "MUSE $ymd *.md" 2>/dev/null | wc -l | tr -d ' ')
        n=$((count - 26))
        first=$((n / 26))
        second=$((n % 26))
        f="$(printf '\\%03o' $((65 + first)))"
        s="$(printf '\\%03o' $((65 + second)))"
        printf '%b%b' "$f" "$s"
    fi
}

sha256_of() {
    shasum -a 256 "$1" | awk '{print $1}'
}

# Prepend a bullet to the top of a target file (creates the file with a bare
# header if it doesn't exist). Used for Quick.md — a bare bullet list with no
# frontmatter or H1.
prepend_line() {
    local target="$1"
    local line="$2"
    local tmp
    tmp="$(mktemp)"
    if [[ -f "$target" ]]; then
        printf '%s\n' "$line" > "$tmp"
        cat "$target" >> "$tmp"
    else
        printf '%s\n' "$line" > "$tmp"
    fi
    mv "$tmp" "$target"
}

# Insert a bullet at the top of the bullet list in a STRUCTURED log file
# (frontmatter → H1 → orientation → blank → bullets). Used for MUSE_LOG_FILE.
# Insertion strategy: before the first existing `- ` bullet; if no bullets
# yet, append at end. If the file doesn't exist, create it with the canonical
# MUSE log header first.
prepend_log_bullet() {
    local target="$1"
    local line="$2"
    local tmp
    tmp="$(mktemp)"
    if [[ ! -f "$target" ]]; then
        cat > "$target" <<'EOF'
---
description: MUSE ingest log — every recording listed with capture time, newest first.
---
# Log Muse

Complete audit trail of every MUSE ingest; suppressed items appear here too.

EOF
    fi
    awk -v new="$line" '
        !inserted && /^- / { print new; inserted = 1 }
        { print }
        END { if (!inserted) print new }
    ' "$target" > "$tmp"
    mv "$tmp" "$target"
}

notify() {
    local msg="$1"
    osascript -e "display notification \"$msg\" with title \"MUSE\" sound name \"$MUSE_NOTIFICATION_SOUND\"" 2>/dev/null || true
}

# Ingest a single audio file. Prints nothing to stdout on success; logs to
# stderr; sends a notification.
ingest_one() {
    local audio="$1"

    # Per-file failure must NOT kill the whole sweep (die → exit 1 would abort
    # every remaining candidate; the sweep loop's `|| warn` cannot catch an
    # exit). Return non-zero so the loop continues — matches the transcribe /
    # empty-transcript per-file contract below.
    [[ -f "$audio" ]] || { warn "audio file not found (skipping): $audio"; return 1; }

    mkdir -p "$MUSE_ITEMS_DIR"
    mkdir -p "$(dirname "$MUSE_QUICK_FILE")"
    local hashfile="$MUSE_ITEMS_DIR/.muse.hashes"

    # 1. quarantine
    xattr -d com.apple.quarantine "$audio" 2>/dev/null || true

    # 2. dedup — PATH-based (primary) + SHA-based (secondary).
    #
    # iCloud FileProvider re-materializes .m4a files with different container
    # metadata but identical audio, so the SHA changes without any actual
    # re-recording (verified 2026-07-12: 07-09/17-01-56.m4a came back with a
    # new SHA but a byte-identical whisper transcript). Path-check catches the
    # common case (each JPR HH-MM-SS.m4a filename is globally unique — same
    # path always means same recording). SHA-check remains as a fallback for
    # the edge case of the same audio arriving under a different path.
    local sha
    sha="$(sha256_of "$audio")"
    if [[ -f "$hashfile" ]] && grep -Fq -- " $audio" "$hashfile" 2>/dev/null; then
        log "SKIP already ingested (path): $audio"
        return 0
    fi
    if [[ -f "$hashfile" ]] && grep -q "^$sha " "$hashfile" 2>/dev/null; then
        # SHA collision at a DIFFERENT path. JPR filenames are globally unique,
        # so this shouldn't happen from real distinct recordings — but it does
        # (observed 2026-07-14: 23-05-30.m4a silently swallowed by an earlier
        # file's SHA). Log the collision twin for diagnosis and PROCEED — a
        # real recording must never disappear. If both are genuine same-audio
        # duplicates the user can dedup the resulting items manually.
        local twin
        twin="$(grep "^$sha " "$hashfile" | head -1 | cut -d' ' -f2-)"
        warn "SHA-collision (different path) — proceeding: this=$audio twin=$twin"
    fi

    # 3. transcribe
    log "transcribing: $audio"
    local text
    # Per-file failures must NOT kill the whole sweep. Return non-zero so the
    # sweep loop's `|| warn "ingest failed: $candidate"` sees the failure and
    # continues to the next file. `die` (which does exit 1) would kill the
    # entire sweep — observed 2026-07-14 where a single iCloud-EDEADLK-stuck
    # file blocked 160 consecutive launchd sweep runs from processing
    # subsequent-day files (including the user's 11:23 dictation).
    text="$("$TRANSCRIBE_BIN" "$audio")" || { warn "transcribe failed (skipping): $audio"; return 1; }
    text="$(printf '%s' "$text" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
    [[ -n "$text" ]] || { warn "empty transcript (skipping): $audio"; return 1; }

    # 3b. suppression check — accidental / low-content recordings still get an
    # item file (audio history preserved, hashfile entry blocks reprocessing)
    # but DON'T get an Inbox bullet or notification. Two thresholds:
    #   - MUSE_MIN_WORDS: total word count. Catches empty/near-empty captures.
    #   - MUSE_MIN_WPS: overall words-per-second (needs ffprobe). Catches long
    #     silence-hallucination captures ('Thank you.' x 46 over 10 min).
    local suppress="no" word_count duration wps have_duration="no"
    word_count="$(printf '%s' "$text" | wc -w | tr -d ' ')"
    # ffprobe gives audio duration for the WPS silence-hallucination check ONLY.
    # A probe failure (binary missing, wrong-arch path, per-file error) must NOT
    # suppress the memo: when duration is unavailable we skip the WPS test
    # entirely (min-words still applies). The old `|| echo 0` fallback made
    # wps=0.000 trip min-wps and SILENTLY SUPPRESSED EVERY MEMO whenever ffprobe
    # was unavailable — a silent-fallback bug. FFPROBE_BIN is overridable and
    # falls back to whatever `ffprobe` is on PATH (not the hardcoded brew path).
    local ffprobe_bin="${FFPROBE_BIN:-/opt/homebrew/bin/ffprobe}"
    [[ -x "$ffprobe_bin" ]] || ffprobe_bin="$(command -v ffprobe || true)"
    duration=""
    [[ -n "$ffprobe_bin" ]] && duration="$("$ffprobe_bin" -v error -show_entries format=duration -of csv=p=0 "$audio" 2>/dev/null || true)"
    if [[ -n "$duration" ]] && awk -v d="$duration" 'BEGIN { exit !(d > 0) }'; then
        have_duration="yes"
        wps="$(awk -v w="$word_count" -v d="$duration" 'BEGIN { printf "%.3f", w/d }')"
    else
        duration="0"
        wps="0.000"
    fi
    if (( word_count < MUSE_MIN_WORDS )); then
        suppress="min-words"
    elif [[ "$have_duration" == "yes" ]] && awk -v wps="$wps" -v min="$MUSE_MIN_WPS" 'BEGIN { exit !(wps < min) }'; then
        suppress="min-wps"
    fi

    # 4. title — skip the LLM call for suppressed items (fixed diagnostic title
    # tells you WHY it was suppressed when browsing the archive)
    local title
    if [[ "$suppress" != "no" ]]; then
        title="Suppressed $suppress ${word_count}w ${duration%.*}s ${wps}wps"
    else
        local raw_title
        raw_title="$("$ASKAI_BIN" "$TITLE_SYSTEM" "$text")" || { warn "title derivation failed (skipping): $audio"; return 1; }
        title="$(sanitize_title "$raw_title")"
        [[ -n "$title" ]] || title="Untitled"
    fi

    # 6. sequence letter — date is YYYY-MM-DD, letter disambiguates same-day items
    local captured ymd letter
    captured="$(audio_captured "$audio")"
    ymd="$(ymd_from_captured "$captured")"
    letter="$(next_letter "$ymd" "$MUSE_ITEMS_DIR")"

    # 7. item file — always written; permanent archive under MUSE_ITEMS_DIR
    local item_base="MUSE $ymd $letter $title"
    local item_path="$MUSE_ITEMS_DIR/$item_base.md"
    log "writing item: $item_base.md"

    {
        printf -- '---\n'
        printf 'source_audio: %s\n' "$audio"
        printf 'captured: %s\n' "$captured"
        printf 'audio_sha256: %s\n' "$sha"
        printf 'state: %s\n' "$([[ "$suppress" != "no" ]] && echo "suppressed-$suppress" || echo "unreviewed")"
        printf 'word_count: %s\n' "$word_count"
        printf 'audio_duration_s: %s\n' "$duration"
        printf 'words_per_second: %s\n' "$wps"
        printf -- '---\n\n'
        printf '%s\n' "$text"
    } > "$item_path"

    # 9. record hash — happens for BOTH suppressed and normal items so the
    # sweep doesn't reprocess. Suppression only affects downstream visibility.
    printf '%s %s\n' "$sha" "$audio" >> "$hashfile"

    # URL-encode spaces in the Markdown link href (Obsidian cuts markdown
    # link URLs at the first bare space, which points every link at MUSE)
    local url_encoded="${item_base// /%20}.md"

    if [[ "$suppress" != "no" ]]; then
        # Log — MUSE audit trail is complete, includes suppressed items.
        # Quick — skipped (suppression exists precisely to hide these).
        # Notification — skipped.
        log "SUPPRESSED ($suppress ${word_count}w ${wps}wps): $item_base"
        prepend_log_bullet "$MUSE_LOG_FILE" "- $captured  [$title]($url_encoded)"
        return 0
    fi

    # 10. Prepend to two targets:
    #  - Quick: bare bullet (inline raw text if short, else linked title).
    #    No date/time — user's daily pane stays lean.
    #  - Log: dated link — MUSE's complete archive index.
    local text_len=${#text}
    local bullet
    if (( text_len <= MUSE_INLINE_MAX_CHARS )); then
        local inline
        inline="$(printf '%s' "$text" | tr '\n' ' ')"
        bullet="- $inline"
    else
        bullet="- [$title]($url_encoded)"
    fi
    prepend_line       "$MUSE_QUICK_FILE" "$bullet"
    prepend_log_bullet "$MUSE_LOG_FILE"   "- $captured  [$title]($url_encoded)"

    # 11. notify
    notify "MUSE $ymd $letter: $title"
    log "OK $item_base"
}

# Wait until a file's size is stable (not still uploading / mid-materialize).
# Observed 2026-07-14: the launchd sweep picked up a JPR .m4a that iCloud was
# still incrementally materializing (grew from ~200 KB → 10.5 MB during
# processing). Result: SHA computed on a partial file didn't match the SHA
# computed on the final file → same recording ingested twice with two hashfile
# entries and two item files. Wait for two consecutive stat calls to agree on
# size before proceeding. Returns 0 on stable, 1 if it never stabilizes within
# the ~30s window (6 stats, 5s apart).
file_stable() {
    local f="$1" prev="" curr=""
    for _ in 1 2 3 4 5 6; do
        curr="$(stat -f '%z' "$f" 2>/dev/null)" || return 1
        if [[ -n "$prev" && "$curr" == "$prev" && "$curr" != "0" ]]; then
            return 0
        fi
        prev="$curr"
        sleep 5
    done
    return 1
}

# Scan MUSE_JPR_DIR for .m4a files not yet in .muse.hashes and ingest each.
# Concurrency: a mkdir-based lock (below) prevents two overlapping SWEEPS from
# racing (observed 2026-07-14 producing duplicate item files). NOTE: a manual
# `muse ingest <path>` does NOT take this lock, so a manual ingest running
# concurrently with a sweep can still double-process a file / collide on the
# daily letter — tracked as an F252 finding for a proper both-paths lock.
ingest_sweep() {
    [[ -d "$MUSE_JPR_DIR" ]] || die "JPR dir not found: $MUSE_JPR_DIR"

    mkdir -p "$MUSE_ITEMS_DIR"
    mkdir -p "$(dirname "$MUSE_QUICK_FILE")"
    local hashfile="$MUSE_ITEMS_DIR/.muse.hashes"
    touch "$hashfile"

    # Concurrency lock via mkdir (macOS lacks a native flock). If another muse
    # sweep is running, skip this pass rather than racing. Use a global (not
    # local) so the EXIT trap can still see the var name under `set -u`.
    MUSE_SWEEP_LOCKDIR="$MUSE_ITEMS_DIR/.muse.sweep.lock"
    if ! mkdir "$MUSE_SWEEP_LOCKDIR" 2>/dev/null; then
        # Lock exists. Decide: owner alive, or STALE? A sweep killed without
        # running its EXIT trap (launchd-timeout SIGKILL, reboot, or power loss
        # mid-sweep) leaves the lockdir behind. It lives in the vault and
        # survives reboot, so without reclamation a single stale lock wedges
        # ALL future sweeps forever — every memo silently unprocessed. Reclaim
        # when the recorded PID is dead, or (no readable PID) when the lock is
        # older than the ceiling.
        local lock_pid lock_stale="no"
        lock_pid="$(cat "$MUSE_SWEEP_LOCKDIR/pid" 2>/dev/null || true)"
        if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
            lock_stale="no"
        elif [[ -n "$lock_pid" ]]; then
            lock_stale="yes"
        else
            local lock_mtime now
            lock_mtime="$(stat -f %m "$MUSE_SWEEP_LOCKDIR" 2>/dev/null || echo 0)"
            now="$(date +%s)"
            (( now - lock_mtime > 1800 )) && lock_stale="yes"
        fi
        if [[ "$lock_stale" != "yes" ]]; then
            log "sweep: another sweep is running (pid ${lock_pid:-unknown}) — skipping"
            return 0
        fi
        warn "sweep: reclaiming stale lock (owner ${lock_pid:-unknown} gone)"
        rm -rf "$MUSE_SWEEP_LOCKDIR"
        if ! mkdir "$MUSE_SWEEP_LOCKDIR" 2>/dev/null; then
            log "sweep: lost stale-lock race — skipping"
            return 0
        fi
    fi
    printf '%s\n' "$$" > "$MUSE_SWEEP_LOCKDIR/pid"
    trap 'rm -rf "${MUSE_SWEEP_LOCKDIR:-/nonexistent}" 2>/dev/null || true' EXIT

    # Force iCloud to materialize any pending JPR files before scanning. iCloud
    # drops don't trigger FSEvents reliably (per muse gotcha), and the
    # FileProvider may leave watch-uploaded files as cloud-only placeholders
    # until something asks for them. brctl is a no-op for already-materialized
    # files. Best-effort — ignore errors.
    command -v brctl >/dev/null 2>&1 && brctl download "$MUSE_JPR_DIR" 2>/dev/null || true

    # Instrumented: log find visibility (helps diagnose TCC / iCloud-materialization
    # differences between launchd and interactive contexts). If found_count is
    # lower under launchd than an interactive shell, the launchd agent needs FDA
    # or the iCloud FileProvider is not exposing the same directory listing.
    #
    # Sort by path so oldest recordings process first — JPR names files
    # YYYY-MM-DD/HH-MM-SS.m4a which sorts lexicographic == chronological.
    # This matters for Quick.md ordering: muse always PREPENDS new bullets,
    # so processing oldest-first leaves newest at the TOP naturally. Observed
    # 2026-07-14: out-of-order sweep put a 9:48 bullet above an 11:23 bullet.
    local candidate count=0 found_count=0
    while IFS= read -r candidate; do
        [[ -z "$candidate" ]] && continue
        found_count=$((found_count + 1))
        # Fast pre-check by path so sweep skips known files without hashing.
        # ingest_one still SHA-checks as a fallback.
        if grep -Fq -- " $candidate" "$hashfile"; then
            continue
        fi
        # Wait for iCloud materialization to finish before hashing/transcribing.
        if ! file_stable "$candidate"; then
            warn "size unstable after ~30s (still uploading?) — skipping: $candidate"
            continue
        fi
        ingest_one "$candidate" && count=$((count + 1)) || warn "ingest failed: $candidate"
    done < <(find "$MUSE_JPR_DIR" -type f -iname '*.m4a' 2>>/tmp/muse-find-stderr.log | sort)

    log "sweep: find returned $found_count candidates; ingested $count new"
    if [[ -s /tmp/muse-find-stderr.log ]]; then
        log "find stderr: $(tr '\n' '|' < /tmp/muse-find-stderr.log | head -c 400)"
        : > /tmp/muse-find-stderr.log
    fi
}

do_ingest() {
    require_deps
    if [[ "${1:-}" == "--sweep" ]]; then
        ingest_sweep
    elif [[ -n "${1:-}" ]]; then
        ingest_one "$1"
    else
        die "usage: muse ingest <audio-path> | --sweep"
    fi
}

case "${1:-}" in
    ingest)
        shift
        do_ingest "$@"
        ;;
    -h|--help|help|"")
        sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        die "unknown verb: $1 (try: muse ingest ... | muse --help)"
        ;;
esac

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oblinger.muse-ingest</string>

    <!-- Direct-exec of the DAS Trust.app bundle's executable. macOS TCC walks
         the parent chain to find Contents/Info.plist and applies the bundle
         identity (com.oblinger.das.trust, Developer-ID-signed, Team ID
         7M5VK5V43M) as the process's TCC identity. The user's FDA grant on
         DAS Trust.app is bound to that Team ID + designated requirement, so
         it persists across re-signs of the same bundle. See
         .../dans-anchor-system/host/README.md. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/oblinger/ob/kmr/SYS/Bespoke/Skill Agent/dans-anchor-system/host/DAS Trust.app/Contents/MacOS/DAS-Trust</string>
        <string>muse</string>
        <string>ingest</string>
        <string>--sweep</string>
    </array>

    <!-- WatchPaths often misses iCloud FileProvider drops (the OS materializes
         downloaded files without firing FSEvents). StartInterval is the
         backstop — worst-case 5-minute lag from watch dictation to Quick.md. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/oblinger/Library/Mobile Documents/iCloud~com~openplanetsoftware~Just-Press-Record/Documents</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/oblinger/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/oblinger</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/oblinger/Library/Logs/muse-ingest.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/oblinger/Library/Logs/muse-ingest.log</string>
</dict>
</plist>

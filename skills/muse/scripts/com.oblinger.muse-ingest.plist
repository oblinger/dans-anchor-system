<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oblinger.muse-ingest</string>

    <!-- Direct-exec of the muse skill script (shebang is /bin/bash → macOS
         TCC treats the process's identity as /bin/bash). Full Disk Access
         is granted at the /bin/bash level in
         System Settings > Privacy & Security > Full Disk Access. This is
         the vanilla path — no build/sign/notarize toolchain required.
         Trade-off: broad blast-radius (any bash process on this account
         gets FDA); acceptable on a personal machine. The signed-.app-bundle
         path is a legit alternative but requires a compiled launcher —
         shell scripts inside a bundle do NOT inherit bundle TCC identity
         even when the bundle is Developer-ID-signed + notarized + stapled. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/oblinger/.claude/skills/muse/scripts/muse</string>
        <string>ingest</string>
        <string>--sweep</string>
    </array>

    <!-- WatchPaths often misses iCloud FileProvider drops (the OS materializes
         downloaded files without firing FSEvents). StartInterval is the
         backstop — worst-case 5-minute lag from watch dictation to Quick.md. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/oblinger/Library/Mobile Documents/iCloud~com~openplanetsoftware~Just-Press-Record/Documents</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/oblinger/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/oblinger</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/oblinger/Library/Logs/muse-ingest.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/oblinger/Library/Logs/muse-ingest.log</string>
</dict>
</plist>

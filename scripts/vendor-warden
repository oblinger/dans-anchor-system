#!/bin/bash
# vendor-warden — copy the Warden engine from its source repo into dans-anchor-system.
#
# Warden's live source lives at ~/ob/proj/warden (T008 extraction, 2026-07-13).
# dans-anchor-system carries a vendored copy of engine/, rs/, and Warden Corpus/
# so the published repo is self-contained. The dependency is one-directional
# (Warden never imports from dans-anchor-system code), so a plain rsync at
# publish time is the whole mechanism — no subtree, no two-way merge.
#
# Run from anywhere. The W2 stale-path self-check in warden itself surfaces
# any drift between the vendored copy and the installed live engine.

set -euo pipefail

SRC="${WARDEN_SRC:-$HOME/ob/proj/warden}"
DST="$(cd "$(dirname "$0")/.." && pwd)/warden"

[ -d "$SRC/engine" ] || { echo "vendor-warden: no engine/ under $SRC" >&2; exit 1; }

for part in engine rs "Warden Corpus"; do
    rsync -a --delete \
        --exclude 'target/' \
        --exclude '__pycache__/' \
        --exclude '*.pyc' \
        --exclude '.git/' \
        --exclude '.DS_Store' \
        "$SRC/$part/" "$DST/$part/"
done

echo "vendor-warden: synced engine/, rs/, Warden Corpus/  ($SRC → $DST)"

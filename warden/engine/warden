#!/usr/bin/env python3
"""`warden` — the Warden control CLI (F220).

    warden status              show enabled/disabled, compiled state, install state
    warden on | off            toggle the global kill switch (~/.warden/DISABLED)
    warden compile             scan + compile the rule corpus → ~/.warden/
    warden install             compile, then register the hook in settings.json
                               (--rust registers the warden-rs binary — F213 phase 2)
    warden uninstall           remove Warden's hook entries from settings.json
    warden fire  ANCHOR MOMENT manually fire one moment against an anchor (debug)
    warden log [-n N] [--moment M] [--anchor A] [--rule R] [--fired] [--full]
                               the fire log (F231): rules considered/fired per
                               moment + the steer text verbatim
    warden daemon start|stop|status   the resident interpreter (F213 phase 2)

The kill switch is a sentinel FILE so a disable is global across every
environment and every concurrent session with no settings edit and no restart —
`warden off` and the very next hook invocation anywhere is a no-op.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from warden_root import corpus_root          # noqa: E402

REPO = corpus_root()                         # …/dans-anchor-system (the rule-corpus root)

import warden_compile as wc      # noqa: E402
import warden_fire as wf         # noqa: E402
import warden_hook as wh         # noqa: E402
import warden_hookgen as hg      # noqa: E402
import warden_scan as ws         # noqa: E402

# shlex.quote the path — the repo path contains a space ("Skill Agent"), and an
# unquoted hook command splits on it (the live test caught this: a broken command
# never launches Python, so it BLOCKS instead of failing safe). Quote it.
HOOK_CMD = "python3 " + shlex.quote(str(HERE / "warden_hook.py"))
# F213 phase 2: the Rust dispatcher + the resident-interpreter spawn command.
RUST_BIN = HERE.parent / "rs" / "target" / "release" / "warden-rs"
RUST_HOOK_CMD = shlex.quote(str(RUST_BIN)) + " hook"
DAEMON_CMD = ("python3 " + shlex.quote(str(HERE / "warden_daemon.py")) + " --serve")

# The installed hook surface. Each entry: (event, matcher-or-None).
# PreToolUse Bash|Edit|Write is the F131 veto surface — without it the
# `deny` rules (R-pathguard, R-ob-remote-ops) compile but never fire in a
# real session (gap found by the 2026-07-06 arch/process adoption audit).
PILOT_HOOKS = [
    ("SessionStart", None),
    ("UserPromptSubmit", None),
    ("PostToolUse", "Write|Edit"),
    ("PreToolUse", "Skill"),
    ("PreToolUse", "Bash|Edit|Write"),
]


def warden_home() -> Path:
    home = wh.warden_home()
    home.mkdir(parents=True, exist_ok=True)
    return home


# ── kill switch ──────────────────────────────────────────────────────────────

def cmd_on(_args) -> int:
    sentinel = warden_home() / "DISABLED"
    sentinel.unlink(missing_ok=True)
    print("warden: ENABLED (kill switch cleared)")
    return 0


def cmd_off(_args) -> int:
    (warden_home() / "DISABLED").write_text("disabled by `warden off`\n", encoding="utf-8")
    print("warden: DISABLED (global kill switch set — every session no-ops)")
    return 0


# ── compile ──────────────────────────────────────────────────────────────────

def _compile_corpus(root: Path, out: Path) -> dict:
    """Fresh scan + compile of `root` → out/rules-ir.json + out/rules_all.py."""
    files, seen, _ = ws.build_index(str(root), {}, {}, rescan=True)
    source_hash = ws.index_hash(files)
    index = {"root": str(root), "files": files, "seen": seen}
    ir, module_src, stats = wc.compile_corpus(root, index, "all", source_hash)
    wc._write_artifacts(out, "all", ir, module_src)
    return stats


def _write_daemon_cmd(out: Path) -> None:
    """The spawn command `warden-rs hook` uses to launch the resident
    interpreter on demand (F213 phase 2)."""
    (out / "daemon.cmd").write_text(DAEMON_CMD + "\n", encoding="utf-8")


def _installed_warden_events(settings: dict) -> dict:
    """{hook event: set of matcher tools} for entries invoking Warden; a
    matcher-less entry contributes `'*'` (all tools)."""
    out: dict = {}
    for ev, entries in (settings.get("hooks") or {}).items():
        for e in entries:
            if not any("warden" in h.get("command", "")
                       for h in e.get("hooks", [])):
                continue
            m = e.get("matcher")
            tools = out.setdefault(ev, set())
            if not m or m == "*":
                tools.add("*")
            else:
                tools.update(t for t in m.split("|") if t)
    return out


def _moment_deliverable(moment: str, ev: dict) -> bool:
    """Can the installed hook surface deliver this compiled moment? Mirrors
    warden_hook.event_to_moments (the F232 D2 drift check)."""
    def has(event, tool):
        ts = ev.get(event, set())
        return "*" in ts or tool in ts
    if moment.startswith("skill:pre"):
        return has("PreToolUse", "Skill")
    if moment.startswith(("tool:pre", "tool:post")):
        event = "PreToolUse" if moment.startswith("tool:pre") else "PostToolUse"
        parts = moment.split(":")
        return has(event, parts[2]) if len(parts) >= 3 else bool(ev.get(event))
    if moment.startswith(("write:", "read:")):
        return has("PostToolUse", "Write") or has("PostToolUse", "Edit")
    if moment == "session:start":
        return "SessionStart" in ev
    if moment in ("session:stop", "prompt:stop"):
        return "Stop" in ev
    if moment == "session:compact":
        return "PreCompact" in ev
    if moment == "prompt:submit":
        return "UserPromptSubmit" in ev
    return False   # git:/timer: — no live hook surface in v1


def _warn_undeliverable(out: Path) -> None:
    """F232 D2: warn when a compiled `when::` moment has no installed hook to
    deliver it — the class of gap that hid the F131 veto surface for a day."""
    try:
        ir = json.loads((out / "rules-ir.json").read_text(encoding="utf-8"))
        settings = json.loads(
            (Path.home() / ".claude" / "settings.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    ev = _installed_warden_events(settings)
    if not ev:
        print("warden: WARNING — no Warden hooks installed; compiled moments "
              "will not fire until `warden install`", file=sys.stderr)
        return
    for m in sorted(ir.get("moments", {})):
        if not _moment_deliverable(m, ev):
            n = len(ir["moments"][m])
            print(f"warden: WARNING — moment '{m}' ({n} rule(s)) has no "
                  "installed hook to deliver it — re-run `warden install`",
                  file=sys.stderr)


def _generate_hooks(out: Path) -> None:
    """F299 hook fan-in: derive the hook manifest from `# warden-hook:`
    declarations plus the user's `config.yaml` `hooks:` block, and generate one
    entrypoint per moment.

    Isolated from the rule compile on purpose. `rules_all.py` is executed by
    every tool call in a live session, so a fault in this much younger stage
    must never be able to abort the write of the artifacts the running session
    depends on — it warns and the compile stands."""
    try:
        stats = hg.generate(out, REPO)
    except Exception as e:  # noqa: BLE001 — never abort a rule compile over hooks
        print(f"warden: WARNING — hook fan-in failed ({type(e).__name__}: {e}); "
              "rules compiled, hook entrypoints unchanged", file=sys.stderr)
        return
    for w in stats["warnings"]:
        print(f"warden: WARNING — hook declaration: {w}", file=sys.stderr)
    print(f"warden: {stats['hooks']} hook(s) across {stats['moments']} moment(s) "
          f"→ {stats['manifest'].name}")


def cmd_compile(_args) -> int:
    out = warden_home()
    stats = _compile_corpus(REPO, out)
    _write_daemon_cmd(out)
    print(f"warden: compiled {stats['rules']} rules from {stats['rulesets']} rulesets "
          f"/ {stats['files']} files — {stats['moments']} moment(s), "
          f"{stats['doc_rules']} doc-rule(s), {stats['py_rules']} python → {out}")
    _generate_hooks(out)
    _warn_undeliverable(out)
    return 0


# ── settings.json install / uninstall ────────────────────────────────────────

def _settings_path(args) -> Path:
    if getattr(args, "settings", None):
        return Path(args.settings).expanduser()
    return Path.home() / ".claude" / "settings.json"


def _load_settings(path: Path) -> dict:
    if path.is_file():
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except ValueError:
            raise SystemExit(f"warden: {path} is not valid JSON — refusing to touch it")
    return {}


def _is_warden_entry(entry: dict) -> bool:
    return any("warden_hook.py" in h.get("command", "") or "warden-rs" in h.get("command", "")
               for h in entry.get("hooks", []))


def cmd_install(args) -> int:
    # compile first — a live hook with no artifacts is a silent no-op.
    _compile_corpus(REPO, warden_home())
    _write_daemon_cmd(warden_home())
    hook_cmd = HOOK_CMD
    if getattr(args, "rust", False):
        if not RUST_BIN.is_file():
            raise SystemExit(f"warden: no Rust binary at {RUST_BIN} — "
                             f"run `cargo build --release` in warden/rs first")
        hook_cmd = RUST_HOOK_CMD
    path = _settings_path(args)
    path.parent.mkdir(parents=True, exist_ok=True)
    settings = _load_settings(path)
    hooks = settings.setdefault("hooks", {})
    added = 0
    # drop any prior Warden entries first (idempotent re-install) — stripping
    # inside the add loop would delete a just-added sibling when one event
    # carries two Warden matchers (PreToolUse: Skill + the veto surface).
    for event, _ in PILOT_HOOKS:
        arr = hooks.setdefault(event, [])
        arr[:] = [e for e in arr if not _is_warden_entry(e)]
    for event, matcher in PILOT_HOOKS:
        entry: dict = {"hooks": [{"type": "command", "command": hook_cmd}]}
        if matcher:
            entry = {"matcher": matcher, "hooks": entry["hooks"]}
        hooks[event].append(entry)
        added += 1
    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    engine = "rust (warden-rs hook + resident daemon)" if hook_cmd is RUST_HOOK_CMD else "python (warden_hook.py)"
    print(f"warden: installed {added} hook(s) [{engine}] → {path}")
    print(f"        (kill switch: `warden off` · uninstall: `warden uninstall`)")
    return 0


def cmd_uninstall(args) -> int:
    path = _settings_path(args)
    if not path.is_file():
        print(f"warden: no settings at {path} — nothing to remove")
        return 0
    settings = _load_settings(path)
    hooks = settings.get("hooks", {})
    removed = 0
    for event in list(hooks):
        before = len(hooks[event])
        hooks[event][:] = [e for e in hooks[event] if not _is_warden_entry(e)]
        removed += before - len(hooks[event])
        if not hooks[event]:
            del hooks[event]
    if not hooks:
        settings.pop("hooks", None)
    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    print(f"warden: removed {removed} hook entry(ies) from {path}")
    return 0


# ── status ───────────────────────────────────────────────────────────────────

def cmd_status(args) -> int:
    home = warden_home()
    on = not wh.disabled()
    compiled = (home / "rules-ir.json").is_file()
    path = _settings_path(args)
    installed = 0
    if path.is_file():
        try:
            hooks = json.loads(path.read_text(encoding="utf-8")).get("hooks", {})
            installed = sum(1 for arr in hooks.values() for e in arr if _is_warden_entry(e))
        except ValueError:
            installed = -1
    # Audit 2026-07-12 W2: dead absolute-path snapshots (IR root, daemon.cmd
    # script, installed hook commands) after a repo move/rename — the state
    # where every veto/doc-fire silently no-ops. Surface them here loudly.
    stale: list[str] = []
    if compiled:
        try:
            ir = json.loads((home / "rules-ir.json").read_text(encoding="utf-8"))
            stale.extend(wh._stale_paths(ir))
        except (OSError, ValueError):
            pass
    if path.is_file():
        try:
            hooks = json.loads(path.read_text(encoding="utf-8")).get("hooks", {})
            cmds = {h.get("command", "") for arr in hooks.values() for e in arr
                    if _is_warden_entry(e) for h in e.get("hooks", [])}
            for c in sorted(cmds):
                exe = (shlex.split(c) or [""])[0] if c.strip() else ""
                if exe and "/" in exe and not Path(exe).exists():
                    stale.append(f"installed hook command missing: {exe}")
        except ValueError:
            pass
    print(f"warden home : {home}")
    print(f"state       : {'ENABLED' if on else 'DISABLED (kill switch set)'}")
    print(f"compiled    : {'yes' if compiled else 'no — run `warden compile`'}")
    print(f"installed   : {installed} hook(s) in {path}")
    for w in stale:
        print(f"STALE       : {w} — repo moved? run `warden install`")
    return 0


# ── resident daemon (F213 phase 2) ───────────────────────────────────────────

def cmd_daemon(args) -> int:
    import subprocess
    import warden_daemon as wd
    if args.action == "status":
        try:
            resp = wd.request({"op": "ping"}, timeout=2.0)
            print(f"warden daemon: RUNNING (pid {resp.get('pid')})")
        except OSError:
            print("warden daemon: not running")
        return 0
    if args.action == "stop":
        try:
            wd.request({"op": "shutdown"}, timeout=2.0)
            print("warden daemon: stopped")
        except OSError:
            print("warden daemon: not running")
        return 0
    if args.action == "start":
        try:
            resp = wd.request({"op": "ping"}, timeout=2.0)
            print(f"warden daemon: already running (pid {resp.get('pid')})")
            return 0
        except OSError:
            pass
        _write_daemon_cmd(warden_home())
        subprocess.Popen(["/bin/sh", "-c", DAEMON_CMD],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        import time
        for _ in range(40):
            time.sleep(0.1)
            try:
                resp = wd.request({"op": "ping"}, timeout=2.0)
                print(f"warden daemon: started (pid {resp.get('pid')})")
                return 0
            except OSError:
                continue
        print("warden daemon: spawn requested but not accepting — see ~/.warden/hook.log")
        return 1
    return 2


# ── fire log viewer (F231 — the why-did-that-happen log) ────────────────────

def _iter_fire_records(home: Path):
    """Yield fire records oldest-first across the rotation pair."""
    # Oldest generation first, so records come out in time order (T607/F613).
    for name in ("fires.jsonl.2", "fires.jsonl.1", "fires.jsonl"):
        p = home / name
        if not p.is_file():
            continue
        for line in p.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except ValueError:
                continue


def _fire_log_coverage(home: Path, recs: list) -> str:
    """One line saying how far back the log actually reaches, and whether
    rotation has thrown anything away.

    T607. Two of three counts on a 9-day soak came back ungradeable: the log
    keeps 5 MB plus a single `.1` generation, and at the observed 5.2 MB per
    3 days the surviving window was 3.7 days -- but nothing in the output said
    the rest had been discarded. It just returned a smaller number, which reads
    exactly like a real answer. A count over a window longer than the log holds
    is a FLOOR, and until it says so the instrument is reporting its own limit
    as a measurement.

    The presence of `fires.jsonl.1` is the tell: rotation only creates it by
    replacing an earlier one, so once it exists, records older than the earliest
    held are gone and unrecoverable.
    """
    import datetime
    if not recs:
        return ""
    ts = [r.get("ts", 0) for r in recs if r.get("ts")]
    if not ts:
        return ""
    first = datetime.datetime.fromtimestamp(min(ts))
    age = (datetime.datetime.now() - first).total_seconds() / 86400.0
    line = (f"warden log: {len(recs)} record(s) held, earliest "
            f"{first.strftime('%Y-%m-%d %H:%M')} ({age:.1f}d ago)")
    if (home / "fires.jsonl.1").is_file():
        line += ("  — ROTATED: older records were discarded, so any count over a "
                 "window longer than this is a floor, not a total")
    return line


def cmd_log(args) -> int:
    """Show recent fire records: which rules were considered/fired at each
    moment and the steer text verbatim. The answer to "did the LLM ignore the
    steer, or did we never send the right one?" starts here."""
    import datetime
    home = warden_home()
    recs = all_recs = list(_iter_fire_records(home))
    if args.moment:
        recs = [r for r in recs if args.moment in r.get("moment", "")]
    if args.anchor:
        recs = [r for r in recs if r.get("anchor") == args.anchor]
    if args.rule:
        recs = [r for r in recs
                if any(args.rule in f.get("rule", "") for f in r.get("fires", []))
                or any(args.rule in c for c in r.get("considered", []))]
    if args.fired:
        recs = [r for r in recs if r.get("fires")]
    if not recs:
        print("warden log: no matching fire records"
              + ("" if (home / "fires.jsonl").is_file() else
                 " (no fires.jsonl yet — records appear as moments fire)"))
        # A zero is a claim about the instrument as much as about the corpus:
        # say what window that zero covers (T607).
        cov = _fire_log_coverage(home, all_recs)
        if cov:
            print(cov)
        return 0
    for r in recs[-args.n:]:
        dt = datetime.datetime.fromtimestamp(r.get("ts", 0))
        t = dt.strftime("%Y-%m-%d %H:%M:%S.") + f"{dt.microsecond // 1000:03d}"
        fname = Path(r["file"]).name if r.get("file") else ""
        head = (f"{t}  {r.get('moment', '?')} @ {r.get('anchor', '?')}"
                f" [{r.get('engine', '?')}] {r.get('ms', 0)} ms")
        if fname:
            head += f"  {fname}"
        if r.get("command"):
            c = r["command"].replace("\n", " ⏎ ")
            head += "  $ " + (c if args.full or len(c) <= 120 else c[:120] + " …")
        fired_ids = {f.get("rule") for f in r.get("fires", [])}
        silent = [c for c in r.get("considered", []) if c not in fired_ids]
        if silent:
            head += f"  (considered, silent: {', '.join(silent)})"
        print(head)
        for f in r.get("fires", []):
            text = f.get("steer", "")
            if not args.full and len(text) > 200:
                text = text[:200] + " …"
            pad = "\n      ".join(text.splitlines())
            print(f"  → {f.get('rule', '?')}: {pad}")
    # Last line, deliberately: it is what a reader counting these records needs
    # in order to know whether the count is a total or a floor (T607).
    cov = _fire_log_coverage(home, all_recs)
    if cov:
        print(cov)
    return 0


# ── manual fire (debug) ──────────────────────────────────────────────────────

def cmd_fire(args) -> int:
    root = Path(args.anchor_root).expanduser().resolve()
    home = warden_home()
    if not (home / "rules-ir.json").is_file():
        raise SystemExit("warden: not compiled — run `warden compile` first")
    ir, module = wf.load_compiled(home, "all")
    ctx = wf.build_ctx(root, args.moment)
    traits = wf.read_anchor_traits(root)
    for s in wf.fire(ir, module, args.moment, ctx, traits):
        print(s)
    return 0


def cmd_mend(args) -> int:
    """F280 — print the remediation message for a rule id.

    An agent sees `mend` at the end of a steer line and cashes it in here.
    Resolution is rule → `mend::` slug → block text; the slug is a corpus
    authoring convenience and never reaches the caller."""
    home = warden_home()
    if not (home / "rules-ir.json").is_file():
        raise SystemExit("warden: not compiled — run `warden compile` first")
    ir = json.loads((home / "rules-ir.json").read_text(encoding="utf-8"))
    rid = args.rule.strip()
    row = (ir.get("rules") or {}).get(rid)
    if row is None:
        raise SystemExit(f"warden: no such rule `{rid}`")
    slug = row.get("mend")
    block = (ir.get("mend") or {}).get(slug) if slug else None
    if block is None:
        raise SystemExit(f"warden: `{rid}` has no mend message — nothing to teach "
                         "(a steer would not have carried the marker)")
    print(block["text"])
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="warden", description="Warden control CLI (F220).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    pm = sub.add_parser("mend", help="print the remediation message for a rule id (F280)")
    pm.add_argument("rule", help="rule id as printed in the steer, e.g. R-log-01")
    pm.set_defaults(fn=cmd_mend)
    sub.add_parser("on", help="clear the kill switch").set_defaults(fn=cmd_on)
    sub.add_parser("off", help="set the global kill switch").set_defaults(fn=cmd_off)
    sub.add_parser("compile", help="scan + compile the corpus → ~/.warden/").set_defaults(fn=cmd_compile)
    for name, fn in (("install", cmd_install), ("uninstall", cmd_uninstall), ("status", cmd_status)):
        p = sub.add_parser(name)
        p.add_argument("--settings", help="settings.json path (default: ~/.claude/settings.json)")
        if name == "install":
            p.add_argument("--rust", action="store_true",
                           help="register the Rust dispatcher (warden-rs hook) instead of the Python hook")
        p.set_defaults(fn=fn)
    pd = sub.add_parser("daemon", help="resident interpreter control (F213 phase 2)")
    pd.add_argument("action", choices=["start", "stop", "status"])
    pd.set_defaults(fn=cmd_daemon)
    pf = sub.add_parser("fire", help="manually fire one moment against an anchor")
    pf.add_argument("anchor_root")
    pf.add_argument("moment")
    pf.set_defaults(fn=cmd_fire)
    pl = sub.add_parser("log", help="show recent fire records (rules considered/fired + steer text)")
    pl.add_argument("-n", type=int, default=20, help="records to show (default 20)")
    pl.add_argument("--moment", help="filter: moment substring (e.g. tool:pre)")
    pl.add_argument("--anchor", help="filter: anchor name")
    pl.add_argument("--rule", help="filter: rule id substring")
    pl.add_argument("--fired", action="store_true", help="only records that emitted a steer")
    pl.add_argument("--full", action="store_true", help="never truncate steer text")
    pl.set_defaults(fn=cmd_log)
    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
